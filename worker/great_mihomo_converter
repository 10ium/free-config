// امنیت و احراز هویت مدیریت (Admin Security)
// ==========================================
async function getAdminPassword(env, kv) {
  if (env && env.ADMIN_PASSWORD) return String(env.ADMIN_PASSWORD).trim();
  if (MEM_ADMIN_PASSWORD) return MEM_ADMIN_PASSWORD;
  if (kv) {
    const p = await kv.get("sys:admin_password");
    if (p) return String(p).trim();
  }
  return null;
}

async function setAdminPassword(password, env, kv) {
  MEM_ADMIN_PASSWORD = password;
  if (kv) {
    await kv.put("sys:admin_password", password);
  }
}

async function isAuthorized(request, env, kv) {
  const adminPass = await getAdminPassword(env, kv);
  if (!adminPass) return true; // اگر رمزی تنظیم نشده اجازه تنظیم اولیه هست

  const authHeader = request.headers.get("x-admin-key") || request.headers.get("Authorization");
  if (authHeader) {
    const cleanAuth = authHeader.replace(/^Bearer\s+/i, "").trim();
    if (cleanAuth === adminPass) return true;
  }

  const cookieHeader = request.headers.get("Cookie") || "";
  const match = cookieHeader.match(/uph_admin_token=([^;]+)/);
  if (match && match[1] === adminPass) return true;

  return false;
}

