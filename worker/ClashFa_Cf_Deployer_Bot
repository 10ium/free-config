async function sendMessage(chatId, text, env, useReplyMarkup = false, customKeyboard = null) {
  const url = `https://api.telegram.org/bot${env.TELEGRAM_BOT_TOKEN}/sendMessage`;
  let replyMarkup = {};
  if (useReplyMarkup) {
    replyMarkup = { keyboard: [[{ text: "🔙 بازگشت به منوی اصلی" }]], resize_keyboard: true };
  } else if (customKeyboard) {
    replyMarkup = { inline_keyboard: customKeyboard };
  }

  await fetch(url, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      chat_id: chatId,
      text: text,
      parse_mode: "HTML",
      reply_markup: (useReplyMarkup || customKeyboard) ? replyMarkup : undefined
    })
  });
}

async function editMessageText(chatId, messageId, text, env, forceKeyboard = false) {
  const url = `https://api.telegram.org/bot${env.TELEGRAM_BOT_TOKEN}/editMessageText`;
  await fetch(url, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      chat_id: chatId,
      message_id: messageId,
      text: text,
      parse_mode: "HTML",
      reply_markup: forceKeyboard ? {
        inline_keyboard: [[{ text: "🔙 بازگشت به منوی اصلی", callback_data: "go_main" }]]
      } : undefined
    })
  });
}

