// --- ADVANCED GITHUB RAW URL NORMALIZER ---
function normalizeGitHubUrl(urlStr) {
  let target = urlStr.trim();
  // Strip query parameters (?raw=true, etc.)
  if (target.includes("?")) {
    target = target.split("?")[0];
  }
  // Convert Gist URL to raw
  if (target.includes("gist.github.com") && !target.includes("/raw")) {
    target = target.replace("gist.github.com", "gist.githubusercontent.com") + "/raw";
    return target;
  }
  // Convert standard GitHub blob URL to raw
  if (target.includes("github.com") && !target.includes("raw.githubusercontent.com")) {
    target = target
      .replace("github.com", "raw.githubusercontent.com")
      .replace("/blob/", "/");
  }
  return target;
}



