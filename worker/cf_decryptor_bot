        <div class="drop-title">\u0627\u0646\u062A\u062E\u0627\u0628 \u06CC\u0627 \u0631\u0647\u0627 \u06A9\u0631\u062F\u0646 \u0641\u0627\u06CC\u0644\u200C\u0647\u0627\u06CC \u06A9\u0627\u0646\u0641\u06CC\u06AF</div>
