function calculateExactAge(birthYear, birthMonth = null, birthDay = null) {
  if (!birthYear) return null;
  const shamsi = getShamsiDetails();
  let age = shamsi.year - birthYear;
  if (birthMonth) {
    if (shamsi.month < birthMonth) {
      age -= 1;
    } else if (shamsi.month === birthMonth && birthDay && shamsi.day < birthDay) {
      age -= 1;
    }
  }
  return age;
}

function getShamsiDetails() {
  const now = new Date();
  try {
    const formatter = new Intl.DateTimeFormat('en-US-u-ca-persian', {
      year: 'numeric',
      month: 'numeric',
      day: 'numeric'
    });
    const parts = formatter.formatToParts(now);
    const y = parseInt(parts.find(p => p.type === 'year')?.value || '1405', 10);
    const m = parseInt(parts.find(p => p.type === 'month')?.value || '1', 10);
    const d = parseInt(parts.find(p => p.type === 'day')?.value || '1', 10);
    return { year: y, month: m, day: d };
  } catch {
    return { year: now.getFullYear() - 621, month: 1, day: 1 };
  }
}

function getTehranDate() {
  const now = new Date();
  const tehranMillis = now.getTime() + (3.5 * 60 * 60 * 1000);
  const t = new Date(tehranMillis);
  const year = t.getUTCFullYear();
  const month = String(t.getUTCMonth() + 1).padStart(2, '0');
  const day = String(t.getUTCDate()).padStart(2, '0');
  const hours = t.getUTCHours();
  const minutes = t.getUTCMinutes();
  const seconds = t.getUTCSeconds();
  
  const secondsToMidnight = (23 - hours) * 3600 + (59 - minutes) * 60 + (60 - seconds);
  const remainingHours = Math.floor(secondsToMidnight / 3600);
  const remainingMinutes = Math.floor((secondsToMidnight % 3600) / 60);
  const remainingSecs = secondsToMidnight % 60;

  return {
    dateStr: `${year}-${month}-${day}`,
    hours,
    minutes,
    seconds,
    remainingStr: `${remainingHours} ساعت و ${remainingMinutes} دقیقه و ${remainingSecs} ثانیه`
  };
}

function parseAgeDiff(text) {
  const clean = text.trim().replace(/[\u200B-\u200D\uFEFF]/g, '').toLowerCase();
  if (clean === 'همسن' || clean === 'هم‌سن' || clean === 'هم سن' || clean === '0' || clean === '۰') {
    return 0;
  }
  const norm = normalizeDigits(clean);
  const match = norm.match(/^([+-]?\d{1,2})$/);
  if (match) {
    const val = parseInt(match[1], 10);
    if (val >= -50 && val <= 50) return val;
  }
  return null;
}

function formatAgeDiff(diff) {
  if (diff === null || diff === undefined) return 'تنظیم‌نشده';
  if (diff === 0) return 'هم‌سن (۰ سال)';
  if (diff === -50) return 'بدون حداقل (مهم نیست)';
  if (diff === 50) return 'بدون حداکثر (مهم نیست)';
  if (diff < 0) return `${Math.abs(diff)} سال از من کوچک‌تر (${diff})`;
  return `${diff} سال از من بزرگ‌تر (+${diff})`;
}

function normalizeDigits(str) {
  if (!str) return '';
  return str.toString()
    .replace(/[۰٠]/g, '0')
    .replace(/[۱١]/g, '1')
    .replace(/[۲٢]/g, '2')
    .replace(/[۳٣]/g, '3')
    .replace(/[۴٤]/g, '4')
    .replace(/[۵٥]/g, '5')
    .replace(/[۶٦]/g, '6')
    .replace(/[۷٧]/g, '7')
    .replace(/[۸٨]/g, '8')
    .replace(/[۹٩]/g, '9');
}

