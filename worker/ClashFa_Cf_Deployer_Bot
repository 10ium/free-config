// Create Pages Project with Auto-Retry on Name Conflict (up to 3 attempts)
async function createPagesProject(token, accountId, name, bindings, retryCount = 0) {
  const kvBindingsObj = {};
  const envVarsObj = {};

  bindings.forEach(b => {
    if (b.type === "kv_namespace") {
      kvBindingsObj[b.name] = { namespace_id: b.namespace_id };
    } else if (b.type === "plain_text") {
      envVarsObj[b.name] = { type: "plain_text", value: b.text };
    }
  });

  const payload = {
    name: name,
    production_branch: "main",
    deployment_configs: {
      production: {
        compatibility_date: (typeof COMPATIBILITY_DATE !== "undefined" ? COMPATIBILITY_DATE : DEFAULT_COMPATIBILITY_DATE),
        compatibility_flags: ["nodejs_compat"],
        kv_namespaces: kvBindingsObj,
        env_vars: envVarsObj
      }
    }
  };

  const res = await fetchWithTimeout(`https://api.cloudflare.com/client/v4/accounts/${accountId}/pages/projects`, {
    method: "POST",
    headers: {
      "Authorization": `Bearer ${token}`,
      "Content-Type": "application/json"
    },
    body: JSON.stringify(payload)
  }, 20000);

  const data = await res.json();
  if (!data.success) {
    if (data.errors?.[0]?.code === 8000000) {
      return await getPagesProject(token, accountId, name);
    }
    const errMsg = (data.errors?.[0]?.message || "").toLowerCase();
    if (errMsg.includes("already exists") && retryCount < 3) {
      const newName = generateSafeWorkerName(null, "pages");
      return await createPagesProject(token, accountId, newName, bindings, retryCount + 1);
    }
    throw new Error(data.errors?.[0]?.message || "Failed to create Pages.");
  }
  return { ...data.result, deployedName: name };
}

