      sourceCode = await getPresetCode(null, env, templateUrl);
    } else {
      const preset = PRESETS[templateIdx];
      sourceCode = await getPresetCode(preset, env);
    }
  } catch (err) {
    session.state = "IDLE";
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(session));
    return sendMessage(chatId, `❌ خطا در دریافت سورس کد:\n<code>${escapeHTML(err.message)}</code>`, env);
