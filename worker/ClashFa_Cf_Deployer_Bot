async function createPagesProject(token, accountId, name, bindings) {
  const kvBindingsObj = {};
  const envVarsObj = {};

  bindings.forEach(b => {
    if (b.type === "kv_namespace") {
      kvBindingsObj[b.name] = { namespace_id: b.namespace_id };
    } else if (b.type === "plain_text") {
      envVarsObj[b.name] = { type: "plain_text", value: b.text };
    }
  });

  const payload = {
    name: name,
    production_branch: "main",
    deployment_configs: {
      production: {
        compatibility_date: new Date().toISOString().split("T")[0],
        compatibility_flags: ["nodejs_compat"],
        kv_namespaces: kvBindingsObj,
        env_vars: envVarsObj
      }
    }
  };

  const res = await fetch(`https://api.cloudflare.com/client/v4/accounts/${accountId}/pages/projects`, {
    method: "POST",
    headers: {
      "Authorization": `Bearer ${token}`,
      "Content-Type": "application/json",
      "User-Agent": "ClashFa-Deployer-Bot"
    },
    body: JSON.stringify(payload)
  });

  const data = await res.json();
  if (!data.success) {
    if (data.errors?.[0]?.code === 8000000) {
      return await getPagesProject(token, accountId, name);
    }
    throw new Error(data.errors?.[0]?.message || "Failed to create Pages.");
  }
  return data.result;
}

