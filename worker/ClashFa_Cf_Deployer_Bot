// Helper to dynamically resolve URL path suffix for any preset
function resolvePathSuffix(preset, vars = {}) {
  if (!preset) return "";
  const u = vars.uuid || vars.UUID || "";
  if (preset.id === "cf_vless_trojan_yongge" || preset.id === "cf_vless_yongge") {
    return u ? `/${u}` : "/86c50e3a-5b87-49dd-bd20-03c7f2735e40";
  }
  if (preset.id === "emotional_damage") {
    return u ? `/${u}` : "/";
  }
  if (preset.id === "nahan") return "/sync/dash";
  if (preset.id === "edgetunnel" || preset.id === "irnova") return "/admin";
  if (preset.id === "netra_panel") return "/panel";
  if (preset.id === "foxcloud") return "/sub";
  if (preset.id === "faceless-bot" || preset.id === "faceless_chat_bot") return "/setup";
  if (preset.id === "cf_proxy_eooce") return "/?ed=2560";
  if (preset.pathSuffix && preset.pathSuffix.includes("{UUID}")) {
    return u ? preset.pathSuffix.replace("{UUID}", u) : "/";
  }
  return preset.pathSuffix || "";
}



