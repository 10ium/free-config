export default {
  async fetch() {
    try {
      // Your new subscription links (Automatically deduplicates any repeated URLs)
      const SUBS = [...new Set(`
      https://raw.githubusercontent.com/liketolivefree/kobabi/main/sub_all.txt
      https://raw.githubusercontent.com/10ium/VpnClashFaCollector/main/sub/all/mixed.txt
      https://raw.githubusercontent.com/10ium/V2ray-Config/main/All_Configs_Sub.txt
      https://raw.githubusercontent.com/maimengmeng/mysub/refs/heads/main/valid_content_all.txt
      https://raw.githubusercontent.com/10ium/VpnClashFaCollector/main/sub/all/mixed.txt
      https://raw.githubusercontent.com/itsyebekhe/PSG/main/subscriptions/xray/base64/reality
      https://raw.githubusercontent.com/itsyebekhe/PSG/main/subscriptions/xray/base64/xhttp
      https://raw.githubusercontent.com/10ium/telegram-configs-collector/main/splitted/mixed
      `.split("\n").map(s => s.trim()).filter(Boolean))]

      let proxies = []

      const fetchPromises = SUBS.map(async (sub) => {
        try {
          const res = await fetch(sub, { cf: { cacheTtl: 0 } })
          const raw = await res.text()
          const decoded = decodeSub(raw)

          const lines = decoded.split("\n")
            .map(l => l.trim())
            .filter(Boolean)

          const localProxies = []
          for (const line of lines) {
            let p = parseProxy(line)
            if (p) {
              // Deep sanitize all fields recursively to completely eliminate YAML control character errors
              p = sanitizeObj(p) 
              p.name = p.name || "Unnamed" // Ensure name exists after sanitization
              if (valid(p)) localProxies.push(p)
            }
          }
          return localProxies
        } catch {
          return []
        }
      })

      const results = await Promise.allSettled(fetchPromises)
      results.forEach(result => {
        if (result.status === "fulfilled") {
          proxies.push(...result.value)
        }
      })

      proxies = dedupe(proxies)

      // --- Sorting Logic: Sort by specific protocol order ---
      const protocolOrder = {
        "hy2": 1,
        "hy": 2,
        "vless": 3,
        "anytls": 4,
        "trojan": 5,
        "ss": 6,
        "vmess": 7,
        "wg": 8,
        "tuic": 9,
        "ssr": 10,
        "snell": 11,
        "http": 12,
        "socks": 13,
        "ssh": 14
      }

      proxies.sort((a, b) => {
        const getDisplayType = (type) => {
          if (type === "hysteria2") return "hy2";
          if (type === "hysteria") return "hy";
          if (type === "wireguard") return "wg";
          if (type === "socks5") return "socks";
          return type.toLowerCase();
        }
        
        const orderA = protocolOrder[getDisplayType(a.type)] || 99; // 99 for unknown protocols
        const orderB = protocolOrder[getDisplayType(b.type)] || 99;
        
        return orderA - orderB;
      })
      // ------------------------------------------------------

      // --- Naming Logic: Rename proxies sequentially based on their type ---
      const typeCounters = {}
      for (const p of proxies) {
        // Normalize type names for display
        const displayType = p.type === "hysteria2" ? "hy2" : 
                            p.type === "hysteria" ? "hy" : 
                            p.type === "wireguard" ? "wg" : 
                            p.type === "socks5" ? "socks" : p.type.toLowerCase()
                            
        typeCounters[displayType] = (typeCounters[displayType] || 0) + 1
        p.name = `${displayType} ${typeCounters[displayType]}`
      }
      // ---------------------------------------------------------------------

      return new Response(buildProvider(proxies), {
        headers: { "content-type": "text/yaml; charset=utf-8" }
      })

    } catch (e) {
      return new Response("error: " + e.toString(), { status: 500 })
    }
  }
}

/* ---------- Decode ---------- */

function normalizeBase64(v) {
  if (!v) return null
  v = v.trim().replace(/-/g, "+").replace(/_/g, "/").replace(/\s+/g, "")
  const pad = v.length % 4
  if (pad === 2) v += "=="
  if (pad === 3) v += "="
  if (pad === 1) return null
  
  try {
    const binString = atob(v);
    const bytes = Uint8Array.from(binString, (m) => m.codePointAt(0));
    return new TextDecoder().decode(bytes);
  } catch { 
    return null 
  }
}

function decodeSub(text) {
  if (text.includes("://")) return text
  const fixed = normalizeBase64(text)
  if (!fixed) return text
  return fixed
}

function safeDecode(str) {
  try { return decodeURIComponent(str) } catch { return str }
}

/* ---------- Deep Sanitize ---------- */

// Recursively removes control characters, BOM, and zero-width spaces from all strings
function sanitizeObj(obj) {
  if (typeof obj === 'string') {
    return obj.replace(/[\x00-\x1F\x7F-\x9F\u200B-\u200D\uFEFF\uFFFD]/g, "").trim();
  }
  if (Array.isArray(obj)) {
    return obj.map(sanitizeObj);
  }
  if (obj !== null && typeof obj === 'object') {
    const res = {};
    for (const key in obj) {
      res[key] = sanitizeObj(obj[key]);
    }
    return res;
  }
  return obj;
}

/* ---------- Parser ---------- */

function parseProxy(line) {
  try {
    const lowerLine = line.toLowerCase();
    if (lowerLine.startsWith("vless://")) return parseVless(line)
    if (lowerLine.startsWith("vmess://")) return parseVmess(line)
    if (lowerLine.startsWith("trojan://")) return parseTrojan(line)
    if (lowerLine.startsWith("anytls://")) return parseAnyTls(line)
    if (lowerLine.startsWith("ss://")) return parseSS(line)
    if (lowerLine.startsWith("ssr://")) return parseSSR(line)
    if (lowerLine.startsWith("hy2://") || lowerLine.startsWith("hysteria2://")) return parseHysteria2(line)
    if (lowerLine.startsWith("hysteria://")) return parseHysteria(line)
    if (lowerLine.startsWith("wg://") || lowerLine.startsWith("wireguard://")) return parseWireguard(line)
    if (lowerLine.startsWith("tuic://")) return parseTuic(line)
    if (lowerLine.startsWith("http://") || lowerLine.startsWith("https://")) return parseHttp(line)
    if (lowerLine.startsWith("socks://") || lowerLine.startsWith("socks5://")) return parseSocks(line)
    if (lowerLine.startsWith("snell://")) return parseSnell(line)
    if (lowerLine.startsWith("ssh://")) return parseSSH(line)
  } catch {}
  return null
}

/* ---------- VLESS ---------- */

function parseVless(link) {
  const url = new URL(link.replace(/^vless:\/\//i, "http://"))
  const security = url.searchParams.get("security") || ""

  const proxy = {
    name: safeDecode(url.hash.substring(1) || url.hostname),
    type: "vless",
    server: url.hostname,
    port: parseInt(url.port),
    uuid: url.username || "",
    tls: ["tls","reality"].includes(security),
    network: url.searchParams.get("type") || "tcp"
  }

  const sni = url.searchParams.get("sni")
  if (sni) proxy.servername = sni

  const fp = url.searchParams.get("fp")
  if (fp) proxy["client-fingerprint"] = fp

  const alpn = url.searchParams.get("alpn")
  if (alpn) proxy.alpn = alpn.split(",")

  const flow = url.searchParams.get("flow")
  if (flow) proxy.flow = flow

  if (security === "reality") {
    proxy["reality-opts"] = {
      "public-key": url.searchParams.get("pbk") || ""
    }
    const sid = url.searchParams.get("sid")
    if (sid) proxy["reality-opts"]["short-id"] = sid
  }

  if (proxy.network === "ws") {
    const path = url.searchParams.get("path")
    const host = url.searchParams.get("host")
    if (path || host) {
      proxy["ws-opts"] = {}
      if (path) proxy["ws-opts"].path = path
      if (host) proxy["ws-opts"].headers = { Host: host }
    }
  } else if (proxy.network === "grpc") {
    const serviceName = url.searchParams.get("serviceName")
    if (serviceName) {
      proxy["grpc-opts"] = { "grpc-service-name": serviceName }
    }
  }

  return proxy
}

/* ---------- VMESS ---------- */

function parseVmess(link) {
  const raw = link.replace(/^vmess:\/\//i, "")
  const fixed = normalizeBase64(raw)
  if (!fixed) return null
  const j = JSON.parse(fixed)

  return {
    name: j.ps || j.add,
    type: "vmess",
    server: j.add,
    port: parseInt(j.port),
    uuid: j.id || "",
    alterId: 0,
    cipher: "auto"
  }
}

/* ---------- TROJAN ---------- */

