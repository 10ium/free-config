  } else if (totalCount > 0) {
    let messageText = `\u2705 <b>\u06A9\u0627\u0646\u0641\u06CC\u06AF\u200C\u0647\u0627\u06CC \u0627\u0633\u062A\u062E\u0631\u0627\u062C\u200C\u0634\u062F\u0647 (${totalCount} \u0639\u062F\u062F):</b>

`;
    for (const item of cleanXrayLinks) {
      if (item.link) {
        messageText += `\u25AB\uFE0F <b>${item.name}</b> (${item.protocol.toUpperCase()}):
<pre><code>${item.link}</code></pre>

`;
      }
    }
    messageText += statsText;
    if (messageText.length > 3900) {
      await bot.sendDocument(chatId, Buffer.from(plainLinks.join("\n"), "utf8"), `${baseName}_xray.txt`, {
        caption: `\u2705 \u062A\u0639\u062F\u0627\u062F \u06A9\u0627\u0646\u0641\u06CC\u06AF\u200C\u0647\u0627 \u0632\u06CC\u0627\u062F \u0628\u0648\u062F (${totalCount} \u0639\u062F\u062F)\u061B \u062F\u0631 \u0641\u0627\u06CC\u0644 \u0627\u0631\u0633\u0627\u0644 \u0634\u062F.${statsText}`,
        messageThreadId: threadId,
        replyMarkup: subDeliveryMarkup
      });
    } else {
      await bot.sendMessage(chatId, messageText, {
        messageThreadId: threadId,
        replyMarkup: subDeliveryMarkup
      });
    }
  } else if (openvpnProfiles.length === 0 && sshProfiles.length === 0 && mihomoProfiles.length === 0) {
    await bot.sendMessage(chatId, `\u26A0\uFE0F \u0647\u06CC\u0686 \u06A9\u0627\u0646\u0641\u06CC\u06AF \u0633\u0627\u0632\u06AF\u0627\u0631 \u0628\u0627 \u0647\u0633\u062A\u0647 Xray \u062F\u0631 \u0648\u0631\u0648\u062F\u06CC\u200C\u0647\u0627\u06CC \u0627\u0631\u0633\u0627\u0644\u06CC \u06CC\u0627\u0641\u062A \u0646\u0634\u062F.${statsText}`, {
      messageThreadId: threadId
    });
  }
  if (mihomoProfiles.length > 0) {
    await new Promise((r) => setTimeout(r, 400));
    const mYaml = buildMihomoConfig(mihomoProfiles, { ...filterOptions, skipFilter: true });
