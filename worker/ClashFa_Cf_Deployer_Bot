  }
}

function isESModule(code) {
  if (!code) return false;
  if (code.includes("export default") || code.includes("export{") || code.includes("export {")) return true;
  if (code.includes("import{") || code.includes("import {")) return true;
  return /export\s*\{/i.test(code) ||
         /export\s+default\b/i.test(code) ||
         /export\s+(const|let|var|function|async|class)\b/i.test(code) ||
         /import\s*\{/i.test(code) ||
         /import\s+[\w$*]+/i.test(code) ||
         /import\s*['"]/i.test(code);
}

