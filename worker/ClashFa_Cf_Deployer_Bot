      }

      if (preset.d1Bindings && preset.d1Bindings.length > 0) {
        for (const d1Name of preset.d1Bindings) {
          if (!bindings.some(b => b.name === d1Name && b.type === "d1")) {
            const dbName = `${workerName}-${d1Name}`.toLowerCase().replace(/[^a-z0-9_-]/g, "-");
            const dbId = await createD1Database(account.token, account.id, dbName);
            if (dbId) {
              bindings.push({ name: d1Name, id: dbId, database_id: dbId, type: "d1" });
              if (preset.id === "faceless-bot" || preset.id === "faceless_chat_bot") {
                const schemaSql = `\nCREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id_hash TEXT NOT NULL UNIQUE, encrypted_tg_id TEXT NOT NULL, nickname TEXT NOT NULL, link_token TEXT NOT NULL UNIQUE, is_link_active INTEGER NOT NULL DEFAULT 1, is_vacation INTEGER NOT NULL DEFAULT 0, delivery_mode TEXT NOT NULL DEFAULT 'direct', is_banned INTEGER NOT NULL DEFAULT 0, personal_rate_limit INTEGER NOT NULL DEFAULT 0, delivery_destination TEXT NOT NULL DEFAULT 'pv', created_at DATETIME DEFAULT CURRENT_TIMESTAMP, last_active DATETIME DEFAULT CURRENT_TIMESTAMP);\nCREATE INDEX IF NOT EXISTS idx_users_link_token ON users(link_token);\nCREATE INDEX IF NOT EXISTS idx_users_user_id_hash ON users(user_id_hash);\n`;
                await executeD1Statements(account.token, account.id, dbId, schemaSql);
              } else if (preset.id === "apex_panel" || preset.id === "apex") {
                const schemaSql = `\nCREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY AUTOINCREMENT, username TEXT NOT NULL UNIQUE, uuid TEXT NOT NULL UNIQUE, sub_token TEXT NOT NULL UNIQUE, trojan_pass TEXT NOT NULL DEFAULT '', trojan_hash TEXT NOT NULL DEFAULT '', quota_bytes INTEGER NOT NULL DEFAULT 0, used_bytes INTEGER NOT NULL DEFAULT 0, status TEXT NOT NULL DEFAULT 'active', note TEXT NOT NULL DEFAULT '', created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL, expires_at INTEGER);\nCREATE INDEX IF NOT EXISTS idx_users_uuid ON users(uuid);\nCREATE INDEX IF NOT EXISTS idx_users_token ON users(sub_token);\nCREATE INDEX IF NOT EXISTS idx_users_trojan ON users(trojan_hash);\nCREATE INDEX IF NOT EXISTS idx_users_expires ON users(expires_at);\nCREATE INDEX IF NOT EXISTS idx_users_status ON users(status);\nCREATE TABLE IF NOT EXISTS settings (key TEXT PRIMARY KEY, value TEXT NOT NULL, updated_at INTEGER NOT NULL);\nCREATE TABLE IF NOT EXISTS usage (day TEXT NOT NULL, user_id INTEGER NOT NULL, up_bytes INTEGER NOT NULL DEFAULT 0, down_bytes INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (day, user_id));\nCREATE INDEX IF NOT EXISTS idx_usage_day ON usage(day);\n`;
                await executeD1Statements(account.token, account.id, dbId, schemaSql);
              } else if (preset.id === "telegram_shipper_bot") {
                if (typeof SHIPPER_SCHEMA_SQL !== "undefined" && SHIPPER_SCHEMA_SQL) {
                  await executeD1Statements(account.token, account.id, dbId, SHIPPER_SCHEMA_SQL);
                }
                if (typeof SHIPPER_CITIES_SQL !== "undefined" && SHIPPER_CITIES_SQL) {
                  await executeD1Statements(account.token, account.id, dbId, SHIPPER_CITIES_SQL);
                }
              }
            }
          }
        }
      }

      if (preset.vars && preset.vars.length > 0) {
        const missingVars = [];
        preset.vars.forEach(rawV => {
          const vName = typeof rawV === "object" ? rawV.name : rawV;
          if (vName && !vName.startsWith("D1_ID_") && !bindings.some(b => b.name === vName)) {
            missingVars.push(vName);
          }
        });
        if (missingVars.length > 0) {
          const gen = autoGenerateVars(missingVars, { chatId: chatId.toString() });
          for (const [k, v] of Object.entries(gen)) {
            bindings.push({ name: k, text: v.toString(), type: "plain_text" });
          }
        }
      }

      await deployWorkerScript(account.token, account.id, workerName, code, bindings, 0, preset);

      const contextVars = {};
      bindings.forEach(b => { if (b.text) contextVars[b.name] = b.text; });

      const urlInfo = await resolveDeploymentUrls(account.token, account.id, workerName, "worker", preset, contextVars, env, account.name);
      const rawBaseUrl = urlInfo.rawBaseUrl;
      const finalUrl = urlInfo.primaryUrl;
      account.subdomain = urlInfo.subdomain;

      let customDomainsMsg = "";
      if (urlInfo.customUrls && urlInfo.customUrls.length > 0) {
        customDomainsMsg = `\n\n🌐 <b>دامنه‌های اختصاصی متصل (Custom Domains):</b>\n`;
        for (const cUrl of urlInfo.customUrls) {
          customDomainsMsg += `🔸 <a href="${cUrl}">${cUrl}</a>\n`;
        }
      }

      let updSuccessMsg = `🎉 <b>سورس‌کد ورکر با موفقیت بروزرسانی شد!</b>\n\n` +
        `🏷 <b>نام ورکر:</b> <code>${escapeHTML(workerName)}</code>\n` +
        `📦 <b>قالب اعمال‌شده:</b> <b>${escapeHTML(preset.name)}</b>\n` +
        `🌐 <b>آدرس ورکر:</b>\n<a href="${finalUrl}">${finalUrl}</a>` +
        `${customDomainsMsg}\n\n` +
        `✅ کدهای جدید بارگذاری و تمام بایندینگ‌های لازم بررسی و حفظ شدند.`;

      if (preset.id === "cf_vless_trojan_yongge") {
        const vlessUrl = `${rawBaseUrl}/${contextVars.uuid || ""}`;
        const trojanUrl = `${rawBaseUrl}/${contextVars.pswd || ""}`;
        updSuccessMsg += `\n\n🔗 <b>لینک‌های دسترسی و سابسکریپشن:</b>\n` +
          `🔹 <b>لینک ساب VLESS:</b> <a href="${vlessUrl}">${vlessUrl}</a>\n` +
          `🔹 <b>لینک ساب Trojan:</b> <a href="${trojanUrl}">${trojanUrl}</a>\n`;
      }

      await logEvent(env, `ورکر ${workerName} با موفقیت به قالب ${preset.name} بروزرسانی شد.`, "info");
      return sendMessage(chatId, updSuccessMsg, env, false, [[{ text: "🔙 بازگشت به منوی ورکر", callback_data: "wk_menu_back" }]]);

    } catch (err) {
      await logEvent(env, `خطا در بروزرسانی ورکر ${workerName}: ${err.message}`, "error");
      return sendMessage(chatId, `❌ خطا در بروزرسانی ورکر:\n<code>${escapeHTML(err.message)}</code>`, env, false, [[{ text: "🔙 بازگشت به منوی ورکر", callback_data: "wk_menu_back" }]]);
    }
  }

  if (data === "manage_binds") {
    return displayWorkerBindings(chatId, userSession, env);
  }

  if (data.startsWith("del_b_")) {
    const idx = parseInt(data.replace("del_b_", ""), 10);
    const bindings = userSession.activeBindings || [];
    if (bindings[idx]) {
      const targetBinding = bindings[idx];
      const filteredBindings = bindings.filter((_, i) => i !== idx);

      const workerName = userSession.activeWorker;
      const accIdx = userSession.activeAccIdx;
      const account = userSession.accounts[accIdx];

      await sendMessage(chatId, `⏳ در حال حذف بایندینگ <code>${escapeHTML(targetBinding.name)}</code> از ورکر...`, env);

      try {
        await updateWorkerBindings(account.token, account.id, workerName, filteredBindings);
        await logEvent(env, `بایندینگ ${targetBinding.name} از ورکر ${workerName} حذف شد.`, "warning");
        await sendMessage(chatId, `✅ بایندینگ <code>${escapeHTML(targetBinding.name)}</code> با موفقیت حذف شد.`, env);
        
        userSession.activeBindings = filteredBindings;
        await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
        return displayWorkerBindings(chatId, userSession, env);
      } catch (err) {
        await sendMessage(chatId, `❌ خطای حذف بایندینگ:\n<code>${escapeHTML(err.message)}</code>`, env);
        return displayWorkerBindings(chatId, userSession, env);
      }
    }
  }

  if (data === "del_all_b") {
    const workerName = userSession.activeWorker;
    const keyboard = [
      [
        { text: "💥 بله، همه حذف شوند", callback_data: "exec_del_all_b" },
        { text: "❌ لغو عملیات", callback_data: "manage_binds" }
      ]
    ];
    return sendMessage(chatId, `⚠️ آیا مطمئن هستید که می‌خواهید <b>تمامی</b> بایندینگ‌های ورکر <code>${escapeHTML(workerName)}</code> را حذف کنید؟ این عمل بلافاصله دسترسی ورکر به منابع را قطع می‌کند.`, env, false, keyboard);
  }

  if (data === "exec_del_all_b") {
    const workerName = userSession.activeWorker;
    const accIdx = userSession.activeAccIdx;
    const account = userSession.accounts[accIdx];

    await sendMessage(chatId, "⏳ در حال حذف تمامی بایندینگ‌های ورکر...", env);

    try {
      await updateWorkerBindings(account.token, account.id, workerName, []);
      await logEvent(env, `تمامی بایندینگ‌های ورکر ${workerName} حذف شدند.`, "warning");
      await sendMessage(chatId, "✅ تمامی بایندینگ‌ها با موفقیت حذف شدند.", env);
      
      userSession.activeBindings = [];
      await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
      return displayWorkerBindings(chatId, userSession, env);
    } catch (err) {
      await sendMessage(chatId, `❌ خطا در حذف تمامی بایندینگ‌ها:\n<code>${escapeHTML(err.message)}</code>`, env);
      return displayWorkerBindings(chatId, userSession, env);
    }
  }

  if (data === "conf_del_wrk_sess") {
    const workerName = userSession.activeWorker;
    const keyboard = [
      [
        { text: "🗑️ فقط حذف خود ورکر", callback_data: "exec_del_wrk_only" },
        { text: "💥 حذف ورکر + متغیرها و دیتابیس‌ها", callback_data: "exec_del_wrk_full" }
      ],
      [
        { text: "❌ لغو عملیات", callback_data: "wk_menu_back" }
      ]
    ];
    return sendMessage(chatId, `⚠️ <b>گزینه‌های حذف ورکر <code>${escapeHTML(workerName)}</code>:</b>\n\nلطفاً نوع حذف را مشخص فرمایید:\n\n1️⃣ <b>فقط حذف ورکر:</b> اسکریپت ورکر پاک می‌شود اما پایگاه‌های داده و متغیرها در کلادفلر حفظ می‌گردند.\n2️⃣ <b>حذف کامل ورکر + منابع:</b> علاوه بر اسکریپت، دیتابیس‌های KV و بایندینگ‌های اختصاصی متصل به این ورکر نیز پاک‌سازی می‌شوند.`, env, false, keyboard);
  }

  if (data === "exec_del_wrk_only" || data === "exec_del_wrk_sess") {
    const workerName = userSession.activeWorker;
    const accIdx = userSession.activeAccIdx;
    const account = userSession.accounts[accIdx];

    await sendMessage(chatId, `⏳ در حال حذف ورکر <code>${escapeHTML(workerName)}</code> از کلادفلر...`, env);
    try {
      await deleteWorkerScript(account.token, account.id, workerName);
      await logEvent(env, `ورکر ${workerName} با موفقیت حذف شد.`, "warning");
      await sendMessage(chatId, `✅ اسکریپت ورکر <code>${escapeHTML(workerName)}</code> با موفقیت حذف گردید (منابع حفظ شدند).`, env);
    } catch (err) {
      await sendMessage(chatId, `❌ خطا در حذف ورکر:\n<code>${escapeHTML(err.message)}</code>`, env);
    }
    return displayTelegramProjects(chatId, account, env, accIdx);
  }

  if (data === "exec_del_wrk_full") {
    const workerName = userSession.activeWorker;
    const accIdx = userSession.activeAccIdx;
    const account = userSession.accounts[accIdx];

    await sendMessage(chatId, `⏳ در حال حذف ورکر <code>${escapeHTML(workerName)}</code> و پاک‌سازی منابع متصل...`, env);
    let deletedResourcesCount = 0;
    try {
      try {
        const settings = await getWorkerSettings(account.token, account.id, workerName);
        if (settings && Array.isArray(settings.bindings)) {
          for (const b of settings.bindings) {
            if (b.type === "kv_namespace" && b.namespace_id) {
              const ok = await deleteKVNamespace(account.token, account.id, b.namespace_id);
              if (ok) deletedResourcesCount++;
            } else if (b.type === "d1" && b.database_id) {
              const ok = await deleteD1Database(account.token, account.id, b.database_id);
              if (ok) deletedResourcesCount++;
            }
          }
        }
      } catch (_) {}

      await deleteWorkerScript(account.token, account.id, workerName);
      await logEvent(env, `ورکر ${workerName} و تعداد ${deletedResourcesCount} منبع متصل حذف شدند.`, "warning");
      await sendMessage(chatId, `✅ ورکر <code>${escapeHTML(workerName)}</code> با موفقیت حذف گردید.\n📦 تعداد منابع اختصاصی پاک‌شده: <code>${deletedResourcesCount}</code>`, env);
    } catch (err) {
      await sendMessage(chatId, `❌ خطا در حذف کامل ورکر:\n<code>${escapeHTML(err.message)}</code>`, env);
    }
    return displayTelegramProjects(chatId, account, env, accIdx);
  }

  if (data.startsWith("conf_del_all_wrk_")) {
    const accIdx = parseInt(data.replace("conf_del_all_wrk_", ""), 10);
    const keyboard = [
      [
        { text: "💥 بله، همه ورکرها حذف شوند", callback_data: `exec_del_all_wrk_${accIdx}` },
        { text: "❌ انصراف", callback_data: `list_opts_${accIdx}` }
      ]
    ];
    return sendMessage(chatId, "⚠️⚠️⚠️ <b>هشدار جدی</b>\n\nآیا از حذف <b>تمامی</b> ورکرهای موجود بر روی این اکانت اطمینان دارید؟ تمامی اسکریپت‌های شما پاک خواهند شد!", env, false, keyboard);
  }

  if (data.startsWith("exec_del_all_wrk_")) {
    const accIdx = parseInt(data.replace("exec_del_all_wrk_", ""), 10);
    const account = userSession.accounts[accIdx];

    await sendMessage(chatId, "⏳ در حال حذف دسته جمعی تمام ورکرها... لطفاً صبور باشید.", env);
    try {
      const workers = await listWorkerScripts(account.token, account.id);
      let deletedCount = 0;
      for (const w of workers) {
        try {
          await deleteWorkerScript(account.token, account.id, w.id);
          deletedCount++;
        } catch (e) {
          await logEvent(env, `خطا در حذف ورکر ${w.id}: ${e.message}`, "error");
        }
      }
      await logEvent(env, `تعداد ${deletedCount} ورکر از اکانت ${account.name} حذف دسته‌جمعی شدند.`, "warning");
      await sendMessage(chatId, `✅ عملیات پایان یافت. تعداد <code>${deletedCount}</code> ورکر با موفقیت حذف شدند.`, env);
    } catch (err) {
      await sendMessage(chatId, `❌ خطا در حذف دسته جمعی:\n<code>${escapeHTML(err.message)}</code>`, env);
    }
    return displayTelegramProjects(chatId, account, env, accIdx);
  }

  if (data === "go_main") {
    userSession.state = "IDLE";
    userSession.history = [];
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
    return sendMainMenu(chatId, env);
  }
}

// --- RESOURCE NAVIGATION FOR CUSTOM WIZARD ---
async function advanceResourceIndex(chatId, session, env) {
  session.deployPayload.resourceIndex += 1;
  pushHistory(session, "COLLECTING_RESOURCES");

  if (session.deployPayload.resourceIndex < session.deployPayload.resourceQueue.length) {
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(session));
    return promptCurrentResource(chatId, session, env);
  } else {
    return proceedToAccountStep(chatId, session, env);
  }
}

async function promptCurrentResource(chatId, session, env) {
  const queue = session.deployPayload.resourceQueue;
  const idx = session.deployPayload.resourceIndex;
  const item = queue[idx];

  const keyboard = [getNavKeyboardRow()];

  if (item.type === "kv") {
    if (item.step === "NAME") {
      return sendMessage(chatId, `📦 <b>دیتابیس KV (شماره ${item.index}):</b>\n\nنام متغیر بایندینگ (Binding Name) را وارد کنید (مثال: <code>KV</code>):`, env, false, keyboard);
    } else if (item.step === "ID") {
      const customKb = [
        [{ text: "🎲 ساخت خودکار توسط ربات", callback_data: "res_auto_kv" }],
        getNavKeyboardRow()
      ];
      return sendMessage(chatId, `📦 <b>دیتابیس KV (شماره ${item.index}):</b>\n\nشناسه Namespace ID دیتابیس KV خود را وارد کنید، یا روی دکمه ساخت خودکار کلیک کنید:`, env, false, customKb);
    }
  } else if (item.type === "d1") {
    if (item.step === "NAME") {
      return sendMessage(chatId, `🗄 <b>دیتابیس D1 (شماره ${item.index}):</b>\n\nنام متغیر بایندینگ (Binding Name) را وارد کنید (مثال: <code>DB</code> یا <code>IOT_DB</code>):`, env, false, keyboard);
    } else if (item.step === "ID") {
      return sendMessage(chatId, `🗄 <b>دیتابیس D1 (شماره ${item.index}):</b>\n\nشناسه دیتابیس D1 (Database ID) را وارد کنید یا خالی بگذارید برای ساخت خودکار:`, env, false, keyboard);
    }
  } else if (item.type === "var") {
    if (item.step === "NAME") {
      return sendMessage(chatId, `⚙️ <b>متغیر معمولی (شماره ${item.index}):</b>\n\nنام متغیر محیطی را وارد کنید (مثال: <code>ADMIN</code>):`, env, false, keyboard);
    } else if (item.step === "VAL") {
      const customKb = [
        [{ text: "🎲 تولید خودکار مقدار رندوم", callback_data: "res_auto_val" }],
        getNavKeyboardRow()
      ];
      return sendMessage(chatId, `⚙️ <b>متغیر معمولی (شماره ${item.index}):</b>\n\nمقدار متغیر <code>${escapeHTML(item.name)}</code> را وارد کنید:`, env, false, customKb);
    }
  }
}

// --- TELEGRAM DEPLOYMENT EXECUTOR ---
async function executeTelegramDeployment(chatId, session, env) {
  const { account, name, templateIdx, templateUrl, isLegacy, kvBindings, d1Bindings, vars, type, autoGenTemplate } = session.deployPayload;
  const activePreset = templateIdx !== "custom" ? PRESETS[templateIdx] : null;

  await sendMessage(chatId, "⚡ در حال خواندن سورس کد قالب...", env);
  let sourceCode = "";
  try {
    if (templateIdx === "custom") {
      sourceCode = await getPresetCode(null, env, templateUrl);
    } else {
      sourceCode = await getPresetCode(activePreset, env);
    }
  } catch (err) {
    session.state = "IDLE";
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(session));
    return sendMessage(chatId, `❌ خطا در دریافت سورس کد:\n<code>${escapeHTML(err.message)}</code>`, env);
  }

  sourceCode += `\n\n/* Signed: ${generateRandomString(CharsetAlphaNumeric, 24)} */`;

  await sendMessage(chatId, "🛠️ در حال ساخت دیتابیس‌ها و تنظیم منابع اختصاصی شما...", env);
  try {
    const activeBindings = [];
    const createdResources = [];

    // Process presets' variables & DB mappings
    let finalVars = { ...vars };
    if (autoGenTemplate && activePreset) {
      finalVars = autoGenerateVars(activePreset.vars, { ...vars, chatId: chatId.toString() });
    }

    // Auto-detect BOT_USERNAME via Telegram API if needed
    if (finalVars.BOT_TOKEN && (!finalVars.BOT_USERNAME || finalVars.BOT_USERNAME === "")) {
      try {
        const tgRes = await fetchWithTimeout(`https://api.telegram.org/bot${finalVars.BOT_TOKEN}/getMe`, {}, 8000);
        const tgData = await tgRes.json();
        if (tgData.ok && tgData.result && tgData.result.username) {
          finalVars.BOT_USERNAME = tgData.result.username;
        }
      } catch (_) {}
    }

    // Ensure ADMIN_IDS has a value if preset needs it
    if (finalVars.hasOwnProperty("ADMIN_IDS") && (!finalVars.ADMIN_IDS || finalVars.ADMIN_IDS === "")) {
      finalVars.ADMIN_IDS = chatId.toString();
    }

    // Process presets' default KVs
    if (kvBindings && kvBindings.length > 0) {
      for (const kvName of kvBindings) {
        await sendMessage(chatId, `📦 در حال ایجاد دیتابیس KV با نام <code>${escapeHTML(kvName)}</code>...`, env);
        const kvNamespaceId = await createKVNamespace(account.token, account.id, `${name}-${kvName}`);
        if (kvNamespaceId) {
          createdResources.push({ type: "kv", id: kvNamespaceId, name: `${name}-${kvName}` });
          activeBindings.push({ name: kvName, namespace_id: kvNamespaceId, type: "kv_namespace" });
        }
      }
    }

    // Process presets' default D1 databases
    if (d1Bindings && d1Bindings.length > 0) {
      for (const d1Name of d1Bindings) {
        await sendMessage(chatId, `🗄 در حال ساخت فیزیکی دیتابیس D1 با نام <code>${escapeHTML(d1Name)}</code>...`, env);
        const sanitizedDbName = `${name}-${d1Name}`.toLowerCase().replace(/[^a-z0-9_-]/g, "-");
        const dbId = await createD1Database(account.token, account.id, sanitizedDbName);
        if (dbId) {
          createdResources.push({ type: "d1", id: dbId, name: sanitizedDbName });
          activeBindings.push({ name: d1Name, id: dbId, database_id: dbId, type: "d1" });
          if (!finalVars) finalVars = {};
          finalVars[`D1_ID_${d1Name}`] = dbId;

          // Execute D1 Database Schema if preset requires it
          if (templateIdx !== "custom") {
            const currentPreset = PRESETS[templateIdx];
            if (currentPreset && (currentPreset.id === "faceless-bot" || currentPreset.id === "faceless_chat_bot")) {
              await sendMessage(chatId, "⚙️ در حال ساخت خودکار جدول‌های دیتابیس (users, chats, logs) برای بات چت ناشناس...", env);
              const schemaSql = `
CREATE TABLE IF NOT EXISTS users (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  user_id_hash TEXT NOT NULL UNIQUE,
  encrypted_tg_id TEXT NOT NULL,
  nickname TEXT NOT NULL,
  link_token TEXT NOT NULL UNIQUE,
  is_link_active INTEGER NOT NULL DEFAULT 1,
  is_vacation INTEGER NOT NULL DEFAULT 0,
  delivery_mode TEXT NOT NULL DEFAULT 'direct',
  is_banned INTEGER NOT NULL DEFAULT 0,
  personal_rate_limit INTEGER NOT NULL DEFAULT 0,
  delivery_destination TEXT NOT NULL DEFAULT 'pv',
  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
