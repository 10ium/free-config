// src/handlers/edit.ts
function escapeHtml3(str = "") {
  return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}
async function handleEditedMessage(editedMsg, env, db, tg) {
  const from = editedMsg.from;
  if (!from)
    return;
  const senderHash = await hashUserId(from.id, env.SECRET_SALT);
  const mapping = await db.getMappingBySource(senderHash, editedMsg.message_id);
  const isPendingPeek = await db.isMessagePendingPeek(senderHash, editedMsg.message_id);
  if (isPendingPeek) {
    await db.updatePendingPeekContent(senderHash, editedMsg.message_id, editedMsg.text, editedMsg.caption);
    return;
  }
  if (!mapping) {
    return;
  }
  const recipientUser = await db.getUserByHash(mapping.dest_chat_hash);
  if (!recipientUser)
    return;
  const senderUser = await db.getUserByHash(senderHash);
  const senderToken = senderUser?.link_token || "";
  const noteRow = await db.getNote(mapping.dest_chat_hash, senderHash);
  const isBlockedSender = await db.isBlocked(mapping.dest_chat_hash, senderHash);
  let senderDisplayName = senderUser?.nickname || "";
  if (noteRow?.admin_alias) {
    senderDisplayName = `${noteRow.admin_alias} [${senderUser?.nickname}]`;
  }
  const actionsKeyboard = messageActionsKeyboard(senderToken, editedMsg.message_id, {
    isBlocked: isBlockedSender,
    hasNote: !!noteRow?.note_text,
    hasAlias: !!noteRow?.admin_alias,
    senderDisplayName
  });
  const headerSettings = await db.getMessageHeaderSettings(mapping.dest_chat_hash);
  const msgHeader = buildMessageHeader(senderUser?.nickname || "", noteRow?.admin_alias, headerSettings);
  const newText = editedMsg.text || "";
  const newCaption = editedMsg.caption || "";
  const formattedNewText = msgHeader ? `${msgHeader}

${escapeHtml3(newText)}` : newText;
  const formattedNewCaption = msgHeader ? newCaption ? `${msgHeader}

${escapeHtml3(newCaption)}` : msgHeader : newCaption;
  try {
    const recipientTgId = await decryptTgId(recipientUser.encrypted_tg_id, env.AES_KEY);
    if (newText) {
      await tg.editMessageText(recipientTgId, mapping.dest_msg_id, formattedNewText, {
        reply_markup: actionsKeyboard
      });
    } else if (newCaption) {
      await tg.editMessageCaption(recipientTgId, mapping.dest_msg_id, formattedNewCaption, {
        reply_markup: actionsKeyboard
      });
    }
  } catch (pvErr) {
  }
  try {
    const connGroup = await db.getUserConnectedGroup(recipientUser.user_id_hash);
    if (connGroup && connGroup.group_id) {
      if (newText) {
        await tg.editMessageText(connGroup.group_id, mapping.dest_msg_id, formattedNewText, {
          reply_markup: actionsKeyboard
        });
      } else if (newCaption) {
        await tg.editMessageCaption(connGroup.group_id, mapping.dest_msg_id, formattedNewCaption, {
          reply_markup: actionsKeyboard
        });
      }
    }
  } catch (groupErr) {
  }
}

// src/handlers/reaction.ts
async function handleMessageReaction(reactionUpdate, env, db, tg) {
  const chatId = reactionUpdate.chat.id;
  const messageId = reactionUpdate.message_id;
  let targetChatId = null;
  let targetMsgId = null;
  if (chatId < 0) {
    const mapping = await db.getMappingByDestMsgId(messageId);
    if (mapping) {
      const srcUser = await db.getUserByHash(mapping.src_chat_hash);
      if (srcUser) {
        targetChatId = await decryptTgId(srcUser.encrypted_tg_id, env.AES_KEY);
        targetMsgId = mapping.src_msg_id;
      }
    }
  } else {
    const userHash = await hashUserId(chatId, env.SECRET_SALT);
    const mappingSrc = await db.getMappingBySource(userHash, messageId);
    if (mappingSrc) {
      const destUser = await db.getUserByHash(mappingSrc.dest_chat_hash);
      if (destUser) {
        if (destUser.delivery_destination === "group") {
          const connGroup = await db.getUserConnectedGroup(destUser.user_id_hash);
          if (connGroup && connGroup.is_active === 1) {
            targetChatId = connGroup.group_id;
          } else {
            targetChatId = await decryptTgId(destUser.encrypted_tg_id, env.AES_KEY);
          }
        } else {
          targetChatId = await decryptTgId(destUser.encrypted_tg_id, env.AES_KEY);
        }
        targetMsgId = mappingSrc.dest_msg_id;
      }
    } else {
      const mappingDest = await db.getMappingByDest(userHash, messageId);
      if (mappingDest) {
        const srcUser = await db.getUserByHash(mappingDest.src_chat_hash);
        if (srcUser) {
          targetChatId = await decryptTgId(srcUser.encrypted_tg_id, env.AES_KEY);
          targetMsgId = mappingDest.src_msg_id;
        }
      }
    }
  }
  if (!targetChatId || !targetMsgId)
    return;
  try {
    await tg.setMessageReaction(targetChatId, targetMsgId, reactionUpdate.new_reaction);
  } catch (e) {
    console.warn("Failed to mirror message reaction:", e);
  }
}

// src/handlers/forum.ts
async function handleForumMessage(msg, env, db, tg) {
  const threadId = msg.message_thread_id;
  const chatId = msg.chat.id;
  if (!threadId || msg.from?.is_bot)
    return;
  const mapping = await db.getTopicMapping(chatId, threadId);
  if (!mapping)
    return;
  const senderUser = await db.getUserByHash(mapping.sender_hash);
  if (!senderUser)
    return;
  const recipientUser = await db.getUserByHash(mapping.recipient_hash);
  const senderTgId = await decryptTgId(senderUser.encrypted_tg_id, env.AES_KEY);
  try {
    const recipientToken = recipientUser?.link_token || "";
    const noteRow = await db.getNote(senderUser.user_id_hash, mapping.recipient_hash);
    const isBlocked = await db.isBlocked(senderUser.user_id_hash, mapping.recipient_hash);
    const recipientDisplayName = recipientUser?.nickname || "\u0645\u062E\u0627\u0637\u0628";
    const actionsKeyboard = messageActionsKeyboard(recipientToken, msg.message_id, {
      isBlocked,
      hasNote: !!noteRow?.note_text,
      senderDisplayName: recipientDisplayName
    });
    let replyToMsgId = void 0;
    if (msg.reply_to_message?.message_id) {
      const prevMapping = await db.getMappingByDestMsgId(msg.reply_to_message.message_id);
      if (prevMapping && prevMapping.src_chat_hash === mapping.sender_hash) {
        replyToMsgId = prevMapping.src_msg_id;
      }
    }
    const filters = await db.getMediaFilters(senderUser.user_id_hash);
    const msgText = msg.text || msg.caption || "";
    const hasLink = /(https?:\/\/|t\.me\/|[a-zA-Z0-9-]+\.[a-zA-Z]{2,}\b)/i.test(msgText);
    const isPeekMode = recipientUser?.delivery_mode === "peek";
    if (msg.media_group_id) {
      await db.addToMediaGroupBuffer(
        msg.media_group_id,
        mapping.recipient_hash,
        mapping.sender_hash,
        chatId,
        msg.message_id,
        replyToMsgId
      );
      const lockKey = `mg:${msg.media_group_id}`;
      const isLeader = await db.acquireUserLock(lockKey, 5e3);
      if (!isLeader) {
        return;
      }
      let lastCount = 0;
      let stableTicks = 0;
      const maxWait = 2500;
      const interval = 250;
      const startTime = Date.now();
      while (Date.now() - startTime < maxWait) {
        await new Promise((resolve) => setTimeout(resolve, interval));
        const currentCount = await db.getMediaGroupBufferCount(msg.media_group_id);
        if (currentCount > 0 && currentCount === lastCount) {
          stableTicks++;
          if (stableTicks >= 2) {
            break;
          }
        } else {
          stableTicks = 0;
          lastCount = currentCount;
        }
      }
      const albumItems = await db.clearMediaGroupBuffer(msg.media_group_id);
      await db.releaseUserLock(lockKey);
      if (albumItems.length === 0) {
        return;
      }
      const messageIds = albumItems.map((it) => it.message_id);
      if (isPeekMode) {
        for (const it of albumItems) {
          await db.addPendingPeek(
            mapping.sender_hash,
            mapping.recipient_hash,
            chatId,
            it.message_id,
            recipientToken,
            it.reply_to_msg_id || replyToMsgId
          );
        }
        const unreadPeeks = await db.getPendingPeeksByToken(mapping.sender_hash, recipientToken);
        const count = unreadPeeks.length;
        const peekPrompt = `\u{1F4E9} <b>\u0622\u0644\u0628\u0648\u0645 \u062C\u062F\u06CC\u062F\u06CC \u0634\u0627\u0645\u0644 ${messageIds.length} \u0631\u0633\u0627\u0646\u0647 \u0627\u0632 \u0637\u0631\u0641 \u0645\u062E\u0627\u0637\u0628 (${recipientDisplayName}) \u062F\u0627\u0631\u06CC\u062F!</b>

\u0628\u0631\u0627\u06CC \u0645\u0634\u0627\u0647\u062F\u0647 \u0631\u0648\u06CC \u062F\u06A9\u0645\u0647 \u0632\u06CC\u0631 \u0628\u0632\u0646\u06CC\u062F:`;
        const peekMsg = await tg.sendMessage(senderTgId, peekPrompt, {
          reply_markup: peekActionsKeyboard(recipientToken, count),
          reply_to_message_id: replyToMsgId
        });
        for (const mid of messageIds) {
          await db.saveMessageMapping(mapping.recipient_hash, mid, mapping.sender_hash, peekMsg.message_id);
        }
        await tg.sendMessage(chatId, "\u2705 \u067E\u0627\u0633\u062E \u0622\u0644\u0628\u0648\u0645 \u0634\u0645\u0627 \u0628\u0627 \u062D\u0627\u0644\u062A \u067E\u06CC\u0634\u200C\u0646\u0645\u0627\u06CC\u0634 \u0627\u0631\u0633\u0627\u0644 \u0634\u062F (\u0628\u0647 \u0645\u062D\u0636 \u0645\u0634\u0627\u0647\u062F\u0647 \u062A\u0648\u0633\u0637 \u0645\u062E\u0627\u0637\u0628\u060C \u0631\u0633\u06CC\u062F \u0633\u06CC\u0646 \u062F\u0631 \u0627\u06CC\u0646 \u062A\u0627\u067E\u06CC\u06A9 \u0627\u0631\u0633\u0627\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F).", {
          message_thread_id: threadId,
          reply_to_message_id: msg.message_id
        });
        await db.recordConversation(senderUser.user_id_hash, mapping.recipient_hash);
        return;
      }
      const copiedList = await tg.copyMessages(senderTgId, chatId, messageIds, {
        reply_to_message_id: replyToMsgId
      });
      for (let i = 0; i < messageIds.length; i++) {
        const orig = messageIds[i];
        const cop = copiedList[i]?.message_id;
        if (cop) {
          await db.saveMessageMapping(mapping.recipient_hash, orig, mapping.sender_hash, cop);
        }
      }
      await tg.sendMessage(senderTgId, `\u{1F4CE} <b>\u0622\u0644\u0628\u0648\u0645 \u0627\u0631\u0633\u0627\u0644\u06CC \u0627\u0632 \u0637\u0631\u0641 \u0645\u062E\u0627\u0637\u0628 (${recipientDisplayName})</b>`, {
        reply_markup: actionsKeyboard
      }).catch(() => {
      });
      await tg.sendMessage(chatId, "\u2705 \u0622\u0644\u0628\u0648\u0645 \u0634\u0645\u0627 \u0628\u0627 \u0645\u0648\u0641\u0642\u06CC\u062A \u0628\u0631\u0627\u06CC \u0645\u062E\u0627\u0637\u0628 \u0627\u0631\u0633\u0627\u0644 \u0634\u062F.", {
        message_thread_id: threadId,
        reply_to_message_id: msg.message_id
      });
      await db.recordConversation(senderUser.user_id_hash, mapping.recipient_hash);
      return;
    }
    if (isPeekMode) {
      await db.addPendingPeek(
        mapping.sender_hash,
        mapping.recipient_hash,
        chatId,
        msg.message_id,
        recipientToken,
        replyToMsgId
      );
      const unreadPeeks = await db.getPendingPeeksByToken(mapping.sender_hash, recipientToken);
      const count = unreadPeeks.length;
      const countText = count > 1 ? ` (\u0634\u0627\u0645\u0644 ${count} \u067E\u06CC\u0627\u0645 \u062C\u062F\u06CC\u062F)` : "";
      const peekPrompt = `\u{1F4E9} <b>\u067E\u0627\u0633\u062E \u062C\u062F\u06CC\u062F\u06CC \u0627\u0632 \u0637\u0631\u0641 \u0645\u062E\u0627\u0637\u0628 (${recipientDisplayName}) \u062F\u0627\u0631\u06CC\u062F!${countText}</b>

\u0628\u0631\u0627\u06CC \u0645\u0634\u0627\u0647\u062F\u0647 \u0631\u0648\u06CC \u062F\u06A9\u0645\u0647 \u0632\u06CC\u0631 \u0628\u0632\u0646\u06CC\u062F:`;
      const peekMsg = await tg.sendMessage(senderTgId, peekPrompt, {
        reply_markup: peekActionsKeyboard(recipientToken, count),
        reply_to_message_id: replyToMsgId
      });
      await db.saveMessageMapping(mapping.recipient_hash, msg.message_id, mapping.sender_hash, peekMsg.message_id);
      await tg.sendMessage(chatId, "\u2705 \u067E\u0627\u0633\u062E \u0634\u0645\u0627 \u0628\u0627 \u062D\u0627\u0644\u062A \u067E\u06CC\u0634\u200C\u0646\u0645\u0627\u06CC\u0634 \u0627\u0631\u0633\u0627\u0644 \u0634\u062F (\u0628\u0647 \u0645\u062D\u0636 \u0645\u0634\u0627\u0647\u062F\u0647 \u062A\u0648\u0633\u0637 \u0645\u062E\u0627\u0637\u0628\u060C \u0631\u0633\u06CC\u062F \u0633\u06CC\u0646 \u062F\u0631 \u0627\u06CC\u0646 \u062A\u0627\u067E\u06CC\u06A9 \u0627\u0631\u0633\u0627\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F).", {
        message_thread_id: threadId,
        reply_to_message_id: msg.message_id
      });
    } else {
      let copied;
      if (filters.allow_web_preview === 0 && hasLink && msg.text) {
        copied = await tg.sendMessage(senderTgId, msg.text, {
          reply_markup: actionsKeyboard,
          reply_to_message_id: replyToMsgId,
          disable_web_page_preview: true
        });
      } else {
        try {
          copied = await tg.copyMessage(senderTgId, chatId, msg.message_id, {
            reply_markup: actionsKeyboard,
            reply_to_message_id: replyToMsgId
          });
        } catch {
          copied = await tg.copyMessage(senderTgId, chatId, msg.message_id, {
            reply_markup: actionsKeyboard
          });
        }
      }
      await db.saveMessageMapping(mapping.recipient_hash, msg.message_id, mapping.sender_hash, copied.message_id);
    }
    await db.recordConversation(senderUser.user_id_hash, mapping.recipient_hash);
  } catch (e) {
    console.error("Failed to route forum reply to user:", e);
  }
}

// src/index.ts
async function reportSystemErrorToAdmin(env, tg, error, context) {
  const adminIds = (env.ADMIN_IDS || "").split(",").map((s) => s.trim()).filter(Boolean);
  const primaryAdminId = adminIds[0];
  if (!primaryAdminId)
    return;
  const errMsg = error?.message || String(error);
  const isTelegramApiError = errMsg.includes("Telegram API");
