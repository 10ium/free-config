async function resolvePrivateTargetUser(text, msg, db, strictPrefixOnly = false) {
  if (msg?.forward_from) {
    if (msg.forward_from.is_bot || SYSTEM_TELEGRAM_USER_IDS.has(msg.forward_from.id)) {
      return { status: 'bot' };
    }
    return {
      status: 'found',
      targetId: msg.forward_from.id,
      targetName: msg.forward_from.first_name || (msg.forward_from.username ? `@${msg.forward_from.username}` : `کاربر ${msg.forward_from.id}`),
      targetUsername: msg.forward_from.username || null
    };
  }
  if (msg?.forward_origin?.type === 'user' && msg.forward_origin.sender_user) {
    const su = msg.forward_origin.sender_user;
    if (su.is_bot || SYSTEM_TELEGRAM_USER_IDS.has(su.id)) {
      return { status: 'bot' };
    }
    return {
      status: 'found',
      targetId: su.id,
      targetName: su.first_name || (su.username ? `@${su.username}` : `کاربر ${su.id}`),
      targetUsername: su.username || null
    };
  }
  if (msg?.forward_sender_name || msg?.forward_origin?.type === 'hidden_user') {
    return { status: 'hidden_forward' };
  }

  const cleanText = normalizeDigits(text || '').replace(/[\u200B-\u200F\u202A-\u202E\uFEFF]/g, '').trim();
  if (!cleanText) return { status: 'not_target' };

  // آیدی عددی تلگرام (۵ تا ۱۵ رقم تا با سال تولد ۴ رقمی مثل 1378 اشتباه نشود)
  const numMatch = cleanText.match(/^(\d{5,15})$/);
  if (numMatch) {
    const targetId = parseInt(numMatch[1], 10);
    const mem = await db.prepare(`SELECT first_name, username FROM group_members WHERE user_id = ? LIMIT 1`).bind(targetId).first();
    const up = mem || await db.prepare(`SELECT first_name, username FROM user_profiles WHERE user_id = ? LIMIT 1`).bind(targetId).first();
    return {
      status: 'found',
      targetId,
      targetName: up?.first_name || (up?.username ? `@${up.username}` : `کاربر ${targetId}`),
      targetUsername: up?.username || null
    };
  }

  let uname = null;
  const linkMatch = cleanText.match(/^(?:https?:\/\/)?(?:www\.)?t\.me\/([a-zA-Z0-9_]{3,32})\/?$/i);
  const atMatch = cleanText.match(/^@([a-zA-Z0-9_]{3,32})$/);
  const bareMatch = !strictPrefixOnly ? cleanText.match(/^([a-zA-Z0-9_]{3,32})$/) : null;

  if (linkMatch) uname = linkMatch[1];
  else if (atMatch) uname = atMatch[1];
  else if (bareMatch) uname = bareMatch[1];

  if (!uname) return { status: 'not_target' };

  const mem = await db.prepare(`SELECT user_id, first_name, username FROM group_members WHERE username = ? COLLATE NOCASE LIMIT 1`).bind(uname).first();
  if (mem) {
    return {
      status: 'found',
      targetId: mem.user_id,
      targetName: mem.first_name || `@${uname}`,
      targetUsername: mem.username || uname
    };
  }
  const up = await db.prepare(`SELECT user_id, first_name, username FROM user_profiles WHERE username = ? COLLATE NOCASE LIMIT 1`).bind(uname).first();
  if (up) {
    return {
      status: 'found',
      targetId: up.user_id,
      targetName: up.first_name || `@${uname}`,
      targetUsername: up.username || uname
    };
  }
  return { status: 'username_not_found', username: uname };
}

