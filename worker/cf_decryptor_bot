        </div>
        <div class="link-box">
          <input class="link-input" type="text" readonly value="${xrayUrl}" id="inp-xray">
          <button class="btn btn-copy" onclick="copyLink('inp-xray')">\u06A9\u067E\u06CC \u0644\u06CC\u0646\u06A9</button>
        </div>
        <div class="btn-group">
          <button class="btn btn-import" onclick="copyText('${b64Url}')">\u{1F4CB} \u06A9\u067E\u06CC \u0644\u06CC\u0646\u06A9 \u0641\u0631\u0645\u062A Base64</button>
        </div>
      </div>
    </div>
  </div>

  <div class="toast" id="toast">\u0644\u06CC\u0646\u06A9 \u062F\u0631 \u062D\u0627\u0641\u0638\u0647 \u06A9\u067E\u06CC \u0634\u062F! \u2705</div>

  <script>
    function copyLink(id) {
      const el = document.getElementById(id);
      if (el) {
        copyText(el.value);
      }
    }
    function copyText(str) {
      navigator.clipboard.writeText(str).then(() => {
        const t = document.getElementById('toast');
        t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 2000);
      });
    }
  </script>
</body>
</html>`;
}

