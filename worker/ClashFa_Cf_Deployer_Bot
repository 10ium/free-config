function generateSafeWorkerName(preset, platform = "worker") {
  let base = "";
  if (preset && preset.id && PRESET_SAFE_IDENTIFIERS[preset.id]) {
    base = PRESET_SAFE_IDENTIFIERS[preset.id];
  } else if (preset && (preset.id || preset.name)) {
    let raw = (preset.id || preset.name).toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
    let parts = raw.split("-").filter(p => p && !SENSITIVE_KEYWORDS.some(sw => p.includes(sw)));
    base = parts.join("-");
  }

  if (!base || base.length < 3) {
    base = (platform === "pages") ? "web-page" : "edge-worker";
  }

  if (platform === "pages" && !base.includes("page")) {
    base = base + "-page";
  }

  const randNum = Math.floor(100 + Math.random() * 900);
  return `${base}-${randNum}`.replace(/-+/g, "-").replace(/^-+|-+$/g, "");
}

// --- ROLLBACK NEWLY CREATED RESOURCES ON FAILURE ---
async function rollbackCreatedResources(token, accountId, createdResources = [], env = null) {
  if (!createdResources || createdResources.length === 0) return;
  for (const res of createdResources) {
    try {
      if (res.type === "kv") {
        await deleteKVNamespace(token, accountId, res.id);
        if (env) await logEvent(env, `Rollback: پاک‌سازی خودکار دیتابیس KV ناتمام ${res.name}`, "warning");
      } else if (res.type === "d1") {
        await deleteD1Database(token, accountId, res.id);
        if (env) await logEvent(env, `Rollback: پاک‌سازی خودکار دیتابیس D1 ناتمام ${res.name}`, "warning");
      }
    } catch (e) {
      console.warn("Rollback resource error:", e);
    }
  }
}

