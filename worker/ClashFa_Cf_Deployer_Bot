// Resilient D1 Database Creator (Handles Duplicate Names Automatically)
async function createD1Database(token, accountId, name) {
  const res = await fetchWithTimeout(`https://api.cloudflare.com/client/v4/accounts/${accountId}/d1/database`, {
    method: "POST",
    headers: {
      "Authorization": `Bearer ${token}`,
      "Content-Type": "application/json"
    },
    body: JSON.stringify({ name })
  }, 20000);

  const data = await res.json();
  if (data.success && data.result && data.result.uuid) {
    return data.result.uuid;
  }

  const errMsg = (data.errors?.[0]?.message || "").toLowerCase();
  const errCode = data.errors?.[0]?.code;
  if (errMsg.includes("already exists") || errCode === 7401) {
    const listRes = await fetchWithTimeout(`https://api.cloudflare.com/client/v4/accounts/${accountId}/d1/database?name=${encodeURIComponent(name)}`, {
      headers: { "Authorization": `Bearer ${token}` }
    }, 20000);
    const listData = await listRes.json();
    if (listData.success && Array.isArray(listData.result)) {
      const found = listData.result.find(db => db.name === name);
      if (found && found.uuid) {
        return found.uuid;
      }
    }
  }

  throw new Error(data.errors?.[0]?.message || "Failed to create D1 Database.");
}

