              if (update.message.chat.type === "private") {
                await handleMessage(update.message, env, db, tg);
              } else if (update.message.chat.type === "supergroup" || update.message.chat.type === "group") {
                const text = (update.message.text || "").trim();
                if (text.startsWith("/")) {
                  await handleMessage(update.message, env, db, tg);
                } else {
                  await handleForumMessage(update.message, env, db, tg);
                }
              }
            } else if (update.callback_query) {
              await handleCallbackQuery(update.callback_query, env, db, tg);
            } else if (update.edited_message) {
              await handleEditedMessage(update.edited_message, env, db, tg);
            } else if (update.message_reaction) {
              await handleMessageReaction(update.message_reaction, env, db, tg);
            }
          } catch (e) {
            console.error("Unhandled error in update processing:", e);
            await reportSystemErrorToAdmin(env, tg, e, {
              source: "Update Handler",
              chatId: update.message?.chat?.id || update.callback_query?.message?.chat?.id,
              userId: update.message?.from?.id || update.callback_query?.from?.id
            });
          }
        })()
      );
      return new Response("OK", { status: 200 });
    }
    return new Response("Not Found", { status: 404 });
  }
