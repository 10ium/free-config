async function handleUpdate(update, token, db) {
  const fromUser = update.message?.from || update.callback_query?.from || update.message_reaction?.user;
  if (!update.message_reaction && !update.message_reaction_count && fromUser?.id) {
    // جلوگیری از اسپم (حداکثر ۴ درخواست در ۲ ثانیه) - استثنا کردن ری‌اکشن‌ها
    if (isRateLimited(`spam_u_${fromUser.id}`, 500)) {
      return;
    }

    // بررسی کاربر مسدود شده توسط ادمین
    const banSetting = await db.prepare(`SELECT value FROM bot_settings WHERE key = 'banned_users'`).first();
    const bannedList = safeJsonArray(banSetting?.value);
    if (bannedList.includes(fromUser.id)) {
      if (update.message?.chat?.type === 'private') {
        await sendMessage(token, update.message.chat.id, `⛔ <b>دسترسی شما به این ربات توسط مدیریت کل مسدود شده است.</b>`);
      }
      return;
    }
  }

  if (update.message_reaction) {
    await handleReaction(update.message_reaction, token, db);
    return;
  }

  if (update.message_reaction_count) {
    await handleReactionCount(update.message_reaction_count, token, db);
    return;
  }

  if (update.callback_query) {
    await handleCallbackQuery(update.callback_query, token, db);
    return;
  }

  if (update.message) {
    await handleMessage(update.message, token, db);
    return;
  }
}

