>\n        <table class=\"w-full text-xs text-right font-mono\">\n          <thead class=\"text-slate-400 border-b border-slate-800\">\n            <tr>\n              <th class=\"p-3 w-40\">زمان (تهران)</th>\n              <th class=\"p-3 w-28\">نوع</th>\n              <th class=\"p-3\">پیام رخداد</th>\n            </tr>\n          </thead>\n          <tbody id=\"logs-table-body\">\n            <tr><td colspan=\"3\" class=\"p-6 text-center text-slate-500\">در حال دریافت لاگ‌ها...</td></tr>\n          </tbody>\n        </table>\n      </div>\n    </section>\n  </main>\n\n  <!-- MODAL: DEPLOY WORKER -->\n  <div id=\"deploy-modal\" class=\"fixed inset-0 z-50 bg-black/70 backdrop-blur-sm hidden flex items-center justify-center p-4\">\n    <div class=\"glass max-w-xl w-full rounded-2xl p-6 border border-slate-700 shadow-2xl relative max-h-[90vh] flex flex-col\">\n      <div class=\"flex items-center justify-between border-b border-slate-800 pb-3 mb-4\">\n        <h3 id=\"modal-preset-title\" class=\"font-bold text-lg text-white\">استقرار ورکر</h3>\n        <button onclick=\"closeDeployModal()\" class=\"text-slate-400 hover:text-white text-xl\">&times;</button>\n      </div>\n\n      <div id=\"modal-form-body\" class=\"overflow-y-auto flex-1 space-y-4 pr-1\">\n        <!-- Injected via JS -->\n      </div>\n\n      <div class=\"border-t border-slate-800 pt-4 mt-4 flex items-center justify-end gap-3\">\n        <button onclick=\"closeDeployModal()\" class=\"px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-sm transition\">لغو</button>\n        <button id=\"btn-submit-deploy\" onclick=\"executeDeployFromWeb()\" class=\"px-5 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-sm font-medium shadow-lg shadow-indigo-600/30 transition flex items-center gap-2\">\n          <span>🚀 آغاز استقرار</span>\n        </button>\n      </div>\n    </div>\n  </div>\n\n  <!-- MODAL: BINDINGS MANAGER -->\n  <div id=\"bindings-modal\" class=\"fixed inset-0 z-50 bg-black/70 backdrop-blur-sm hidden flex items-center justify-center p-4\">\n    <div class=\"glass max-w-2xl w-full rounded-2xl p-6 border border-slate-700 shadow-2xl relative max-h-[85vh] flex flex-col\">\n      <div class=\"flex items-center justify-between border-b border-slate-800 pb-3 mb-4\">\n        <h3 id=\"modal-bindings-title\" class=\"font-bold text-lg text-white\">مدیریت بایندینگ‌های ورکر</h3>\n        <button onclick=\"closeBindingsModal()\" class=\"text-slate-400 hover:text-white text-xl\">&times;</button>\n      </div>\n\n      <div id=\"modal-bindings-body\" class=\"overflow-y-auto flex-1 space-y-3\">\n        <!-- Injected via JS -->\n      </div>\n\n      <div class=\"border-t border-slate-800 pt-4 mt-4 flex items-center justify-between\">\n        <button onclick=\"deleteAllBindingsWeb()\" class=\"px-4 py-2 bg-rose-600/20 hover:bg-rose-600/30 text-rose-400 border border-rose-600/30 rounded-xl text-xs transition\">💥 حذف همه بایندینگ‌ها</button>\n        <button onclick=\"closeBindingsModal()\" class=\"px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-sm transition\">بستن</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- MODAL: ADD ACCOUNT -->\n  <div id=\"add-account-modal\" class=\"fixed inset-0 z-50 bg-black/70 backdrop-blur-sm hidden flex items-center justify-center p-4\">\n    <div class=\"glass max-w-md w-full rounded-2xl p-6 border border-slate-700 shadow-2xl relative\">\n      <div class=\"flex items-center justify-between border-b border-slate-800 pb-3 mb-4\">\n        <h3 class=\"font-bold text-lg text-white\">➕ افزودن حساب کلادفلر</h3>\n        <button onclick=\"closeAddAccountModal()\" class=\"text-slate-400 hover:text-white text-xl\">&times;</button>\n      </div>\n\n      <div class=\"space-y-4 text-sm\">\n        <div>\n          <label class=\"block text-slate-400 mb-1 text-xs\">توکن اختصاصی کلادفلر (Cloudflare API Token):</label>\n          <input type=\"password\" id=\"input-cf-token\" placeholder=\"توکن API با دسترسی‌های کامل...\" class=\"w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-slate-200 outline-none focus:border-indigo-500 transition\">\n        </div>\n        <div class=\"bg-indigo-950/40 border border-indigo-800/40 rounded-xl p-3 text-xs text-indigo-300\">\n          💡 راهنما: توکن شما باید حداقل دارای مجوزهای <b>Account.Workers Scripts:Edit</b> و <b>Account.Workers KV Storage:Edit</b> و <b>Account.D1:Edit</b> باشد.\n        </div>\n      </div>\n\n      <div class=\"border-t border-slate-800 pt-4 mt-6 flex items-center justify-end gap-3\">\n        <button onclick=\"closeAddAccountModal()\" class=\"px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-sm transition\">لغو</button>\n        <button id=\"btn-save-account\" onclick=\"saveNewAccountWeb()\" class=\"px-5 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-sm font-medium shadow-lg shadow-indigo-600/30 transition flex items-center gap-2\">\n          <span>تایید و اتصال</span>\n        </button>\n      </div>\n    </div>\n  </div>\n\n  <!-- Client JavaScript -->\n  <script>\n    let globalPresets = [];\n    let globalAccounts = [];\n    let activePreset = null;\n    let currentBindingsContext = null;\n\n    async function init() {\n      await loadPresets();\n      await loadAccounts();\n    }\n\n    function switchTab(tabId) {\n      document.querySelectorAll('.tab-btn').forEach(btn => {\n        btn.classList.remove('bg-indigo-600', 'text-white');\n        btn.classList.add('text-slate-400');\n      });\n      document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));\n\n      document.getElementById('tab-' + tabId).classList.add('bg-indigo-600', 'text-white');\n      document.getElementById('tab-' + tabId).classList.remove('text-slate-400');\n      document.getElementById('content-' + tabId).classList.remove('hidden');\n\n      if (tabId === 'workers') loadWorkersList();\n      if (tabId === 'logs') loadLogs();\n      if (tabId === 'accounts') renderAccounts();\n    }\n\n    function showAlert(message, type) {\n      const banner = document.getElementById('alert-banner');\n      banner.classList.remove('hidden', 'bg-emerald-950/60', 'border-emerald-800', 'text-emerald-300', 'bg-rose-950/60', 'border-rose-800', 'text-rose-300', 'bg-indigo-950/60', 'border-indigo-800', 'text-indigo-300');\n      if (type === 'success') {\n        banner.classList.add('bg-emerald-950/60', 'border-emerald-800', 'text-emerald-300');\n      } else if (type === 'error') {\n        banner.classList.add('bg-rose-950/60', 'border-rose-800', 'text-rose-300');\n      } else {\n        banner.classList.add('bg-indigo-950/60', 'border-indigo-800', 'text-indigo-300');\n      }\n      banner.innerHTML = '<span>' + message + '</span><button onclick=\"this.parentElement.classList.add(\\'hidden\\')\" class=\"text-xs opacity-70 hover:opacity-100\">&times;</button>';\n      setTimeout(() => banner.classList.add('hidden'), 8000);\n    }\n\n    async function loadPresets() {\n      try {\n        const res = await fetch('/api/presets');\n        globalPresets = await res.json();\n        renderPresets(globalPresets);\n      } catch (err) {\n        console.error(\"Presets loading error:\", err);\n      }\n    }\n\n    function renderPresets(presets) {\n      const container = document.getElementById('presets-grid');\n      container.innerHTML = presets.map((p) => {\n        let kvBadge = (p.kvBindings && p.kvBindings.length > 0) ? '<span class=\"bg-indigo-950/80 text-indigo-300 px-1.5 py-0.5 rounded border border-indigo-800/50\">KV</span>' : '';\n        let d1Badge = (p.vars && p.vars.some(v => v.startsWith('D1_'))) ? '<span class=\"bg-amber-950/80 text-amber-300 px-1.5 py-0.5 rounded border border-amber-800/50\">D1</span>' : '';\n        let varsBadge = (p.vars && p.vars.length > 0) ? '<span class=\"bg-slate-800 text-slate-300 px-1.5 py-0.5 rounded\">' + p.vars.length + ' متغیر</span>' : '';\n\n        return '<div class=\"glass-card rounded-2xl p-5 flex flex-col justify-between hover:border-indigo-500/50 transition group\">' +\n          '<div>' +\n            '<div class=\"flex items-center justify-between gap-2 mb-3\">' +\n              '<span class=\"px-2.5 py-1 rounded-md text-[11px] font-medium bg-slate-800 text-slate-300 border border-slate-700\">' + getCatTitle(p.category) + '</span>' +\n              '<span class=\"text-xs text-slate-500 font-mono\">#' + p.id + '</span>' +\n            '</div>' +\n            '<h3 class=\"font-bold text-base text-white group-hover:text-indigo-400 transition mb-2\">' + p.name + '</h3>' +\n            '<p class=\"text-xs text-slate-400 line-clamp-3 leading-relaxed mb-4\">' + (p.description || 'بدون توضیح') + '</p>' +\n          '</div>' +\n          '<div class=\"border-t border-slate-800/80 pt-4 flex items-center justify-between gap-2\">' +\n            '<div class=\"flex items-center gap-1.5 text-[11px] text-slate-400\">' + kvBadge + d1Badge + varsBadge + '</div>' +\n            '<button onclick=\"openDeployModal(\\'' + p.id + '\\')\" class=\"px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white text-xs rounded-xl font-medium shadow-md shadow-indigo-600/20 transition\">استقرار 🚀</button>' +\n          '</div>' +\n        '</div>';\n      }).join('');\n    }\n\n    function getCatTitle(c) {\n      if (c === 'clashfa') return '🚀 کلش‌فا';\n      if (c === 'dns') return '🌐 دی‌ان‌اس';\n      if (c === 'config') return '🛰️ کانفیگ';\n      return 'سایر';\n    }\n\n    function filterCategory(cat) {\n      document.querySelectorAll('.cat-filter').forEach(b => {\n        b.classList.remove('bg-indigo-600', 'text-white');\n        b.classList.add('bg-slate-800', 'text-slate-400');\n      });\n      event.target.classList.add('bg-indigo-600', 'text-white');\n      event.target.classList.remove('bg-slate-800', 'text-slate-400');\n\n      if (cat === 'all') {\n        renderPresets(globalPresets);\n      } else {\n        renderPresets(globalPresets.filter(p => p.category === cat));\n      }\n    }\n\n    async function loadAccounts() {\n      try {\n        const res = await fetch('/api/accounts');\n        globalAccounts = await res.json();\n        renderAccounts();\n        updateAccountSelects();\n      } catch (err) {\n        console.error(\"Accounts error:\", err);\n      }\n    }\n\n    function updateAccountSelects() {\n      const select = document.getElementById('workers-account-select');\n      if (!select) return;\n      if (globalAccounts.length === 0) {\n        select.innerHTML = '<option value=\"\">هیچ حسابی متصل نیست</option>';\n        return;\n      }\n      select.innerHTML = globalAccounts.map((a, i) => '<option value=\"' + i + '\">' + a.name + ' (' + a.id.substring(0, 8) + '...)</option>').join('');\n    }\n\n    function renderAccounts() {\n      const container = document.getElementById('accounts-cards');\n      if (globalAccounts.length === 0) {\n        container.innerHTML = '<div class=\"col-span-2 p-8 text-center glass-card rounded-2xl text-slate-400\">هنوز هیچ حساب کلادفلری متصل نشده است. روی دکمه «افزودن اکانت جدید» کلیک کنید.</div>';\n        return;\n      }\n\n      container.innerHTML = globalAccounts.map((a, idx) => {\n        return '<div class=\"glass-card rounded-2xl p-5 border border-slate-800 relative\">' +\n          '<div class=\"flex items-center justify-between mb-4\">' +\n            '<div class=\"flex items-center gap-3\">' +\n              '<div class=\"w-10 h-10 rounded-xl bg-slate-800 flex items-center justify-center text-lg\">👤</div>' +\n              '<div>' +\n                '<h3 class=\"font-bold text-white text-base\">' + a.name + '</h3>' +\n                '<p class=\"text-xs text-slate-400 font-mono\">شناسه: ' + a.id + '</p>' +\n              '</div>' +\n            '</div>' +\n            '<button onclick=\"deleteAccountWeb(' + idx + ')\" class=\"text-rose-400 hover:text-rose-300 text-xs px-2.5 py-1 rounded-lg bg-rose-950/40 border border-rose-800/40 transition\">حذف اکانت</button>' +\n          '</div>' +\n          '<div class=\"bg-slate-900/90 rounded-xl p-3 text-xs space-y-2 mb-4\">' +\n            '<div class=\"flex items-center justify-between\">' +\n              '<span class=\"text-slate-400\">ساب‌دامین ورکرز:</span>' +\n              '<span class=\"font-mono text-indigo-300\">' + (a.subdomain || 'دریافت نشده') + '</span>' +\n            '</div>' +\n            '<div class=\"flex items-center justify-between\">' +\n              '<span class=\"text-slate-400\">توکن:</span>' +\n              '<span class=\"font-mono text-slate-500\">' + (a.tokenMasked || '••••••••••••') + '</span>' +\n            '</div>' +\n          '</div>' +\n          '<div class=\"flex items-center justify-between gap-2\">' +\n            '<button onclick=\"refreshSubdomainWeb(' + idx + ')\" class=\"px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs rounded-xl border border-slate-700 transition\">🔄 استعلام زنده ساب‌دامین</button>' +\n          '</div>' +\n        '</div>';\n      }).join('');\n    }\n\n    function openDeployModal(presetId) {\n      activePreset = globalPresets.find(p => p.id === presetId);\n      if (!activePreset) return;\n\n      document.getElementById('modal-preset-title').textContent = 'استقرار ' + activePreset.name;\n      const form = document.getElementById('modal-form-body');\n\n      let html = '<div>' +\n        '<label class=\"block text-xs text-slate-400 mb-1\">حساب مقصد کلادفلر:</label>' +\n        '<select id=\"deploy-acc-idx\" class=\"w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-sm text-slate-200 outline-none\">' +\n          globalAccounts.map((a, i) => '<option value=\"' + i + '\">' + a.name + '</option>').join('') +\n        '</select>' +\n      '</div>' +\n      '<div>' +\n        '<label class=\"block text-xs text-slate-400 mb-1\">نام پروژه ورکر (حروف کوچک و خط تیره):</label>' +\n        '<input type=\"text\" id=\"deploy-worker-name\" value=\"' + activePreset.id + '-' + Math.random().toString(36).substring(2, 6) + '\" class=\"w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-sm text-slate-200 outline-none\">' +\n      '</div>';\n\n      if (activePreset.vars && activePreset.vars.length > 0) {\n        html += '<div class=\"border-t border-slate-800 pt-3\"><p class=\"text-xs font-bold text-slate-300 mb-2\">متغیرهای محیطی قالب:</p>';\n        activePreset.vars.forEach(v => {\n          let placeholder = 'مقدار ' + v;\n          let isD1 = v.startsWith('D1_ID_');\n          html += '<div class=\"mb-3\">' +\n            '<div class=\"flex items-center justify-between mb-1\">' +\n              '<label class=\"text-xs text-slate-400 font-mono\">' + v + '</label>' +\n              '<button type=\"button\" onclick=\"autoFillVar(\\'' + v + '\\')\" class=\"text-[11px] text-indigo-400 hover:text-indigo-300\">🎲 مقدار خودکار</button>' +\n            '</div>' +\n            '<input type=\"text\" id=\"var-' + v + '\" placeholder=\"' + (isD1 ? 'شناسه دیتابیس D1 یا خالی برای ساخت خودکار' : placeholder) + '\" class=\"w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-sm text-slate-200 outline-none\">' +\n          '</div>';\n        });\n        html += '</div>';\n      }\n\n      form.innerHTML = html;\n      document.getElementById('deploy-modal').classList.remove('hidden');\n    }\n\n    function closeDeployModal() {\n      document.getElementById('deploy-modal').classList.add('hidden');\n    }\n\n    function autoFillVar(varName) {\n      const input = document.getElementById('var-' + varName);\n      if (!input) return;\n      if (varName === 'UUID' || varName === 'uuid') {\n        input.value = crypto.randomUUID();\n      } else if (varName.startsWith('D1_ID_')) {\n        input.value = 'auto';\n      } else if (varName === 'AES_KEY') {\n        input.value = Array.from(crypto.getRandomValues(new Uint8Array(16))).map(b => b.toString(16).padStart(2, '0')).join('');\n      } else if (varName === 'WEBHOOK_SECRET' || varName === 'SECRET_SALT') {\n        input.value = Math.random().toString(36).substring(2, 14);\n      } else if (varName === 'PROXY_IP' || varName === 'PROXYIP' || varName === 'proxyip') {\n        input.value = 'speed.cloudflare.com';\n      } else if (varName === 'SUB_PATH') {\n        input.value = '/sub/' + Math.random().toString(36).substring(2, 8);\n      } else {\n        input.value = Math.random().toString(36).substring(2, 10);\n      }\n    }\n\n    async function executeDeployFromWeb() {\n      if (!activePreset) return;\n      const accIdx = parseInt(document.getElementById('deploy-acc-idx').value, 10);\n      const workerName = document.getElementById('deploy-worker-name').value.trim();\n\n      if (!workerName) {\n        alert('لطفاً نام پروژه را وارد کنید.');\n        return;\n      }\n\n      const vars = {};\n      if (activePreset.vars) {\n        activePreset.vars.forEach(v => {\n          const el = document.getElementById('var-' + v);\n          if (el) vars[v] = el.value.trim();\n        });\n      }\n\n      const btn = document.getElementById('btn-submit-deploy');\n      btn.disabled = true;\n      btn.innerHTML = '<span>⏳ در حال استقرار...</span>';\n\n      try {\n        const res = await fetch('/api/deploy', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({\n            accIdx,\n            presetId: activePreset.id,\n            workerName,\n            vars\n          })\n        });\n        const data = await res.json();\n        if (data.success) {\n          closeDeployModal();\n          showAlert('✅ ورکر ' + workerName + ' با موفقیت بر روی کلادفلر استقرار یافت! آدرس: ' + (data.url || ''), 'success');\n          loadLogs();\n        } else {\n          showAlert('❌ خطا در استقرار: ' + (data.error || 'خطای نامشخص'), 'error');\n        }\n      } catch (err) {\n        showAlert('❌ خطا در ارتباط با سرور: ' + err.message, 'error');\n      } finally {\n        btn.disabled = false;\n        btn.innerHTML = '<span>🚀 آغاز استقرار</span>';\n      }\n    }\n\n    async function loadWorkersList() {\n      const select = document.getElementById('workers-account-select');\n      const tbody = document.getElementById('workers-table-body');\n      if (!select || !select.value) {\n        tbody.innerHTML = '<tr><td colspan=\"5\" class=\"p-6 text-center text-slate-500\">حسابی انتخاب نشده است.</td></tr>';\n        return;\n      }\n\n      const accIdx = parseInt(select.value, 10);\n      tbody.innerHTML = '<tr><td colspan=\"5\" class=\"p-6 text-center text-slate-400\">⏳ در حال دریافت لیست ورکرها از کلادفلر...</td></tr>';\n\n      try {\n        const res = await fetch('/api/workers?accIdx=' + accIdx);\n        const workers = await res.json();\n        if (!Array.isArray(workers) || workers.length === 0) {\n          tbody.innerHTML = '<tr><td colspan=\"5\" class=\"p-6 text-center text-slate-500\">هیچ ورکری در این اکانت یافت نشد.</td></tr>';\n          return;\n        }\n\n        tbody.innerHTML = workers.map((w, idx) => {\n          let rawSub = (globalAccounts[accIdx] && globalAccounts[accIdx].subdomain) ? globalAccounts[accIdx].subdomain.trim().replace(/^\\.+|\\.+$/g, \"\") : \"\";\n          let baseDomain = rawSub ? (rawSub.endsWith(\"workers.dev\") ? rawSub : rawSub + \".workers.dev\") : \"workers.dev\";\n          let workerUrl = \"https://\" + w.id + \".\" + baseDomain;\n          return '<tr class=\"border-b border-slate-800/60 hover:bg-slate-900/40 transition\">' +\n            '<td class=\"p-3 text-slate-500\">' + (idx + 1) + '</td>' +\n            '<td class=\"p-3 font-medium text-white font-mono\">' + w.id + '</td>' +\n            '<td class=\"p-3 text-xs text-slate-400\">' + new Date(w.modified_on).toLocaleDateString('fa-IR') + '</td>' +\n            '<td class=\"p-3 text-xs text-indigo-400 font-mono\"><a href=\"' + workerUrl + '\" target=\"_blank\" class=\"hover:underline\">مشاهده ↗</a></td>' +\n            '<td class=\"p-3 text-center\">' +\n              '<div class=\"flex items-center justify-center gap-2\">' +\n                '<button onclick=\"openBindingsModal(' + accIdx + ', \\'' + w.id + '\\')\" class=\"px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs rounded-lg transition\">⚙️ بایندینگ‌ها</button>' +\n                '<button onclick=\"downloadWorkerCodeWeb(' + accIdx + ', \\'' + w.id + '\\')\" class=\"px-2.5 py-1 bg-indigo-950/60 hover:bg-indigo-900/60 text-indigo-300 border border-indigo-800/40 text-xs rounded-lg transition\">📥 دانلود کد</button>' +\n                '<button onclick=\"deleteWorkerWeb(' + accIdx + ', \\'' + w.id + '\\')\" class=\"px-2.5 py-1 bg-rose-950/40 hover:bg-rose-900/40 text-rose-300 border border-rose-800/40 text-xs rounded-lg transition\">🗑️ حذف</button>' +\n              '</div>' +\n            '</td>' +\n          '</tr>';\n        }).join('');\n      } catch (err) {\n        tbody.innerHTML = '<tr><td colspan=\"5\" class=\"p-6 text-center text-rose-400\">خطا در دریافت اطلاعات: ' + err.message + '</td></tr>';\n      }\n    }\n\n    async function downloadWorkerCodeWeb(accIdx, workerName) {\n      try {\n        const res = await fetch('/api/worker-source?accIdx=' + accIdx + '&name=' + workerName);\n        const code = await res.text();\n        const blob = new Blob([code], { type: 'application/javascript' });\n        const url = URL.createObjectURL(blob);\n        const a = document.createElement('a');\n        a.href = url;\n        a.download = workerName + '.js';\n        document.body.appendChild(a);\n        a.click();\n        document.body.removeChild(a);\n        URL.revokeObjectURL(url);\n        showAlert('✅ سورس‌کد ورکر با موفقیت دانلود شد.', 'success');\n      } catch (err) {\n        showAlert('❌ خطا در دریافت سورس‌کد: ' + err.message, 'error');\n      }\n    }\n\n    async function deleteWorkerWeb(accIdx, workerName) {\n      if (!confirm('آیا مطمئن هستید که می‌خواهید ورکر ' + workerName + ' را حذف کنید؟')) return;\n      const cleanBindings = confirm('آیا می‌خواهید منابع متصل به این ورکر (فضاهای KV و دیتابیس‌های اختصاصی D1) نیز حذف شوند؟\\n\\n[OK]: حذف ورکر + منابع متصل\\n[Cancel]: فقط حذف خود ورکر و نگه‌داری منابع');\n      try {\n        const res = await fetch('/api/workers?accIdx=' + accIdx + '&name=' + encodeURIComponent(workerName) + '&cleanBindings=' + cleanBindings, { method: 'DELETE' });\n        const data = await res.json();\n        if (data.success) {\n          showAlert('✅ ورکر ' + workerName + ' با موفقیت حذف شد.', 'success');\n          loadWorkersList();\n          loadLogs();\n        } else {\n          showAlert('❌ خطا در حذف ورکر: ' + (data.error || ''), 'error');\n        }\n      } catch (err) {\n        showAlert('❌ خطا در حذف: ' + err.message, 'error');\n      }\n    }\n\n    async function openBindingsModal(accIdx, workerName) {\n      currentBindingsContext = { accIdx, workerName };\n      document.getElementById('modal-bindings-title').textContent = 'مدیریت بایندینگ‌های ' + workerName;\n      const body = document.getElementById('modal-bindings-body');\n      body.innerHTML = '<p class=\"text-xs text-slate-400 text-center p-4\">⏳ در حال دریافت بایندینگ‌ها...</p>';\n      document.getElementById('bindings-modal').classList.remove('hidden');\n\n      try {\n        const res = await fetch('/api/worker-bindings?accIdx=' + accIdx + '&name=' + workerName);\n        const data = await res.json();\n        const bindings = data.bindings || [];\n\n        if (bindings.length === 0) {\n          body.innerHTML = '<p class=\"text-xs text-slate-500 text-center p-4\">هیچ بایندینگی برای این ورکر ثبت نشده است.</p>';\n          return;\n        }\n\n        body.innerHTML = bindings.map((b, idx) => {\n          return '<div class=\"glass-card rounded-xl p-3 flex items-center justify-between text-xs border border-slate-800\">' +\n            '<div>' +\n              '<span class=\"font-bold text-white font-mono\">' + b.name + '</span>' +\n              '<span class=\"text-slate-400 mr-2\">(' + b.type + ')</span>' +\n              '<p class=\"text-slate-500 font-mono text-[11px] mt-1\">' + (b.namespace_id || b.database_id || b.text || '(مقدار رمز)') + '</p>' +\n            '</div>' +\n            '<button onclick=\"deleteSingleBindingWeb(' + idx + ')\" class=\"text-rose-400 hover:text-rose-300 px-2 py-1 bg-rose-950/40 rounded border border-rose-800/40 transition\">حذف بایندینگ</button>' +\n          '</div>';\n        }).join('');\n      } catch (err) {\n        body.innerHTML = '<p class=\"text-xs text-rose-400 text-center p-4\">خطا: ' + err.message + '</p>';\n      }\n    }\n\n    function closeBindingsModal() {\n      document.getElementById('bindings-modal').classList.add('hidden');\n    }\n\n    async function deleteSingleBindingWeb(bindingIdx) {\n      if (!currentBindingsContext) return;\n      if (!confirm('آیا از حذف این بایندینگ مطمئن هستید؟')) return;\n      try {\n        const res = await fetch('/api/worker-bindings?accIdx=' + currentBindingsContext.accIdx + '&name=' + currentBindingsContext.workerName + '&idx=' + bindingIdx, { method: 'DELETE' });\n        const data = await res.json();\n        if (data.success) {\n          showAlert('✅ بایندینگ با موفقیت حذف شد.', 'success');\n          openBindingsModal(currentBindingsContext.accIdx, currentBindingsContext.workerName);\n          loadLogs();\n        } else {\n          showAlert('❌ خطا در حذف: ' + (data.error || ''), 'error');\n        }\n      } catch (err) {\n        showAlert('❌ خطا: ' + err.message, 'error');\n      }\n    }\n\n    async function deleteAllBindingsWeb() {\n      if (!currentBindingsContext) return;\n      if (!confirm('آیا مطمئن هستید که می‌خواهید تمامی بایندینگ‌های این ورکر را یکجا پاک کنید؟')) return;\n      try {\n        const res = await fetch('/api/worker-bindings?accIdx=' + currentBindingsContext.accIdx + '&name=' + currentBindingsContext.workerName + '&all=true', { method: 'DELETE' });\n        const data = await res.json();\n        if (data.success) {\n          showAlert('✅ تمامی بایندینگ‌ها حذف شدند.', 'success');\n          closeBindingsModal();\n          loadLogs();\n        } else {\n          showAlert('❌ خطا: ' + (data.error || ''), 'error');\n        }\n      } catch (err) {\n        showAlert('❌ خطا: ' + err.message, 'error');\n      }\n    }\n\n    function openAddAccountModal() {\n      document.getElementById('input-cf-token').value = '';\n      document.getElementById('add-account-modal').classList.remove('hidden');\n    }\n\n    function closeAddAccountModal() {\n      document.getElementById('add-account-modal').classList.add('hidden');\n    }\n\n    async function saveNewAccountWeb() {\n      const token = document.getElementById('input-cf-token').value.trim();\n      if (!token) {\n        alert('لطفاً توکن را وارد کنید.');\n        return;\n      }\n\n      const btn = document.getElementById('btn-save-account');\n      btn.disabled = true;\n      btn.innerHTML = '<span>⏳ در حال بررسی مجوزها...</span>';\n\n      try {\n        const res = await fetch('/api/accounts', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({ token })\n        });\n        const data = await res.json();\n        if (data.success) {\n          closeAddAccountModal();\n          showAlert('✅ حساب کلادفلر با موفقیت اضافه شد!', 'success');\n          await loadAccounts();\n          loadLogs();\n        } else {\n          showAlert('❌ ' + (data.error || 'خطا در احراز هویت توکن'), 'error');\n        }\n      } catch (err) {\n        showAlert('❌ خطا در ارتباط: ' + err.message, 'error');\n      } finally {\n        btn.disabled = false;\n        btn.innerHTML = '<span>تایید و اتصال</span>';\n      }\n    }\n\n    async function deleteAccountWeb(idx) {\n      if (!confirm('آیا از حذف این حساب اطمینان دارید؟')) return;\n      try {\n        const res = await fetch('/api/accounts?idx=' + idx, { method: 'DELETE' });\n        const data = await res.json();\n        if (data.success) {\n          showAlert('✅ حساب کلادفلر حذف شد.', 'success');\n          await loadAccounts();\n          loadLogs();\n        }\n      } catch (err) {\n        showAlert('❌ خطا: ' + err.message, 'error');\n      }\n    }\n\n    async function refreshSubdomainWeb(idx) {\n      try {\n        const res = await fetch('/api/refresh-subdomain?idx=' + idx, { method: 'POST' });\n        const data = await res.json();\n        if (data.success) {\n          showAlert('✅ ساب‌دامین استعلام شد: ' + data.subdomain, 'success');\n          await loadAccounts();\n        } else {\n          showAlert('❌ خطا در استعلام: ' + (data.error || ''), 'error');\n        }\n      } catch (err) {\n        showAlert('❌ خطا: ' + err.message, 'error');\n      }\n    }\n\n    async function refreshPresetsCache() {\n      const icon = document.getElementById('cache-icon');\n      icon.classList.add('animate-spin');\n      try {\n        const res = await fetch('/api/refresh-cache', { method: 'POST' });\n        const data = await res.json();\n        if (data.success) {\n          showAlert('✅ تمام ۱۹ قالب با موفقیت از گیت‌هاب دانلود و کش شدند.', 'success');\n          loadLogs();\n        } else {\n          showAlert('❌ خطا در کش کردن قالب‌ها: ' + (data.error || ''), 'error');\n        }\n      } catch (err) {\n        showAlert('❌ خطا در ارتباط: ' + err.message, 'error');\n      } finally {\n        icon.classList.remove('animate-spin');\n      }\n    }\n\n    async function loadLogs() {\n      const tbody = document.getElementById('logs-table-body');\n      try {\n        const res = await fetch('/api/logs');\n        const logs = await res.json();\n        if (!Array.isArray(logs) || logs.length === 0) {\n          tbody.innerHTML = '<tr><td colspan=\"3\" class=\"p-6 text-center text-slate-500\">هیچ لاگی ثبت نشده است.</td></tr>';\n          return;\n        }\n\n        tbody.innerHTML = logs.map(l => {\n          let badgeClass = 'bg-slate-800 text-slate-300';\n          if (l.type === 'error') badgeClass = 'bg-rose-950 text-rose-300 border border-rose-800/40';\n          if (l.type === 'warning') badgeClass = 'bg-amber-950 text-amber-300 border border-amber-800/40';\n          if (l.type === 'info') badgeClass = 'bg-indigo-950 text-indigo-300 border border-indigo-800/40';\n\n          return '<tr class=\"border-b border-slate-800/40 hover:bg-slate-900/30 transition\">' +\n            '<td class=\"p-3 text-slate-400\">' + l.timestamp + '</td>' +\n            '<td class=\"p-3\"><span class=\"px-2 py-0.5 rounded text-[10px] uppercase font-bold ' + badgeClass + '\">' + l.type + '</span></td>' +\n            '<td class=\"p-3 text-slate-200 break-all\">' + l.message + '</td>' +\n          '</tr>';\n        }).join('');\n      } catch (err) {\n        tbody.innerHTML = '<tr><td colspan=\"3\" class=\"p-6 text-center text-rose-400\">خطا در بارگذاری لاگ‌ها: ' + err.message + '</td></tr>';\n      }\n    }\n\n    window.addEventListener('DOMContentLoaded', init);\n  </script>\n</body>\n</html>\n";
