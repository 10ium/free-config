// --- SMART WRITER COMPILING METADATA AS MODULE OR SERVICE WORKER ---
async function deployWorkerScript(token, accountId, scriptName, code, bindings) {
  // Comprehensive module syntax detector to cover compiled imports/exports
  const isModule = code.includes("export default") || 
                   code.includes("export {") || 
                   code.includes("export{") || 
                   code.includes("import ") || 
                   code.includes("import{");
  
  const formData = new FormData();
  const metadata = {
    bindings: bindings,
    compatibility_date: new Date().toISOString().split("T")[0],
    compatibility_flags: ["nodejs_compat"]
  };

  if (isModule) {
    metadata.main_module = "worker.js";
    formData.append("metadata", JSON.stringify(metadata));
    formData.append("worker.js", new Blob([code], { type: "application/javascript+module" }), "worker.js");
  } else {
    metadata.body_part = "script";
    formData.append("metadata", JSON.stringify(metadata));
    formData.append("script", new Blob([code], { type: "application/javascript" }), "script");
  }

  const res = await fetch(`https://api.cloudflare.com/client/v4/accounts/${accountId}/workers/scripts/${scriptName}`, {
    method: "PUT",
    headers: { 
      "Authorization": `Bearer ${token}`,
      "User-Agent": "ClashFa-Deployer-Bot"
    },
    body: formData
  });

  const data = await res.json();
  if (!data.success) {
    throw new Error(data.errors?.[0]?.message || "Failed to deploy Worker.");
  }
  return data.result;
}

