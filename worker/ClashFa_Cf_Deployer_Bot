        varsMsg += "\n🖥️ <b>اطلاعات ورود به پنل نوا (IRNova):</b>\n";
        varsMsg += "🔸 مسیر پنل: <code>/admin</code>\n";
        varsMsg += "🔸 رمز عبور پیش‌فرض: <code>admin123</code>\n";
      } else if (activePreset.id === "edgetunnel") {
        varsMsg += "\n🖥️ <b>اطلاعات ورود به پنل:</b>\n";
        varsMsg += "🔸 مسیر پنل: <code>/admin</code>\n";
      } else if (activePreset.id === "faceless-bot" || activePreset.id === "faceless_chat_bot") {
        varsMsg += "\n🤖 <b>راه‌اندازی ۳ در ۱ ربات فیسلس:</b>\n";
        varsMsg += "🔸 مسیر ست‌آپ: <code>/setup</code>\n";
        varsMsg += "🔸 عملکرد: ساخت خودکار جداول دیتابیس D1، اتصال وب‌هوک و ثبت منوی دستورات فارسی.\n";
      }
    }

    if (session.deployPayload.resourceQueue && session.deployPayload.resourceQueue.length > 0) {
      varsMsg += "\n\n📦 <b>منابع متصل شده سفارشی:</b>\n";
      for (const item of session.deployPayload.resourceQueue) {
        if (item.type === "kv") {
          varsMsg += `🔸 دیتابیس [KV] با متغیر: <code>${item.name}</code>\n`;
        } else if (item.type === "d1") {
          varsMsg += `🔸 دیتابیس [D1] با متغیر: <code>${item.name}</code> (شناسه: <code>${item.id}</code>)\n`;
        } else if (item.type === "var") {
          varsMsg += `🔸 متغیر [Plain] با نام <code>${item.name}</code>: <code>${escapeHTML(item.val.toString())}</code>\n`;
        }
      }
    }

    // Special automated post-deploy webhook setup for Telegram bots
    let postDeployNotice = "";
    if (activePreset && (activePreset.id === "faceless-bot" || activePreset.id === "faceless_chat_bot")) {
      await sendMessage(chatId, "⏳ در حال اجرای راه‌اندازی خودکار ۳ در ۱ ربات فیسلس (/setup)...", env);
      try {
