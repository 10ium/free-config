\u0628\u0631\u0627\u06CC \u0645\u0634\u0627\u0647\u062F\u0647 \u067E\u06CC\u0627\u0645 \u0631\u0648\u06CC \u062F\u06A9\u0645\u0647 \u0632\u06CC\u0631 \u0628\u0632\u0646\u06CC\u062F:`;
    const peekKeyboard = {
      inline_keyboard: [
        [{ text: "\u{1F441} \u0645\u0634\u0627\u0647\u062F\u0647 \u067E\u06CC\u0627\u0645", callback_data: `peek:${senderTgId}:${msg.message_id}:${senderUser.link_token}` }]
      ]
    };
    await tg.sendMessage(recipientTgId, peekPrompt, { reply_markup: peekKeyboard });
  } else {
    const prefix = `${noteHeader}\u{1F4AC} <b>\u067E\u06CC\u0627\u0645 \u0646\u0627\u0634\u0646\u0627\u0633 \u0627\u0632 \u0637\u0631\u0641: ${senderDisplayName}</b>`;
    await tg.sendMessage(recipientTgId, prefix);
    const copied = await tg.copyMessage(recipientTgId, senderTgId, msg.message_id, {
      reply_markup: actionsKeyboard,
      reply_to_message_id: replyToMsgId
    });
    await db.saveMessageMapping(senderUser.user_id_hash, msg.message_id, recipientHash, copied.message_id);
    await tg.sendMessage(senderTgId, "\u2705 \u067E\u06CC\u0627\u0645 \u0634\u0645\u0627 \u0628\u0627 \u0645\u0648\u0641\u0642\u06CC\u062A \u0627\u0631\u0633\u0627\u0644 \u0634\u062F.", {
      reply_markup: messageSentConfirmationKeyboard(copied.message_id),
      reply_to_message_id: msg.message_id
    });
  }
  await db.recordConversation(senderUser.user_id_hash, recipientHash);
}

// src/handlers/callback.ts
async function handleCallbackQuery(cb, env, db, tg) {
  const data = cb.data;
  if (!data || !cb.message)
    return;
  const from = cb.from;
  const userHash = await hashUserId(from.id, env.SECRET_SALT);
  const user = await db.getUserByHash(userHash);
  if (!user)
    return;
  const adminIds = (env.ADMIN_IDS || "").split(",").map((s) => s.trim());
  const isAdmin = adminIds.includes(from.id.toString());
  const msgId = cb.message.message_id;
  if (data === "menu:main") {
    await tg.answerCallbackQuery(cb.id);
    await tg.editMessageText(from.id, msgId, "\u{1F3E0} <b>\u0645\u0646\u0648\u06CC \u0627\u0635\u0644\u06CC:</b>", {
      reply_markup: mainMenuInlineKeyboard(user, env.BOT_USERNAME, isAdmin)
    });
    return;
  }
  if (data === "menu:link") {
    await tg.answerCallbackQuery(cb.id);
    const linkUrl = `https://t.me/${env.BOT_USERNAME}?start=u_${user.link_token}`;
    const txt = `\u{1F517} <b>\u0644\u06CC\u0646\u06A9 \u0627\u062E\u062A\u0635\u0627\u0635\u06CC \u067E\u06CC\u0627\u0645 \u0646\u0627\u0634\u0646\u0627\u0633 \u0634\u0645\u0627:</b>

<code>${linkUrl}</code>

\u0647\u0631 \u06A9\u0633 \u0631\u0648\u06CC \u0627\u06CC\u0646 \u0644\u06CC\u0646\u06A9 \u06A9\u0644\u06CC\u06A9 \u06A9\u0646\u062F\u060C \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0628\u062F\u0648\u0646 \u0627\u06CC\u0646\u06A9\u0647 \u0647\u0648\u06CC\u062A\u0634 \u0641\u0627\u0634 \u0634\u0648\u062F \u0628\u0647 \u0634\u0645\u0627 \u067E\u06CC\u0627\u0645 \u0628\u0641\u0631\u0633\u062A\u062F.`;
    await tg.editMessageText(from.id, msgId, txt, {
      reply_markup: linkManagementKeyboard(user.link_token, user.is_link_active === 1, env.BOT_USERNAME)
    });
    return;
  }
  if (data === "link:regen") {
    const newToken = generateRandomToken(12);
    await db.regenerateLinkToken(userHash, newToken);
    await tg.answerCallbackQuery(cb.id, "\u2705 \u0644\u06CC\u0646\u06A9 \u0642\u0628\u0644\u06CC \u0628\u0627\u0637\u0644 \u0634\u062F \u0648 \u0644\u06CC\u0646\u06A9 \u062C\u062F\u06CC\u062F \u0633\u0627\u062E\u062A\u0647 \u0634\u062F!", true);
    const linkUrl = `https://t.me/${env.BOT_USERNAME}?start=u_${newToken}`;
    const txt = `\u{1F517} <b>\u0644\u06CC\u0646\u06A9 \u0627\u062E\u062A\u0635\u0627\u0635\u06CC \u062C\u062F\u06CC\u062F \u0634\u0645\u0627:</b>

<code>${linkUrl}</code>

\u0644\u06CC\u0646\u06A9 \u0642\u0628\u0644\u06CC \u062F\u06CC\u06AF\u0631 \u06A9\u0627\u0631 \u0646\u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u063A\u06CC\u0631\u0641\u0639\u0627\u0644 \u0634\u062F.`;
    await tg.editMessageText(from.id, msgId, txt, {
      reply_markup: linkManagementKeyboard(newToken, true, env.BOT_USERNAME)
    });
    return;
  }
  if (data === "link:toggle") {
    const nextState = user.is_link_active === 1 ? false : true;
    await db.toggleLinkActive(userHash, nextState);
    await tg.answerCallbackQuery(
      cb.id,
      nextState ? "\u2705 \u0644\u06CC\u0646\u06A9 \u0634\u0645\u0627 \u0641\u0639\u0627\u0644 \u0634\u062F." : "\u274C \u0644\u06CC\u0646\u06A9 \u0634\u0645\u0627 \u063A\u06CC\u0631\u0641\u0639\u0627\u0644 \u0634\u062F."
    );
    const linkUrl = `https://t.me/${env.BOT_USERNAME}?start=u_${user.link_token}`;
    const txt = `\u{1F517} <b>\u0648\u0636\u0639\u06CC\u062A \u0644\u06CC\u0646\u06A9 \u0627\u062E\u062A\u0635\u0627\u0635\u06CC: ${nextState ? "\u0641\u0639\u0627\u0644 \u2705" : "\u063A\u06CC\u0631\u0641\u0639\u0627\u0644 \u274C"}</b>

<code>${linkUrl}</code>`;
    await tg.editMessageText(from.id, msgId, txt, {
      reply_markup: linkManagementKeyboard(user.link_token, nextState, env.BOT_USERNAME)
    });
    return;
  }
  if (data === "menu:vacation") {
    const isNowVacation = await db.toggleVacation(userHash);
    const updatedUser = await db.getUserByHash(userHash);
    if (isNowVacation) {
      await tg.answerCallbackQuery(cb.id, "\u23F8 \u062D\u0627\u0644\u062A \u0627\u0633\u062A\u0631\u0627\u062D\u062A \u0641\u0639\u0627\u0644 \u0634\u062F. \u067E\u06CC\u0627\u0645\u200C\u0647\u0627\u06CC \u062C\u062F\u06CC\u062F \u062F\u0631 \u0635\u0641 \u0645\u06CC\u200C\u0645\u0627\u0646\u0646\u062F.", true);
    } else {
      await tg.answerCallbackQuery(cb.id, "\u25B6\uFE0F \u062D\u0627\u0644\u062A \u0627\u0633\u062A\u0631\u0627\u062D\u062A \u063A\u06CC\u0631\u0641\u0639\u0627\u0644 \u0634\u062F \u0648 \u0622\u0646\u0644\u0627\u06CC\u0646 \u0634\u062F\u06CC\u062F.", true);
      const queue = await db.getAndClearQueuedMessages(userHash);
      if (queue.length > 0) {
        await tg.sendMessage(from.id, `\u{1F4EC} \u0634\u0645\u0627 <b>${queue.length}</b> \u067E\u06CC\u0627\u0645 \u062F\u0631 \u0635\u0641 \u062F\u0627\u0634\u062A\u06CC\u062F \u06A9\u0647 \u0627\u06A9\u0646\u0648\u0646 \u062A\u062D\u0648\u06CC\u0644 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F:`);
        for (const qItem of queue) {
          try {
            await tg.copyMessage(from.id, qItem.from_chat_id, qItem.message_id);
          } catch (e) {
            console.error("Error flushing queue message:", e);
          }
        }
      }
    }
    await tg.editMessageText(from.id, msgId, "\u{1F3E0} <b>\u0645\u0646\u0648\u06CC \u0627\u0635\u0644\u06CC:</b>", {
      reply_markup: mainMenuInlineKeyboard(updatedUser, env.BOT_USERNAME, isAdmin)
    });
    return;
  }
  if (data === "menu:settings") {
    await tg.answerCallbackQuery(cb.id);
    const filters = await db.getMediaFilters(userHash);
    await tg.editMessageText(from.id, msgId, "\u2699\uFE0F <b>\u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u062D\u0633\u0627\u0628 \u06A9\u0627\u0631\u0628\u0631\u06CC \u0648 \u0641\u06CC\u0644\u062A\u0631 \u0631\u0633\u0627\u0646\u0647\u200C\u0647\u0627:</b>", {
      reply_markup: settingsKeyboard(user, filters)
    });
    return;
  }
  if (data === "set:nickname") {
    await tg.answerCallbackQuery(cb.id);
    await db.setSetting(`state:${userHash}`, "nickname:set");
    await tg.sendMessage(from.id, "\u270F\uFE0F \u0644\u0637\u0641\u0627\u064B \u0644\u0642\u0628 \u062C\u062F\u06CC\u062F \u062E\u0648\u062F \u0631\u0627 \u0627\u0631\u0633\u0627\u0644 \u06A9\u0646\u06CC\u062F (\u0628\u06CC\u0646 \u06F2 \u062A\u0627 \u06F3\u06F0 \u06A9\u0627\u0631\u0627\u06A9\u062A\u0631):");
    return;
  }
  if (data === "set:delivery") {
    const nextMode = user.delivery_mode === "direct" ? "peek" : "direct";
    await db.setDeliveryMode(userHash, nextMode);
    await tg.answerCallbackQuery(
      cb.id,
      nextMode === "direct" ? "\u26A1\uFE0F \u067E\u06CC\u0627\u0645\u200C\u0647\u0627 \u0645\u0633\u062A\u0642\u06CC\u0645\u0627\u064B \u0627\u0631\u0633\u0627\u0644 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F." : "\u{1F441} \u067E\u06CC\u0627\u0645\u200C\u0647\u0627 \u0628\u0627 \u062F\u06A9\u0645\u0647 \u0645\u0634\u0627\u0647\u062F\u0647 \u0648 \u0631\u0633\u06CC\u062F \u062E\u0648\u0627\u0646\u062F\u0647 \u0634\u062F\u0646 \u0645\u06CC\u200C\u0622\u06CC\u0646\u062F."
    );
    const updatedUser = await db.getUserByHash(userHash);
    const filters = await db.getMediaFilters(userHash);
    await tg.editMessageText(from.id, msgId, "\u2699\uFE0F <b>\u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u062D\u0633\u0627\u0628 \u06A9\u0627\u0631\u0628\u0631\u06CC \u0648 \u0641\u06CC\u0644\u062A\u0631 \u0631\u0633\u0627\u0646\u0647\u200C\u0647\u0627:</b>", {
      reply_markup: settingsKeyboard(updatedUser, filters)
    });
    return;
  }
  if (data.startsWith("flt:")) {
    const field = data.replace("flt:", "");
    await db.toggleMediaFilter(userHash, field);
    await tg.answerCallbackQuery(cb.id, "\u0648\u0636\u0639\u06CC\u062A \u0641\u06CC\u0644\u062A\u0631 \u062A\u063A\u06CC\u06CC\u0631 \u06A9\u0631\u062F.");
    const filters = await db.getMediaFilters(userHash);
    await tg.editMessageText(from.id, msgId, "\u2699\uFE0F <b>\u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u062D\u0633\u0627\u0628 \u06A9\u0627\u0631\u0628\u0631\u06CC \u0648 \u0641\u06CC\u0644\u062A\u0631 \u0631\u0633\u0627\u0646\u0647\u200C\u0647\u0627:</b>", {
      reply_markup: settingsKeyboard(user, filters)
    });
    return;
  }
  if (data === "set:rate_limit") {
    const rates = [0, 3, 5, 10];
    const currentIdx = rates.indexOf(user.personal_rate_limit);
    const nextRate = rates[(currentIdx + 1) % rates.length];
    await db.setPersonalRateLimit(userHash, nextRate);
    await tg.answerCallbackQuery(
      cb.id,
      nextRate === 0 ? "\u0633\u067E\u0631 \u0636\u062F \u0627\u0633\u067E\u0645 \u063A\u06CC\u0631\u0641\u0639\u0627\u0644 \u0634\u062F." : `\u0633\u067E\u0631 \u0631\u0648\u06CC ${nextRate} \u067E\u06CC\u0627\u0645 \u062F\u0631 \u062F\u0642\u06CC\u0642\u0647 \u062A\u0646\u0638\u06CC\u0645 \u0634\u062F.`
    );
    const updatedUser = await db.getUserByHash(userHash);
    const filters = await db.getMediaFilters(userHash);
    await tg.editMessageText(from.id, msgId, "\u2699\uFE0F <b>\u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u062D\u0633\u0627\u0628 \u06A9\u0627\u0631\u0628\u0631\u06CC \u0648 \u0641\u06CC\u0644\u062A\u0631 \u0631\u0633\u0627\u0646\u0647\u200C\u0647\u0627:</b>", {
      reply_markup: settingsKeyboard(updatedUser, filters)
    });
    return;
  }
  if (data.startsWith("peek:")) {
    const [, senderTgIdStr, targetMidStr, senderToken] = data.split(":");
    const senderTgId = parseInt(senderTgIdStr, 10);
    const targetMid = parseInt(targetMidStr, 10);
    await tg.answerCallbackQuery(cb.id, "\u067E\u06CC\u0627\u0645 \u0628\u0627\u0631\u06AF\u0630\u0627\u0631\u06CC \u0634\u062F.");
    const actionsKeyboard = messageActionsKeyboard(senderToken, targetMid);
    await tg.copyMessage(from.id, senderTgId, targetMid, {
      reply_markup: actionsKeyboard
    });
    await tg.deleteMessage(from.id, msgId);
    await tg.sendMessage(senderTgId, "\u2705 \u067E\u06CC\u0627\u0645 \u0634\u0645\u0627 \u062A\u0648\u0633\u0637 \u0637\u0631\u0641 \u0645\u0642\u0627\u0628\u0644 \u062E\u0648\u0627\u0646\u062F\u0647 \u0634\u062F.", {
      reply_to_message_id: targetMid
    });
    return;
  }
  if (data.startsWith("reply:")) {
    const [, targetToken, replyMidStr] = data.split(":");
    const targetUser = await db.getUserByLinkToken(targetToken);
    if (!targetUser) {
      await tg.answerCallbackQuery(cb.id, "\u274C \u0645\u062E\u0627\u0637\u0628 \u06CC\u0627\u0641\u062A \u0646\u0634\u062F \u06CC\u0627 \u062A\u063A\u06CC\u06CC\u0631 \u06A9\u0631\u062F\u0647 \u0627\u0633\u062A.", true);
      return;
    }
    await db.setSetting(`state:${userHash}`, `target:${targetUser.user_id_hash}`);
    await tg.answerCallbackQuery(cb.id);
    await tg.sendMessage(
      from.id,
      `\u270D\uFE0F \u0627\u06A9\u0646\u0648\u0646 \u067E\u0627\u0633\u062E \u062E\u0648\u062F \u0631\u0627 \u0628\u0631\u0627\u06CC <b>${targetUser.nickname}</b> \u0628\u0646\u0648\u06CC\u0633\u06CC\u062F \u06CC\u0627 \u0647\u0631 \u0641\u0627\u06CC\u0644\u06CC \u0628\u0641\u0631\u0633\u062A\u06CC\u062F:`,
      { reply_to_message_id: parseInt(replyMidStr, 10) }
    );
    return;
  }
  if (data.startsWith("block:")) {
    const targetToken = data.replace("block:", "");
    const targetUser = await db.getUserByLinkToken(targetToken);
    if (!targetUser)
      return;
    await db.addBlock(userHash, targetUser.user_id_hash);
    await tg.answerCallbackQuery(cb.id, "\u{1F512} \u0627\u06CC\u0646 \u0645\u062E\u0627\u0637\u0628 \u0628\u0627 \u0645\u0648\u0641\u0642\u06CC\u062A \u0645\u0633\u062F\u0648\u062F \u0634\u062F.", true);
    const newKb = messageActionsKeyboard(targetToken, msgId, { isBlocked: true });
    await tg.editMessageText(from.id, msgId, cb.message.text || "\u067E\u06CC\u0627\u0645 \u0646\u0627\u0634\u0646\u0627\u0633", {
      reply_markup: newKb
    });
    return;
  }
  if (data.startsWith("unblock:")) {
    const targetToken = data.replace("unblock:", "");
    const targetUser = await db.getUserByLinkToken(targetToken);
    if (!targetUser)
      return;
    await db.removeBlock(userHash, targetUser.user_id_hash);
    await tg.answerCallbackQuery(cb.id, "\u{1F513} \u0645\u062E\u0627\u0637\u0628 \u0631\u0641\u0639 \u0645\u0633\u062F\u0648\u062F\u06CC \u0634\u062F.", true);
    const newKb = messageActionsKeyboard(targetToken, msgId, { isBlocked: false });
    await tg.editMessageText(from.id, msgId, cb.message.text || "\u067E\u06CC\u0627\u0645 \u0646\u0627\u0634\u0646\u0627\u0633", {
      reply_markup: newKb
    });
    return;
  }
  if (data.startsWith("note:")) {
    const targetToken = data.replace("note:", "");
    const targetUser = await db.getUserByLinkToken(targetToken);
    if (!targetUser)
      return;
    await db.setSetting(`state:${userHash}`, `note:${targetUser.user_id_hash}`);
    await tg.answerCallbackQuery(cb.id);
    await tg.sendMessage(
      from.id,
      `\u{1F4DD} \u0644\u0637\u0641\u0627\u064B \u0645\u062A\u0646 \u06CC\u0627\u062F\u062F\u0627\u0634\u062A \u0645\u062D\u0631\u0645\u0627\u0646\u0647 \u062E\u0648\u062F \u0628\u0631\u0627\u06CC <b>${targetUser.nickname}</b> \u0631\u0627 \u0627\u0631\u0633\u0627\u0644 \u06A9\u0646\u06CC\u062F:
(\u0627\u06CC\u0646 \u0646\u0648\u062A \u0641\u0642\u0637 \u0628\u0631\u0627\u06CC \u062E\u0648\u062F\u062A\u0627\u0646 \u0646\u0645\u0627\u06CC\u0634 \u062F\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F)`
    );
    return;
  }
  if (data.startsWith("report:")) {
    const [, targetToken, reportedMidStr] = data.split(":");
    const targetUser = await db.getUserByLinkToken(targetToken);
    if (!targetUser)
      return;
    const caseId = generateReportCaseId();
    await tg.answerCallbackQuery(cb.id, `\u{1F6A8} \u06AF\u0632\u0627\u0631\u0634 \u0628\u0627 \u0634\u0646\u0627\u0633\u0647 \u067E\u06CC\u06AF\u06CC\u0631\u06CC ${caseId} \u0628\u0631\u0627\u06CC \u0645\u062F\u06CC\u0631\u06CC\u062A \u0627\u0631\u0633\u0627\u0644 \u0634\u062F.`, true);
    const primaryAdminId = adminIds[0];
    if (primaryAdminId) {
      const reportReportTxt = `\u{1F6A8} <b>\u06AF\u0632\u0627\u0631\u0634 \u062A\u062E\u0644\u0641 \u062C\u062F\u06CC\u062F (#${caseId})</b>

\u0644\u0642\u0628 \u0641\u0631\u062F \u06AF\u0632\u0627\u0631\u0634\u200C\u0634\u062F\u0647: <b>${targetUser.nickname}</b>
\u0634\u0646\u0627\u0633\u0647 \u0647\u0634 \u0634\u0627\u06A9\u06CC: <code>${userHash.slice(0, 10)}...</code>

\u067E\u06CC\u0627\u0645 \u0631\u06CC\u067E\u0648\u0631\u062A\u200C\u0634\u062F\u0647 \u062F\u0631 \u0627\u062F\u0627\u0645\u0647 \u0647\u062F\u0627\u06CC\u062A \u0645\u06CC\u200C\u0634\u0648\u062F:`;
      const adminReportKb = {
        inline_keyboard: [
          [{ text: "\u{1F6AB} \u0628\u0646 \u0633\u0631\u0627\u0633\u0631\u06CC \u06A9\u0627\u0631\u0628\u0631 (Global Ban)", callback_data: `admin:ban:${targetUser.user_id_hash}` }]
        ]
      };
