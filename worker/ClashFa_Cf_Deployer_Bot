async function displayTelegramProjects(chatId, account, env, accIdx) {
  await sendMessage(chatId, `⏳ در حال لود اطلاعات پروژه از سرورهای کلادفلر...`, env);

  try {
    const workers = await listWorkerScripts(account.token, account.id);
    const pages = await listPagesProjects(account.token, account.id);

    // Save fetched workers list in user session to prevent Telegram's 64-character callback_data limit
    let userSession = await env.BOT_KV.get(`session:${chatId}`, { type: "json" }) || { state: "IDLE", accounts: [], history: [] };
    userSession.listedWorkers = workers.map(w => w.id);
    userSession.activeAccIdx = accIdx;
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));

    let output = `👤 حساب متصل: <b>${account.name}</b>\n\n`;

    output += `<b>🚀 اسکریپت‌های ورکر (${workers.length}):</b>\n`;
    
    const keyboard = [];

    if (workers.length > 0) {
      workers.forEach((w, idx) => {
        output += `${idx + 1}. <code>${w.id}</code> (بروزرسانی: ${new Date(w.modified_on).toLocaleDateString("fa-IR")})\n`;
        keyboard.push([{ text: `🛠️ مدیریت ورکر ${w.id}`, callback_data: `wk_menu_${idx}` }]);
      });
      
      // Add bulk delete button
      keyboard.push([{ text: "⚠️ حذف تمامی ورکرها ⚠️", callback_data: `conf_del_all_wrk_${accIdx}` }]);
    } else {
      output += "موردی ثبت نشده است.\n";
    }

    output += `\n<b>📦 پروژه‌های صفحات (${pages.length}):</b>\n`;
    if (pages.length > 0) {
      pages.forEach((p, idx) => {
        output += `${idx + 1}. <code>${p.name}</code> (ساب‌دومین: ${p.subdomain})\n`;
      });
    } else {
      output += "موردی ثبت نشده است.\n";
    }

    keyboard.push([{ text: "🔙 بازگشت به لیست حساب‌ها", callback_data: "list_projects" }]);

    return sendMessage(chatId, output, env, false, keyboard);
  } catch (err) {
    return sendMessage(chatId, `❌ خطا در دریافت اطلاعات از کلادفلر:\n<code>${err.message}</code>`, env);
  }
}

// --- NEW VIEW & MANAGE WORKER BINDINGS ENGINE ---
async function displayWorkerBindings(chatId, userSession, env) {
  const workerName = userSession.activeWorker;
  const accIdx = userSession.activeAccIdx;
  const account = userSession.accounts[accIdx];

  await sendMessage(chatId, `⏳ در حال لود لیست بایندینگ‌ها از کلادفلر...`, env);

  try {
    const settings = await getWorkerSettings(account.token, account.id, workerName);
    const bindings = settings.bindings || [];

    userSession.activeBindings = bindings;
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));

    let output = `⚙️ **لیست بایندینگ‌های ورکر:** <code>${workerName}</code>\n\n`;

    if (bindings.length === 0) {
      output += "⚠️ هیچ بایندینگی (KV، D1 یا متغیر محیطی) برای این ورکر ثبت نشده است.";
      const keyboard = [
        [{ text: "🔙 بازگشت به منوی ورکر", callback_data: "wk_menu_back" }]
      ];
      return sendMessage(chatId, output, env, false, keyboard);
    }

    const keyboard = [];

    bindings.forEach((b, idx) => {
      let typeLabel = "";
      let detail = "";

      if (b.type === "kv_namespace") {
        typeLabel = "📦 [KV]";
        detail = `شناسه: <code>${b.namespace_id}</code>`;
      } else if (b.type === "d1") {
        typeLabel = "🗄 [D1]";
        detail = `شناسه: <code>${b.database_id}</code>`;
      } else if (b.type === "plain_text") {
        typeLabel = "⚙️ [Var]";
        detail = `مقدار: <code>${b.text}</code>`;
      } else if (b.type === "secret_text") {
        typeLabel = "🔒 [Secret]";
        detail = `مقدار: <code>(مخفی)</code>`;
      } else {
        typeLabel = `🔌 [${b.type}]`;
        detail = `سایر منابع`;
      }

      output += `${idx + 1}. ${typeLabel} <b>${b.name}</b>\n   └─ ${detail}\n\n`;
      keyboard.push([{ text: `🗑️ حذف بایندینگ ${b.name}`, callback_data: `del_b_${idx}` }]);
    });

    keyboard.push([{ text: "💥 حذف همه بایندینگ‌ها با هم", callback_data: "del_all_b" }]);
    keyboard.push([{ text: "🔙 بازگشت به منوی ورکر", callback_data: "wk_menu_back" }]);

    return sendMessage(chatId, output, env, false, keyboard);
  } catch (err) {
    return sendMessage(chatId, `❌ خطا در دریافت اطلاعات بایندینگ‌ها:\n<code>${err.message}</code>`, env);
  }
}

