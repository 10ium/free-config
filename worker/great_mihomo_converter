// مدیریت ذخیره و بازیابی اسلاگ‌ها در KV / حافظه
// ==========================================
async function getSlugConfig(slug, kv) {
  slug = String(slug || "").trim().toLowerCase();
  if (!slug) return null;
  if (kv) {
    let data = await kv.get(`slug:${slug}`, { type: "json" });
    if (typeof data === "string") {
      try { data = JSON.parse(data); } catch {}
    }
    if (data && typeof data === "object") return data;
  }
  return MEM_SLUGS.get(slug) || null;
}

async function saveSlugConfig(slug, config, kv) {
  slug = String(slug || "").trim().toLowerCase();
  config.slug = slug;
  config.updated_at = Date.now();
  if (kv) {
    await kv.put(`slug:${slug}`, JSON.stringify(config));
    // بروزرسانی ایندکس
    const idx = await getSlugIndex(kv);
    idx.add(slug);
    await kv.put("sys:slug_index", JSON.stringify([...idx]));
  }
  MEM_SLUGS.set(slug, config);
  MEM_SLUG_INDEX.add(slug);
}

async function deleteSlugConfig(slug, kv) {
  slug = String(slug || "").trim().toLowerCase();
  if (kv) {
    await kv.delete(`slug:${slug}`);
    const idx = await getSlugIndex(kv);
    idx.delete(slug);
    await kv.put("sys:slug_index", JSON.stringify([...idx]));
  }
  MEM_SLUGS.delete(slug);
  MEM_SLUG_INDEX.delete(slug);
}

async function getSlugIndex(kv) {
  const set = new Set();
  if (kv) {
    try {
      const listed = await kv.list({ prefix: "slug:" });
      if (listed && listed.keys) {
        for (const k of listed.keys) {
          set.add(k.name.replace(/^slug:/, ""));
        }
      }
    } catch (e) {
      const raw = await kv.get("sys:slug_index", { type: "json" });
      if (Array.isArray(raw)) raw.forEach(s => set.add(s));
    }
  }
  for (const s of MEM_SLUG_INDEX) set.add(s);
  return set;
}

