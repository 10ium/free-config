async function renderShipHistoryPeriod(chatId, messageId, targetChatId, period, token, db) {
  let query = `
    SELECT dc.*, 
      (SELECT first_name FROM group_members WHERE user_id = dc.user1_id LIMIT 1) as u1_name,
      (SELECT first_name FROM group_members WHERE user_id = dc.user2_id LIMIT 1) as u2_name
    FROM daily_couples dc
    WHERE dc.chat_id = ?
  `;
  const params = [targetChatId];

  if (period === '7') {
    query += ` AND dc.created_at >= datetime('now', '-7 days')`;
  } else if (period === '30') {
    query += ` AND dc.created_at >= datetime('now', '-30 days')`;
  } else if (period === '365') {
    query += ` AND dc.created_at >= datetime('now', '-365 days')`;
  }
  query += ` ORDER BY dc.id DESC LIMIT 10`;

  const list = await db.prepare(query).bind(...params).all();
  const rows = list.results || [];

  if (rows.length === 0) {
    await editMessageText(token, chatId, messageId, `📜 در این بازه زمانی هیچ زوجی ثبت نشده است!`);
    return;
  }

  let text = `📜 <b>تاریخچه زوج‌های برگزیده:</b>\n\n`;
  rows.forEach((r, idx) => {
    const scoreStr = (r.compatibility_score !== null && r.compatibility_score !== undefined && r.compatibility_score > 0) ? ` (${r.compatibility_score}٪)` : '';
    text += `${idx + 1}. <b>${r.u1_name || 'یار اول'}</b> + <b>${r.u2_name || 'یار دوم'}</b> = ❤️${scoreStr}\n   📅 <i>${r.ship_date}</i>\n\n`;
  });

  await editMessageText(token, chatId, messageId, text);
}

async function handleGroupPromote(chatId, threadId, msg, token, db) {
  const member = await tgCall(token, 'getChatMember', { chat_id: chatId, user_id: msg.from.id });
  const status = member?.result?.status;
  if (status !== 'administrator' && status !== 'creator') {
    await sendMessage(token, chatId, `⚠️ فقط مدیران گروه می‌توانند گروه را در لیست ویترین ثبت کنند.`, { message_thread_id: threadId });
    return;
  }

  let inviteLink = msg.chat.username ? `https://t.me/${msg.chat.username}` : null;
  if (!inviteLink) {
    const linkRes = await tgCall(token, 'exportChatInviteLink', { chat_id: chatId });
    inviteLink = linkRes?.result || null;
  }

  const memberCountRes = await tgCall(token, 'getChatMemberCount', { chat_id: chatId });
  const count = memberCountRes?.result || 0;

  await db.prepare(`
    INSERT INTO group_directory (chat_id, title, description, invite_link, member_count, is_public_listed)
    VALUES (?, ?, ?, ?, ?, 1)
    ON CONFLICT(chat_id) DO UPDATE SET title = excluded.title, invite_link = excluded.invite_link, member_count = excluded.member_count, is_public_listed = 1;
  `).bind(chatId, msg.chat.title || 'گروه دوستانه', 'گروه فعال با ربات جفت‌چین', inviteLink, count).run();

  await sendMessage(token, chatId, `🎉 <b>گروه در ویترین کشف گروه‌ها ثبت شد!</b>`, { message_thread_id: threadId });
}

