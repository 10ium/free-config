var index_default = {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);
    const pathname = url.pathname;
    const origin = url.origin;
    const kv = (env && (env.CONFIG_STORE || env.BOT_KV || env.KV || env.SUBS_KV)) || null;

    // ۱. سرویس فاویکون
    if (pathname === "/favicon.ico") {
      const faviconBase64 = "iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAhklEQVQ4T2NkYGD4z0ABYBw1gGE0DBhGwwBhNAwYRsOAYTQMGEYDAGzQn0H6qCgMAAAAAElFTkSuQmCC";
      return new Response(Uint8Array.from(atob(faviconBase64), c => c.charCodeAt(0)), {
        headers: { "Content-Type": "image/png", "Cache-Control": "public, max-age=86400" }
      });
    }

    // ۲. پایش سلامت
    if (pathname === "/health") {
      return new Response(JSON.stringify({ ok: true, name: "Universal Proxy Hub", time: Date.now() }), {
        headers: { "Content-Type": "application/json" }
      });
    }

    // ۳. بررسی وضعیت احراز هویت اولیه (API: /api/status)
    if (pathname === "/api/status") {
      const adminPass = await getAdminPassword(env, kv);
      const isAuth = await isAuthorized(request, env, kv);
      return new Response(JSON.stringify({
        setupRequired: !adminPass,
        authenticated: isAuth
      }), {
        headers: { "Content-Type": "application/json" }
      });
    }

    // ۴. ثبت رمز عبور اولیه در صورت نبودن رمز (API: /api/setup)
    if (pathname === "/api/setup" && request.method === "POST") {
      const adminPass = await getAdminPassword(env, kv);
      if (adminPass) {
        return new Response(JSON.stringify({ error: "رمز عبور قبلاً تعیین شده است." }), {
          status: 400,
          headers: { "Content-Type": "application/json" }
        });
      }
      try {
        const body = await request.json();
        const newPass = String(body.password || "").trim();
        if (!newPass) {
          return new Response(JSON.stringify({ error: "رمز عبور نمی‌تواند خالی باشد." }), {
            status: 400,
            headers: { "Content-Type": "application/json" }
          });
        }
        await setAdminPassword(newPass, env, kv);
        return new Response(JSON.stringify({ success: true }), {
          headers: { "Content-Type": "application/json" }
        });
      } catch (e) {
        return new Response(JSON.stringify({ error: e.message }), {
          status: 500,
          headers: { "Content-Type": "application/json" }
        });
      }
    }

    // ۵. بررسی لاگین مدیر (API: /api/auth)
    if (pathname === "/api/auth" && request.method === "POST") {
      const adminPass = await getAdminPassword(env, kv);
      try {
        const body = await request.json();
        const inputPass = String(body.password || "").trim();
        if (adminPass && inputPass === adminPass) {
          return new Response(JSON.stringify({ success: true }), {
            headers: { "Content-Type": "application/json" }
          });
        }
        return new Response(JSON.stringify({ error: "رمز عبور اشتباه است." }), {
          status: 401,
          headers: { "Content-Type": "application/json" }
        });
      } catch (e) {
        return new Response(JSON.stringify({ error: e.message }), {
          status: 500,
          headers: { "Content-Type": "application/json" }
        });
      }
    }

    // ۶. دریافت لیست تمام اسلاگ‌ها برای مدیر (API: GET /api/slugs)
    if (pathname === "/api/slugs" && request.method === "GET") {
      const auth = await isAuthorized(request, env, kv);
      if (!auth) {
        return new Response(JSON.stringify({ error: "دسترسی غیرمجاز." }), {
          status: 401,
          headers: { "Content-Type": "application/json" }
        });
      }
      const slugKeys = await getSlugIndex(kv);
      const list = [];
      for (const sk of slugKeys) {
        const cfg = await getSlugConfig(sk, kv);
        if (cfg) {
          list.push({
            slug: sk,
            subsCount: cfg.subs ? cfg.subs.length : 0,
            limit_total: cfg.limit_total || null,
            dedup: cfg.dedup !== false,
            awg: Boolean(cfg.awg),
            updated_at: cfg.updated_at || null
          });
        }
      }
      return new Response(JSON.stringify(list), {
        headers: { "Content-Type": "application/json" }
      });
    }

    // ۷. دریافت جزئیات یک اسلاگ خاص برای ویرایش (API: GET /api/slug/:slug)
    if (pathname.startsWith("/api/slug/") && request.method === "GET") {
      const auth = await isAuthorized(request, env, kv);
      if (!auth) {
        return new Response(JSON.stringify({ error: "دسترسی غیرمجاز." }), {
          status: 401,
          headers: { "Content-Type": "application/json" }
        });
      }
      const rawTarget = pathname.slice("/api/slug/".length);
      let targetSlug = rawTarget;
      try { targetSlug = decodeURIComponent(rawTarget); } catch {}
      targetSlug = targetSlug.trim().toLowerCase();
      const cfg = await getSlugConfig(targetSlug, kv);
      if (!cfg) {
        return new Response(JSON.stringify({ error: "اسلاگ یافت نشد." }), {
          status: 404,
          headers: { "Content-Type": "application/json" }
        });
      }
      return new Response(JSON.stringify({ slug: targetSlug, config: cfg }), {
        headers: { "Content-Type": "application/json" }
      });
    }

    // ۸. ذخیره یا بروزرسانی اسلاگ (API: POST /api/slug)
    if (pathname === "/api/slug" && request.method === "POST") {
      const auth = await isAuthorized(request, env, kv);
      if (!auth) {
        return new Response(JSON.stringify({ error: "دسترسی غیرمجاز." }), {
          status: 401,
          headers: { "Content-Type": "application/json" }
        });
      }
      try {
        const body = await request.json();
        const slug = (body.slug || "").trim().toLowerCase();
        if (!slug || RESERVED_SYSTEM_PATHS.has(slug)) {
          return new Response(JSON.stringify({ error: "نام اسلاگ رزرو شده یا نامعتبر است." }), {
            status: 400,
            headers: { "Content-Type": "application/json" }
          });
        }

        let config = {};
        if (body.configQuery) {
          const q = new URLSearchParams(body.configQuery);
          config.subs = q.get("subs") ? q.get("subs").split(",").map(s => s.trim()).filter(Boolean) : [];
          config.limit_total = q.get("limit_total") ? parseInt(q.get("limit_total")) : null;
          config.dedup = q.get("dedup") !== "0";
          config.awg = q.get("awg") === "1";
          config.awg_jc = q.get("awg_jc") ? parseInt(q.get("awg_jc")) : 4;
          config.awg_jmin = q.get("awg_jmin") ? parseInt(q.get("awg_jmin")) : 40;
          config.awg_jmax = q.get("awg_jmax") ? parseInt(q.get("awg_jmax")) : 70;
          config.limits = {};
          config.priorities = {};
          for (const proto of ALLOWED_3WAY_PROTOCOLS) {
            if (q.has(`limit_${proto}`)) config.limits[proto] = parseInt(q.get(`limit_${proto}`));
            if (q.has(`prio_${proto}`)) config.priorities[proto] = parseInt(q.get(`prio_${proto}`));
          }
        } else {
          config = body.config || {};
          if (body.url) {
            config.subs = [body.url];
          }
        }

        await saveSlugConfig(slug, config, kv);

        const encodedSlugOut = encodeURIComponent(slug);
        return new Response(JSON.stringify({
          success: true,
          slug,
          links: {
            smart: `${origin}/${encodedSlugOut}`,
            clash: `${origin}/${encodedSlugOut}/clash`,
            singbox: `${origin}/${encodedSlugOut}/singbox`,
            xray: `${origin}/${encodedSlugOut}/xray`,
            b64: `${origin}/${encodedSlugOut}/b64`
          }
        }), {
          headers: { "Content-Type": "application/json" }
        });
      } catch (e) {
        return new Response(JSON.stringify({ error: e.message }), {
          status: 500,
          headers: { "Content-Type": "application/json" }
        });
      }
    }

    // ۹. حذف یک اسلاگ (API: DELETE /api/slug/:slug)
    if (pathname.startsWith("/api/slug/") && request.method === "DELETE") {
      const auth = await isAuthorized(request, env, kv);
      if (!auth) {
        return new Response(JSON.stringify({ error: "دسترسی غیرمجاز." }), {
          status: 401,
          headers: { "Content-Type": "application/json" }
        });
      }
      const rawDelTarget = pathname.slice("/api/slug/".length);
      let targetSlug = rawDelTarget;
      try { targetSlug = decodeURIComponent(rawDelTarget); } catch {}
      targetSlug = targetSlug.trim().toLowerCase();
      await deleteSlugConfig(targetSlug, kv);
      return new Response(JSON.stringify({ success: true, slug: targetSlug }), {
        headers: { "Content-Type": "application/json" }
      });
    }

    // ۱۰. صفحه اصلی (داشبورد ژنراتور وب)
    if (pathname === "/" || pathname === "") {
      return new Response(getHTML(origin), {
        headers: { "Content-Type": "text/html; charset=utf-8" }
      });
    }

    // ۱۱. بررسی مسیرهای سفارشی یا استاندارد
    const pathParts = pathname.split("/").filter(Boolean).map(seg => {
      try { return decodeURIComponent(seg); } catch { return seg; }
    });
    let targetSlug = null;
    let formatParam = url.searchParams.get("format");

    if (pathParts.length === 1) {
      const part = pathParts[0].toLowerCase();
      if (part === "sub") {
        // استاندارد /sub
      } else if (["clash", "singbox", "xray", "b64", "json"].includes(part)) {
        formatParam = part;
      } else {
        // نام اسلاگ سفارشی مستقیم: /:slug
        targetSlug = part;
      }
    } else if (pathParts.length >= 2) {
      if (pathParts[0].toLowerCase() === "sub") {
        targetSlug = pathParts[1].toLowerCase();
      } else {
        targetSlug = pathParts[0].toLowerCase();
        const subAction = pathParts[1].toLowerCase();
        if (["clash", "singbox", "xray", "b64", "json"].includes(subAction)) {
          formatParam = subAction;
        }
      }
    }

    // بارگذاری کانفیگ اسلاگ در صورت وجود
    let slugConfig = null;
    if (targetSlug) {
      slugConfig = await getSlugConfig(targetSlug, kv);
      if (!slugConfig && !url.searchParams.has("subs") && !url.searchParams.has("url") && !url.searchParams.has("sub")) {
        slugConfig = { subs: DEFAULT_SUBS };
      }
    }

    // تشخیص کلاینت از روی User-Agent
    const ua = (request.headers.get("User-Agent") || "").toLowerCase();
    let finalFormat = formatParam;

    if (!finalFormat) {
      if (ua.includes("clash") || ua.includes("meta") || ua.includes("stash") || ua.includes("flclash") || ua.includes("bettbox")) {
        finalFormat = "clash";
      } else if (ua.includes("sing-box") || ua.includes("singbox") || ua.includes("hiddify") || ua.includes("nekobox") || ua.includes("sfa") || ua.includes("sfi")) {
        finalFormat = "singbox";
      } else if (ua.includes("v2ray") || ua.includes("xray") || ua.includes("streisand") || ua.includes("v2box") || ua.includes("shadowrocket")) {
        finalFormat = "xray";
      } else if (ua.includes("mozilla") || ua.includes("chrome") || ua.includes("safari")) {
        finalFormat = "html";
      } else {
        finalFormat = "clash";
      }
    }

    // گردآوری پارامترهای پردازش
    let subsList = [];
    const queryUrls = [
      ...url.searchParams.getAll("subs"),
      ...url.searchParams.getAll("sub"),
      ...url.searchParams.getAll("url")
    ];
    if (queryUrls.length > 0) {
      subsList = queryUrls.flatMap(s => s.split(/[\r\n,]+/)).map(s => s.trim()).filter(Boolean);
    } else if (slugConfig?.subs?.length > 0) {
      subsList = slugConfig.subs;
    } else {
      subsList = DEFAULT_SUBS;
    }

    const limitTotal = parseInt(url.searchParams.get("limit_total") || slugConfig?.limit_total) || Infinity;
    const enableAwg = url.searchParams.get("awg") === "1" || slugConfig?.awg === true;
    const enableDedup = url.searchParams.get("dedup") !== "0" && slugConfig?.dedup !== false;
    const awgParams = {
      jc: parseInt(url.searchParams.get("awg_jc") || slugConfig?.awg_jc) || 4,
      jmin: parseInt(url.searchParams.get("awg_jmin") || slugConfig?.awg_jmin) || 40,
      jmax: parseInt(url.searchParams.get("awg_jmax") || slugConfig?.awg_jmax) || 70
    };

    const limits = {};
    const priorities = {};
    for (const proto of ALLOWED_3WAY_PROTOCOLS) {
      const limVal = url.searchParams.get(`limit_${proto}`) ?? slugConfig?.limits?.[proto];
      if (limVal !== undefined && limVal !== "" && limVal !== null) {
        limits[proto] = parseInt(limVal);
      }
      const prioVal = url.searchParams.get(`prio_${proto}`) ?? slugConfig?.priorities?.[proto];
      if (prioVal !== undefined && prioVal !== "" && prioVal !== null) {
        priorities[proto] = parseInt(prioVal);
      }
    }

    try {
      // اجرای پردازش سورس‌ها
      const processed = await processSubscription({
        subsList,
        limitTotal,
        limits,
        priorities,
        enableAwg,
        enableDedup,
        awgParams
      });

      // در صورت درخواست فرمت JSON (آمار)
      if (finalFormat === "json") {
        return new Response(JSON.stringify(processed.stats), {
          headers: { "Content-Type": "application/json" }
        });
      }

      // در صورت مشاهده در مرورگر (داشبورد سابسکریپشن بدون افشای سورس‌ها)
      if (finalFormat === "html") {
        const displaySlug = url.searchParams.get("title") || slugConfig?.title || targetSlug || "سفارشی";
        return new Response(getSubDashboardHtml(displaySlug, processed.stats, origin), {
          headers: { "Content-Type": "text/html; charset=utf-8" }
        });
      }

      // هدرهای استاندارد سابسکریپشن برای تمام کلاینت‌ها
      const profileTitle = url.searchParams.get("title") || slugConfig?.title || targetSlug || "";
      const commonHeaders = {
        "subscription-userinfo": `upload=0; download=0; total=107374182400; expire=0`,
        "profile-update-interval": "24",
        "cache-control": "no-cache, no-store, must-revalidate"
      };
      if (profileTitle) {
        commonHeaders["profile-title"] = "base64:" + Buffer.from(String(profileTitle), "utf8").toString("base64");
      }

      const subFileSlug = targetSlug || "subscription";
      const safeAsciiSlug = subFileSlug.replace(/[^a-zA-Z0-9._-]/g, "_").replace(/^[_-]+|[_-]+$/g, "").replace(/_+/g, "_") || "subscription";
      const utf8TitleName = profileTitle || safeAsciiSlug;
      const makeDisp = (ext) => `inline; filename="${safeAsciiSlug}${ext}"; filename*=UTF-8''${encodeURIComponent(utf8TitleName + ext)}`;

      // خروجی کلش / میهومو
      if (finalFormat === "clash") {
        const outputMode = url.searchParams.get("output") || slugConfig?.output || "config";
        if (outputMode === "provider") {
          return new Response(buildProvider(processed.proxies), {
            headers: {
              ...commonHeaders,
              "Content-Type": "text/yaml; charset=utf-8",
              "content-disposition": makeDisp(".yaml")
            }
          });
        }
        return new Response(buildMihomoConfig(processed.proxies), {
          headers: {
            ...commonHeaders,
            "Content-Type": "text/yaml; charset=utf-8",
            "content-disposition": makeDisp(".yaml")
          }
        });
      }

      // خروجی سینگ‌باکس
      if (finalFormat === "singbox") {
        return new Response(buildSingboxConfig(processed.proxies), {
          headers: {
            ...commonHeaders,
            "Content-Type": "application/json; charset=utf-8",
            "content-disposition": makeDisp(".json")
          }
        });
      }

      // خروجی متنی اکس‌ری (Raw Xray Links)
      const xrayItems = extractXrayLinks(processed.proxies, { skipFilter: true });
      const rawText = xrayItems.map(x => x.link).filter(Boolean).join("\n") + "\n";

      // خروجی بیس۶۴ اکس‌ری
      if (finalFormat === "b64") {
        const b64Body = Buffer.from(rawText).toString("base64");
        return new Response(b64Body, {
          headers: {
            ...commonHeaders,
            "Content-Type": "text/plain; charset=utf-8",
            "content-disposition": makeDisp("_b64.txt")
          }
        });
      }

      // خروجی پیش‌فرض اکس‌ری
      return new Response(rawText, {
        headers: {
          ...commonHeaders,
          "Content-Type": "text/plain; charset=utf-8",
          "content-disposition": makeDisp(".txt")
        }
      });

    } catch (e) {
      return new Response(`خطا در پردازش سابسکریپشن: ${e.message}`, {
        status: 500,
        headers: { "Content-Type": "text/plain; charset=utf-8" }
      });
    }
  }
};

export {
  index_default as default
};
