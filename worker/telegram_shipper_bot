async function handleDirectMatchRequest(chatId, user, token, db) {
  const myProfile = await db.prepare(`SELECT * FROM user_profiles WHERE user_id = ?`).bind(user.id).first();
  if (!myProfile || !myProfile.birth_year || !myProfile.city) {
    await sendMessage(token, chatId, `⚠️ لطفاً ابتدا در منوی پروفایل، حداقل <b>سال تولد</b> و <b>شهر</b> خود را تکمیل کنید تا کیوپید بتواند بهترین پارتنر را برای شما پیدا کند.`);
    return;
  }

  const candidates = await db.prepare(`
    SELECT dp.*, up.*
    FROM direct_ship_pool dp
    JOIN user_profiles up ON dp.user_id = up.user_id
    WHERE dp.is_active = 1 AND dp.user_id != ?
    LIMIT 50
  `).bind(user.id).all();

  const list = candidates.results || [];
  if (list.length === 0) {
    await sendMessage(token, chatId, `🏹 <b>در حال حاضر پارتنر سازگار آزادی در صف شیپ مستقیم نیست!</b>\nسیستم فعال است و به محض ورود پارتنری متناسب با معیارهای شما، کیوپید پیامی برای هر دوی شما در پیوی ارسال خواهد کرد. ✨`);
    return;
  }

  let best = list[0];
  let maxScore = -1;
  for (const c of list) {
    const s = computePairScore(myProfile, c);
    if (s.score > maxScore) {
      maxScore = s.score;
      best = c;
    }
  }

  const myDirect = await db.prepare(`SELECT * FROM direct_ship_pool WHERE user_id = ?`).bind(user.id).first();
  const partnerDirect = best;

  const partnerContact = partnerDirect.share_username && best.username ? `@${best.username}` : 'مخفی به انتخاب کاربر';
  const myContact = myDirect?.share_username && user.username ? `@${user.username}` : 'مخفی به انتخاب کاربر';

  const groupInfo = partnerDirect.shared_group_link ? `\n🔗 <b>لینک گروه پیشنهادی پارتنر:</b> ${partnerDirect.shared_group_link}` : '';

  const msgForMe = `💘 <b>پارتنر منتخب کیوپید در شیپ مستقیم پیوی!</b>\n\n👤 <b>نام پارتنر:</b> ${best.first_name || 'کاربر'}\n📍 <b>محل سکونت:</b> ${best.province} - ${best.city}\n🎂 <b>سن تقریبی:</b> ${getShamsiDetails().year - (best.birth_year || 1380)} ساله\n📊 <b>درصد تفاهم:</b> ${maxScore}٪\n💬 <b>ارتباط:</b> ${partnerContact}${groupInfo}\n\n<i>امیدواریم گفتگوی فوق‌العاده‌ای داشته باشید! ✨</i>`;
  await sendMessage(token, chatId, msgForMe);

  const myGroupInfo = myDirect?.shared_group_link ? `\n🔗 <b>لینک گروه پیشنهادی پارتنر:</b> ${myDirect.shared_group_link}` : '';
  const msgForPartner = `💘 <b>پارتنر منتخب کیوپید در شیپ مستقیم پیوی!</b>\n\n👤 <b>نام پارتنر:</b> ${user.first_name || 'کاربر'}\n📍 <b>محل سکونت:</b> ${myProfile.province} - ${myProfile.city}\n🎂 <b>سن تقریبی:</b> ${getShamsiDetails().year - myProfile.birth_year} ساله\n📊 <b>درصد تفاهم:</b> ${maxScore}٪\n💬 <b>ارتباط:</b> ${myContact}${myGroupInfo}\n\n<i>امیدواریم گفتگوی فوق‌العاده‌ای داشته باشید! ✨</i>`;
  await sendMessage(token, best.user_id, msgForPartner);
}

// ورودی متن آزاد با مدیریت خطای حرفه‌ای
async function handlePrivateTextInput(chatId, user, text, msg, token, db) {
  const norm = normalizeDigits(text);
  const profile = await db.prepare(`SELECT * FROM user_profiles WHERE user_id = ?`).bind(user.id).first();
  const step = profile?.onboarding_step;

  // پردازش افزودن کاربر به لیست سیاه شیپ در پیوی
  if (step === 'waiting_block_target') {
    if (text === '/cancel') {
      await db.prepare(`UPDATE user_profiles SET onboarding_step = 'done' WHERE user_id = ?`).bind(user.id).run();
      await sendMessage(token, chatId, `عملیات لغو شد.`);
      await showBlockShipMenu(chatId, user, token, db);
      return;
    }

    let targetId = null;
    let targetName = null;

    if (msg.forward_from) {
      targetId = msg.forward_from.id;
      targetName = msg.forward_from.first_name || (msg.forward_from.username ? `@${msg.forward_from.username}` : `کاربر ${targetId}`);
    } else if (msg.forward_origin && msg.forward_origin.type === 'user' && msg.forward_origin.sender_user) {
      targetId = msg.forward_origin.sender_user.id;
      targetName = msg.forward_origin.sender_user.first_name || (msg.forward_origin.sender_user.username ? `@${msg.forward_origin.sender_user.username}` : `کاربر ${targetId}`);
    } else if (msg.forward_sender_name || (msg.forward_origin && msg.forward_origin.type === 'hidden_user')) {
      await sendMessage(token, chatId, `⚠️ <b>تنظیمات فوروارد این کاربر خصوصی است:</b>\nتلگرام به دلیل تنظیمات حریم خصوصی این شخص، آیدی او را در فوروارد پنهان کرده است.\nلطفاً <b>آیدی کاربری (@username)</b> یا <b>آیدی عددی</b> او را تایپ و ارسال کنید.`);
      return;
    } else if (text) {
      const cleanText = text.trim();
      const numMatch = cleanText.match(/^(\d{6,15})$/);
      if (numMatch) {
        targetId = parseInt(numMatch[1], 10);
        const mem = await db.prepare(`SELECT first_name, username FROM group_members WHERE user_id = ? LIMIT 1`).bind(targetId).first();
        targetName = mem?.first_name || `کاربر ${targetId}`;
      } else {
        const uMatch = cleanText.match(/^@?([a-zA-Z0-9_]{3,32})$/);
        if (uMatch) {
          const uname = uMatch[1];
          const mem = await db.prepare(`SELECT user_id, first_name FROM group_members WHERE username = ? COLLATE NOCASE LIMIT 1`).bind(uname).first();
          if (mem) {
            targetId = mem.user_id;
            targetName = mem.first_name || `@${uname}`;
          } else {
            const up = await db.prepare(`SELECT user_id, first_name FROM user_profiles WHERE username = ? COLLATE NOCASE LIMIT 1`).bind(uname).first();
            if (up) {
              targetId = up.user_id;
              targetName = up.first_name || `@${uname}`;
            } else {
              await sendMessage(token, chatId, `❌ کاربری با یوزرنیم <b>@${uname}</b> در دیتابیس گروه‌ها یا ربات یافت نشد!\nاگر آیدی عددی او را دارید یا می‌توانید پیامی از او فوروارد کنید، لطفاً آن را بفرستید.`);
              return;
            }
          }
        }
      }
    }

    if (!targetId) {
      await sendMessage(token, chatId, `❌ <b>ورودی نامعتبر است!</b>\nلطفاً یا پیامی از کاربر را فوروارد کنید، یا آیدی عددی/یوزرنیم او را بفرستید.`);
      return;
    }

    if (targetId === user.id) {
      await sendMessage(token, chatId, `❌ شما نمی‌توانید خودتان را مسدود کنید!`);
      return;
    }

    await db.prepare(`INSERT OR IGNORE INTO user_ship_blocks (user_id, blocked_user_id) VALUES (?, ?), (?, ?)`).bind(user.id, targetId, targetId, user.id).run();
    await db.prepare(`UPDATE user_profiles SET onboarding_step = 'done' WHERE user_id = ?`).bind(user.id).run();

    await sendMessage(token, chatId, `✅ <b>کاربر ${targetName} با موفقیت در لیست سیاه شیپینگ شما قرار گرفت!</b>\nاز این پس کیوپید در هیچ گروهی شما دو نفر را با یکدیگر شیپ نخواهد کرد. 🚫`);
    await showBlockShipMenu(chatId, user, token, db);
    return;
  }

  // ورود متنی حداقل اختلاف سن
  if (step === 'waiting_age_min') {
    const parsed = parseAgeDiff(text);
    if (parsed === null) {
      await sendMessage(token, chatId, `❌ <b>مقدار واردشده معتبر نیست!</b>\nلطفاً عددی مانند <code>-5</code> یا <code>+3</code> یا کلمه <code>همسن</code> را ارسال کنید.`);
      return;
    }
    const curMax = profile.age_max_diff ?? 50;
    if (parsed > curMax) {
      await sendMessage(token, chatId, `❌ <b>حداقل سن نمی‌تواند از حداکثر سن فعلی شما بزرگ‌تر باشد!</b>\nحداکثر فعلی شما <b>${formatAgeDiff(curMax)}</b> است. لطفاً عددی کوچک‌تر از آن بفرستید.`);
      return;
    }
    await db.prepare(`UPDATE user_profiles SET age_min_diff = ?, onboarding_step = 'done' WHERE user_id = ?`).bind(parsed, user.id).run();
    await sendMessage(token, chatId, `✅ حداقل اختلاف سن با موفقیت روی <b>${formatAgeDiff(parsed)}</b> تنظیم شد!`);
    await showUserProfileMenu(chatId, user, token, db);
    return;
  }

  // ورود متنی حداکثر اختلاف سن
  if (step === 'waiting_age_max') {
    const parsed = parseAgeDiff(text);
    if (parsed === null) {
      await sendMessage(token, chatId, `❌ <b>مقدار واردشده معتبر نیست!</b>\nلطفاً عددی مانند <code>+10</code> یا <code>-2</code> یا کلمه <code>همسن</code> را ارسال کنید.`);
      return;
    }
    const curMin = profile.age_min_diff ?? -50;
    if (parsed < curMin) {
      await sendMessage(token, chatId, `❌ <b>حداکثر سن نمی‌تواند از حداقل سن فعلی شما کوچک‌تر باشد!</b>\nحداقل فعلی شما <b>${formatAgeDiff(curMin)}</b> است. لطفاً عددی بزرگ‌تر از آن بفرستید.`);
      return;
    }
    await db.prepare(`UPDATE user_profiles SET age_max_diff = ?, onboarding_step = 'done' WHERE user_id = ?`).bind(parsed, user.id).run();
    await sendMessage(token, chatId, `✅ حداکثر اختلاف سن با موفقیت روی <b>${formatAgeDiff(parsed)}</b> تنظیم شد!`);
    await showUserProfileMenu(chatId, user, token, db);
    return;
  }

  // ۱. ثبت لینک گروه مشترک
  if (step === 'waiting_group_link') {
    if (text.includes('t.me/')) {
      await db.prepare(`
        INSERT INTO direct_ship_pool (user_id, shared_group_link) VALUES (?, ?)
        ON CONFLICT(user_id) DO UPDATE SET shared_group_link = excluded.shared_group_link;
      `).bind(user.id, text).run();
      await db.prepare(`UPDATE user_profiles SET onboarding_step = 'done' WHERE user_id = ?`).bind(user.id).run();
      await sendMessage(token, chatId, `🔗 لینک گروه با موفقیت ثبت شد! ✅`);
      await showUserProfileMenu(chatId, user, token, db);
      return;
    } else {
      await sendMessage(token, chatId, `❌ <b>لینک واردشده معتبر نیست!</b>\nلطفاً یک لینک معتبر تلگرام (مثلاً: <code>https://t.me/yourgroup</code>) ارسال کنید.`);
      return;
    }
  }

  // ۲. ورود تاریخ تولد با سال، ماه و روز
  if (step === 'waiting_birth') {
    // پشتیبانی کامل از هر دو فرمت: روز/ماه/سال (مثلاً 11/12/1376) یا سال/ماه/روز (1376/12/11) یا فقط سال
    const ymdMatch = norm.match(/^(13\d{2}|14\d{2})[/-](\d{1,2})[/-](\d{1,2})$/);
    const dmyMatch = norm.match(/^(\d{1,2})[/-](\d{1,2})[/-](13\d{2}|14\d{2})$/);
    const yearMatch = norm.match(/^(13\d{2}|14\d{2})$/);

    if (ymdMatch || dmyMatch) {
      let y, m, d;
      if (ymdMatch) {
        y = parseInt(ymdMatch[1], 10);
        m = parseInt(ymdMatch[2], 10);
        d = parseInt(ymdMatch[3], 10);
      } else {
        d = parseInt(dmyMatch[1], 10);
        m = parseInt(dmyMatch[2], 10);
        y = parseInt(dmyMatch[3], 10);
      }

      const age = calculateExactAge(y, m, d);

      if (age < 10 || age > 110 || m < 1 || m > 12 || d < 1 || d > 31) {
        await sendMessage(token, chatId, `❌ <b>تاریخ وارد شده معتبر نیست!</b>\nسن باید بین ۱۰ تا ۱۱۰ سال باشد و ماه و روز معتبر باشند.`);
        return;
      }

      await db.prepare(`UPDATE user_profiles SET birth_year = ?, birth_month = ?, birth_day = ?, onboarding_step = 'done' WHERE user_id = ?`).bind(y, m, d, user.id).run();
      await sendMessage(token, chatId, `🎂 تاریخ تولد شما <b>${d}/${m}/${y}</b> (${age} ساله) با موفقیت ثبت شد! ✅\n<i>کیوپید در روز تولدتان در گروه‌ها به شما تبریک خواهد گفت! 🎉</i>`);
      await showUserProfileMenu(chatId, user, token, db);
      return;
    }

    if (yearMatch) {
      const y = parseInt(yearMatch[1], 10);
      const age = calculateExactAge(y);

      if (age < 10 || age > 110) {
        await sendMessage(token, chatId, `❌ <b>سال تولد معتبر نیست!</b>\nسن باید بین ۱۰ تا ۱۱۰ سال باشد.`);
        return;
      }

      await db.prepare(`UPDATE user_profiles SET birth_year = ?, birth_month = NULL, birth_day = NULL, onboarding_step = 'done' WHERE user_id = ?`).bind(y, user.id).run();
      await sendMessage(token, chatId, `🎂 سال تولد شما <b>${y}</b> (${age} ساله) با موفقیت ثبت شد! ✅`);
      await showUserProfileMenu(chatId, user, token, db);
      return;
    }

    await sendMessage(token, chatId, `❌ <b>فرمت تاریخ معتبر نیست!</b>\nلطفاً سال یا تاریخ را مانند نمونه‌های زیر وارد کنید:\n• <code>1380</code>\n• <code>1382/04/15</code>`);
    return;
  }

  // ۳. جستجوی نام شهر در دیتابیس ۱۶۷۲ شهر
  const cleanCity = text.trim().replace(/ي/g, "ی").replace(/ك/g, "ک");
  const matched = await db.prepare(`
    SELECT * FROM iran_cities 
    WHERE city = ? OR city LIKE ? OR ? LIKE ('%' || city || '%')
    ORDER BY LENGTH(city) ASC LIMIT 1
  `).bind(cleanCity, cleanCity, cleanCity).first();

  if (matched) {
    await db.prepare(`UPDATE user_profiles SET province = ?, city = ?, city_lat = ?, city_lon = ?, onboarding_step = 'done' WHERE user_id = ?`).bind(matched.province, matched.city, matched.lat, matched.lon, user.id).run();
    await sendMessage(token, chatId, `📍 شهر <b>${matched.city}</b> (استان ${matched.province}) با موفقیت شناسایی و ثبت شد! ✅`);
    await showUserProfileMenu(chatId, user, token, db);
    return;
  }

  // اگر مستقیم عدد سال فرستاد
  const directYear = norm.match(/^(13\d{2}|14\d{2})/);
  if (directYear) {
    const y = parseInt(directYear[1], 10);
    const shamsi = getShamsiDetails();
    const age = shamsi.year - y;
    if (age >= 10 && age <= 110) {
      await db.prepare(`UPDATE user_profiles SET birth_year = ?, onboarding_step = 'done' WHERE user_id = ?`).bind(y, user.id).run();
      await sendMessage(token, chatId, `🎂 سال تولد شما <b>${y}</b> (${age} ساله) ثبت شد! ✅`);
      await showUserProfileMenu(chatId, user, token, db);
      return;
    }
  }

  // پیام خطای عدم یافتن شهر
  const errKeyboard = {
    inline_keyboard: [
      [{ text: '📍 انتخاب شهر از لیست استان‌ها', callback_data: 'step_province' }],
      [{ text: '🔙 بازگشت به منوی پروفایل', callback_data: 'main_menu' }]
    ]
  };
  await sendMessage(token, chatId, `❌ <b>متأسفانه شهر «${text}» در دیتابیس ۱۶۷۲ شهر ایران پیدا نشد!</b>\n\n💡 <b>راهنما:</b>\n۱. لطفاً املای صحیح نام شهر را بنویسید (مثلاً: کازرون، نیشابور، کرج، لاهیجان).\n۲. یا با دکمه زیر استان خود را انتخاب کنید تا لیست شهرهایش را ببینید:`, { reply_markup: errKeyboard });
}

async function showGroupDirectory(chatId, token, db) {
  const list = await db.prepare(`SELECT * FROM group_directory WHERE is_public_listed = 1 ORDER BY RANDOM() LIMIT 4`).all();
  const groups = list.results || [];

  if (groups.length === 0) {
    await sendMessage(token, chatId, `🔍 هنوز گروهی در ویترین ثبت نشده است. ادمین‌های گروه‌ها می‌توانند با دستور /promote گروه خود را اضافه کنند.`);
    return;
  }

  let text = `🎲 <b>کشف گروه‌های فعال و مجهز به جُفت‌چین:</b>\n\n`;
  const buttons = [];

  groups.forEach((g, idx) => {
    text += `${idx + 1}. <b>${g.title}</b>\n   👥 اعضا: ${g.member_count} نفر\n   💬 ${g.description || ''}\n\n`;
    if (g.invite_link) {
            const shortTitle = g.title.length > 14 ? g.title.slice(0, 12) + '…' : g.title;
      buttons.push([{ text: `ورود به ${shortTitle} 🚀`, url: g.invite_link }]);
    }
  });

  buttons.push([{ text: '🎲 گروه‌های تصادفی دیگر', callback_data: 'explore_groups' }]);
  buttons.push([{ text: '🔙 بازگشت به منو', callback_data: 'main_menu' }]);

  await sendMessage(token, chatId, text, { reply_markup: { inline_keyboard: buttons } });
}

async function showUserStatus(chatId, userId, token, db) {
  const tehran = getTehranDate();
  const list = await db.prepare(`
    SELECT dc.*, g.title as group_title, g.username as group_username
    FROM daily_couples dc
    JOIN groups g ON dc.chat_id = g.chat_id
    WHERE (dc.user1_id = ? OR dc.user2_id = ? OR dc.user3_id = ?) AND dc.ship_date = ?
  `).bind(userId, userId, userId, tehran.dateStr).all();

  const ships = list.results || [];
  if (ships.length === 0) {
    await sendMessage(token, chatId, `🏹 شما امروز هنوز در هیچ گروهی به عنوان زوج روز انتخاب نشده‌اید.\n<i>تا ساعت ۱۲ شب منتظر شلیک تیر کیوپید باشید! 💘</i>`);
    return;
  }

  let text = `🎉 <b>شما امروز در گروه‌های زیر به عنوان زوج روز انتخاب شده‌اید:</b>\n\n`;
  const buttons = [];

  ships.forEach((s, idx) => {
    let link = null;
    if (s.group_username && s.message_id) {
      link = `https://t.me/${s.group_username}/${s.message_id}`;
    } else if (s.chat_id && s.message_id) {
      const cleanChatId = Math.abs(s.chat_id).toString().replace(/^100/, '');
      link = `https://t.me/c/${cleanChatId}/${s.message_id}`;
    }

    const scorePart = (s.compatibility_score !== null && s.compatibility_score !== undefined && s.compatibility_score > 0) ? `\n   📊 درصد تفاهم: ${s.compatibility_score}٪` : '';
    text += `${idx + 1}. 👥 <b>${s.group_title}</b>${scorePart}\n   ✨ وجه اشتراک: ${s.reason}\n\n`;
    if (link) {
            const shortTitle = s.group_title.length > 14 ? s.group_title.slice(0, 12) + '…' : s.group_title;
      buttons.push([{ text: `مشاهده در ${shortTitle} 🔗`, url: link }]);
    }
  });

  await sendMessage(token, chatId, text, { reply_markup: { inline_keyboard: buttons } });
}

async function handleAdminPanel(chatId, userId, text, token, db) {
  const ownerSetting = await db.prepare(`SELECT value FROM bot_settings WHERE key = 'owner_id'`).first();
  let ownerId = parseInt(ownerSetting?.value || '0', 10);

  if (ownerId === 0) {
    await db.prepare(`UPDATE bot_settings SET value = ? WHERE key = 'owner_id'`).bind(userId.toString()).run();
    ownerId = userId;
  }

  if (userId !== ownerId) {
    await sendMessage(token, chatId, `⛔ شما ادمین این ربات نیستید.`);
    return;
  }

  const modeSetting = await db.prepare(`SELECT value FROM bot_settings WHERE key = 'mode'`).first();
  const currentMode = modeSetting?.value || 'public';

  const parts = text.split(' ');
  const subCmd = parts[1]?.toLowerCase();

  if (subCmd === 'public' || subCmd === 'private') {
    await db.prepare(`UPDATE bot_settings SET value = ? WHERE key = 'mode'`).bind(subCmd).run();
    await sendMessage(token, chatId, `✅ حالت ربات به <b>${subCmd === 'public' ? 'عمومی (همه گروه‌ها)' : 'خصوصی (فقط گروه‌های من)'}</b> تغییر یافت.`);
    return;
  }

  if (subCmd === 'whitelist' && parts[2]) {
    const targetChat = parseInt(parts[2], 10);
    await db.prepare(`INSERT INTO groups (chat_id, mode_override) VALUES (?, 'allowed') ON CONFLICT(chat_id) DO UPDATE SET mode_override = 'allowed'`).bind(targetChat).run();
    await sendMessage(token, chatId, `✅ گروه <code>${targetChat}</code> با موفقیت وایت‌لیست شد (همیشه فعال).`);
    return;
  }

  if (subCmd === 'blacklist' && parts[2]) {
    const targetChat = parseInt(parts[2], 10);
    await db.prepare(`INSERT INTO groups (chat_id, mode_override) VALUES (?, 'blocked') ON CONFLICT(chat_id) DO UPDATE SET mode_override = 'blocked'`).bind(targetChat).run();
    await sendMessage(token, chatId, `🚫 گروه <code>${targetChat}</code> بلک‌لیست شد (همیشه غیرفعال).`);
    return;
  }

  if (subCmd === 'banuser' && parts[2]) {
    const targetUserId = parseInt(parts[2], 10);
    const banSetting = await db.prepare(`SELECT value FROM bot_settings WHERE key = 'banned_users'`).first();
    const bannedList = safeJsonArray(banSetting?.value);
    if (!bannedList.includes(targetUserId)) {
      bannedList.push(targetUserId);
      await db.prepare(`INSERT INTO bot_settings (key, value) VALUES ('banned_users', ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value`).bind(JSON.stringify(bannedList)).run();
    }
    await sendMessage(token, chatId, `🚫 کاربر <code>${targetUserId}</code> با موفقیت در لیست سیاه کل ربات قرار گرفت.`);
    return;
  }

  if (subCmd === 'unbanuser' && parts[2]) {
    const targetUserId = parseInt(parts[2], 10);
    const banSetting = await db.prepare(`SELECT value FROM bot_settings WHERE key = 'banned_users'`).first();
    const bannedList = safeJsonArray(banSetting?.value);
    bannedList = bannedList.filter(id => id !== targetUserId);
    await db.prepare(`INSERT INTO bot_settings (key, value) VALUES ('banned_users', ?) ON CONFLICT(key) DO UPDATE SET value = excluded.value`).bind(JSON.stringify(bannedList)).run();
    await sendMessage(token, chatId, `✅ کاربر <code>${targetUserId}</code> از لیست سیاه خارج شد.`);
    return;
  }

  if (subCmd === 'banlist') {
    const banSetting = await db.prepare(`SELECT value FROM bot_settings WHERE key = 'banned_users'`).first();
    const bannedList = safeJsonArray(banSetting?.value);
    if (bannedList.length === 0) {
      await sendMessage(token, chatId, `📋 لیست سیاه کاربران خالی است.`);
    } else {
      await sendMessage(token, chatId, `🚫 <b>لیست کاربران مسدود شده (${bannedList.length} نفر):</b>\n` + bannedList.map(id => `• <code>${id}</code>`).join('\n'));
    }
    return;
  }

  const adminMsg = `👑 <b>پنل مدیریت ادمین کل ربات جُفت‌چین</b>\n\n⚙️ <b>حالت فعلی:</b> ${currentMode === 'public' ? 'عمومی (کارکرد در همه گروه‌ها)' : 'خصوصی (فقط گروه‌هایی که سازنده حضور دارد)'}\n\n<b>دستورات مدیریتی:</b>\n• <code>/admin public</code> : تغییر به حالت عمومی\n• <code>/admin private</code> : تغییر به حالت خصوصی\n• <code>/admin whitelist &lt;chat_id&gt;</code> : وایت‌لیست کردن یک گروه خاص\n• <code>/admin blacklist &lt;chat_id&gt;</code> : بلک‌لیست کردن یک گروه خاص\n• <code>/admin banuser &lt;user_id&gt;</code> : مسدودسازی کامل یک کاربر\n• <code>/admin unbanuser &lt;user_id&gt;</code> : رفع مسدودیت کاربر\n• <code>/admin banlist</code> : مشاهده لیست سیاه کاربران`;
  await sendMessage(token, chatId, adminMsg);
}
