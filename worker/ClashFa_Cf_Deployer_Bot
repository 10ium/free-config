// Resilient KV Namespace Creator (Handles Duplicate Titles Automatically)
async function createKVNamespace(token, accountId, title) {
  try {
    const res = await fetchWithTimeout(`https://api.cloudflare.com/client/v4/accounts/${accountId}/storage/kv/namespaces`, {
      method: "POST",
      headers: {
        "Authorization": `Bearer ${token}`,
        "Content-Type": "application/json"
      },
      body: JSON.stringify({ title })
    }, 20000);

    const data = await res.json();
    if (data.success && data.result && data.result.id) {
      return data.result.id;
    }

    const errMsg = (data.errors?.[0]?.message || "").toLowerCase();
    const errCode = data.errors?.[0]?.code;

    // Handle "a namespace with this account ID and title already exists"
    if (errMsg.includes("already exists") || errCode === 10014) {
      const listRes = await fetchWithTimeout(`https://api.cloudflare.com/client/v4/accounts/${accountId}/storage/kv/namespaces?per_page=100`, {
        headers: { "Authorization": `Bearer ${token}` }
      }, 20000);
      const listData = await listRes.json();
      if (listData.success && Array.isArray(listData.result)) {
        const found = listData.result.find(ns => ns.title === title);
        if (found && found.id) {
          return found.id;
        }
      }

      // If not matched directly, create with unique random suffix
      const altTitle = `${title.substring(0, 50)}-${generateRandomString(CharsetAlphaNumeric, 4)}`;
      const altRes = await fetchWithTimeout(`https://api.cloudflare.com/client/v4/accounts/${accountId}/storage/kv/namespaces`, {
        method: "POST",
        headers: {
          "Authorization": `Bearer ${token}`,
          "Content-Type": "application/json"
        },
        body: JSON.stringify({ title: altTitle })
      }, 20000);
      const altData = await altRes.json();
      if (altData.success && altData.result?.id) {
        return altData.result.id;
      }
    }

    throw new Error(data.errors?.[0]?.message || "Failed to create KV Namespace.");
  } catch (err) {
    throw err;
  }
}

