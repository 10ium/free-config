// --- HELPER UTILITIES ---
function generateRandomString(charset, length) {
  let result = "";
  for (let i = 0; i < length; i++) {
    result += charset.charAt(Math.floor(Math.random() * charset.length));
  }
  return result;
}

function deriveFallbackSubdomain(accountName, accountId = "") {
  if (!accountName) return "";
  let clean = typeof accountName === "object" && accountName !== null ? (accountName.name || accountName.email || "") : String(accountName || "");
  const accId = typeof accountName === "object" && accountName !== null ? (accountName.id || accountId) : accountId;
  if (clean.includes("@")) {
    clean = clean.split("@")[0];
  } else if (clean.includes("'s Account")) {
    clean = clean.replace(/'s Account/gi, "");
  }
  let base = clean.toLowerCase().replace(/[^a-z0-9-]/g, "");
  if (!base && accId) {
    base = "cf-" + String(accId).replace(/[^a-z0-9]/gi, "").substring(0, 8);
  }
  if (base.length > 25) base = base.substring(0, 25);
  return base;
}

function getVarName(v) {
  if (!v) return "";
  return typeof v === "object" ? (v.name || "") : v.toString();
}

function getVarNames(vars) {
  if (!Array.isArray(vars)) return [];
  return vars.map(v => getVarName(v)).filter(Boolean);
}

function autoGenerateVars(varList, context = {}) {
  const generated = {};
  if (!Array.isArray(varList)) return generated;

  varList.forEach(rawVar => {
    const v = typeof rawVar === "object" ? (rawVar.name || "") : rawVar.toString();
    if (!v) return;

    // Preserve explicit non-empty user input
    if (context[v] !== undefined && context[v] !== null && context[v] !== "") {
      generated[v] = context[v];
      return;
    }
    if (v === "UUID" || v === "uuid") {
      const u = (context && (context.UUID || context.uuid)) || crypto.randomUUID();
      generated[v] = u;
    } else if (v === "TR_PASS" || v === "ADMIN_PASSWORD" || v === "ADMIN" || v === "pswd") {
      generated[v] = generateRandomString(CharsetTrojanPassword, 12);
    } else if (v === "SUB_PATH") {
      generated[v] = "/sub/" + generateRandomString(CharsetURIPath, 16);
    } else if (v === "PROXY_IP" || v === "PROXYIP" || v === "proxyip") {
      generated[v] = "speed.cloudflare.com";
    } else if (v === "PREFIX") {
      generated[v] = "BPB";
    } else if (v === "FALLBACK") {
      generated[v] = "speed.cloudflare.com";
    } else if (v === "PASSWORD") {
      generated[v] = generateRandomString(CharsetAlphaNumeric, 12);
    } else if (v === "KEY") {
      generated[v] = generateRandomString(CharsetAlphaNumeric, 32);
    } else if (v === "SOCKS5") {
      generated[v] = "";
    } else if (v.startsWith("D1_ID_")) {
      generated[v] = "auto";
    } else if (v === "AES_KEY") {
      const array = new Uint8Array(16);
      crypto.getRandomValues(array);
      generated[v] = Array.from(array, b => b.toString(16).padStart(2, '0')).join('');
    } else if (v === "WEBHOOK_SECRET") {
      generated[v] = generateRandomString(CharsetAlphaNumeric, 32);
    } else if (v === "SECRET_SALT") {
      generated[v] = generateRandomString(CharsetAlphaNumeric, 32);
    } else if (v === "BOT_TOKEN") {
      generated[v] = context.BOT_TOKEN || "";
    } else if (v === "BOT_USERNAME") {
      generated[v] = context.BOT_USERNAME || "facelesscahtbot";
    } else if (v === "ADMIN_IDS" || v === "ADMIN_ID") {
      generated[v] = context.chatId ? context.chatId.toString() : "";
    } else if (typeof rawVar === "object" && rawVar.defaultValue !== undefined) {
      generated[v] = rawVar.defaultValue;
    } else {
      generated[v] = generateRandomString(CharsetAlphaNumeric, 12);
    }
  });
  return generated;
}

