function isRateLimited(key, limitMs = 2000) {
  const now = Date.now();
  if (cooldowns.has(key)) {
    const last = cooldowns.get(key);
    if (now - last < limitMs) return true;
  }
  cooldowns.set(key, now);
  return false;
}

