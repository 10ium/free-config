    }

    session.state = "IDLE";
    session.deployPayload = {};
    session.history = [];
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(session));

    await logEvent(env, `استقرار موفق پروژه ${name} بر روی اکانت ${account.name}`, "info");

    const successMsg = `🎉 <b>استقرار با موفقیت کامل انجام شد!</b>\n\n` +
      `🏷 <b>نام پروژه:</b> <code>${escapeHTML(name)}</code>\n` +
      `👤 <b>حساب کلادفلر:</b> <code>${escapeHTML(account.name)}</code>\n` +
      `🌐 <b>آدرس نهایی ورکر:</b>\n` +
      `<a href="${finalUrl}">${finalUrl}</a>` +
      `${varsMsg}${postDeployNotice}\n\n` +
      `✅ تمام دیتابیس‌ها و متغیرهای لازم ساخته و بایند شدند.`;

    return sendMessage(chatId, successMsg, env);

  } catch (err) {
    session.state = "IDLE";
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(session));
    await logEvent(env, `خطای استقرار در پروژه ${name}: ${err.message}`, "error");
