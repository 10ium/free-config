// --- TELEGRAM DEPLOYMENT EXECUTOR ---
async function executeTelegramDeployment(chatId, session, env) {
  const { account, name, templateIdx, templateUrl, isLegacy, kvBindings, vars, type, autoGenTemplate } = session.deployPayload;

  await sendMessage(chatId, "⚡ در حال خواندن سورس کد قالب...", env);
  let sourceCode = "";
  try {
    if (templateIdx === "custom") {
      sourceCode = await getPresetCode(null, env, templateUrl);
    } else {
      const preset = PRESETS[templateIdx];
      sourceCode = await getPresetCode(preset, env);
    }
  } catch (err) {
    session.state = "IDLE";
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(session));
    return sendMessage(chatId, `❌ خطا در دریافت سورس کد:\n<code>${err.message}</code>`, env);
  }

  sourceCode += `\n\n/* Signed: ${generateRandomString(CharsetAlphaNumeric, 24)} */`;

  await sendMessage(chatId, "🛠️ در حال ساخت دیتابیس‌ها و تنظیم منابع اختصاصی شما...", env);
  try {
    const activeBindings = [];

    // Process presets' default KVs
    if (kvBindings && kvBindings.length > 0) {
      for (const kvName of kvBindings) {
        await sendMessage(chatId, `📦 در حال ایجاد دیتابیس KV با نام <code>${kvName}</code>...`, env);
        const kvNamespaceId = await createKVNamespace(account.token, account.id, `${name}-${kvName}`);
        if (kvNamespaceId) {
          activeBindings.push({ name: kvName, namespace_id: kvNamespaceId, type: "kv_namespace" });
        }
      }
    }

    // Process presets' variables & DB mappings
    let finalVars = { ...vars };
    if (autoGenTemplate && templateIdx !== "custom") {
      const preset = PRESETS[templateIdx];
      finalVars = autoGenerateVars(preset.vars, vars);
    }

    if (finalVars) {
      for (let [key, val] of Object.entries(finalVars)) {
        if (key.startsWith("D1_ID_")) {
          const bindingName = key.replace("D1_ID_", "");
          let dbId = val;
          if (dbId === "auto" || !dbId) {
            await sendMessage(chatId, `🗄 در حال ایجاد فیزیکی دیتابیس D1 با نام <code>${bindingName}</code>...`, env);
            const sanitizedDbName = `${name}-${bindingName}`.toLowerCase().replace(/[^a-z0-9_-]/g, "-");
            dbId = await createD1Database(account.token, account.id, sanitizedDbName);
            finalVars[key] = dbId; // Update final variables with the real database ID!
          }
          activeBindings.push({ name: bindingName, database_id: dbId, type: "d1" });
        } else {
          activeBindings.push({ name: key, text: val, type: "plain_text" });
        }
      }
    }

    // Process Custom resources queue
    if (session.deployPayload.resourceQueue) {
      for (const item of session.deployPayload.resourceQueue) {
        if (item.type === "kv") {
          if (item.id === "auto" || !item.id) {
            await sendMessage(chatId, `📦 در حال ایجاد دیتابیس KV با نام <code>${item.name}</code>...`, env);
            const kvId = await createKVNamespace(account.token, account.id, `${name}-${item.name}`);
            activeBindings.push({ name: item.name, namespace_id: kvId, type: "kv_namespace" });
          } else {
            activeBindings.push({ name: item.name, namespace_id: item.id, type: "kv_namespace" });
          }
        } else if (item.type === "d1") {
          let dbId = item.id;
          if (dbId === "auto" || !dbId) {
            await sendMessage(chatId, `🗄 در حال ایجاد فیزیکی دیتابیس D1 با نام <code>${item.name}</code>...`, env);
            const sanitizedDbName = `${name}-${item.name}`.toLowerCase().replace(/[^a-z0-9_-]/g, "-");
            dbId = await createD1Database(account.token, account.id, sanitizedDbName);
            item.id = dbId;
          }
          activeBindings.push({ name: item.name, database_id: dbId, type: "d1" });
        } else if (item.type === "var") {
          activeBindings.push({ name: item.name, text: item.val, type: "plain_text" });
        }
      }
    }

    if (type === "worker") {
      await sendMessage(chatId, "🚀 در حال آپلود و پیاده‌سازی ورکر شما بر روی شبکه لبه کلادفلر...", env);
      await deployWorkerScript(account.token, account.id, name, sourceCode, activeBindings);
      await enableWorkerSubdomain(account.token, account.id, name);

      let sub = await getWorkerSubdomain(account.token, account.id, env, account.name);
      sub = sub ? sub.trim().replace(/^\.+|\.+$/g, "") : "";

      // Dynamic path suffix resolution
      let pathSuffix = "";
      if (templateIdx !== "custom") {
        const preset = PRESETS[templateIdx];
        if (preset.id === "nahan") {
          pathSuffix = "/sync/dash";
        } else if (preset.id === "edgetunnel") {
          pathSuffix = "/admin";
        } else if (isLegacy) {
          pathSuffix = "/panel";
        }
      }
      
      const panelURL = sub ? `https://${name}.${sub}.workers.dev${pathSuffix}` : `https://${name}.workers.dev${pathSuffix}`;

      session.state = "IDLE";
      session.history = [];
      await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(session));

      // Build precise success variable list output
      let varsMsg = "";
      if (finalVars && Object.keys(finalVars).length > 0) {
        varsMsg += "\n\n🔑 <b>مشخصات و متغیرهای ثبت‌شده:</b>\n";
        for (const [k, v] of Object.entries(finalVars)) {
          const displayKey = k.startsWith("D1_ID_") ? k.replace("D1_ID_", "D1_DATABASE_") : k;
          varsMsg += `🔸 <code>${displayKey}</code>: <code>${v}</code>\n`;
        }
      }

      if (session.deployPayload.resourceQueue && session.deployPayload.resourceQueue.length > 0) {
        varsMsg += "\n\n📦 <b>منابع متصل شده سفارشی:</b>\n";
        for (const item of session.deployPayload.resourceQueue) {
          if (item.type === "kv") {
            varsMsg += `🔸 دیتابیس [KV] با متغیر: <code>${item.name}</code>\n`;
          } else if (item.type === "d1") {
            varsMsg += `🔸 دیتابیس [D1] با متغیر: <code>${item.name}</code> (شناسه: <code>${item.id}</code>)\n`;
          } else if (item.type === "var") {
            varsMsg += `🔸 متغیر [Plain] با نام <code>${item.name}</code>: <code>${item.val}</code>\n`;
          }
        }
      }

      await logEvent(env, `پروژه ورکر (${name}) با موفقیت دپلو شد. ساب‌دومین نهایی: ${sub}`, "info");
      return sendMessage(chatId, `🎉 <b>ورکر با موفقیت فعال شد!</b>\n\n🔗 لینک دسترسی:\n<code>${panelURL}</code>${varsMsg}`, env);
    } else {
      await sendMessage(chatId, "🚀 در حال ایجاد و بارگذاری صفحات پروژه (Pages)...", env);
      const project = await createPagesProject(account.token, account.id, name, activeBindings);
      await deployPagesAsset(account.token, account.id, name, sourceCode);

      const pagesHost = project && project.subdomain ? project.subdomain : `${name}.pages.dev`;

      session.state = "IDLE";
      session.history = [];
      await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(session));

      let varsMsg = "";
      if (finalVars && Object.keys(finalVars).length > 0) {
        varsMsg += "\n\n🔑 <b>مشخصات و متغیرهای ثبت‌شده:</b>\n";
        for (const [k, v] of Object.entries(finalVars)) {
          const displayKey = k.startsWith("D1_ID_") ? k.replace("D1_ID_", "D1_DATABASE_") : k;
          varsMsg += `🔸 <code>${displayKey}</code>: <code>${v}</code>\n`;
        }
      }

      await logEvent(env, `پروژه Pages (${name}) با موفقیت دپلو شد.`, "info");
      return sendMessage(chatId, `🎉 <b>صفحه (Pages) با موفقیت دپلو شد!</b>\n\n🔗 لینک دسترسی:\n<code>https://${pagesHost}${isLegacy ? "/panel" : ""}/</code>${varsMsg}`, env);
    }
  } catch (err) {
    session.state = "IDLE";
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(session));
    await logEvent(env, `خطا در اجرای دپلو در تلگرام: ${err.message}`, "error");
    return sendMessage(chatId, `❌ خطای فرآیند دپلو کلادفلر:\n<code>${err.message}</code>`, env);
  }
}

// --- CLOUDFLARE D1 DATABASE CREATION ENGINE ---
async function createD1Database(token, accountId, name) {
  const res = await fetch(`https://api.cloudflare.com/client/v4/accounts/${accountId}/d1/database`, {
    method: "POST",
    headers: {
      "Authorization": `Bearer ${token}`,
      "Content-Type": "application/json",
      "User-Agent": "ClashFa-Deployer-Bot"
    },
    body: JSON.stringify({ name })
  });
  const data = await res.json();
  if (!data.success) {
    throw new Error(data.errors?.[0]?.message || "Failed to create D1 Database.");
  }
  return data.result.uuid; // Return the valid UUIDv4 of the newly created database
}

