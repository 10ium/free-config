async function getWorkerSubdomain(token, accountId, env, accountName = "") {
  if (env && env.BOT_KV) {
    const cached = await env.BOT_KV.get(`subdomain:${accountId}`);
    if (cached) return cached;
  }

  try {
    const res = await fetch(`https://api.cloudflare.com/client/v4/accounts/${accountId}/workers/subdomains`, {
      headers: { 
        "Authorization": `Bearer ${token}`,
        "User-Agent": "ClashFa-Deployer-Bot"
      }
    });
    const data = await res.json();
    if (data.success && data.result && data.result.subdomain) {
      const sub = data.result.subdomain.trim();
      if (env && env.BOT_KV) {
        await env.BOT_KV.put(`subdomain:${accountId}`, sub);
      }
      return sub;
    }
  } catch (err) {
    if (env) await logEvent(env, `خطا در دریافت ساب‌دومین: ${err.message}`, "error");
  }

  // Robust parsing as requested
  if (accountName) {
    const fallbackSub = deriveFallbackSubdomain(accountName);
    if (env && env.BOT_KV && fallbackSub) {
      await env.BOT_KV.put(`subdomain:${accountId}`, fallbackSub);
    }
    return fallbackSub;
  }
  return "";
}

