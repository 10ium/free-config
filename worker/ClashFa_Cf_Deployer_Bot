async function updateWorkerBindings(token, accountId, scriptName, bindings) {
  const cleanedBindings = (bindings || []).map(b => {
    if (b.type === "kv_namespace") {
      return { name: b.name, type: "kv_namespace", namespace_id: b.namespace_id };
    } else if (b.type === "d1") {
      return { name: b.name, type: "d1", database_id: b.database_id };
    } else if (b.type === "plain_text") {
      return { name: b.name, type: "plain_text", text: b.text || "" };
    } else if (b.type === "secret_text") {
      return b.text ? { name: b.name, type: "secret_text", text: b.text } : null;
    }
    return b;
  }).filter(Boolean);

  const res = await fetchWithTimeout(`https://api.cloudflare.com/client/v4/accounts/${accountId}/workers/scripts/${scriptName}/settings`, {
    method: "PATCH",
    headers: {
      "Authorization": `Bearer ${token}`,
      "Content-Type": "application/json"
    },
    body: JSON.stringify({ bindings: cleanedBindings })
  }, 15000);
  const data = await res.json();
  if (!data.success) {
    throw new Error(data.errors?.[0]?.message || "Failed to update bindings.");
  }
  return data.success;
}

