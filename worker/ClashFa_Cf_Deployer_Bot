// Code Cache & Preset Fetcher
async function getPresetCode(preset, env = null, customUrl = null) {
  const url = preset ? preset.url : customUrl;
  if (!url) throw new Error("آدرس سورس‌کد تعریف نشده است.");

  const cacheKey = `cache:code:${preset ? preset.id : "custom_" + Math.abs(hashCode(url))}`;
  if (env && env.BOT_KV && preset) {
    const cached = await env.BOT_KV.get(cacheKey);
    if (cached) return cached;
  }

  let res;
  try {
    res = await fetchWithTimeout(url, {
      headers: { "User-Agent": "ClashFa-Deployer-Bot" }
    }, 25000);
  } catch (err) {
    res = { ok: false, status: 0, statusText: err.message };
  }

  if (!res || !res.ok) {
    if (preset && preset.fallbackUrl) {
      try {
        res = await fetchWithTimeout(preset.fallbackUrl, {
          headers: { "User-Agent": "ClashFa-Deployer-Bot" }
        }, 25000);
      } catch (_) {}
    }
  }

  if (!res || !res.ok) {
    throw new Error(`خطا در دانلود سورس‌کد (${res?.status || 0} ${res?.statusText || "Connection Error"})`);
  }

  let code = await res.text();
  if (!code || code.trim().length === 0) {
    throw new Error("سورس‌کد دریافتی خالی است.");
  }

  // Ensure Service Worker format has registered event listeners
  if (!isESModule(code) && !code.includes("addEventListener") && code.includes("handleFetch")) {
    code += `\n\n// Auto-appended Cloudflare Workers event listeners\nif (typeof addEventListener !== "undefined") {\n  addEventListener("fetch", event => event.respondWith(handleFetch(event.request, event)));\n  if (typeof handleScheduled !== "undefined") {\n    addEventListener("scheduled", event => event.waitUntil(handleScheduled(event)));\n  }\n}\n`;
  }

  if (env && env.BOT_KV && preset) {
    // Cache for 6 hours
    await env.BOT_KV.put(cacheKey, code, { expirationTtl: 21600 });
  }

  return code;
}

async function cacheAllPresets(env) {
  if (!env || !env.BOT_KV) return;
  for (const p of PRESETS) {
    try {
      await getPresetCode(p, env);
