}

// منوی کامل پروفایل در پیوی
async function showBlockShipMenu(chatId, user, token, db, editMessageId = null) {
  const blocks = await db.prepare(`SELECT blocked_user_id FROM user_ship_blocks WHERE user_id = ?`).bind(user.id).all();
  const list = blocks.results || [];

  let text = `🚫 <b>لیست سیاه شیپ و مدیریت افراد:</b>\n\n` +
    `افرادی که با <code>/blockship</code>، این منو یا ری‌اکشن منفی (👎 / 💔) رد کرده‌اید در اینجا قرار دارند و با شما شیپ نمی‌شوند.\n\n`;

  const inlineKeyboard = [];

  if (list.length === 0) {
    text += `<i>در حال حاضر هیچ کاربری در لیست مسدودی شما قرار ندارد.</i>\n`;
  } else {
    text += `📋 <b>تعداد افراد مسدود: ${list.length} نفر</b>\nبرای <b>حذف هر شخص و بازگشت امکان شیپ دوباره</b>، روی دکمه کنار نامش بزنید:\n\n`;

    const maxShow = Math.min(list.length, 40);
    for (let i = 0; i < maxShow; i++) {
      const bId = list[i].blocked_user_id;
      const mem = await db.prepare(`SELECT first_name, username FROM group_members WHERE user_id = ? LIMIT 1`).bind(bId).first();
      const prof = mem || await db.prepare(`SELECT first_name, username FROM user_profiles WHERE user_id = ? LIMIT 1`).bind(bId).first();
      const rawName = prof?.first_name || (prof?.username ? `@${prof.username}` : `کاربر ${bId}`);
      const shortName = rawName.length > 14 ? rawName.slice(0, 12) + '…' : rawName;
      inlineKeyboard.push([
        { text: `❌ حذف ${shortName} (شیپ دوباره)`, callback_data: `unblock_ship_${bId}` }
      ]);
    }
    if (list.length > maxShow) {
      text += `<i>(برای مشاهده یا آزادسازی نفرات بیشتر، از «🔍 بررسی و تایید وضعیت یک فرد» استفاده کنید.)</i>\n\n`;
    }

    inlineKeyboard.push([
      { text: '🗑️ پاک‌سازی کامل لیست', callback_data: 'clear_all_blocks' }
    ]);
  }

  inlineKeyboard.push([
    { text: '🔍 بررسی و تایید وضعیت یک فرد', callback_data: 'manage_ship_target' }
  ]);
  inlineKeyboard.push([
    { text: '➕ افزودن مسدودی جدید', callback_data: 'add_block_ship' }
  ]);
  inlineKeyboard.push([
    { text: '🔙 بازگشت به منو', callback_data: 'main_menu' }
  ]);

  if (editMessageId) {
    await editMessageText(token, chatId, editMessageId, text, { reply_markup: { inline_keyboard: inlineKeyboard } });
  } else {
    await sendMessage(token, chatId, text, { reply_markup: { inline_keyboard: inlineKeyboard } });
  }
}

async function showUserProfileMenu(chatId, user, token, db) {
  let profile = await db.prepare(`SELECT * FROM user_profiles WHERE user_id = ?`).bind(user.id).first();
  if (!profile) {
    await db.prepare(`INSERT INTO user_profiles (user_id, first_name, username) VALUES (?, ?, ?)`).bind(user.id, user.first_name || '', user.username || null).run();
    profile = await db.prepare(`SELECT * FROM user_profiles WHERE user_id = ?`).bind(user.id).first();
  }

  const shamsi = getShamsiDetails();
  let birthYearStr = 'تنظیم‌نشده';
  let ageStr = 'تنظیم‌نشده';
  let bdayStr = '';

  if (profile.birth_year) {
    const age = calculateExactAge(profile.birth_year, profile.birth_month, profile.birth_day);
    birthYearStr = `${profile.birth_year} شمسی`;
    ageStr = `${age} ساله`;
    if (profile.birth_month && profile.birth_day) {
