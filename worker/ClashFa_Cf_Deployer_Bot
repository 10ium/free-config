// --- PAGINATED TEMPLATE SELECTION ---
async function sendTemplateSelection(chatId, env, type, category, page = 0) {
  const isAdm = await checkIsAdmin(chatId, env);
  const disabledPresets = await getDisabledPresets(env);

  const matching = [];
  PRESETS.forEach((preset, index) => {
    if (preset.category === category) {
      const isOff = disabledPresets.includes(preset.id);
      if (isAdm) {
        matching.push({ preset, index, isOff });
      } else if (!isOff) {
        matching.push({ preset, index, isOff: false });
      }
    }
  });

  const pageSize = 5;
  const totalPages = Math.ceil(matching.length / pageSize) || 1;
  const currentPage = Math.max(0, Math.min(page, totalPages - 1));

  const pageItems = matching.slice(currentPage * pageSize, (currentPage + 1) * pageSize);

  const keyboard = [];
  pageItems.forEach(({ preset, index, isOff }) => {
    const label = isOff ? `❌ ${preset.name} (مخفی)` : preset.name;
    keyboard.push([{ text: label, callback_data: `tpl_idx_${index}` }]);
  });

  // Pagination navigation row if more than 1 page
  if (totalPages > 1) {
    const navRow = [];
    if (currentPage > 0) {
      navRow.push({ text: "⬅️ قبلی", callback_data: `tpl_page_${category}_${currentPage - 1}` });
    }
    navRow.push({ text: `📄 ${currentPage + 1} از ${totalPages}`, callback_data: "noop" });
    if (currentPage < totalPages - 1) {
      navRow.push({ text: "بعدی ➡️", callback_data: `tpl_page_${category}_${currentPage + 1}` });
    }
    keyboard.push(navRow);
  }

  // Only Admin sees the refresh presets cache button
  if (isAdm) {
    keyboard.push([{ text: "🔄 بروزرسانی کش قالب‌ها", callback_data: "refresh_presets_cache" }]);
  }
  keyboard.push(getNavKeyboardRow());

  const catNames = {
    clashfa: "کلش‌فا 🚀",
    tgproxy: "پروکسی تلگرام ✈️",
    dns: "دی‌ان‌اس 🌐",
    config: "کانفیگ و پروکسی 🛰️"
  };

  const currentCatName = catNames[category] || "پروژه‌ها";

  return sendMessage(chatId, `📋 <b>قالب‌های دسته‌بندی ${currentCatName}:</b>\n\nقالب مورد نظر را جهت شروع فرآیند استقرار لمس کنید:`, env, false, keyboard);
}

