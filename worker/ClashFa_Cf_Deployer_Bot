    [{ text: `🎲 تولید خودکار ${varName}`, callback_data: `auto_gen_var_${varName}` }],
    getNavKeyboardRow()
  ];
  let promptText = `✍️ لطفاً مقدار متغیر محیطی <code>${varName}</code> را وارد کنید:`;
