async function checkMutualCoupleCelebration(couple, chatId, token, db) {
  if (couple.celebration_sent === 1) return;

  const isTriad = Boolean(couple.user3_id);
  let mutualReady = false;

  if (isTriad) {
    const rx = await db.prepare(`
      SELECT DISTINCT user_id FROM couple_reactions 
      WHERE chat_id = ? AND message_id = ? AND user_id IN (?, ?, ?) AND reaction_val = 1
    `).bind(chatId, couple.message_id, couple.user1_id, couple.user2_id, couple.user3_id).all();
    if ((rx.results || []).length >= 3) mutualReady = true;
  } else {
    const rx = await db.prepare(`
      SELECT DISTINCT user_id FROM couple_reactions 
      WHERE chat_id = ? AND message_id = ? AND user_id IN (?, ?) AND reaction_val = 1
    `).bind(chatId, couple.message_id, couple.user1_id, couple.user2_id).all();
    if ((rx.results || []).length >= 2) mutualReady = true;
  }

  if (!mutualReady) return;

  const updateRes = await db.prepare(`
    UPDATE daily_couples SET celebration_sent = 1 WHERE id = ? AND celebration_sent = 0
  `).bind(couple.id).run();

  const changes = updateRes?.meta?.changes ?? updateRes?.changes ?? 1;
  if (changes === 0) return;

  const u1 = await db.prepare(`SELECT * FROM user_profiles WHERE user_id = ?`).bind(couple.user1_id).first();
  const u2 = await db.prepare(`SELECT * FROM user_profiles WHERE user_id = ?`).bind(couple.user2_id).first();

  const m1Info = await db.prepare(`SELECT first_name, username FROM group_members WHERE user_id = ? AND chat_id = ? LIMIT 1`).bind(couple.user1_id, chatId).first();
  const m2Info = await db.prepare(`SELECT first_name, username FROM group_members WHERE user_id = ? AND chat_id = ? LIMIT 1`).bind(couple.user2_id, chatId).first();

  const m1 = userMention(couple.user1_id, m1Info?.first_name || 'کاربر اول', m1Info?.username);
  const m2 = userMention(couple.user2_id, m2Info?.first_name || 'کاربر دوم', m2Info?.username);

  let category = 'empty_profile';

  if (isTriad) {
    category = 'polyamory_triad';
  } else {
    const g1 = safeJsonArrayOrItem(u1?.relationship_goal);
    const g2 = safeJsonArrayOrItem(u2?.relationship_goal);
    const mutualGoals = g1.filter(g => g2.includes(g));

    if (mutualGoals.includes('ازدواج و تشکیل خانواده')) {
      category = 'marriage';
    } else if (mutualGoals.includes('ازدواج سفید')) {
      category = 'white_marriage';
    } else if (mutualGoals.includes('رابطه عاطفی جدی و پایدار')) {
      category = 'serious_relationship';
    } else if (mutualGoals.some(g => g.includes('تفریح') || g.includes('سرگرمی') || g.includes('معمولی') || g.includes('دیت'))) {
      category = 'fun_casual';
    } else if ((u1?.relationship_structure || '').includes('چندعشقی') || (u1?.relationship_structure || '').includes('باز') || (u2?.relationship_structure || '').includes('چندعشقی') || (u2?.relationship_structure || '').includes('باز')) {
      category = 'polyamory';
    } else if (couple.reason && couple.reason.includes('مکمل')) {
      category = 'bdsm_roles';
    } else if (u1?.city_lat && u2?.city_lat) {
      const dist = calculateDistanceKm(u1.city_lat, u1.city_lon, u2.city_lat, u2.city_lon);
      if (dist <= 50 || (u1.city && u1.city === u2.city)) {
        category = 'same_city';
      } else if (dist >= 250) {
        category = 'long_distance';
      }
    } else if (u1?.birth_year && u2?.birth_year && Math.abs(u1.birth_year - u2.birth_year) <= 2) {
      category = 'same_age';
    } else {
      category = 'empty_profile';
    }
  }

  const list = CELEBRATION_MESSAGES[category] || CELEBRATION_MESSAGES.empty_profile;
  const template = list[Math.floor(Math.random() * list.length)];

  let text = template.replace(/{user1}/g, m1).replace(/{user2}/g, m2);
  if (isTriad) {
    const m3Info = await db.prepare(`SELECT first_name, username FROM group_members WHERE user_id = ? AND chat_id = ? LIMIT 1`).bind(couple.user3_id, chatId).first();
    const m3 = userMention(couple.user3_id, m3Info?.first_name || 'کاربر سوم', m3Info?.username);
    text = text.replace(/{user3}/g, m3);
  }

  const threadId = (couple.topic_id && couple.topic_id > 0) ? couple.topic_id : undefined;
  await sendMessage(token, chatId, text, { 
    message_thread_id: threadId,
    reply_to_message_id: couple.message_id
  });
}

async function handleReactionCount(countUpdate, token, db) {
  const chatId = countUpdate.chat.id;
  const messageId = countUpdate.message_id;

  const couple = await db.prepare(`SELECT * FROM daily_couples WHERE chat_id = ? AND message_id = ?`).bind(chatId, messageId).first();
  if (!couple) return;

  let posCount = 0;
  let negCount = 0;

  for (const r of (countUpdate.reactions || [])) {
    const emoji = r.type?.emoji || (typeof r.type === 'string' ? r.type : '');
    const count = r.total_count || 0;
    if (isPositiveReaction(emoji)) posCount += count;
    if (isNegativeReaction(emoji)) negCount += count;
  }

  const netScore = posCount - negCount;
  if (netScore <= -5) {
    await triggerCommunityRecharge(couple, chatId, posCount, negCount, token, db);
  }
}

async function checkCommunityDissatisfaction(couple, chatId, token, db) {
  const stats = await db.prepare(`
    SELECT 
      SUM(CASE WHEN reaction_val = 1 THEN 1 ELSE 0 END) as pos_count,
      SUM(CASE WHEN reaction_val = -1 THEN 1 ELSE 0 END) as neg_count,
      SUM(reaction_val) as net_score
    FROM couple_reactions
    WHERE chat_id = ? AND message_id = ?
  `).bind(chatId, couple.message_id).first();

  const posCount = stats?.pos_count || 0;
  const negCount = stats?.neg_count || 0;
  const netScore = stats?.net_score || 0;

  if (netScore <= -5) {
    await triggerCommunityRecharge(couple, chatId, posCount, negCount, token, db);
  }
}

async function triggerCommunityRecharge(couple, chatId, posCount, negCount, token, db) {
  const tehran = getTehranDate();

  // شارژ جمعی فقط روی شیپ فعالِ همان روز (نه پیام‌های قدیمی یا جایگزین‌شده) اعمال می‌شود
  if (couple.ship_date !== tehran.dateStr || couple.reroll_count !== 0 || couple.community_recharge_used === 1) {
    return;
  }

  // بررسی اینکه آیا این گروه امروز قبلاً از شارژ مجدد ناشی از رای منفی استفاده کرده است یا خیر
  const usedCheck = await db.prepare(`
    SELECT COUNT(*) as count 
    FROM daily_couples 
    WHERE chat_id = ? AND ship_date = ? AND community_recharge_used = 1
  `).bind(chatId, tehran.dateStr).first();

  if (usedCheck?.count > 0) {
    return; // فقط یک‌بار در روز شارژ می‌شود
  }

  // ثبت اتمیک شارژ روزانه و آزاد کردن قفل شیپ امروز (جلوگیری از ارسال پیام تکراری در هم‌زمانی)
  const upRes = await db.prepare(`
    UPDATE daily_couples 
    SET community_recharge_used = 1, reroll_count = 1 
    WHERE id = ? AND reroll_count = 0 AND community_recharge_used = 0
  `).bind(couple.id).run();

  const changes = upRes?.meta?.changes ?? upRes?.changes ?? 0;
  if (changes === 0) {
    return;
  }

  const msg = `📉 <b>نارضایتی اعضای گروه از زوج منتخب!</b>\n\n` +
    `تفاضل ری‌اکشن‌ها به <b>۵-</b> رسید (نارضایتی: <b>${negCount}</b> 💔 در برابر رضایت: <b>${posCount}</b> 👍).\n\n` +
    `🎁 <b>۱ فرصت شیپ مجدد برای امروز گروه شارژ شد!</b> 🎲\n\n` +
    `👉 هم‌اکنون هر یک از اعضا می‌تواند با ارسال دستور <code>/shipping</code> زوج جدید امروز گروه را انتخاب کند!\n` +
    `<i>(توجه: شارژ مجدد ناشی از رای منفی فقط ۱ بار در شبانه‌روز فعال می‌شود)</i>`;

  await sendMessage(token, chatId, msg, { message_thread_id: (couple.topic_id && couple.topic_id > 0) ? couple.topic_id : undefined });
}

async function handleGroupBlockShip(chatId, threadId, msg, token, db) {
  const fromId = msg.from.id;
  let targetId = null;
  let targetName = 'کاربر';

  if (msg.reply_to_message?.from && !isSystemOrAnonymousSender(msg.reply_to_message.from)) {
    targetId = msg.reply_to_message.from.id;
    targetName = msg.reply_to_message.from.first_name || 'کاربر';
  } else if (msg.reply_to_message?.from?.is_bot && msg.reply_to_message?.message_id) {
    // اگر روی پیام معرفی زوج امروز از خود ربات ریپلای زده شده باشد، پارتنرِ همان شیپ را بلاک می‌کنیم
    const shipMsg = await db.prepare(`SELECT user1_id, user2_id, user3_id FROM daily_couples WHERE chat_id = ? AND message_id = ?`).bind(chatId, msg.reply_to_message.message_id).first();
    if (shipMsg && [shipMsg.user1_id, shipMsg.user2_id, shipMsg.user3_id].includes(fromId)) {
      const otherIds = [shipMsg.user1_id, shipMsg.user2_id, shipMsg.user3_id].filter(id => id && id !== fromId);
      for (const oid of otherIds) {
        await db.prepare(`INSERT OR IGNORE INTO user_ship_blocks (user_id, blocked_user_id) VALUES (?, ?)`).bind(fromId, oid).run();
      }
      await sendMessage(token, chatId, `🚫 پارتنر این شیپ برای همیشه در لیست مسدودی شما قرار گرفت.`, { message_thread_id: threadId });
      return;
    }
  }

  if (!targetId) {
    const parts = (msg.text || msg.caption || '').replace(/[\u200B-\u200F\u202A-\u202E\uFEFF]/g, '').trim().split(/\s+/);
    if (parts.length > 1) {
      const arg = parts[1].trim();
      if (/^\d{5,15}$/.test(arg)) {
        targetId = parseInt(arg, 10);
        const mem = await db.prepare(`SELECT first_name FROM group_members WHERE user_id = ? LIMIT 1`).bind(targetId).first();
        targetName = mem?.first_name || `کاربر ${targetId}`;
      } else {
        const cleanUname = arg.replace(/^@/, '');
        if (cleanUname) {
          const memLocal = await db.prepare(`SELECT user_id, first_name FROM group_members WHERE chat_id = ? AND username = ? COLLATE NOCASE LIMIT 1`).bind(chatId, cleanUname).first();
          const memAny = memLocal || await db.prepare(`SELECT user_id, first_name FROM group_members WHERE username = ? COLLATE NOCASE LIMIT 1`).bind(cleanUname).first();
          const prof = memAny || await db.prepare(`SELECT user_id, first_name FROM user_profiles WHERE username = ? COLLATE NOCASE LIMIT 1`).bind(cleanUname).first();
          if (prof) {
            targetId = prof.user_id;
            targetName = prof.first_name || `@${cleanUname}`;
          }
        }
      }
    }
  }

  if (!targetId || targetId === fromId) {
    await sendMessage(token, chatId, `⚠️ لطفاً روی پیام فرد مورد نظر ریپلای بزنید یا آیدی/یوزرنیم او را بعد از دستور بنویسید (مثلاً <code>/blockship @username</code>).`, { message_thread_id: threadId });
    return;
  }

  await db.prepare(`INSERT OR IGNORE INTO user_ship_blocks (user_id, blocked_user_id) VALUES (?, ?)`).bind(fromId, targetId).run();
  await sendMessage(token, chatId, `🚫 <b>${escapeHtml(targetName)}</b> با موفقیت در لیست مسدودی شیپینگ شما قرار گرفت.`, { message_thread_id: threadId });
}

