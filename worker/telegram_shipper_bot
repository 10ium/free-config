  const isGroup = msg.chat.type === 'group' || msg.chat.type === 'supergroup';
  const isPrivate = msg.chat.type === 'private';
  const fromUser = msg.from;
  const threadId = msg.message_thread_id;
  const text = (msg.text || '').trim();

  if (!fromUser || fromUser.is_bot) return;

  if (isGroup) {
    const memberKey = `${chatId}_${fromUser.id}`;

    // ۱. ثبت مشخصات گروه فقط یک‌بار در طول چرخه حیات ورکر (کاهش ۱۰۰٪ رایت‌های اضافه در گروه شلوغ)
    if (!knownGroups.has(chatId)) {
      knownGroups.add(chatId);
      await db.prepare(`
        INSERT INTO groups (chat_id, title, username, is_forum)
        VALUES (?, ?, ?, ?)
        ON CONFLICT(chat_id) DO UPDATE SET title = excluded.title, username = excluded.username, is_forum = excluded.is_forum;
      `).bind(chatId, msg.chat.title || '', msg.chat.username || null, !!msg.is_topic_message ? 1 : 0).run();
    }

    // ۲. حذف آنی کاربر در صورت لفت دادن یا اخراج از گروه
    if (msg.left_chat_member) {
      knownGroupMembers.delete(`${chatId}_${msg.left_chat_member.id}`);
      await db.prepare(`DELETE FROM group_members WHERE chat_id = ? AND user_id = ?`).bind(chatId, msg.left_chat_member.id).run();
      return; // پیام سیستمی خروج پردازش بیشتری نیاز ندارد
    }

    // ۳. ثبت اعضای جدیدی که تازه وارد گروه شده‌اند (سرویس جوین)
    if (msg.new_chat_members && Array.isArray(msg.new_chat_members)) {
      for (const newM of msg.new_chat_members) {
        if (!newM.is_bot) {
          knownGroupMembers.add(`${chatId}_${newM.id}`);
          await db.prepare(`
            INSERT INTO group_members (chat_id, user_id, first_name, username, last_active)
            VALUES (?, ?, ?, ?, CURRENT_TIMESTAMP)
            ON CONFLICT(chat_id, user_id) DO UPDATE SET first_name = excluded.first_name, username = excluded.username, last_active = CURRENT_TIMESTAMP;
          `).bind(chatId, newM.id, newM.first_name || '', newM.username || null).run();
        }
      }
      return; // پیام سیستمی ورود نیاز به پردازش چت ندارد
    }

    // ۴. ثبت فوق‌سریع چت‌کننده‌ها با معماری Zero-Overhead (اگر کاربر قبلاً در لیست بود، در کسری از میلی‌ثانیه رد می‌شود)
    if (!knownGroupMembers.has(memberKey)) {
      knownGroupMembers.add(memberKey);
      if (knownGroupMembers.size > 20000) {
        knownGroupMembers.clear();
        knownGroupMembers.add(memberKey);
      }
      await db.prepare(`
        INSERT INTO group_members (chat_id, user_id, first_name, username, last_active)
        VALUES (?, ?, ?, ?, CURRENT_TIMESTAMP)
        ON CONFLICT(chat_id, user_id) DO UPDATE SET first_name = excluded.first_name, username = excluded.username, last_active = CURRENT_TIMESTAMP;
      `).bind(chatId, fromUser.id, fromUser.first_name || '', fromUser.username || null).run();
    }

    // ۵. بررسی تبریک تولد: حداکثر یک‌بار در شبانه‌روز برای هر کاربر (بدون کوئری مداوم به دیتابیس)
    const tehran = getTehranDate();
    const bdayKey = `${tehran.dateStr}_${fromUser.id}`;
    if (!bdayCheckCache.has(bdayKey)) {
      bdayCheckCache.add(bdayKey);
      if (bdayCheckCache.size > 10000) bdayCheckCache.clear();
      await checkBirthdayGreeting(chatId, threadId, fromUser, token, db);
    }

    // ۶. امنیت و حریم خصوصی ۱۰۰٪ (نخوردن به محدودیت ورکر و عدم ذخیره متن چت)
    // اگر پیام دستور ربات نباشد، هیچ متنی خوانده یا ذخیره نمی‌شود و فوراً خارج می‌شویم!
    if (!text.startsWith('/')) {
      return;
    }
  }

  if (isGroup && text.startsWith('/')) {
    const cmd = text.split('@')[0].split(' ')[0].toLowerCase();

    const isForceArg = text.toLowerCase().includes('force') || text.includes('تازه');
    if (cmd === '/shipping' || cmd === '/ship' || cmd === '/couple' || cmd === '/forceship') {
      const isForce = (cmd === '/forceship' || isForceArg);
      await handleShippingCommand(chatId, threadId, fromUser, token, db, false, isForce);
      return;
    }



    if (cmd === '/noship') {
      const p = await db.prepare(`SELECT user_id FROM user_profiles WHERE user_id = ?`).bind(fromUser.id).first();
      if (!p) {
        await db.prepare(`INSERT INTO user_profiles (user_id, first_name, username, is_global_opted_out) VALUES (?, ?, ?, 1)`).bind(fromUser.id, fromUser.first_name || '', fromUser.username || null).run();
      } else {
        await db.prepare(`UPDATE user_profiles SET is_global_opted_out = 1 WHERE user_id = ?`).bind(fromUser.id).run();
      }
      await db.prepare(`UPDATE group_members SET is_opted_out = 1 WHERE user_id = ?`).bind(fromUser.id).run();
      await sendMessage(token, chatId, `❌ <b>${fromUser.first_name}</b> عزیز، حضور شما در گردونه شیپینگ در تمام گروه‌ها خاموش شد.`, { message_thread_id: threadId });
      return;
    }

    if (cmd === '/shipme') {
      const p = await db.prepare(`SELECT user_id FROM user_profiles WHERE user_id = ?`).bind(fromUser.id).first();
      if (!p) {
        await db.prepare(`INSERT INTO user_profiles (user_id, first_name, username, is_global_opted_out) VALUES (?, ?, ?, 0)`).bind(fromUser.id, fromUser.first_name || '', fromUser.username || null).run();
      } else {
        await db.prepare(`UPDATE user_profiles SET is_global_opted_out = 0 WHERE user_id = ?`).bind(fromUser.id).run();
      }
      await db.prepare(`UPDATE group_members SET is_opted_out = 0 WHERE user_id = ?`).bind(fromUser.id).run();
      await sendMessage(token, chatId, `✅ <b>${fromUser.first_name}</b> عزیز، حضور شما در گردونه شیپینگ در تمام گروه‌ها مجدداً فعال شد!`, { message_thread_id: threadId });
      return;
    }

    if (cmd === '/blockship') {
      await handleGroupBlockShip(chatId, threadId, msg, token, db);
      return;
    }

    if (cmd === '/shiphistory') {
      await showShipHistoryMenu(chatId, threadId, token);
      return;
    }

    if (cmd === '/promote') {
      await handleGroupPromote(chatId, threadId, msg, token, db);
      return;
    }

    if (cmd === '/help') {
      const helpMsg = `🏹 <b>راهنمای دستورات ربات جُفت‌چین در گروه:</b>\n\n` +
        `• <code>/shipping</code> : شلیک تیر کیوپید و معرفی زوج روز بر اساس الگوریتم هوشمند\n` +
        `• <code>/shiphistory</code> : مشاهده تاریخچه زوج‌های منتخب گروه در بازه‌های زمانی مختلف\n` +
        `• <code>/blockship</code> : با ریپلای روی پیام یک فرد، شیپ شدن با او را برای همیشه مسدود کنید\n` +
        `• <code>/noship</code> : خروج کامل از گردونه شیپینگ ربات (در تمام گروه‌ها)\n` +
        `• <code>/shipme</code> : فعال‌سازی مجدد شیپینگ ربات (در تمام گروه‌ها)\n` +
        `• <code>/promote</code> : ثبت این گروه در ویترین کشف گروه‌ها\n\n` +
        `💡 <i>برای تکمیل شناسنامه عشقی، ربات را در گفت‌وگوی خصوصی استارت کنید.</i>`;
      await sendMessage(token, chatId, helpMsg, { message_thread_id: threadId });
      return;
    }
  }

  if (isPrivate) {
    if (text.startsWith('/start') || text.startsWith('/profile')) {
      await showUserProfileMenu(chatId, fromUser, token, db);
      return;
    }

    if (text.startsWith('/status')) {
      await showUserStatus(chatId, fromUser.id, token, db);
      return;
    }

    if (text.startsWith('/myblocks')) {
      await showBlockShipMenu(chatId, fromUser, token, db);
      return;
    }

    if (text.startsWith('/explore')) {
      await showGroupDirectory(chatId, token, db);
      return;
    }

    if (text.startsWith('/help')) {
      const helpMsg = `🏹 <b>راهنمای جامع ربات جُفت‌چین (Cupid):</b>\n\n` +
        `• <code>/start</code> یا <code>/profile</code> : مشاهده شناسنامه عشقی و ویرایش تنظیمات\n` +
        `• <code>/status</code> : بررسی وضعیت شیپینگ امروز شما در تمام گروه‌ها\n` +
        `• <code>/myblocks</code> : مشاهده و مدیریت افرادی که مسدود کرده‌اید\n` +
        `• <code>/explore</code> : کشف گروه‌های فعال و دوستانه برای شیپینگ\n` +
        `• <code>/noship</code> : خاموش کردن حضور شما در تمام گروه‌ها\n` +
        `• <code>/shipme</code> : فعال‌سازی مجدد حضور شما در شیپینگ‌ها\n\n` +
        `🎯 <b>نحوه کارکرد:</b>\n` +
        `اطلاعات شما در پیوی کاملاً محرمانه ذخیره شده و فقط برای محاسبه دقیق درصد سازگاری (شهر، سن، اهداف، ساختار و مکمل‌های روحی) استفاده می‌شود!`;
      await sendMessage(token, chatId, helpMsg);
      return;
    }

    if (text.startsWith('/noship')) {
      const p = await db.prepare(`SELECT user_id FROM user_profiles WHERE user_id = ?`).bind(fromUser.id).first();
      if (!p) {
        await db.prepare(`INSERT INTO user_profiles (user_id, first_name, username, is_global_opted_out) VALUES (?, ?, ?, 1)`).bind(fromUser.id, fromUser.first_name || '', fromUser.username || null).run();
      } else {
        await db.prepare(`UPDATE user_profiles SET is_global_opted_out = 1 WHERE user_id = ?`).bind(fromUser.id).run();
      }
      await db.prepare(`UPDATE group_members SET is_opted_out = 1 WHERE user_id = ?`).bind(fromUser.id).run();
      await sendMessage(token, chatId, `⛔ <b>${fromUser.first_name}</b> عزیز، حضور شما در گردونه شیپینگ در تمام گروه‌ها خاموش شد.`);
      return;
    }

    if (text.startsWith('/setowner')) {
      const ownerSetting = await db.prepare(`SELECT value FROM bot_settings WHERE key = 'owner_id'`).first();
      let ownerId = parseInt(ownerSetting?.value || '0', 10);
      const parts = text.split(' ');
      const secret = parts[1];
      // امنیت کامل: تعیین مالک فقط با رمز عبور مدیر کل یا شناسه قفل‌شده در دیتابیس
      if (secret === 'cupid2026' || (ownerId === 0 && fromUser.id)) {
        await db.prepare(`UPDATE bot_settings SET value = ? WHERE key = 'owner_id'`).bind(fromUser.id.toString()).run();
        await sendMessage(token, chatId, `👑 <b>شما به عنوان مالک و ادمین کل ربات تایید و در دیتابیس قفل شدید!</b>\nشناسه شما: <code>${fromUser.id}</code>\n\nاز این پس فقط شناسه شما می‌تواند از دستورات اختصاصی مانند <code>/forceship</code> استفاده کند.`);
        return;
      } else {
        await sendMessage(token, chatId, `⛔ دسترسی غیرمجاز. مالک ربات در سیستم قفل شده است.`);
        return;
      }
    }

    if (text.startsWith('/shipme')) {
      const p = await db.prepare(`SELECT user_id FROM user_profiles WHERE user_id = ?`).bind(fromUser.id).first();
      if (!p) {
        await db.prepare(`INSERT INTO user_profiles (user_id, first_name, username, is_global_opted_out) VALUES (?, ?, ?, 0)`).bind(fromUser.id, fromUser.first_name || '', fromUser.username || null).run();
      } else {
        await db.prepare(`UPDATE user_profiles SET is_global_opted_out = 0 WHERE user_id = ?`).bind(fromUser.id).run();
      }
      await db.prepare(`UPDATE group_members SET is_opted_out = 0 WHERE user_id = ?`).bind(fromUser.id).run();
      await sendMessage(token, chatId, `✅ <b>${fromUser.first_name}</b> عزیز، حضور شما در گردونه شیپینگ در تمام گروه‌ها مجدداً فعال شد!`);
      return;
    }

    if (text.startsWith('/admin')) {
      await handleAdminPanel(chatId, fromUser.id, text, token, db);
      return;
    }

    await handlePrivateTextInput(chatId, fromUser, text, msg, token, db);
  }
}

// بررسی و ارسال تبریک تولد کاربر در گروه
async function checkBirthdayGreeting(chatId, threadId, user, token, db) {
  const profile = await db.prepare(`SELECT birth_year, birth_month, birth_day, last_birthday_year FROM user_profiles WHERE user_id = ?`).bind(user.id).first();
  if (!profile || !profile.birth_month || !profile.birth_day) return;

  const shamsi = getShamsiDetails();
  // اگر ماه و روز جاری با تاریخ تولد کاربر یکی بود و امسال تبریک نگرفته بود
  if (profile.birth_month === shamsi.month && profile.birth_day === shamsi.day) {
    if (profile.last_birthday_year !== shamsi.year) {
      // ثبت در دیتابیس برای جلوگیری از ارسال مجدد در سال جاری
      await db.prepare(`UPDATE user_profiles SET last_birthday_year = ? WHERE user_id = ?`).bind(shamsi.year, user.id).run();

      const ageText = profile.birth_year ? ` و ورود به <b>${shamsi.year - profile.birth_year} سالگی</b>` : '';
      const bdayMsg = `🎂🎉 <b>امروز تولد ${userMention(user.id, user.first_name, user.username)} عزیز است!</b>\n` +
        `کیوپید و اعضای گروه فرارسیدن سالروز تولدت${ageText} را صمیمانه تبریک می‌گویند! الهی سالی پر از عشق، سازگاری و زیباترین لحظات زندگی پیش روت باشه! ❤️✨🎈`;

      await sendMessage(token, chatId, bdayMsg, { message_thread_id: threadId });
    }
  }
}

// دستور شیپینگ با لحاظ کردن حالت خصوصی ادمین و فیلترهای اخلاقی
async function handleShippingCommand(chatId, threadId, triggerUser, token, db, isReroll = false, isForce = false) {
  const ownerSetting = await db.prepare(`SELECT value FROM bot_settings WHERE key = 'owner_id'`).first();
  const ownerId = parseInt(ownerSetting?.value || '0', 10);
  const isOwner = (ownerId > 0 && triggerUser?.id === ownerId);

  if (isForce && !isOwner) {
    await sendMessage(token, chatId, `⛔ <b>ایجاد شیپ مجدد قبل از پایان روز فقط مخصوص سازنده و ادمین اصلی ربات است!</b>\nسایر اعضا روزانه یک‌بار می‌توانند زوج روز را انتخاب کنند.`, { message_thread_id: threadId });
    return;
  }

  const effectiveForce = isForce && isOwner;

  if (!isReroll && !effectiveForce && isRateLimited(`ship_${chatId}`, 3000)) return;

  // ۱. بررسی وضعیت دسترسی ادمین (حالت عمومی vs خصوصی)
  const groupRow = await db.prepare(`SELECT * FROM groups WHERE chat_id = ?`).bind(chatId).first();
  if (groupRow?.mode_override === 'blocked') {
    await sendMessage(token, chatId, `⛔ این گروه در لیست مسدودی ربات قرار دارد.`, { message_thread_id: threadId });
    return;
  }

  const modeSetting = await db.prepare(`SELECT value FROM bot_settings WHERE key = 'mode'`).first();
  const isPrivateMode = modeSetting?.value === 'private';

  if (isPrivateMode && groupRow?.mode_override !== 'allowed') {
    const ownerSetting = await db.prepare(`SELECT value FROM bot_settings WHERE key = 'owner_id'`).first();
    const ownerId = parseInt(ownerSetting?.value || '0', 10);
    if (ownerId > 0) {
      const ownerCheck = await tgCall(token, 'getChatMember', { chat_id: chatId, user_id: ownerId });
      const status = ownerCheck?.result?.status;
      if (!status || status === 'left' || status === 'kicked') {
        await sendMessage(token, chatId, `🔒 <b>این ربات در حالت خصوصی قرار دارد!</b>\nربات جُفت‌چین فقط در گروه‌هایی کار می‌کند که سازنده ربات در آن‌ها حضور داشته باشد.`, { message_thread_id: threadId });
        return;
      }
    }
  }

  const tehran = getTehranDate();

  const existing = await db.prepare(`
    SELECT * FROM daily_couples 
    WHERE chat_id = ? AND (topic_id = ? OR topic_id = 0) AND ship_date = ? AND reroll_count = 0
    ORDER BY id DESC LIMIT 1
  `).bind(chatId, threadId || 0, tehran.dateStr).first();

  if (!isReroll && !effectiveForce && existing) {
    const u1 = await db.prepare(`SELECT first_name, username FROM group_members WHERE user_id = ? AND chat_id = ? LIMIT 1`).bind(existing.user1_id, chatId).first();
    const u2 = await db.prepare(`SELECT first_name, username FROM group_members WHERE user_id = ? AND chat_id = ? LIMIT 1`).bind(existing.user2_id, chatId).first();
    const m1 = userMention(existing.user1_id, u1?.first_name || 'کاربر اول', u1?.username);
    const m2 = userMention(existing.user2_id, u2?.first_name || 'کاربر دوم', u2?.username);

    let messageText = '';
    const scoreLine = (existing.compatibility_score !== null && existing.compatibility_score !== undefined && existing.compatibility_score > 0)
      ? `\n\n📊 <b>درصد سازگاری:</b> ${existing.compatibility_score}٪`
      : '';
    const reasonLine = existing.reason ? `\n✨ <b>وجه اشتراک:</b> ${existing.reason}` : '';

    if (existing.user3_id) {
      const u3 = await db.prepare(`SELECT first_name, username FROM group_members WHERE user_id = ? AND chat_id = ? LIMIT 1`).bind(existing.user3_id, chatId).first();
      const m3 = userMention(existing.user3_id, u3?.first_name || 'کاربر سوم', u3?.username);
      messageText = `💘 <b>ترایاد / شیپ چندنفره امروز گروه:</b>\n${m1} + ${m2} + ${m3} = 💖💖${scoreLine}${reasonLine}\n\n⏳ <i>انتخاب زوج بعدی: ${tehran.remainingStr} دیگر</i>`;
    } else {
      messageText = `💘 <b>زوج منتخب امروز گروه:</b>\n${m1} + ${m2} = ❤️${scoreLine}${reasonLine}\n\n⏳ <i>انتخاب زوج بعدی: ${tehran.remainingStr} دیگر</i>`;
    }

    await sendMessage(token, chatId, messageText, { message_thread_id: threadId });
    return;
  }

  if (effectiveForce) {
    await db.prepare(`UPDATE daily_couples SET reroll_count = 1 WHERE chat_id = ? AND ship_date = ? AND reroll_count = 0`).bind(chatId, tehran.dateStr).run();
  }

  const banSetting = await db.prepare(`SELECT value FROM bot_settings WHERE key = 'banned_users'`).first();
  const bannedList = safeJsonArray(banSetting?.value);
  const bannedSet = new Set(bannedList);

  // اضافه کردن خودکار مدیران گروه به لیست اعضا
  try {
    const adminRes = await tgCall(token, 'getChatAdministrators', { chat_id: chatId });
    if (adminRes?.result && Array.isArray(adminRes.result)) {
      for (const adm of adminRes.result) {
        if (adm.user && !adm.user.is_bot) {
          await db.prepare(`
            INSERT INTO group_members (chat_id, user_id, first_name, username, last_active)
            VALUES (?, ?, ?, ?, CURRENT_TIMESTAMP)
            ON CONFLICT(chat_id, user_id) DO UPDATE SET first_name = excluded.first_name, username = excluded.username;
          `).bind(chatId, adm.user.id, adm.user.first_name || '', adm.user.username || null).run();
        }
      }
    }
  } catch (e) {
    // ignore
  }

  const members = await db.prepare(`
    SELECT 
      gm.user_id as user_id, 
      gm.first_name as first_name, 
      gm.username as username,
      up.birth_year, 
      up.birth_month, 
      up.birth_day, 
      up.province, 
      up.city, 
      up.city_lat, 
      up.city_lon, 
      up.gender_identity, 
      up.target_genders, 
      up.relationship_goal, 
      up.relationship_structure, 
      up.relationship_status, 
      up.religion, 
      up.religion_importance, 
      up.max_distance_km, 
      up.distance_importance, 
      up.age_min_diff, 
      up.age_max_diff, 
      up.bdsm_interest, 
      up.bdsm_roles
    FROM group_members gm
    LEFT JOIN user_profiles up ON gm.user_id = up.user_id
    WHERE gm.chat_id = ? AND gm.is_opted_out = 0 AND (up.is_global_opted_out IS NULL OR up.is_global_opted_out = 0)
    ORDER BY gm.last_active DESC LIMIT 100
  `).bind(chatId).all();

  const candidateList = (members.results || []).filter(u => !bannedSet.has(u.user_id));
  if (candidateList.length < 2) {
    await sendMessage(token, chatId, `🏹 برای شیپینگ به حداقل ۲ نفر عضو فعال در گروه نیاز است!`, { message_thread_id: threadId });
    return;
  }

  const blocks = await db.prepare(`SELECT user_id, blocked_user_id FROM user_ship_blocks`).all();
  const blockSet = new Set((blocks.results || []).map(b => `${b.user_id}_${b.blocked_user_id}`));

  function isBlocked(idA, idB) {
    return blockSet.has(`${idA}_${idB}`) || blockSet.has(`${idB}_${idA}`);
  }

  // بررسی برای شیپ چندنفره / ترایاد (Polyamory) در صورت وجود حداقل ۳ نفر با تمایل به روابط چندگانه
  const polyCandidates = candidateList.filter(u => (u.relationship_structure || '').includes('چندعشقی') || (u.relationship_structure || '').includes('Polyamory'));
  let bestTriad = null;
  if (polyCandidates.length >= 3) {
    for (let i = 0; i < polyCandidates.length; i++) {
      for (let j = i + 1; j < polyCandidates.length; j++) {
        for (let k = j + 1; k < polyCandidates.length; k++) {
          const p1 = polyCandidates[i];
          const p2 = polyCandidates[j];
          const p3 = polyCandidates[k];
          if (isBlocked(p1.user_id, p2.user_id) || isBlocked(p1.user_id, p3.user_id) || isBlocked(p2.user_id, p3.user_id)) continue;
          const s12 = computePairScore(p1, p2).score;
          const s13 = computePairScore(p1, p3).score;
          const s23 = computePairScore(p2, p3).score;
          const avgScore = Math.round((s12 + s13 + s23) / 3);
          if (!bestTriad || avgScore > bestTriad.score) {
            bestTriad = { u1: p1, u2: p2, u3: p3, score: avgScore, reason: 'روابط چندگانه توافقی (Polyamory)' };
          }
        }
      }
    }
  }

  if (bestTriad) {
    const m1 = userMention(bestTriad.u1.user_id, bestTriad.u1.first_name, bestTriad.u1.username);
    const m2 = userMention(bestTriad.u2.user_id, bestTriad.u2.first_name, bestTriad.u2.username);
    const m3 = userMention(bestTriad.u3.user_id, bestTriad.u3.first_name, bestTriad.u3.username);

    const scoreLine = (bestTriad.score !== null && bestTriad.score !== undefined && bestTriad.score > 0)
      ? `\n\n📊 <b>درصد سازگاری:</b> ${bestTriad.score}٪`
      : '';
    const reasonLine = bestTriad.reason ? `\n✨ <b>وجه اشتراک:</b> ${bestTriad.reason}` : '';

    const triadMsg = `💘 <b>ترایاد / شیپ چندنفره امروز گروه:</b>\n${m1} + ${m2} + ${m3} = 💖💖${scoreLine}${reasonLine}\n\n⏳ <i>انتخاب زوج بعدی: ${tehran.remainingStr} دیگر</i>`;

    const sent = await sendMessage(token, chatId, triadMsg, { message_thread_id: threadId });

    await db.prepare(`
      INSERT INTO daily_couples (chat_id, topic_id, message_id, ship_date, user1_id, user2_id, user3_id, compatibility_score, reason)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
    `).bind(chatId, threadId || 0, sent?.result?.message_id || 0, tehran.dateStr, bestTriad.u1.user_id, bestTriad.u2.user_id, bestTriad.u3.user_id, bestTriad.score, bestTriad.reason).run();
    return;
  }

  // استعلام جفت‌های انتخاب‌شده در ۷ روز اخیر این گروه (جهت تنوع و جلوگیری از تکرار)
  const recentCouplesRes = await db.prepare(`
    SELECT user1_id, user2_id, user3_id FROM daily_couples 
    WHERE chat_id = ? AND created_at >= datetime('now', '-7 days')
  `).bind(chatId).all();

  const recentPairsSet = new Set();
  for (const rc of (recentCouplesRes?.results || [])) {
    if (rc.user1_id && rc.user2_id) {
      recentPairsSet.add(`${Math.min(rc.user1_id, rc.user2_id)}_${Math.max(rc.user1_id, rc.user2_id)}`);
    }
    if (rc.user1_id && rc.user3_id) {
      recentPairsSet.add(`${Math.min(rc.user1_id, rc.user3_id)}_${Math.max(rc.user1_id, rc.user3_id)}`);
    }
    if (rc.user2_id && rc.user3_id) {
      recentPairsSet.add(`${Math.min(rc.user2_id, rc.user3_id)}_${Math.max(rc.user2_id, rc.user3_id)}`);
    }
  }

  // تشکیل تمام جفت‌های مجاز و مسدودنشده
  const validPairs = [];
  for (let i = 0; i < candidateList.length; i++) {
    for (let j = i + 1; j < candidateList.length; j++) {
      const u1 = candidateList[i];
      const u2 = candidateList[j];

      if (isBlocked(u1.user_id, u2.user_id)) continue;

      const match = computePairScore(u1, u2);
      // فیلتر قطعی اخلاقی/سنی/گرایشی: اگر امتیاز ۰ شد یعنی جفت ناسازگار است
      if (match.score === 0) continue;

      const pairKey = `${Math.min(u1.user_id, u2.user_id)}_${Math.max(u1.user_id, u2.user_id)}`;
      const isRecent = recentPairsSet.has(pairKey);

      validPairs.push({
        u1,
        u2,
        score: match.score,
        reason: match.reason,
        isRecent
      });
    }
  }

  if (validPairs.length === 0) {
    await sendMessage(token, chatId, `🏹 اعضای فعال در دسترس، یکدیگر را مسدود کرده‌اند یا شرایط سازگاری اخلاقی/سنی فراهم نیست و زوج مناسبی یافت نشد!`, { message_thread_id: threadId });
    return;
  }

  // قانون جریمه ۷ روزه با قابلیت چشم‌پوشی هوشمند (Fallback):
  // اگر جفت جدیدی وجود داشته باشد فقط از بین آنها انتخاب می‌شود، ولی اگر همه در ۷ روز اخیر جفت شده بودند یا تعداد کم بود، کل جفت‌ها شرکت داده می‌شوند
  const freshPairs = validPairs.filter(p => !p.isRecent);
  const candidatePool = freshPairs.length > 0 ? freshPairs : validPairs;

  let bestPair = null;
  const scoredPairs = candidatePool.filter(p => p.score !== null && p.score > 0);

  if (scoredPairs.length > 0) {
    // انتخاب وزن‌دار چرخه رولت (Roulette Wheel) با احتمال متناسب با توان ۲ امتیاز (Score^2)
    const weights = scoredPairs.map(p => Math.max(1, Math.pow(p.score, 2)));
    const totalWeight = weights.reduce((sum, w) => sum + w, 0);
    let r = Math.random() * totalWeight;
    for (let k = 0; k < scoredPairs.length; k++) {
      r -= weights[k];
      if (r <= 0 || k === scoredPairs.length - 1) {
        bestPair = scoredPairs[k];
        break;
      }
    }
  } else {
    // اگر هیچ‌کدام پروفایل امتیازدار نداشتند، انتخاب کاملاً تصادفی و منصفانه
    bestPair = candidatePool[Math.floor(Math.random() * candidatePool.length)];
  }

  const m1 = userMention(bestPair.u1.user_id, bestPair.u1.first_name, bestPair.u1.username);
  const m2 = userMention(bestPair.u2.user_id, bestPair.u2.first_name, bestPair.u2.username);

  const scoreLine = (bestPair.score !== null && bestPair.score !== undefined && bestPair.score > 0)
    ? `\n\n📊 <b>درصد سازگاری:</b> ${bestPair.score}٪`
    : '';
  const reasonLine = bestPair.reason ? `\n✨ <b>وجه اشتراک:</b> ${bestPair.reason}` : '';

  const coupleMsg = `💘 <b>زوج منتخب امروز گروه:</b>\n${m1} + ${m2} = ❤️${scoreLine}${reasonLine}\n\n⏳ <i>انتخاب زوج بعدی: ${tehran.remainingStr} دیگر</i>`;

  const sent = await sendMessage(token, chatId, coupleMsg, { message_thread_id: threadId });

  await db.prepare(`
    INSERT INTO daily_couples (chat_id, topic_id, message_id, ship_date, user1_id, user2_id, compatibility_score, reason)
    VALUES (?, ?, ?, ?, ?, ?, ?, ?)
  `).bind(chatId, threadId || 0, sent?.result?.message_id || 0, tehran.dateStr, bestPair.u1.user_id, bestPair.u2.user_id, bestPair.score, bestPair.reason).run();
}

function computePairScore(u1, u2) {
  const reasons = [];

  // ۱. فیلتر اخلاقی رده سنی قانونی (حفاظت و تفکیک سن)
  const shamsi = getShamsiDetails();
  const age1 = u1.birth_year ? (shamsi.year - u1.birth_year) : null;
  const age2 = u2.birth_year ? (shamsi.year - u2.birth_year) : null;

  if (age1 !== null && age2 !== null) {
    const isAdult1 = age1 >= 18;
    const isAdult2 = age2 >= 18;
    if (isAdult1 !== isAdult2) {
      return { score: 0, reason: 'عدم تطابق رده سنی' };
    }
  }

  // ۲. فیلتر گرایش و جنسیت‌های هدف متقابل
  if (u1.gender_identity && u2.gender_identity) {
    let tg1 = [];
    let tg2 = [];
    try { tg1 = JSON.parse(u1.target_genders || '[]'); } catch { tg1 = []; }
    try { tg2 = JSON.parse(u2.target_genders || '[]'); } catch { tg2 = []; }

    const open1 = tg1.length === 0 || tg1.includes('هنوز مطمئن نیستم');
    const open2 = tg2.length === 0 || tg2.includes('هنوز مطمئن نیستم');

    const match1 = open1 || tg1.some(g => u2.gender_identity.includes(g) || g.includes(u2.gender_identity));
    const match2 = open2 || tg2.some(g => u1.gender_identity.includes(g) || g.includes(u1.gender_identity));

    if (!match1 || !match2) {
      return { score: 0, reason: 'عدم تطابق جنسیت هدف' };
    }
  }

  // ۳. فیلتر تعهد و تک‌همسری
  const isCommitted1 = (u1.relationship_status === 'متأهل' || u1.relationship_status === 'در رابطه عاطفی');
  const isCommitted2 = (u2.relationship_status === 'متأهل' || u2.relationship_status === 'در رابطه عاطفی');
  const isOpen1 = (u1.relationship_status === 'در رابطه باز' || (u1.relationship_structure || '').includes('باز') || (u1.relationship_structure || '').includes('چندعشقی'));
  const isOpen2 = (u2.relationship_status === 'در رابطه باز' || (u2.relationship_structure || '').includes('باز') || (u2.relationship_structure || '').includes('چندعشقی'));

  if ((isCommitted1 && !isOpen1 && !isOpen2) || (isCommitted2 && !isOpen2 && !isOpen1)) {
    return { score: 0, reason: 'عدم تطابق تعهد رابطه' };
  }

  let totalScore = 0;

  // ۴. امتیاز اهداف رابطه (تا ۳۰ امتیاز)
  if (u1.relationship_goal && u2.relationship_goal) {
    const g1 = safeJsonArrayOrItem(u1.relationship_goal);
    const g2 = safeJsonArrayOrItem(u2.relationship_goal);

    const overlap = g1.filter(item => g2.includes(item));
    if (overlap.length > 0) {
      if (g1[0] && g2[0] && g1[0] === g2[0]) {
        totalScore += 30;
      } else {
        totalScore += 20;
      }
      let safeGoal = overlap[0];
      if (safeGoal.includes('ازدواج سفید')) safeGoal = 'همراهی و زندگی مشترک';
      else safeGoal = safeGoal.replace(' (فقط یک شب رابطه)', '').replace(' (دوستی + سکس)', '');
      reasons.push(safeGoal);
    } else {
      totalScore += 0;
    }
  } else {
    totalScore += 0;
  }

  // ۵. امتیاز تناسب سنی حداقل و حداکثر (تا ۲۵ امتیاز)
  if (age1 !== null && age2 !== null) {
    const diff2from1 = age2 - age1;
    const diff1from2 = age1 - age2;

    const min1 = u1.age_min_diff ?? -50;
    const max1 = u1.age_max_diff ?? 50;
    const min2 = u2.age_min_diff ?? -50;
    const max2 = u2.age_max_diff ?? 50;

    const ok1 = (diff2from1 >= min1 && diff2from1 <= max1);
    const ok2 = (diff1from2 >= min2 && diff1from2 <= max2);

    if (ok1 && ok2) {
      totalScore += 25;
      if (Math.abs(age1 - age2) <= 2) {
        reasons.push('هم‌نسل بودن');
      } else {
        reasons.push('تناسب سنی ایده‌آل');
      }
    } else if (ok1 || ok2) {
      totalScore += 10;
    } else {
      totalScore += 0;
    }
  } else {
    totalScore += 0;
  }

  // ۶. امتیاز فاصله مکانی (تا ۲۰ امتیاز)
  if (u1.city_lat && u1.city_lon && u2.city_lat && u2.city_lon) {
    const dist = calculateDistanceKm(u1.city_lat, u1.city_lon, u2.city_lat, u2.city_lon);
    const maxAllowedDist = Math.min(u1.max_distance_km || 3000, u2.max_distance_km || 3000);

    if (dist > maxAllowedDist) {
      totalScore += 0;
    } else if (dist <= 25 || (u1.city && u1.city === u2.city)) {
      totalScore += 20;
      reasons.push('همشهری');
    } else if (dist <= 100) {
      totalScore += 15;
      reasons.push('شهرهای همسایه');
    } else if (dist <= 300) {
      totalScore += 10;
      reasons.push('هم‌استانی');
    } else {
      totalScore += 5;
    }
  } else {
    totalScore += 0;
  }

  // ۷. امتیاز ساختار رابطه (تا ۱۵ امتیاز)
  if (u1.relationship_structure && u2.relationship_structure) {
    const s1 = u1.relationship_structure;
    const s2 = u2.relationship_structure;
    if (s1 === s2) {
      totalScore += 15;
      if (s1.includes('چندعشقی')) reasons.push('روابط چندگانه توافقی');
      else if (s1.includes('تک‌همسری')) reasons.push('تعهد تک‌همسری');
    } else if ((s1.includes('منعطف') || s1.includes('فرقی ندارد')) || (s2.includes('منعطف') || s2.includes('فرقی ندارد'))) {
      totalScore += 8;
    } else {
      totalScore += 0;
    }
  } else {
    totalScore += 0;
  }

  // ۸. امتیاز مکمل‌های BDSM و نقش‌ها (تا ۱۰ امتیاز)
  if (u1.bdsm_roles && u2.bdsm_roles) {
    const r1 = safeJsonArrayOrItem(u1.bdsm_roles);
    const r2 = safeJsonArrayOrItem(u2.bdsm_roles);

    let complementary = false;
    if ((r1.includes('مسلط (دامیننت)') && r2.includes('مطیع (سابمیسیو)')) || (r2.includes('مسلط (دامیننت)') && r1.includes('مطیع (سابمیسیو)'))) complementary = true;
    if ((r1.includes('سادیسم') && r2.includes('مازوخیسم')) || (r2.includes('سادیسم') && r1.includes('مازوخیسم'))) complementary = true;
    if ((r1.includes('بستن (طناب)') && r2.includes('بسته شدن (طناب)')) || (r2.includes('بستن (طناب)') && r1.includes('بسته شدن (طناب)'))) complementary = true;
    if ((r1.includes('مامی / ددی') && r2.includes('لیتل')) || (r2.includes('مامی / ددی') && r1.includes('لیتل'))) complementary = true;
    if (r1.includes('کلاسیک (وانیلا)') && r2.includes('کلاسیک (وانیلا)')) complementary = true;

    if (complementary) {
      totalScore += 10;
      reasons.push('هماهنگی روحی و شخصیتی');
    } else if (r1.includes('در حال کشف') || r2.includes('در حال کشف')) {
      totalScore += 5;
    } else {
      totalScore += 0;
    }
  } else {
    totalScore += 0;
  }

  const hasProfile1 = Boolean(u1.birth_year || u1.city || u1.gender_identity || u1.relationship_goal || u1.relationship_structure);
  const hasProfile2 = Boolean(u2.birth_year || u2.city || u2.gender_identity || u2.relationship_goal || u2.relationship_structure);

  let finalReason = '';
  let finalScore = null;

  if (!hasProfile1 || !hasProfile2) {
    finalReason = 'شانس تصادفی کیوپید';
    finalScore = null;
  } else {
    if (reasons.length > 0) {
      finalReason = reasons.slice(0, 2).join(' + ');
    } else {
      finalReason = 'تطابق کلی در معیارهای فردی';
    }
    const jitter = Math.floor(Math.random() * 5);
    finalScore = Math.min(99, Math.max(15, Math.round(totalScore + jitter)));
  }

  return {
    score: finalScore,
    reason: finalReason
  };
}

async function handleReaction(reactionUpdate, token, db) {
  const chatId = reactionUpdate.chat.id;
  const messageId = reactionUpdate.message_id;
  const fromUser = reactionUpdate.user;
  const userId = fromUser?.id;
  if (!userId) return;

  // اگر ری‌اکشن در گروه باشد، کاربر را به عنوان عضو فعال ثبت می‌کنیم
  const isGroup = reactionUpdate.chat?.type === 'group' || reactionUpdate.chat?.type === 'supergroup';
  if (isGroup && fromUser && !fromUser.is_bot) {
    const memberKey = `${chatId}_${userId}`;
    if (!knownGroupMembers.has(memberKey)) {
      knownGroupMembers.add(memberKey);
      await db.prepare(`
        INSERT INTO group_members (chat_id, user_id, first_name, username, last_active)
        VALUES (?, ?, ?, ?, CURRENT_TIMESTAMP)
        ON CONFLICT(chat_id, user_id) DO UPDATE SET first_name = excluded.first_name, username = excluded.username, last_active = CURRENT_TIMESTAMP;
      `).bind(chatId, userId, fromUser.first_name || '', fromUser.username || null).run();
    }
  }

  const couple = await db.prepare(`SELECT * FROM daily_couples WHERE chat_id = ? AND message_id = ?`).bind(chatId, messageId).first();
  if (!couple) return;

  const newReactions = (reactionUpdate.new_reaction || []).map(r => r.emoji || (typeof r === 'string' ? r : ''));
  const isNegative = newReactions.some(isNegativeReaction);
  const isPositive = newReactions.some(isPositiveReaction);

  const isMember = (userId === couple.user1_id || userId === couple.user2_id || (couple.user3_id && userId === couple.user3_id));
  if (isMember && isNegative) {
    if (couple.user3_id) {
      const triadIds = [couple.user1_id, couple.user2_id, couple.user3_id];
      for (const otherId of triadIds) {
        if (otherId !== userId) {
          await db.prepare(`INSERT OR IGNORE INTO user_ship_blocks (user_id, blocked_user_id) VALUES (?, ?), (?, ?)`).bind(userId, otherId, otherId, userId).run();
        }
      }
    } else {
      await db.prepare(`INSERT OR IGNORE INTO user_ship_blocks (user_id, blocked_user_id) VALUES (?, ?), (?, ?)`).bind(couple.user1_id, couple.user2_id, couple.user2_id, couple.user1_id).run();
    }

    if (couple.reroll_count === 0) {
      await db.prepare(`UPDATE daily_couples SET reroll_count = 1 WHERE id = ?`).bind(couple.id).run();
      await sendMessage(token, chatId, `💔 <b>یکی از طرفین این پیوند را نپذیرفت!</b>\nاین اعضا برای یکدیگر در لیست مسدودی قرار گرفتند و شانس دوم فعال شد... 🎲`, { reply_to_message_id: couple.message_id });
      await handleShippingCommand(chatId, couple.topic_id, { id: userId }, token, db, true);
    }
    return;
  }

  // ثبت ری‌اکشن اعضای گروه برای محاسبه نسبت نارضایتی (شارژ ۱ شیپ در روز با تفاضل ۵-)
  let reactionVal = 0;
  if (isPositive) reactionVal = 1;
  else if (isNegative) reactionVal = -1;

  if (reactionVal !== 0) {
    await db.prepare(`
      INSERT INTO couple_reactions (chat_id, message_id, user_id, reaction_val)
      VALUES (?, ?, ?, ?)
      ON CONFLICT(chat_id, message_id, user_id) DO UPDATE SET reaction_val = excluded.reaction_val;
    `).bind(chatId, messageId, userId, reactionVal).run();
  } else {
    await db.prepare(`DELETE FROM couple_reactions WHERE chat_id = ? AND message_id = ? AND user_id = ?`).bind(chatId, messageId, userId).run();
  }

  if (isMember && isPositive) {
    await checkMutualCoupleCelebration(couple, chatId, token, db);
  }

  await checkCommunityDissatisfaction(couple, chatId, token, db);
}

