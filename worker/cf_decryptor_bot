  const cleanXrayLinks = extractXrayLinks(cleanProfiles, { ...filterOptions, skipFilter: true });
  const plainLinks = cleanXrayLinks.map((x2) => x2.link).filter(Boolean);
  const totalCount = plainLinks.length;
  const openvpnProfiles = cleanProfiles.filter((p) => (p.protocol || p.type || "").toLowerCase() === "openvpn");
  const sshProfiles = cleanProfiles.filter((p) => (p.protocol || p.type || "").toLowerCase() === "ssh");
  const mihomoProfiles = cleanProfiles.filter((p) => MIHOMO_EXCLUSIVE_PROTOS.has((p.protocol || p.type || "").toLowerCase()));
  const isFew = totalCount <= 3 && totalCount > 0;
  const sendAsFile = outputMode === "file" || outputMode === "auto" && !isFew;
  if (sendAsFile && totalCount > 0) {
    const fileContent = plainLinks.join("\n") + "\n";
    const caption = `\u2705 <b>\u0631\u0645\u0632\u06AF\u0634\u0627\u06CC\u06CC \u0647\u0633\u062A\u0647 Xray \u0628\u0627 \u0645\u0648\u0641\u0642\u06CC\u062A \u0627\u0646\u062C\u0627\u0645 \u0634\u062F</b> \u26A1
\u{1F4CA} \u062A\u0639\u062F\u0627\u062F \u06A9\u0627\u0646\u0641\u06CC\u06AF\u200C\u0647\u0627\u06CC \u0645\u0639\u062A\u0628\u0631: <b>${totalCount}</b> \u0639\u062F\u062F${statsText}
