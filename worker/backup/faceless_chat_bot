\u2022 \u0632\u06CC\u0631 \u0647\u0631 \u067E\u06CC\u0627\u0645\u06CC \u06A9\u0647 \u0645\u06CC\u200C\u0641\u0631\u0633\u062A\u06CC\u062F\u060C \u062F\u06A9\u0645\u0647 <b>\xAB\u{1F5D1} \u062D\u0630\u0641 \u067E\u06CC\u0627\u0645\xBB</b> \u0642\u0631\u0627\u0631 \u062F\u0627\u0631\u062F.
\u2022 \u0628\u0627 \u0632\u062F\u0646 \u0622\u0646\u060C \u067E\u06CC\u0627\u0645 \u0647\u0645 \u0627\u0632 \u0686\u062A \u062E\u0648\u062F\u062A\u0627\u0646 \u0648 \u0647\u0645 \u0627\u0632 \u0686\u062A \u06AF\u06CC\u0631\u0646\u062F\u0647 (\u0648 \u062D\u062A\u06CC \u0627\u0632 \u06AF\u0631\u0648\u0647 \u0645\u062A\u0635\u0644 \u0627\u0648) \u067E\u0627\u06A9\u0633\u0627\u0632\u06CC \u06A9\u0627\u0645\u0644 \u0645\u06CC\u200C\u06AF\u0631\u062F\u062F.

