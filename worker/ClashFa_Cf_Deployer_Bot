async function executeD1Statements(token, accountId, databaseId, sql) {
  const statements = sql
    .split(";")
    .map(s => s.trim())
    .filter(s => s.length > 0);

  const report = { success: true, executed: 0, failed: 0, errors: [] };
  for (const stmt of statements) {
    try {
      const res = await fetchWithTimeout(`https://api.cloudflare.com/client/v4/accounts/${accountId}/d1/database/${databaseId}/query`, {
        method: "POST",
        headers: {
          "Authorization": `Bearer ${token}`,
          "Content-Type": "application/json"
        },
        body: JSON.stringify({ sql: stmt })
      }, 15000);
      const data = await res.json();
      if (!data.success) {
        report.failed++;
        report.errors.push(data.errors?.[0]?.message || "Query statement failed");
        console.warn(`D1 execution warning on statement: ${stmt.substring(0, 30)} - ${data.errors?.[0]?.message}`);
      } else {
        report.executed++;
      }
    } catch (e) {
      report.failed++;
      report.errors.push(e.message);
      console.warn("D1 execute error: ", e.message);
    }
  }

  if (report.failed > 0 && report.executed === 0) {
    report.success = false;
    throw new Error(`خطا در اجرای ساختار جداول دیتابیس D1: ${report.errors.join(", ")}`);
  }
  return report;
}

// Code Cache & Preset Fetcher with Smart 12-Hour Freshness Window (Zero Cron Required)
const PRESET_CACHE_TTL_MS = 12 * 3600 * 1000; // 12 hours (refreshes 1-2 times daily automatically)

async function getPresetCode(preset, env = null, customUrl = null, forceRefresh = false) {
  const url = preset ? preset.url : customUrl;
  if (!url) throw new Error("آدرس سورس‌کد تعریف نشده است.");

  const cacheKey = `cache:code:${preset ? preset.id : "custom_" + Math.abs(hashCode(url))}`;
  const cacheTsKey = `cache:ts:${preset ? preset.id : "custom_" + Math.abs(hashCode(url))}`;

  let cachedCode = null;
  if (!forceRefresh && env && env.BOT_KV && preset) {
    try {
      const [cached, tsStr] = await Promise.all([
        env.BOT_KV.get(cacheKey),
        env.BOT_KV.get(cacheTsKey)
      ]);
      const cachedTs = parseInt(tsStr || "0", 10);
      const isFresh = (Date.now() - cachedTs) < PRESET_CACHE_TTL_MS;

      if (cached && isFresh) {
        return cached; // Still fresh (within 12 hours), return instantly!
      }
      if (cached) {
        cachedCode = cached; // Stale fallback preserved in case network fetch fails
      }
    } catch (_) {}
  }

  let res;
  try {
    res = await fetchWithTimeout(url, {
      headers: { "User-Agent": "ClashFa-Deployer-Bot" }
    }, 25000);
  } catch (err) {
    res = { ok: false, status: 0, statusText: err.message };
  }

  if (!res || !res.ok) {
    if (preset && preset.fallbackUrl) {
      try {
        res = await fetchWithTimeout(preset.fallbackUrl, {
          headers: { "User-Agent": "ClashFa-Deployer-Bot" }
        }, 25000);
      } catch (_) {}
    }
  }

  // If fetch failed but we have stale cached code, return the stale code gracefully!
  if ((!res || !res.ok) && cachedCode) {
    console.warn(`Using stale cache for ${preset?.id || url} due to network error: ${res?.statusText || "fetch failed"}`);
    return cachedCode;
  }

  if (!res || !res.ok) {
    throw new Error(`خطا در دانلود سورس‌کد (${res?.status || 0} ${res?.statusText || "Connection Error"})`);
  }

  let code = await res.text();
  if (!code || code.trim().length === 0) {
    if (cachedCode) return cachedCode;
    throw new Error("سورس‌کد دریافتی خالی است.");
  }

  // Ensure Service Worker format has registered event listeners
  if (!isESModule(code) && !code.includes("addEventListener") && code.includes("handleFetch")) {
    code += `\n\n// Auto-appended Cloudflare Workers event listeners\nif (typeof addEventListener !== "undefined") {\n  addEventListener("fetch", event => event.respondWith(handleFetch(event.request, event)));\n  if (typeof handleScheduled !== "undefined") {\n    addEventListener("scheduled", event => event.waitUntil(handleScheduled(event)));\n  }\n}\n`;
  }

  if (env && env.BOT_KV && preset) {
    // Save persistently without expirationTtl (no cron required, refreshed on traffic every 12h)
    try {
      await env.BOT_KV.put(cacheKey, code);
      await env.BOT_KV.put(cacheTsKey, Date.now().toString());
    } catch (_) {}
  }

  return code;
}

async function cacheAllPresets(env, forceRefresh = true) {
  if (!env || !env.BOT_KV) return;
  for (const p of PRESETS) {
    try {
      await getPresetCode(p, env, null, forceRefresh);
    } catch (_) {}
  }
  try {
    await env.BOT_KV.put("cache:last_auto_refresh", Date.now().toString());
  } catch (_) {}
}

function isESModule(code) {
  if (!code) return false;
  // 1. If the script explicitly defines a top-level export default or export as default, it MUST be an ES Module
  if (/(?:^|[;\n}])\s*export\s+default\b/m.test(code) || /(?:^|[;\n}])\s*export\s*\{[^}]*\bas\s+default\b/im.test(code)) {
    return true;
  }
  // 2. If the script explicitly registers fetch event listener, it is definitively a Service Worker
  if (/addEventListener\s*\(\s*['"]fetch['"]/.test(code)) {
    return false;
  }
  // 3. Otherwise, check for standard ES module export/import syntax
  return /(?:^|[;\n}])\s*export\s*\{/m.test(code) ||
         /(?:^|[;\n}])\s*import\s*\{/m.test(code) ||
         /(?:^|[;\n}])\s*import\s+[\w$*]+/m.test(code);
}

// Deploy Worker Script with Auto-Retry on Name Conflict (up to 3 attempts)
async function deployWorkerScript(token, accountId, scriptName, code, bindings = [], retryCount = 0, preset = null) {
  const isModule = isESModule(code);
  const formData = new FormData();
  
  const metadata = {
    compatibility_date: (typeof COMPATIBILITY_DATE !== "undefined" ? COMPATIBILITY_DATE : DEFAULT_COMPATIBILITY_DATE),
    compatibility_flags: ["nodejs_compat"],
    bindings: bindings
  };

  if (isModule) {
    metadata.main_module = "worker.js";
    formData.append("metadata", JSON.stringify(metadata));
    formData.append("worker.js", new Blob([code], { type: "application/javascript+module" }), "worker.js");
  } else {
    metadata.body_part = "script";
    formData.append("metadata", JSON.stringify(metadata));
    formData.append("script", new Blob([code], { type: "application/javascript" }), "script");
  }

  const res = await fetchWithTimeout(`https://api.cloudflare.com/client/v4/accounts/${accountId}/workers/scripts/${scriptName}`, {
    method: "PUT",
    headers: { 
      "Authorization": `Bearer ${token}`
    },
    body: formData
  }, 30000);

  const data = await res.json();
  if (!data.success) {
    const errMsg = (data.errors?.[0]?.message || "").toLowerCase();
    const errCode = data.errors?.[0]?.code;

    // If duplicate name or conflict, automatically generate a new safe name and retry
    if ((errMsg.includes("already exists") || errCode === 10009 || errCode === 10014) && retryCount < 3) {
      const newName = generateSafeWorkerName(preset, "worker");
      console.log(`Conflict for ${scriptName}. Retrying deploy with ${newName} (attempt ${retryCount + 1})...`);
      return await deployWorkerScript(token, accountId, newName, code, bindings, retryCount + 1, preset);
    }

    throw new Error(data.errors?.[0]?.message || "Failed to deploy Worker.");
  }
  return { ...data.result, deployedName: scriptName };
}

