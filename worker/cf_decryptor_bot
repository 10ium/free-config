  </div>

  <footer>
    \u0637\u0631\u0627\u062D\u06CC\u200C\u0634\u062F\u0647 \u0628\u0627 \u0646\u0647\u0627\u06CC\u062A \u0633\u0631\u0639\u062A \u0648 \u0627\u0645\u0646\u06CC\u062A \u0628\u0631 \u0628\u0633\u062A\u0631 Cloudflare Workers \u2022 <a href="/setup">\u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u0631\u0628\u0627\u062A \u062A\u0644\u06AF\u0631\u0627\u0645</a> \u2022 <a href="/diag">\u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC</a>
  </footer>

  <script>
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');
    const subInput = document.getElementById('subInput');
    const subBtn = document.getElementById('subBtn');
    const statusEl = document.getElementById('status');
    const resultsEl = document.getElementById('results');
    const cardsList = document.getElementById('cardsList');
    const summaryEl = document.getElementById('resultSummary');
    const copyAllBtn = document.getElementById('copyAllBtn');
    const downloadBtn = document.getElementById('downloadBtn');
    const fullConfigBox = document.getElementById('fullConfigBox');
    const fullConfigContent = document.getElementById('fullConfigContent');

    let currentFormat = 'xray';
    let lastResult = null;

    // Format selection buttons
    document.querySelectorAll('.format-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.format-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentFormat = btn.dataset.fmt;
      });
    });

    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('dragover'); });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('dragover');
      if (e.dataTransfer.files.length) handleUpload(e.dataTransfer.files, '');
    });
    fileInput.addEventListener('change', () => {
      if (fileInput.files.length) handleUpload(fileInput.files, '');
    });
    subBtn.addEventListener('click', () => {
      const url = subInput.value.trim();
      if (!url) return alert('\u0644\u0637\u0641\u0627\u064B \u0644\u06CC\u0646\u06A9 \u0627\u0634\u062A\u0631\u0627\u06A9 \u0631\u0627 \u0648\u0627\u0631\u062F \u0646\u0645\u0627\u06CC\u06CC\u062F.');
      handleUpload([], url);
    });

    async function handleUpload(files, subUrl) {
      statusEl.textContent = '\u062F\u0631 \u062D\u0627\u0644 \u067E\u0631\u062F\u0627\u0632\u0634 \u0648\u0631\u0648\u062F\u06CC\u200C\u0647\u0627...';
      statusEl.className = 'status';
      resultsEl.style.display = 'none';
      const sb = document.getElementById('statsBox'); if (sb) sb.style.display = 'none';
      cardsList.innerHTML = '';
      fullConfigBox.style.display = 'none';
      lastResult = null;

      const filterDuplicates = document.getElementById('filterDuplicatesCheck')?.checked !== false;
      const filterBroken = document.getElementById('filterBrokenCheck')?.checked !== false;
      const passwordVal = document.getElementById('passwordInput')?.value.trim();

      try {
        let allCollectedProfiles = [];
        const successFiles = [];
        const failedFiles = [];

        // 1. Process Subscription URL if provided
        if (subUrl && subUrl.trim()) {
          statusEl.textContent = '\u062F\u0631 \u062D\u0627\u0644 \u062F\u0631\u06CC\u0627\u0641\u062A \u0648 \u0628\u0631\u0631\u0633\u06CC \u0644\u06CC\u0646\u06A9 \u0633\u0627\u0628\u200C\u0627\u0633\u06A9\u0631\u06CC\u067E\u0634\u0646...';
          const fd = new FormData();
          fd.append('format', 'xray');
          fd.append('subUrl', subUrl.trim());
          const subRes = await fetch('/api/decrypt', { method: 'POST', body: fd });
          const subData = await subRes.json();
          if (subData.ok && subData.profiles) {
            allCollectedProfiles.push(...subData.profiles);
            successFiles.push({ file: '\u0644\u06CC\u0646\u06A9 \u0633\u0627\u0628\u200C\u0627\u0633\u06A9\u0631\u06CC\u067E\u0634\u0646', count: subData.count });
          } else {
            failedFiles.push({ file: '\u0644\u06CC\u0646\u06A9 \u0633\u0627\u0628\u200C\u0627\u0633\u06A9\u0631\u06CC\u067E\u0634\u0646', error: subData.error || '\u062E\u0637\u0627 \u062F\u0631 \u0628\u0627\u0631\u06AF\u06CC\u0631\u06CC' });
          }
        }

        // 2. Process Files sequentially (resilient batching: prevents Cloudflare CPU timeout)
        const totalFiles = files.length;
        for (let i = 0; i < totalFiles; i++) {
          const file = files[i];
          statusEl.textContent = totalFiles > 1
            ? ('\u062F\u0631 \u062D\u0627\u0644 \u067E\u0631\u062F\u0627\u0632\u0634 \u0641\u0627\u06CC\u0644 ' + (i + 1) + ' \u0627\u0632 ' + totalFiles + ': ' + file.name + '...')
            : ('\u062F\u0631 \u062D\u0627\u0644 \u0628\u0627\u0632\u06AF\u0634\u0627\u06CC\u06CC \u0648 \u067E\u0631\u062F\u0627\u0632\u0634 ' + file.name + '...');

          const fd = new FormData();
          fd.append('format', 'xray');
          fd.append('files', file);
          if (passwordVal) fd.append('password', passwordVal);

          try {
            const res = await fetch('/api/decrypt', { method: 'POST', body: fd });
            const data = await res.json();
            if (data.ok && data.profiles && data.profiles.length > 0) {
              allCollectedProfiles.push(...data.profiles);
              successFiles.push({ file: file.name, count: data.count || data.profiles.length });
            } else {
              failedFiles.push({ file: file.name, error: data.error || '\u0631\u0645\u0632 \u0639\u0628\u0648\u0631 \u0646\u0627\u062F\u0631\u0633\u062A \u06CC\u0627 \u0641\u0627\u06CC\u0644 \u0641\u0627\u0642\u062F \u06A9\u0627\u0646\u0641\u06CC\u06AF' });
            }
          } catch (fileErr) {
            failedFiles.push({ file: file.name, error: fileErr.message });
          }
        }

        if (allCollectedProfiles.length === 0) {
          const errDetail = failedFiles.length > 0
            ? failedFiles.map(f => (f.file + ': ' + f.error)).join(' | ')
            : '\u0647\u06CC\u0686 \u06A9\u0627\u0646\u0641\u06CC\u06AF \u0645\u0639\u062A\u0628\u0631\u06CC \u0627\u0633\u062A\u062E\u0631\u0627\u062C \u0646\u0634\u062F.';
          throw new Error(errDetail);
        }

        // 3. Assemble and build final merged configuration
        statusEl.textContent = '\u062F\u0631 \u062D\u0627\u0644 \u062A\u0644\u0641\u06CC\u0642\u060C \u062D\u0630\u0641 \u0645\u0648\u0627\u0631\u062F \u0641\u06CC\u06A9 \u0648 \u0633\u0627\u062E\u062A \u062E\u0631\u0648\u062C\u06CC \u0646\u0647\u0627\u06CC\u06CC...';
        const buildRes = await fetch('/api/build', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            profiles: allCollectedProfiles,
            format: currentFormat,
            filterDuplicates,
            filterBroken
          })
        });
        const data = await buildRes.json();
        if (!data.ok) throw new Error(data.error || '\u062E\u0637\u0627 \u062F\u0631 \u0633\u0627\u062E\u062A \u062E\u0631\u0648\u062C\u06CC \u0646\u0647\u0627\u06CC\u06CC');

        data.successFiles = successFiles;
        data.failedFiles = failedFiles;
        lastResult = data;

        const count = data.count || (data.links ? data.links.length : 0);
        let statusMsg = '\u2705 \u067E\u0631\u062F\u0627\u0632\u0634 \u0628\u0627 \u0645\u0648\u0641\u0642\u06CC\u062A \u0627\u0646\u062C\u0627\u0645 \u0634\u062F (' + count + ' \u06A9\u0627\u0646\u0641\u06CC\u06AF \u0645\u0639\u062A\u0628\u0631)';
        const parts = [];
        if (data.stats) {
          const statsBox = document.getElementById('statsBox');
          if (statsBox) {
            statsBox.style.display = 'block';
            document.getElementById('statTotal').textContent = data.stats.total || count;
            document.getElementById('statValid').textContent = data.stats.valid || count;
            document.getElementById('statDuplicates').textContent = data.stats.duplicates || 0;
            document.getElementById('statRejected').textContent = data.stats.rejected || 0;
            const protoBox = document.getElementById('protoChips');
            if (protoBox && data.stats.protoCounts) {
              protoBox.innerHTML = Object.entries(data.stats.protoCounts)
                .sort((a, b) => b[1] - a[1])
                .map(([pr, cnt]) => '<span style="background: #1e3a8a; color: #93c5fd; padding: 4px 10px; border-radius: 8px; font-size: 0.78rem; font-weight: 700;">' + pr + ': ' + cnt + '</span>')
                .join('');
            }
          }
          if (data.stats.rejected > 0) parts.push(data.stats.rejected + ' \u0645\u0648\u0631\u062F \u0641\u06CC\u06A9 \u062D\u0630\u0641 \u0634\u062F');
          else if (!filterBroken) parts.push('\u0641\u06CC\u0644\u062A\u0631 \u0641\u06CC\u06A9: \u063A\u06CC\u0631\u0641\u0639\u0627\u0644');
          if (data.stats.duplicates > 0) parts.push(data.stats.duplicates + ' \u0645\u0648\u0631\u062F \u062A\u06A9\u0631\u0627\u0631\u06CC \u062D\u0630\u0641 \u0634\u062F');
          else if (!filterDuplicates) parts.push('\u0641\u06CC\u0644\u062A\u0631 \u062A\u06A9\u0631\u0627\u0631\u06CC: \u063A\u06CC\u0631\u0641\u0639\u0627\u0644');
        }
        if (failedFiles.length > 0) {
          parts.push('\u26A0\uFE0F ' + failedFiles.length + ' \u0641\u0627\u06CC\u0644 \u0646\u0627\u0645\u0648\u0641\u0642');
        }
        if (parts.length > 0) statusMsg += ' \u2022 ' + parts.join(' | ');
        statusEl.textContent = statusMsg;
        statusEl.className = 'status ok';

        if (currentFormat === 'singbox' && data.singboxConfig) {
          summaryEl.textContent = '\u{1F4E6} \u06A9\u0627\u0646\u0641\u06CC\u06AF \u06A9\u0627\u0645\u0644 Sing-box v1.9+ (' + count + ' \u0633\u0631\u0648\u0631)';
          fullConfigContent.textContent = data.singboxConfig;
          fullConfigBox.style.display = 'block';
        } else if (currentFormat === 'mihomo' && data.mihomoConfig) {
          summaryEl.textContent = '\u{1F431} \u06A9\u0627\u0646\u0641\u06CC\u06AF \u06A9\u0627\u0645\u0644 Mihomo (Clash.Meta) (' + count + ' \u0633\u0631\u0648\u0631)';
          fullConfigContent.textContent = data.mihomoConfig;
          fullConfigBox.style.display = 'block';
        } else {
          summaryEl.textContent = '\u26A1 \u06A9\u0627\u0646\u0641\u06CC\u06AF\u200C\u0647\u0627\u06CC \u0645\u0633\u062A\u0642\u06CC\u0645 \u0647\u0633\u062A\u0647 Xray (' + (data.links?.length || 0) + ' \u0639\u062F\u062F)';
          cardsList.innerHTML = (data.links || []).map((item, idx) => 
            '<div class="card">' +
              '<div class="card-header">' +
                '<div class="card-title">' + (item.name || '\u06A9\u0627\u0646\u0641\u06CC\u06AF') + '</div>' +
                '<span class="tag">' + (item.protocol || 'xray') + '</span>' +
              '</div>' +
              '<div class="code-box" id="link_' + idx + '">' + item.link + '</div>' +
              '<div class="card-actions">' +
                '<button class="btn-secondary" onclick="copyText(' + idx + ')">\u06A9\u067E\u06CC \u0644\u06CC\u0646\u06A9</button>' +
              '</div>' +
            '</div>'
          ).join('');
        }

        resultsEl.style.display = 'block';
      } catch (err) {
        statusEl.textContent = '\u274C \u062E\u0637\u0627: ' + err.message;
        statusEl.className = 'status err';
      }
    }

    window.copyText = (idx) => {
      const text = document.getElementById('link_' + idx).textContent;
      navigator.clipboard.writeText(text);
      alert('\u0644\u06CC\u0646\u06A9 \u06A9\u067E\u06CC \u0634\u062F!');
    };

    copyAllBtn.addEventListener('click', () => {
      if (!lastResult) return;
      let text = '';
      if (currentFormat === 'singbox') text = lastResult.singboxConfig;
      else if (currentFormat === 'mihomo') text = lastResult.mihomoConfig;
      else text = (lastResult.links || []).map(x => x.link).join('\\n');

      navigator.clipboard.writeText(text);
      alert('\u062A\u0645\u0627\u0645\u06CC \u0645\u062D\u062A\u0648\u0627 \u062F\u0631 \u06A9\u0644\u06CC\u067E\u200C\u0628\u0648\u0631\u062F \u06A9\u067E\u06CC \u0634\u062F.');
    });

    downloadBtn.addEventListener('click', () => {
      if (!lastResult) return;
      let content = '', filename = 'Configs.txt', mime = 'text/plain;charset=utf-8';
      if (currentFormat === 'singbox') {
        content = lastResult.singboxConfig;
        filename = 'singbox_config.json';
        mime = 'application/json;charset=utf-8';
      } else if (currentFormat === 'mihomo') {
        content = lastResult.mihomoConfig;
        filename = 'clash_config.yaml';
        mime = 'text/yaml;charset=utf-8';
      } else {
        content = (lastResult.links || []).map(x => x.link).join('\\n') + '\\n';
        filename = 'Configs_Decrypted.txt';
      }

      const blob = new Blob([content], { type: mime });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = filename;
      a.click();
    });
  </script>
</body>
</html>`;
}
