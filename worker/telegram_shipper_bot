      [{ text: '⚧ هویت جنسیتی من', callback_data: 'step_gender' }],
      [{ text: '🎯 با چه جنسیت‌هایی شیپ شوم؟', callback_data: 'step_target_gender' }],
      [{ text: '💖 هدف از رابطه', callback_data: 'step_goals' }],
      [{ text: '💍 وضعیت رابطه و تأهل فعلی', callback_data: 'step_status' }],
      [{ text: '🔗 ساختار رابطه (تک‌همسری/چندعشقی)', callback_data: 'step_structure' }],
      [{ text: '📐 ترجیح اختلاف سنی', callback_data: 'step_age_diff' }],
      [{ text: '🗺 محدوده فاصله مکانی مجاز', callback_data: 'step_distance' }],
      [{ text: '⛓ نقش‌های مکمل (BDSM)', callback_data: 'step_bdsm' }],
