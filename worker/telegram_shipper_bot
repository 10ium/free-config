// کالبک‌ها
async function handleCallbackQuery(cb, token, db) {
  const data = cb.data;
  const chatId = cb.message?.chat?.id;
  const messageId = cb.message?.message_id;
  const user = cb.from;
  if (!user) return;

  // مدیریت لیست سیاه شیپ در پیوی
  if (data.startsWith('admin_force_ship_')) {
    const targetChat = parseInt(data.replace('admin_force_ship_', ''), 10);
    const ownerSetting = await db.prepare(`SELECT value FROM bot_settings WHERE key = 'owner_id'`).first();
    const ownerId = parseInt(ownerSetting?.value || '0', 10);
    if (user.id !== ownerId) {
      await answerCallback(token, cb.id, '⛔ این قابلیت فقط مخصوص سازنده و ادمین اصلی ربات است!', true);
      return;
    }
    await answerCallback(token, cb.id, '🎲 در حال انتخاب زوج جدید...');
    await handleShippingCommand(targetChat, cb.message?.message_thread_id, user, token, db, false, true);
    return;
  }

  if (data === 'block_ship_menu') {
    await answerCallback(token, cb.id);
    await showBlockShipMenu(chatId, user, token, db, messageId);
    return;
  }

  if (data === 'add_block_ship') {
    await db.prepare(`UPDATE user_profiles SET onboarding_step = 'waiting_block_target' WHERE user_id = ?`).bind(user.id).run();
    await answerCallback(token, cb.id);
    const cancelKeyboard = {
      inline_keyboard: [
        [{ text: '🔙 انصراف', callback_data: 'block_ship_menu' }]
      ]
    };
    await sendMessage(token, chatId, `🚫 <b>افزودن به لیست سیاه شیپینگ:</b>\n\nبرای اینکه کاربری هرگز در هیچ گروهی با شما شیپ نشود، یکی از روش‌های زیر را انجام دهید:\n\n۱. <b>یک پیام از آن شخص را به اینجا فوروارد (Forward) کنید.</b>\n۲. یا <b>آیدی کاربری او (@username)</b> را بفرستید.\n۳. یا <b>آیدی عددی (User ID)</b> او را بفرستید.\n\n<i>برای لغو می‌توانید /cancel را بفرستید یا دکمه زیر را لمس کنید.</i>`, { reply_markup: cancelKeyboard });
    return;
  }

  if (data.startsWith('unblock_ship_')) {
    const targetId = parseInt(data.replace('unblock_ship_', ''), 10);
    await db.prepare(`DELETE FROM user_ship_blocks WHERE (user_id = ? AND blocked_user_id = ?) OR (user_id = ? AND blocked_user_id = ?)`).bind(user.id, targetId, targetId, user.id).run();
    await answerCallback(token, cb.id, '✅ کاربر از لیست مسدودی شما خارج شد.', true);
    await showBlockShipMenu(chatId, user, token, db, messageId);
    return;
  }

  if (data === 'clear_all_blocks') {
    await db.prepare(`DELETE FROM user_ship_blocks WHERE user_id = ? OR blocked_user_id = ?`).bind(user.id, user.id).run();
    await answerCallback(token, cb.id, '🗑️ تمام افراد از لیست مسدودی شما حذف شدند.', true);
    await showBlockShipMenu(chatId, user, token, db, messageId);
    return;
  }

  // تاریخچه گروه
  if (data.startsWith('his_')) {
    const parts = data.split('_');
    const targetChat = parts[1];
    const period = parts[2];
    await answerCallback(token, cb.id);
    await renderShipHistoryPeriod(chatId, messageId, targetChat, period, token, db);
    return;
  }

  // تاریخ تولد
  if (data === 'step_birth') {
    await db.prepare(`UPDATE user_profiles SET onboarding_step = 'waiting_birth' WHERE user_id = ?`).bind(user.id).run();
    await answerCallback(token, cb.id);
    await sendMessage(token, chatId, `🎂 لطفاً تاریخ یا سال تولد شمسی خود را بنویسید (مثلاً: <code>1380</code> یا <code>1382/04/15</code>):\n<i>(اگر روز و ماه را هم وارد کنید، ربات در روز تولدتان در گروه تبریک خواهد گفت! 🎉)</i>`);
    return;
  }

  // استان و شهر
  if (data === 'step_province') {
    await answerCallback(token, cb.id);
    const buttons = [];
    for (let i = 0; i < IRAN_PROVINCES.length; i += 3) {
      const row = IRAN_PROVINCES.slice(i, i + 3).map((p, pIdx) => ({
        text: p,
        callback_data: `pv_${i + pIdx}_0`
      }));
      buttons.push(row);
    }
    buttons.push([{ text: '🔙 بازگشت به منو', callback_data: 'main_menu' }]);
    await editMessageText(token, chatId, messageId, `📍 <b>استان خود را انتخاب کنید</b> (یا هر زمان می‌توانید نام شهرتان را همینجا تایپ کنید):`, { reply_markup: { inline_keyboard: buttons } });
    return;
  }

  if (data.startsWith('pv_')) {
    const parts = data.split('_');
    const provIndex = parseInt(parts[1], 10);
    const page = parseInt(parts[2] || '0', 10);
    const provName = IRAN_PROVINCES[provIndex] || 'تهران';

    await answerCallback(token, cb.id);

    const citiesResult = await db.prepare(`SELECT id, city FROM iran_cities WHERE province = ? ORDER BY city`).bind(provName).all();
    const cities = citiesResult.results || [];

    const pageSize = 12;
    const totalPages = Math.ceil(cities.length / pageSize) || 1;
    const startIdx = page * pageSize;
    const pageCities = cities.slice(startIdx, startIdx + pageSize);

    const buttons = [];
    for (let i = 0; i < pageCities.length; i += 2) {
      const row = pageCities.slice(i, i + 2).map(c => ({
        text: c.city,
        callback_data: `c_id_${c.id}`
      }));
      buttons.push(row);
    }

    const navRow = [];
    if (page > 0) {
      navRow.push({ text: '⬅️ صفحه قبل', callback_data: `pv_${provIndex}_${page - 1}` });
    }
    if (page < totalPages - 1) {
      navRow.push({ text: 'صفحه بعد ➡️', callback_data: `pv_${provIndex}_${page + 1}` });
    }
    if (navRow.length > 0) buttons.push(navRow);

    buttons.push([{ text: '🔙 بازگشت به لیست استان‌ها', callback_data: 'step_province' }]);

    await editMessageText(token, chatId, messageId, `🏙 شهرهای استان <b>${provName}</b> (صفحه ${page + 1} از ${totalPages}):\n<i>روی شهر خود بزنید یا نام آن را بنویسید:</i>`, { reply_markup: { inline_keyboard: buttons } });
    return;
  }

  if (data.startsWith('c_id_')) {
    const cityId = parseInt(data.replace('c_id_', ''), 10);
    const cityRow = await db.prepare(`SELECT * FROM iran_cities WHERE id = ?`).bind(cityId).first();
    if (cityRow) {
      await db.prepare(`UPDATE user_profiles SET province = ?, city = ?, city_lat = ?, city_lon = ?, onboarding_step = 'done' WHERE user_id = ?`).bind(cityRow.province, cityRow.city, cityRow.lat, cityRow.lon, user.id).run();
      await answerCallback(token, cb.id, `شهر ${cityRow.city} ثبت شد! ✅`, true);
      await showUserProfileMenu(chatId, user, token, db);
    }
    return;
  }

  // تغییر وضعیت سراسری حضور در شیپینگ
  if (data === 'toggle_global_optout') {
    const curProfile = await db.prepare(`SELECT is_global_opted_out FROM user_profiles WHERE user_id = ?`).bind(user.id).first();
    const newStatus = curProfile?.is_global_opted_out ? 0 : 1;
    await db.prepare(`UPDATE user_profiles SET is_global_opted_out = ? WHERE user_id = ?`).bind(newStatus, user.id).run();
    await answerCallback(token, cb.id, newStatus ? 'حضور شما در تمام شیپینگ‌ها خاموش شد ⛔' : 'حضور شما در تمام شیپینگ‌ها فعال شد ✅');
    await showUserProfileMenu(chatId, user, token, db);
    return;
  }

  // هویت جنسیتی
  if (data === 'step_gender') {
    await answerCallback(token, cb.id);
    const buttons = GENDERS.map((g, idx) => [{ text: g, callback_data: `s_gen_${idx}` }]);
    buttons.push([{ text: '🔙 بازگشت', callback_data: 'main_menu' }]);
    await editMessageText(token, chatId, messageId, `⚧ <b>هویت جنسیتی خود را مشخص کنید:</b>`, { reply_markup: { inline_keyboard: buttons } });
    return;
  }

  if (data.startsWith('s_gen_')) {
    const idx = parseInt(data.replace('s_gen_', ''), 10);
    const chosen = GENDERS[idx] || 'ترجیح می‌دهم نگویم';
    await db.prepare(`UPDATE user_profiles SET gender_identity = ? WHERE user_id = ?`).bind(chosen, user.id).run();
    await answerCallback(token, cb.id, 'هویت جنسیتی ثبت شد! ✅', true);
    await showUserProfileMenu(chatId, user, token, db);
    return;
  }

  // جنسیت‌های هدف
  if (data === 'step_target_gender') {
    await answerCallback(token, cb.id);
    await renderTargetGendersMenu(chatId, messageId, user.id, token, db);
    return;
  }

  if (data.startsWith('t_tg_')) {
    const idx = parseInt(data.replace('t_tg_', ''), 10);
    const targetItem = TARGET_GENDERS[idx];
    const profile = await db.prepare(`SELECT target_genders FROM user_profiles WHERE user_id = ?`).bind(user.id).first();
    let current = safeJsonArray(profile?.target_genders);

