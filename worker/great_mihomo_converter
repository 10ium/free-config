      if (rem <= 0) throw new Error("Socket read timeout");
      const result = await Promise.race([
        reader.read(),
        new Promise((_, reject) => setTimeout(() => reject(new Error("Socket read timeout")), rem))
      ]);
      if (result.done) break;
      if (result.value && result.value.byteLength > 0) {
        chunks.push(result.value);
        totalLen += result.value.byteLength;
        if (totalLen > 12 * 1024 * 1024) break;
      }
    }
  } finally {
    try { await socket.close(); } catch {}
  }

  const fullBytes = new Uint8Array(totalLen);
  let offset = 0;
  for (const c of chunks) {
    fullBytes.set(c, offset);
    offset += c.byteLength;
  }

  let headerEnd = -1;
  for (let i = 0; i <= fullBytes.length - 4; i++) {
    if (fullBytes[i] === 13 && fullBytes[i + 1] === 10 && fullBytes[i + 2] === 13 && fullBytes[i + 3] === 10) {
      headerEnd = i;
      break;
    }
  }
  if (headerEnd === -1) throw new Error("Invalid HTTP response over socket");

  const headerText = new TextDecoder("latin1").decode(fullBytes.subarray(0, headerEnd));
  let bodyBytes = fullBytes.subarray(headerEnd + 4);
  const headerLines = headerText.split("\r\n");
  const statusMatch = headerLines[0].match(/HTTP\/\d(?:\.\d)?\s+(\d{3})/);
  const status = statusMatch ? parseInt(statusMatch[1], 10) : 0;

  const respHeaders = {};
  for (let i = 1; i < headerLines.length; i++) {
    const colon = headerLines[i].indexOf(":");
    if (colon > 0) {
      const k = headerLines[i].slice(0, colon).trim().toLowerCase();
      const v = headerLines[i].slice(colon + 1).trim();
      respHeaders[k] = v;
    }
  }

  if ([301, 302, 303, 307, 308].includes(status) && respHeaders.location && maxRedirects > 0) {
    const nextUrl = new URL(respHeaders.location, u).toString();
    return fetchViaCloudflareSocket(nextUrl, requestHeaders, maxRedirects - 1);
  }

  if ((respHeaders["transfer-encoding"] || "").toLowerCase().includes("chunked")) {
    const decodedParts = [];
    let decodedLen = 0;
    let pos = 0;
    while (pos < bodyBytes.length) {
      let lineEnd = -1;
      for (let j = pos; j < bodyBytes.length - 1; j++) {
        if (bodyBytes[j] === 13 && bodyBytes[j + 1] === 10) {
          lineEnd = j;
          break;
        }
      }
      if (lineEnd === -1) break;
      const sizeHex = new TextDecoder("latin1").decode(bodyBytes.subarray(pos, lineEnd)).split(";")[0].trim();
      const chunkSize = parseInt(sizeHex, 16);
      pos = lineEnd + 2;
      if (isNaN(chunkSize) || chunkSize <= 0) break;
      const endPos = Math.min(pos + chunkSize, bodyBytes.length);
      const part = bodyBytes.subarray(pos, endPos);
      decodedParts.push(part);
      decodedLen += part.byteLength;
      pos = endPos + 2;
    }
    const merged = new Uint8Array(decodedLen);
    let mOff = 0;
    for (const p of decodedParts) {
      merged.set(p, mOff);
      mOff += p.byteLength;
    }
    bodyBytes = merged;
  }

  const ce = (respHeaders["content-encoding"] || "").toLowerCase().trim();
  if ((ce === "gzip" || ce === "deflate") && typeof DecompressionStream !== "undefined") {
    const ds = new DecompressionStream(ce);
    const ab = await new Response(new Response(bodyBytes).body.pipeThrough(ds)).arrayBuffer();
    bodyBytes = new Uint8Array(ab);
  }

  return {
    ok: status >= 200 && status < 300,
    status,
    text: async () => new TextDecoder("utf-8").decode(bodyBytes)
  };
}

async function fetchSingleSubscription(subUrl, fetchFn = fetch) {
  const normUrl = normalizeSubscriptionUrl(subUrl);
  if (!normUrl) return { url: subUrl, proxies: [], error: "لینک سورس نامعتبر است." };

  const baseHeaders = {
    "Accept": "*/*",
    "Cache-Control": "no-cache, no-store, must-revalidate",
    "Pragma": "no-cache"
  };

  let isIpHost = false;
  try {
    const parsedHost = new URL(normUrl).hostname.replace(/^\[|\]$/g, "");
    isIpHost = /^(\d{1,3}\.){3}\d{1,3}$/.test(parsedHost) || parsedHost.includes(":");
  } catch {}

  const makeFetchOpts = (ua) => {
    const opts = { headers: { ...baseHeaders, "User-Agent": ua } };
    if (fetchFn === fetch && typeof caches !== "undefined") {
      opts.cf = { cacheTtl: 0, cacheEverything: false };
    }
    return opts;
  };

  const tryFetchWithUa = async (ua) => {
    try {
      return { res: await fetchFn(normUrl, makeFetchOpts(ua)), err: null };
    } catch (e) {
      return { res: null, err: e };
    }
  };

  const isRetryableStatus = (s) => !s || [400, 401, 403, 406, 418, 429, 502, 503, 504].includes(s) || s >= 520;

  try {
    const primaryUa = "v2rayNG/1.8.12 (Clash.Meta; Sing-box; UniversalProxyHub)";
    let { res, err: fetchErr } = await tryFetchWithUa(primaryUa);
    let socketErrMsg = "";

    const trySocket = async (ua) => {
      if (fetchFn !== fetch) return null;
      try {
        const sockRes = await fetchViaCloudflareSocket(normUrl, { ...baseHeaders, "User-Agent": ua });
        if (sockRes && sockRes.status > 0) return sockRes;
      } catch (se) {
        socketErrMsg = se?.message || String(se);
      }
      return null;
    };

    // گام ۱: در صورت خطای 403/52x یا قطع اتصال (چه برای آی‌پی و چه دامنه)، تلاش با سوکت مستقیم بدون هدر کلودفلر
    if (!res || (!res.ok && (isIpHost || res.status === 403 || res.status >= 520))) {
      const sockRes = await trySocket(primaryUa);
      if (sockRes && (sockRes.ok || !res)) {
        res = sockRes;
        fetchErr = null;
      }
    }

    // گام ۲: در صورت خطای کلاینت/فایروال، تلاش با User-Agentهای استاندارد کلاینت‌های کلش و v2rayNG
    if (!res || (!res.ok && isRetryableStatus(res.status))) {
      const fallbackUas = ["clash-verge/v2.2.3", "ClashMetaForAndroid/2.11.5.Meta"];
      for (const altUa of fallbackUas) {
        const altAttempt = await tryFetchWithUa(altUa);
        if (altAttempt.res && altAttempt.res.ok) {
          res = altAttempt.res;
          fetchErr = null;
          break;
        }
        if (!altAttempt.res || isIpHost || altAttempt.res.status === 403 || altAttempt.res.status >= 520) {
          const altSock = await trySocket(altUa);
          if (altSock && altSock.ok) {
            res = altSock;
            fetchErr = null;
            break;
          }
        }
      }
    }

    if (fetchErr && !res) {
      throw new Error(socketErrMsg ? `${fetchErr.message} | سوکت: ${socketErrMsg}` : fetchErr.message);
    }

    if (!res.ok) {
      const errDetail = socketErrMsg
        ? `خطای سرور سورس (${res.status} | تلاش جایگزین ناموفق: ${socketErrMsg})`
        : `خطای سرور سورس (${res.status})`;
      return { url: normUrl, proxies: [], error: errDetail };
    }

    const rawText = await res.text();
    if (!rawText || !rawText.trim()) {
      return { url: normUrl, proxies: [], error: "سورس دریافتی خالی بود." };
    }

    const text = rawText.trim();
    let parsedProxies = [];

    // ۱. بررسی فرمت YAML میهومو/کلش
    if (text.includes("proxies:") || (text.includes("name:") && (text.includes("type:") || text.includes("server:")))) {
      try {
        const ym = parseMihomoYaml(text, "Mihomo");
        if (ym && ym.length > 0) parsedProxies = ym;
      } catch (e) {}
    }

    // ۲. بررسی فرمت JSON سینگ‌باکس
    if (parsedProxies.length === 0 && (text.startsWith("{") || text.startsWith("[")) && text.includes("outbounds")) {
      try {
        const sb = parseSingboxJson(text, "Singbox");
        if (sb && sb.length > 0) parsedProxies = sb;
      } catch (e) {}
    }

    // ۳. بررسی فرمت لینک‌های متنی و بیس۶۴
    if (parsedProxies.length === 0) {
      let decodedText = text;
      try {
        const cleanedB64 = text.replace(/\s+/g, "");
        if (!text.includes("://") && /^[A-Za-z0-9+/=_-]+$/.test(cleanedB64)) {
          const normB64 = cleanedB64.replace(/-/g, "+").replace(/_/g, "/");
          decodedText = Buffer.from(normB64, "base64").toString("utf-8");
        }
      } catch (e) {}

      const links = splitConcatenatedLinks(decodedText);
      for (const link of links) {
        try {
          const cfg = parseUriConfig(link);
          if (cfg && cfg.server) {
            parsedProxies.push(cfg);
          }
        } catch (e) {}
      }
    }

    return { url: normUrl, proxies: parsedProxies, error: null };
  } catch (err) {
    return { url: normUrl, proxies: [], error: err.message };
  }
}

async function processSubscription(options) {
  const {
    subsList = [],
    limitTotal = Infinity,
    limits = {},
    priorities = {},
    enableAwg = false,
    enableDedup = true,
    awgParams = { jc: 4, jmin: 40, jmax: 70 },
    fetchFn = fetch
  } = options;

  const targets = subsList && subsList.length > 0 ? subsList : DEFAULT_SUBS;

  const results = await Promise.all(
    targets.map(subUrl => fetchSingleSubscription(subUrl, fetchFn))
  );

  let allRawProxies = [];
  const errors = [];

  for (const r of results) {
    if (r.error) {
      errors.push({ url: r.url, reason: r.error });
    }
    if (r.proxies && r.proxies.length > 0) {
      allRawProxies.push(...r.proxies);
    }
  }

  // فیلتر اولیه پروتکل‌های سازگار در هر ۳ هسته
  allRawProxies = allRawProxies.filter(p => {
    if (!p) return false;
    const proto = (p.type || p.protocol || "").toLowerCase().trim();
    if (DNS_PROTOCOLS.has(proto)) return false;
    return ALLOWED_3WAY_PROTOCOLS.has(proto);
  });

  // پاکسازی، اعتبارسنجی و حذف تکراری‌ها با انجین رسمی
  const dedup = filterAndDeduplicateProxiesWithStats(allRawProxies, {
    filterDuplicates: Boolean(enableDedup),
    filterBroken: true
  });

  let validProxies = dedup.proxies;

  // اعمال تنظیمات سفارشی Amnezia-WG برای کانفیگ‌های WireGuard
  if (enableAwg) {
    validProxies = validProxies.map(p => {
      const proto = (p.type || p.protocol || "").toLowerCase();
      if (proto === "wireguard" || proto === "wg") {
        const copy = { ...p };
        if (copy.v2rayProfile) copy.v2rayProfile = { ...copy.v2rayProfile };
        copy.jc = awgParams.jc || 4;
        copy.jmin = awgParams.jmin || 40;
        copy.jmax = awgParams.jmax || 70;
        if (awgParams.s1) copy.s1 = awgParams.s1;
        if (awgParams.s2) copy.s2 = awgParams.s2;
        if (awgParams.h1) copy.h1 = awgParams.h1;
        if (awgParams.h2) copy.h2 = awgParams.h2;
        if (awgParams.h3) copy.h3 = awgParams.h3;
        if (awgParams.h4) copy.h4 = awgParams.h4;
        return copy;
      }
      return p;
    });
  }

  // گروه‌بندی بر اساس نوع نرمالایز شده پروتکل
  const grouped = {};
  for (const p of validProxies) {
    const proto = normalizeProto(p.type || p.protocol || "unknown");
    if (!grouped[proto]) grouped[proto] = [];
    grouped[proto].push(p);
  }

  // اعمال محدودیت به تفکیک پروتکل
  let filtered = [];
  for (const [proto, list] of Object.entries(grouped)) {
    const lim = limits[proto] !== undefined ? limits[proto] : Infinity;
    if (lim === 0) continue;
    filtered.push(...list.slice(0, lim));
  }

  // مرتب‌سازی بر اساس اولویت مشخص شده برای هر پروتکل
  filtered.sort((a, b) => {
    const protoA = normalizeProto(a.type || a.protocol || "");
    const protoB = normalizeProto(b.type || b.protocol || "");
    const pa = priorities[protoA] ?? 99;
    const pb = priorities[protoB] ?? 99;
    return pa - pb;
  });

  // اعمال سقف تعداد کل
  if (limitTotal && limitTotal > 0 && limitTotal !== Infinity) {
    filtered = filtered.slice(0, limitTotal);
  }

  const finalTypes = {};
  for (const p of filtered) {
    const proto = (p.type || p.protocol || "unknown").toLowerCase();
    finalTypes[proto] = (finalTypes[proto] || 0) + 1;
  }

  return {
    proxies: filtered,
    stats: {
      total: filtered.length,
      types: finalTypes,
      errors: errors
    }
  };
}

