function resolvePathSuffix(preset, contextVars = {}) {
  if (!preset) return "";
  let s = preset.pathSuffix || "";
  if (!s) return "";
  const uuidVal = contextVars.UUID || contextVars.uuid || "";
  if (s.includes("{UUID}") && uuidVal) {
    s = s.replace("{UUID}", uuidVal);
  }
  if (s.includes("{uuid}") && uuidVal) {
    s = s.replace("{uuid}", uuidVal);
  }
  if (s.includes("{ADMIN_KEY}")) {
    const adminKey = contextVars.ADMIN_KEY || "";
    s = s.replace("{ADMIN_KEY}", adminKey);
  }
  if (s.includes("{SECRET}")) {
    const sec = contextVars.SECRET || "";
    s = s.replace("{SECRET}", sec);
  }
  if ((preset.id === "faceless-bot" || preset.id === "faceless_chat_bot") && contextVars && contextVars.WEBHOOK_SECRET) {
    return "/setup?secret=" + encodeURIComponent(contextVars.WEBHOOK_SECRET);
  }
  return s;
}



