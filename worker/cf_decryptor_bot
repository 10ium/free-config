    const mihomoProfiles2 = cleanProfiles;
    if (mihomoProfiles2.length > 0) {
      const yamlStr = buildMihomoConfig(mihomoProfiles2, { ...filterOptions, skipFilter: true });
      const count = mihomoProfiles2.length;
      const caption = `\u{1F431} <b>\u06A9\u0627\u0646\u0641\u06CC\u06AF \u06A9\u0627\u0645\u0644 Mihomo (Clash.Meta) \u0622\u0645\u0627\u062F\u0647 \u0634\u062F</b> \u26A1
\u{1F4CA} \u062A\u0639\u062F\u0627\u062F \u067E\u0631\u0648\u06A9\u0633\u06CC\u200C\u0647\u0627\u06CC \u0645\u0639\u062A\u0628\u0631: <b>${count}</b> \u0639\u062F\u062F
\u{1F1EE}\u{1F1F7} \u0628\u0627\u06CC\u200C\u067E\u0633 \u0633\u0627\u06CC\u062A\u200C\u0647\u0627\u06CC \u0627\u06CC\u0631\u0627\u0646\u06CC \u0648 \u062A\u0641\u06A9\u06CC\u06A9 \u0647\u0648\u0634\u0645\u0646\u062F
\u{1F916} \u06AF\u0631\u0648\u0647\u200C\u0647\u0627\u06CC \u062A\u0641\u06A9\u06CC\u06A9\u200C\u0634\u062F\u0647: \u062E\u0648\u062F\u06A9\u0627\u0631 (\u0628\u0647\u062A\u0631\u06CC\u0646 \u067E\u06CC\u0646\u06AF) \u0648 \u062F\u0633\u062A\u06CC
\u{1F18E} \u0645\u0633\u062F\u0648\u062F\u0633\u0627\u0632\u06CC \u062A\u0628\u0644\u06CC\u063A\u0627\u062A \u0641\u0639\u0627\u0644 \u0634\u062F.${statsText}`;
      await bot.sendDocument(chatId, Buffer.from(yamlStr, "utf8"), `${baseName}_clash.yaml`, {
        caption,
        messageThreadId: threadId,
        replyMarkup: subDeliveryMarkup
      });
    } else {
      await bot.sendMessage(chatId, `\u26A0\uFE0F \u0647\u06CC\u0686 \u067E\u0631\u0648\u06A9\u0633\u06CC \u0633\u0627\u0632\u06AF\u0627\u0631 \u0628\u0627 \u0647\u0633\u062A\u0647 Mihomo \u062F\u0631 \u0648\u0631\u0648\u062F\u06CC\u200C\u0647\u0627\u06CC \u0627\u0631\u0633\u0627\u0644\u06CC \u06CC\u0627\u0641\u062A \u0646\u0634\u062F.${statsText}`, {
        messageThreadId: threadId
      });
    }
    await deliverDnsCompanionFile();
    return;
