
function safeJsonArray(val) {
  if (!val) return [];
  if (Array.isArray(val)) return val;
  try {
    const res = JSON.parse(val);
    return Array.isArray(res) ? res : [];
  } catch {
    return [];
  }
}

function safeJsonArrayOrItem(val) {
  if (!val) return [];
  if (Array.isArray(val)) return val;
  try {
    const res = JSON.parse(val);
    if (Array.isArray(res)) return res;
    return [res];
  } catch {
    return [val];
  }
}

