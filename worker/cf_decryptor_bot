              <div style="font-size: 0.75rem; color: var(--text-muted);">\u{1F4E5} \u06A9\u0644 \u0648\u0631\u0648\u062F\u06CC\u200C\u0647\u0627</div>
              <div id="statTotal" style="font-size: 1.2rem; font-weight: 800; color: #38bdf8;">0</div>
            </div>
            <div style="background: #111827; padding: 10px; border-radius: 10px; text-align: center; border: 1px solid #1e293b;">
              <div style="font-size: 0.75rem; color: var(--text-muted);">\u2705 \u0633\u0627\u0644\u0645 \u0648 \u0641\u0639\u0627\u0644</div>
              <div id="statValid" style="font-size: 1.2rem; font-weight: 800; color: #10b981;">0</div>
            </div>
            <div style="background: #111827; padding: 10px; border-radius: 10px; text-align: center; border: 1px solid #1e293b;">
              <div style="font-size: 0.75rem; color: var(--text-muted);">\u{1F504} \u062A\u06A9\u0631\u0627\u0631\u06CC\u200C\u0647\u0627\u06CC \u062D\u0630\u0641\u200C\u0634\u062F\u0647</div>
              <div id="statDuplicates" style="font-size: 1.2rem; font-weight: 800; color: #f59e0b;">0</div>
            </div>
            <div style="background: #111827; padding: 10px; border-radius: 10px; text-align: center; border: 1px solid #1e293b;">
              <div style="font-size: 0.75rem; color: var(--text-muted);">\u{1F6AB} \u0641\u06CC\u06A9 \u0648 \u062E\u0631\u0627\u0628\u200C\u0647\u0627</div>
              <div id="statRejected" style="font-size: 1.2rem; font-weight: 800; color: #ef4444;">0</div>
