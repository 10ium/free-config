function renderWebDashboard() {
  return "<!DOCTYPE html>\r\n<html lang=\"fa\" dir=\"rtl\">\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n  <title>ClashFa Deployer & Orchestrator</title>\r\n  <script src=\"https://cdn.tailwindcss.com\">\r\n    function copyText(val, btn) {\r\n      navigator.clipboard.writeText(val).then(() => {\r\n        const orig = btn.innerHTML;\r\n        btn.innerHTML = '✅ کپی شد!';\r\n        btn.classList.add('bg-emerald-600', 'text-white');\r\n        setTimeout(() => {\r\n          btn.innerHTML = orig;\r\n          btn.classList.remove('bg-emerald-600', 'text-white');\r\n        }, 2000);\r\n      }).catch(() => {\r\n        alert('مقدار: ' + val);\r\n      });\r\n    }\r\n\r\n    function showDeploySuccessModal(name, url, vars, preset) {\r\n      let modal = document.getElementById('success-result-modal');\r\n      if (!modal) {\r\n        modal = document.createElement('div');\r\n        modal.id = 'success-result-modal';\r\n        modal.className = 'fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4';\r\n        document.body.appendChild(modal);\r\n      }\r\n\r\n      let varsHtml = '';\r\n      if (vars && Object.keys(vars).length > 0) {\r\n        varsHtml += '<div class=\"mt-4 border-t border-slate-800 pt-3\"><p class=\"text-xs font-bold text-slate-300 mb-2\">🔑 مشخصات و متغیرهای ثبت‌شده:</p>';\r\n        for (const [k, v] of Object.entries(vars)) {\r\n          const displayKey = k.startsWith('D1_ID_') ? k.replace('D1_ID_', 'D1_DB_') : k;\r\n          if (k === 'BOT_USERNAME' && v) {\r\n            const cleanUser = v.toString().replace(/^@/, '');\r\n            varsHtml += '<div class=\"flex items-center justify-between bg-slate-900 border border-indigo-900/50 rounded-xl p-2.5 mb-2\">' +\r\n              '<div class=\"flex flex-col text-right overflow-hidden mr-2\">' +\r\n                '<span class=\"text-[11px] text-indigo-400 font-mono font-bold\">🤖 آیدی ربات تلگرام:</span>' +\r\n                '<a href=\"https://t.me/' + cleanUser + '\" target=\"_blank\" class=\"text-xs text-indigo-300 font-mono font-medium hover:underline flex items-center gap-1\">@' + cleanUser + ' ↗</a>' +\r\n              '</div>' +\r\n              '<a href=\"https://t.me/' + cleanUser + '\" target=\"_blank\" class=\"px-3 py-1 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-xs font-medium transition shrink-0 flex items-center gap-1\">ورود به ربات 🚀</a>' +\r\n            '</div>';\r\n          } else {\r\n            varsHtml += '<div class=\"flex items-center justify-between bg-slate-900 border border-slate-800 rounded-xl p-2.5 mb-2\">' +\r\n              '<div class=\"flex flex-col text-right overflow-hidden mr-2\">' +\r\n                '<span class=\"text-[11px] text-slate-400 font-mono\">' + displayKey + '</span>' +\r\n                '<span class=\"text-xs text-emerald-400 font-mono font-medium truncate\">' + v + '</span>' +\r\n              '</div>' +\r\n              '<button onclick=\"copyText(\\'' + v + '\\', this)\" class=\"px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-xs font-medium transition shrink-0\">📋 کپی</button>' +\r\n            '</div>';\r\n          }\r\n        }\r\n        varsHtml += '</div>';\r\n      }\r\n\r\n      let panelNotice = '';\r\n      if (preset) {\r\n        if (preset.id === 'netra_panel') {\r\n          panelNotice = '<div class=\"mt-3 p-3 bg-indigo-950/40 border border-indigo-800/40 rounded-xl text-xs text-indigo-200 leading-relaxed\">🖥️ <b>اطلاعات پنل نترا:</b> مسیر پنل <code>/panel</code> و متغیر KV متصل شد. در ورود اول رمز دلخواه خود را تعیین کنید.</div>';\r\n        } else if (preset.id === 'nahan') {\r\n          panelNotice = '<div class=\"mt-3 p-3 bg-indigo-950/40 border border-indigo-800/40 rounded-xl text-xs text-indigo-200 leading-relaxed\">🖥️ <b>اطلاعات پنل نهان:</b> مسیر پنل <code>/sync/dash</code> و نام کاربری/رمز پیش‌فرض <code>admin</code> است.</div>';\r\n        } else if (preset.id === 'irnova') {\r\n          panelNotice = '<div class=\"mt-3 p-3 bg-indigo-950/40 border border-indigo-800/40 rounded-xl text-xs text-indigo-200 leading-relaxed\">🖥️ <b>اطلاعات پنل نوا:</b> مسیر پنل <code>/admin</code> و رمز پیش‌فرض <code>admin123</code> است.</div>';\r\n        } else if (preset.id === 'hamed_panel') {\r\n          panelNotice = '<div class=\"mt-3 p-3 bg-indigo-950/40 border border-indigo-800/40 rounded-xl text-xs text-indigo-200 leading-relaxed\">🖥️ <b>مشخصات ورود به پنل حامد (Aurora):</b><br>🔹 مسیر ورود: <code>/panel</code><br>🔹 نام کاربری: <b class=\"text-emerald-400 font-mono\">admin</b><br>🔹 رمز عبور (Master Key): <b class=\"text-emerald-400 font-mono\">admin</b><br>🔹 دیتابیس ابری D1 (بایندینگ IOT_DB) متصل شد.</div>';\r\n        } else if (preset.id === 'apex_panel') {\r\n          panelNotice = '<div class=\"mt-3 p-3 bg-indigo-950/40 border border-indigo-800/40 rounded-xl text-xs text-indigo-200 leading-relaxed\">🖥️ <b>مشخصات ورود به پنل Apex (Netra):</b><br>🔹 مسیر ورود: <code>/apex/panel</code><br>🔹 دیتابیس D1 (بایندینگ netra) و جداول آماده شدند.<br>🔹 در اولین ورود نام کاربری و رمز دلخواه خود را ثبت کنید.</div>';\r\n        }\r\n      }\r\n\r\n      modal.innerHTML = '<div class=\"glass-card max-w-lg w-full rounded-2xl p-6 shadow-2xl border border-emerald-500/30 text-right\">' +\r\n        '<div class=\"flex items-center justify-between mb-4\">' +\r\n          '<h3 class=\"text-lg font-bold text-white flex items-center gap-2\">🎉 استقرار با موفقیت کامل انجام شد!</h3>' +\r\n          '<button onclick=\"document.getElementById(\\'success-result-modal\\').classList.add(\\'hidden\\')\" class=\"text-slate-400 hover:text-white text-xl\">&times;</button>' +\r\n        '</div>' +\r\n        '<p class=\"text-xs text-slate-400 mb-4\">پروژه <b>' + name + '</b> با موفقیت بر روی کلادفلر منتشر شد.</p>' +\r\n        '<div class=\"bg-slate-900 border border-slate-800 rounded-xl p-3 mb-3\">' +\r\n          '<div class=\"flex items-center justify-between mb-1\">' +\r\n            '<span class=\"text-xs text-slate-400 font-medium\">🌐 آدرس نهایی ورکر:</span>' +\r\n            '<button onclick=\"copyText(\\'' + (url || '') + '\\', this)\" class=\"px-2 py-0.5 bg-indigo-600/80 hover:bg-indigo-600 text-white rounded text-[11px] font-medium transition\">📋 کپی آدرس</button>' +\r\n          '</div>' +\r\n          '<a href=\"' + (url || '#') + '\" target=\"_blank\" class=\"text-xs text-indigo-400 hover:underline break-all font-mono\">' + (url || '') + '</a>' +\r\n        '</div>' +\r\n        panelNotice +\r\n        varsHtml +\r\n        '<div class=\"mt-6 flex justify-end\">' +\r\n          '<button onclick=\"document.getElementById(\\'success-result-modal\\').classList.add(\\'hidden\\')\" class=\"px-5 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-xs rounded-xl font-medium transition\">متوجه شدم و بستن</button>' +\r\n        '</div>' +\r\n      '</div>';\r\n\r\n      modal.classList.remove('hidden');\r\n    }\r\n\r\n  </script>\r\n  <link href=\"https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css\" rel=\"stylesheet\" type=\"text/css\" />\r\n  <style>\r\n    body { font-family: 'Vazirmatn', sans-serif; }\r\n    .glass { background: rgba(30, 41, 59, 0.75); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.1); }\r\n    .glass-card { background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(8px); border: 1px solid rgba(255, 255, 255, 0.08); }\r\n    ::-webkit-scrollbar { width: 6px; height: 6px; }\r\n    ::-webkit-scrollbar-track { background: #0f172a; }\r\n    ::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }\r\n    ::-webkit-scrollbar-thumb:hover { background: #475569; }\r\n  </style>\r\n</head>\r\n<body class=\"bg-slate-950 text-slate-100 min-h-screen flex flex-col\">\r\n  <!-- Navbar -->\r\n  <header class=\"sticky top-0 z-50 glass border-b border-slate-800 px-4 py-3\">\r\n    <div class=\"max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-4\">\r\n      <div class=\"flex items-center gap-3\">\r\n        <div class=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-500 to-purple-600 flex items-center justify-center text-xl shadow-lg shadow-indigo-500/30\">\r\n          ⚡\r\n        </div>\r\n        <div>\r\n          <h1 class=\"font-bold text-lg text-white tracking-wide\">ClashFa Deployer & Orchestrator</h1>\r\n          <p class=\"text-xs text-slate-400\">سامانه جامع استقرار و مدیریت ورکرهای کلادفلر</p>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Navigation Tabs -->\r\n      <nav class=\"flex items-center gap-1 bg-slate-900/80 p-1 rounded-xl border border-slate-800 text-sm\">\r\n        <button onclick=\"switchTab('templates')\" id=\"tab-templates\" class=\"tab-btn px-4 py-2 rounded-lg font-medium transition bg-indigo-600 text-white\">🚀 قالب‌ها</button>\r\n        <button onclick=\"switchTab('workers')\" id=\"tab-workers\" class=\"tab-btn px-4 py-2 rounded-lg font-medium transition text-slate-400 hover:text-white\">📂 مدیریت ورکرها</button>\r\n        <button onclick=\"switchTab('accounts')\" id=\"tab-accounts\" class=\"tab-btn px-4 py-2 rounded-lg font-medium transition text-slate-400 hover:text-white\">🔑 اکانت‌ها</button>\r\n        <button onclick=\"switchTab('logs')\" id=\"tab-logs\" class=\"tab-btn px-4 py-2 rounded-lg font-medium transition text-slate-400 hover:text-white\">📋 لاگ‌های سیستم</button>\r\n      </nav>\r\n\r\n      <!-- Refresh cache button -->\r\n      <div class=\"flex items-center gap-2\">\r\n        <button onclick=\"refreshPresetsCache()\" class=\"px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs rounded-lg border border-slate-700 flex items-center gap-1.5 transition\">\r\n          <span id=\"cache-icon\">🔄</span> بروزرسانی کش قالب‌ها\r\n        </button>\r\n      </div>\r\n    </div>\r\n  </header>\r\n\r\n  <!-- Main Content Area -->\r\n  <main class=\"flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6\">\r\n    <!-- Notice Banner -->\r\n    <div id=\"alert-banner\" class=\"hidden mb-6 p-4 rounded-xl border text-sm flex items-center justify-between transition\"></div>\r\n\r\n    <!-- TAB 1: TEMPLATES -->\r\n    <section id=\"content-templates\" class=\"tab-content\">\r\n      <div class=\"flex flex-wrap items-center justify-between gap-4 mb-6\">\r\n        <div>\r\n          <h2 class=\"text-xl font-bold text-white flex items-center gap-2\">🚀 قالب‌های آماده استقرار</h2>\r\n          <p class=\"text-sm text-slate-400\">انتخاب از میان <span id=\"presets-total-count\">۲۱</span> ورکر بهینه‌سازی‌شده برای کلش‌فا، پروکسی و دی‌ان‌اس</p>\r\n        </div>\r\n        <div class=\"flex items-center gap-2\">\r\n          <button id=\"cat-all-btn\" onclick=\"filterCategory('all')\" class=\"cat-filter px-3 py-1.5 rounded-lg text-xs font-medium bg-indigo-600 text-white\">همه (۲۱)</button>\r\n          <button id=\"cat-clashfa-btn\" onclick=\"filterCategory('clashfa')\" class=\"cat-filter px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-800 text-slate-400 hover:text-white\">کلش‌فا (۹)</button>\n          <button id=\"cat-tgproxy-btn\" onclick=\"filterCategory('tgproxy')\" class=\"cat-filter px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-800 text-slate-400 hover:text-white\">پروکسی تلگرام (۲)</button>\r\n          <button id=\"cat-config-btn\" onclick=\"filterCategory('config')\" class=\"cat-filter px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-800 text-slate-400 hover:text-white\">کانفیگ و پروکسی (۱۱)</button>\r\n          <button id=\"cat-dns-btn\" onclick=\"filterCategory('dns')\" class=\"cat-filter px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-800 text-slate-400 hover:text-white\">دی‌ان‌اس (۴)</button>\r\n        </div>\r\n      </div>\r\n\r\n      <div id=\"presets-grid\" class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\">\r\n        <!-- Injected via JS -->\r\n      </div>\r\n    </section>\r\n\r\n    <!-- TAB 2: WORKERS MANAGER -->\r\n    <section id=\"content-workers\" class=\"tab-content hidden\">\r\n      <div class=\"flex flex-wrap items-center justify-between gap-4 mb-6\">\r\n        <div>\r\n          <h2 class=\"text-xl font-bold text-white\">📂 مدیریت ورکرها و بایندینگ‌ها</h2>\r\n          <p class=\"text-sm text-slate-400\">مشاهده اسکریپت‌ها، دریافت سورس‌کد، تنظیمات متغیرها و حذف ورکرها</p>\r\n        </div>\r\n        <div class=\"flex items-center gap-3\">\r\n          <label class=\"text-xs text-slate-400\">انتخاب اکانت:</label>\r\n          <select id=\"workers-account-select\" onchange=\"loadWorkersList()\" class=\"bg-slate-900 border border-slate-700 text-slate-200 text-sm rounded-lg px-3 py-2 outline-none\">\r\n            <!-- Injected via JS -->\r\n          </select>\r\n          <button onclick=\"loadWorkersList()\" class=\"px-3 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-xs rounded-lg transition\">🔄 بروزرسانی لیست</button>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"glass-card rounded-2xl p-4 overflow-x-auto\">\r\n        <table class=\"w-full text-sm text-right\">\r\n          <thead class=\"text-xs text-slate-400 border-b border-slate-800\">\r\n            <tr>\r\n              <th class=\"p-3\">#</th>\r\n              <th class=\"p-3\">نام ورکر</th>\r\n              <th class=\"p-3\">آخرین بروزرسانی</th>\r\n              <th class=\"p-3\">لینک ورکر</th>\r\n              <th class=\"p-3 text-center\">عملیات</th>\r\n            </tr>\r\n          </thead>\r\n          <tbody id=\"workers-table-body\">\r\n            <tr><td colspan=\"5\" class=\"p-6 text-center text-slate-500\">در حال دریافت اطلاعات ورکرها...</td></tr>\r\n          </tbody>\r\n        </table>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- TAB 3: ACCOUNTS -->\r\n    <section id=\"content-accounts\" class=\"tab-content hidden\">\r\n      <div class=\"flex flex-wrap items-center justify-between gap-4 mb-6\">\r\n        <div>\r\n          <h2 class=\"text-xl font-bold text-white\">🔑 حساب‌های متصل کلادفلر</h2>\r\n          <p class=\"text-sm text-slate-400\">مدیریت توکن‌های API کلادفلر، بررسی مجوزها و ساب‌دامین ورکرز</p>\r\n        </div>\r\n        <button onclick=\"openAddAccountModal()\" class=\"px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-sm rounded-xl font-medium shadow-lg shadow-indigo-600/30 transition flex items-center gap-1.5\">\r\n          ➕ افزودن اکانت جدید\r\n        </button>\r\n      </div>\r\n\r\n      <div id=\"accounts-cards\" class=\"grid grid-cols-1 md:grid-cols-2 gap-5\">\r\n        <!-- Injected via JS -->\r\n      </div>\r\n    </section>\r\n\r\n    <!-- TAB 4: LOGS -->\r\n    <section id=\"content-logs\" class=\"tab-content hidden\">\r\n      <div class=\"flex flex-wrap items-center justify-between gap-4 mb-6\">\r\n        <div>\r\n          <h2 class=\"text-xl font-bold text-white\">📋 لاگ‌ها و رخدادهای سیستم</h2>\r\n          <p class=\"text-sm text-slate-400\">گزارش ۵۰ رخداد اخیر دیپلوی، تغییرات بایندینگ و ارتباطات با سرورها</p>\r\n        </div>\r\n        <div class=\"flex items-center gap-2\">\r\n          <button onclick=\"loadLogs()\" class=\"px-3 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs rounded-lg border border-slate-700 transition\">🔄 بروزرسانی لاگ‌ها</button>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"glass-card rounded-2xl p-4 overflow-x-auto\">\r\n        <table class=\"w-full text-xs text-right font-mono\">\r\n          <thead class=\"text-slate-400 border-b border-slate-800\">\r\n            <tr>\r\n              <th class=\"p-3 w-40\">زمان (تهران)</th>\r\n              <th class=\"p-3 w-28\">نوع</th>\r\n              <th class=\"p-3\">پیام رخداد</th>\r\n            </tr>\r\n          </thead>\r\n          <tbody id=\"logs-table-body\">\r\n            <tr><td colspan=\"3\" class=\"p-6 text-center text-slate-500\">در حال دریافت لاگ‌ها...</td></tr>\r\n          </tbody>\r\n        </table>\r\n      </div>\r\n    </section>\r\n  </main>\r\n\r\n  <!-- MODAL: DEPLOY WORKER -->\r\n  <div id=\"deploy-modal\" class=\"fixed inset-0 z-50 bg-black/70 backdrop-blur-sm hidden flex items-center justify-center p-4\">\r\n    <div class=\"glass max-w-xl w-full rounded-2xl p-6 border border-slate-700 shadow-2xl relative max-h-[90vh] flex flex-col\">\r\n      <div class=\"flex items-center justify-between border-b border-slate-800 pb-3 mb-4\">\r\n        <h3 id=\"modal-preset-title\" class=\"font-bold text-lg text-white\">استقرار ورکر</h3>\r\n        <button onclick=\"closeDeployModal()\" class=\"text-slate-400 hover:text-white text-xl\">&times;</button>\r\n      </div>\r\n\r\n      <div id=\"modal-form-body\" class=\"overflow-y-auto flex-1 space-y-4 pr-1\">\r\n        <!-- Injected via JS -->\r\n      </div>\r\n\r\n      <div class=\"border-t border-slate-800 pt-4 mt-4 flex items-center justify-end gap-3\">\r\n        <button onclick=\"closeDeployModal()\" class=\"px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-sm transition\">لغو</button>\r\n        <button id=\"btn-submit-deploy\" onclick=\"executeDeployFromWeb()\" class=\"px-5 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-sm font-medium shadow-lg shadow-indigo-600/30 transition flex items-center gap-2\">\r\n          <span>🚀 آغاز استقرار</span>\r\n        </button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- MODAL: BINDINGS MANAGER -->\r\n  <div id=\"bindings-modal\" class=\"fixed inset-0 z-50 bg-black/70 backdrop-blur-sm hidden flex items-center justify-center p-4\">\r\n    <div class=\"glass max-w-2xl w-full rounded-2xl p-6 border border-slate-700 shadow-2xl relative max-h-[85vh] flex flex-col\">\r\n      <div class=\"flex items-center justify-between border-b border-slate-800 pb-3 mb-4\">\r\n        <h3 id=\"modal-bindings-title\" class=\"font-bold text-lg text-white\">مدیریت بایندینگ‌های ورکر</h3>\r\n        <button onclick=\"closeBindingsModal()\" class=\"text-slate-400 hover:text-white text-xl\">&times;</button>\r\n      </div>\r\n\r\n      <div id=\"modal-bindings-body\" class=\"overflow-y-auto flex-1 space-y-3\">\r\n        <!-- Injected via JS -->\r\n      </div>\r\n\r\n      <div class=\"border-t border-slate-800 pt-4 mt-4 flex items-center justify-between\">\r\n        <button onclick=\"deleteAllBindingsWeb()\" class=\"px-4 py-2 bg-rose-600/20 hover:bg-rose-600/30 text-rose-400 border border-rose-600/30 rounded-xl text-xs transition\">💥 حذف همه بایندینگ‌ها</button>\r\n        <button onclick=\"closeBindingsModal()\" class=\"px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-sm transition\">بستن</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- MODAL: ADD ACCOUNT -->\r\n  <div id=\"add-account-modal\" class=\"fixed inset-0 z-50 bg-black/70 backdrop-blur-sm hidden flex items-center justify-center p-4\">\r\n    <div class=\"glass max-w-md w-full rounded-2xl p-6 border border-slate-700 shadow-2xl relative\">\r\n      <div class=\"flex items-center justify-between border-b border-slate-800 pb-3 mb-4\">\r\n        <h3 class=\"font-bold text-lg text-white\">➕ افزودن حساب کلادفلر</h3>\r\n        <button onclick=\"closeAddAccountModal()\" class=\"text-slate-400 hover:text-white text-xl\">&times;</button>\r\n      </div>\r\n\r\n      <div class=\"space-y-4 text-sm\">\r\n        <div>\r\n          <label class=\"block text-slate-400 mb-1 text-xs\">توکن اختصاصی کلادفلر (Cloudflare API Token):</label>\r\n          <input type=\"password\" id=\"input-cf-token\" placeholder=\"توکن API با دسترسی‌های کامل...\" class=\"w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-slate-200 outline-none focus:border-indigo-500 transition\">\r\n        </div>\r\n        <div class=\"bg-indigo-950/40 border border-indigo-800/40 rounded-xl p-3 text-xs text-indigo-300 leading-relaxed\">\r\n          💡 راهنما: برای عملکرد کامل سیستم، توکن شما باید شامل مجوزهای <b>Account.Workers Scripts:Edit</b> (شامل متغیرها و سکرت‌ها)، <b>Account.Cloudflare Pages:Edit</b>، <b>Account.Workers KV Storage:Edit</b>، <b>Account.D1:Edit</b> و <b>Account.Account Settings:Read</b> باشد.\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"border-t border-slate-800 pt-4 mt-6 flex items-center justify-end gap-3\">\r\n        <button onclick=\"closeAddAccountModal()\" class=\"px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-sm transition\">لغو</button>\r\n        <button id=\"btn-save-account\" onclick=\"saveNewAccountWeb()\" class=\"px-5 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-sm font-medium shadow-lg shadow-indigo-600/30 transition flex items-center gap-2\">\r\n          <span>تایید و اتصال</span>\r\n        </button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- Client JavaScript -->\r\n  <script>\r\n    let globalPresets = [];\r\n    let globalAccounts = [];\r\n    let activePreset = null;\r\n    let currentBindingsContext = null;\r\n\r\n    async function init() {\r\n      await loadPresets();\r\n      await loadAccounts();\r\n    }\r\n\r\n    function switchTab(tabId) {\r\n      document.querySelectorAll('.tab-btn').forEach(btn => {\r\n        btn.classList.remove('bg-indigo-600', 'text-white');\r\n        btn.classList.add('text-slate-400');\r\n      });\r\n      document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));\r\n\r\n      document.getElementById('tab-' + tabId).classList.add('bg-indigo-600', 'text-white');\r\n      document.getElementById('tab-' + tabId).classList.remove('text-slate-400');\r\n      document.getElementById('content-' + tabId).classList.remove('hidden');\r\n\r\n      if (tabId === 'workers') loadWorkersList();\r\n      if (tabId === 'logs') loadLogs();\r\n      if (tabId === 'accounts') renderAccounts();\r\n    }\r\n\r\n    function showAlert(message, type) {\r\n      const banner = document.getElementById('alert-banner');\r\n      banner.classList.remove('hidden', 'bg-emerald-950/60', 'border-emerald-800', 'text-emerald-300', 'bg-rose-950/60', 'border-rose-800', 'text-rose-300', 'bg-indigo-950/60', 'border-indigo-800', 'text-indigo-300');\r\n      if (type === 'success') {\r\n        banner.classList.add('bg-emerald-950/60', 'border-emerald-800', 'text-emerald-300');\r\n      } else if (type === 'error') {\r\n        banner.classList.add('bg-rose-950/60', 'border-rose-800', 'text-rose-300');\r\n      } else {\r\n        banner.classList.add('bg-indigo-950/60', 'border-indigo-800', 'text-indigo-300');\r\n      }\r\n      banner.innerHTML = '<span>' + message + '</span><button onclick=\"this.parentElement.classList.add(\\'hidden\\')\" class=\"text-xs opacity-70 hover:opacity-100\">&times;</button>';\r\n      setTimeout(() => banner.classList.add('hidden'), 8000);\r\n    }\r\n\r\n    async function loadPresets() {\r\n      try {\r\n        const res = await fetch('/api/presets');\r\n        globalPresets = await res.json();\r\n        updateCategoryCounts();\r\n        renderPresets(globalPresets);\r\n      } catch (err) {\r\n        console.error(\"Presets loading error:\", err);\r\n      }\r\n    }\r\n\r\n    function updateCategoryCounts() {\r\n      if (!globalPresets) return;\r\n      const totalCount = globalPresets.length;\r\n      const clashfaCount = globalPresets.filter(p => p.category === 'clashfa').length;\r\n      const configCount = globalPresets.filter(p => p.category === 'config').length;\r\n      const dnsCount = globalPresets.filter(p => p.category === 'dns').length;\r\n\r\n      const totalEl = document.getElementById('presets-total-count');\r\n      if (totalEl) totalEl.textContent = totalCount;\r\n      const btnAll = document.getElementById('cat-all-btn');\r\n      if (btnAll) btnAll.textContent = 'همه (' + totalCount + ')';\r\n      const btnClashfa = document.getElementById('cat-clashfa-btn');\r\n      if (btnClashfa) btnClashfa.textContent = 'کلش‌فا (' + clashfaCount + ')';\r\n      const btnConfig = document.getElementById('cat-config-btn');\r\n      if (btnConfig) btnConfig.textContent = 'کانفیگ و پروکسی (' + configCount + ')';\r\n      const btnDns = document.getElementById('cat-dns-btn');\r\n      if (btnDns) btnDns.textContent = 'دی‌ان‌اس (' + dnsCount + ')';\r\n    }\r\n\r\n    const SENSITIVE_KEYWORDS = [\r\n      \"vpn\", \"vless\", \"vmess\", \"trojan\", \"shadowsocks\", \"shadowtls\",\r\n      \"proxy\", \"proxies\", \"sub\", \"subs\", \"subscription\",\r\n      \"filter\", \"antifilter\", \"bypass\", \"censor\", \"censorship\",\r\n      \"warp\", \"tuic\", \"hysteria\", \"hy2\", \"wireguard\", \"v2ray\", \"xray\", \"singbox\"\r\n    ];\r\n\r\n    const PRESET_SAFE_IDENTIFIERS = {\r\n      iptv_player: \"iptv\",\r\n      irnova: \"irnova\",\r\n      nahan: \"nahan\",\r\n      edgetunnel: \"edgetunnel\",\r\n      netra_panel: \"netra-panel\",\r\n      hamed_panel: \"hamed-panel\",\r\n      apex_panel: \"apex-panel\",\r\n      cf_proxy_eooce: \"eooce-node\",\r\n      foxcloud: \"foxcloud\",\r\n      emotional_damage: \"emotional-damage\",\r\n      cf_vless_trojan_yongge: \"cf-yongge\",\r\n      clashfa_mirror: \"clashfa-mirror\",\r\n      mihomo_converter: \"mihomo-convert\",\r\n      tg_proxy_assistant: \"tg-assistant\",\r\n      iran_proxy: \"iran-relay\",\r\n      \"faceless-bot\": \"faceless-bot\",\r\n      clashfa_cf_deployer_bot: \"clashfa-deployer\",\r\n      doh_4n0nymou3: \"doh-4n0nymou3\",\r\n      doh_thegreatazizi: \"doh-azizi\",\r\n      doh_code3_dev: \"doh-code3\",\r\n      doh_seramo: \"doh-seramo\"\r\n    };\r\n\r\n    function getInitialSafeName(preset) {\r\n      let base = \"\";\r\n      if (preset && preset.id && PRESET_SAFE_IDENTIFIERS[preset.id]) {\r\n        base = PRESET_SAFE_IDENTIFIERS[preset.id];\r\n      } else if (preset && (preset.id || preset.name)) {\r\n        let raw = (preset.id || preset.name).toLowerCase()\r\n          .replace(/[^a-z0-9]+/g, \"-\")\r\n          .replace(/^-+|-+$/g, \"\");\r\n        let parts = raw.split(\"-\").filter(p => p && !SENSITIVE_KEYWORDS.some(sw => p.includes(sw)));\r\n        base = parts.join(\"-\");\r\n      }\r\n      if (!base || base.length < 3) {\r\n        base = (preset && preset.platform === \"pages\") ? \"web-page\" : \"edge-worker\";\r\n      }\r\n      if (preset && preset.platform === \"pages\" && !base.includes(\"page\")) {\r\n        base = base + \"-page\";\r\n      }\r\n      const randNum = Math.floor(100 + Math.random() * 900);\r\n      return (base + \"-\" + randNum).replace(/-+/g, \"-\").replace(/^-+|-+$/g, \"\");\r\n    }\r\n\r\n    function autoGenerateDeployName() {\r\n      const name = getInitialSafeName(activePreset);\r\n      const input = document.getElementById('deploy-worker-name');\r\n      if (input) input.value = name;\r\n    }\r\n\r\n    function renderPresets(presets) {\r\n      const container = document.getElementById('presets-grid');\r\n      container.innerHTML = presets.map((p) => {\r\n        let kvBadge = (p.kvBindings && p.kvBindings.length > 0) ? '<span class=\"bg-indigo-950/80 text-indigo-300 px-1.5 py-0.5 rounded border border-indigo-800/50\">KV</span>' : '';\r\n        let d1Badge = (p.vars && p.vars.some(v => v.startsWith('D1_'))) ? '<span class=\"bg-amber-950/80 text-amber-300 px-1.5 py-0.5 rounded border border-amber-800/50\">D1</span>' : '';\r\n        let varsBadge = (p.vars && p.vars.length > 0) ? '<span class=\"bg-slate-800 text-slate-300 px-1.5 py-0.5 rounded\">' + p.vars.length + ' متغیر</span>' : '';\r\n\r\n        return '<div class=\"glass-card rounded-2xl p-5 flex flex-col justify-between hover:border-indigo-500/50 transition group\">' +\r\n          '<div>' +\r\n            '<div class=\"flex items-center justify-between gap-2 mb-3\">' +\r\n              '<span class=\"px-2.5 py-1 rounded-md text-[11px] font-medium bg-slate-800 text-slate-300 border border-slate-700\">' + getCatTitle(p.category) + '</span>' +\r\n              '<span class=\"text-xs text-slate-500 font-mono\">#' + p.id + '</span>' +\r\n            '</div>' +\r\n            '<h3 class=\"font-bold text-base text-white group-hover:text-indigo-400 transition mb-2\">' + p.name + '</h3>' +\r\n            '<p class=\"text-xs text-slate-400 line-clamp-3 leading-relaxed mb-4\">' + (p.summary || p.description || 'بدون توضیح') + '</p>' +\r\n          '</div>' +\r\n          '<div class=\"border-t border-slate-800/80 pt-4 flex items-center justify-between gap-2\">' +\r\n            '<div class=\"flex items-center gap-1.5 text-[11px] text-slate-400\">' + kvBadge + d1Badge + varsBadge + '</div>' +\r\n            '<div class=\"flex items-center gap-2\">' +\r\n              '<button onclick=\"openPresetInfoModal(\\'' + p.id + '\\')\" class=\"px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs rounded-xl font-medium border border-slate-700 transition flex items-center gap-1\">ℹ️ توضیحات</button>' +\r\n              '<button onclick=\"openDeployModal(\\'' + p.id + '\\')\" class=\"px-3.5 py-1.5 bg-indigo-600 hover:bg-indigo-500 text-white text-xs rounded-xl font-medium shadow-md shadow-indigo-600/20 transition\">استقرار 🚀</button>' +\r\n            '</div>' +\r\n          '</div>' +\r\n        '</div>';\r\n      }).join('');\r\n    }\r\n\r\n    function getCatTitle(c) {\r\n      if (c === 'clashfa') return '🚀 کلش‌فا';\r\n      if (c === 'dns') return '🌐 دی‌ان‌اس';\r\n      if (c === 'config') return '🛰️ کانفیگ';\r\n      return 'سایر';\r\n    }\r\n\r\n    function filterCategory(cat) {\r\n      document.querySelectorAll('.cat-filter').forEach(b => {\r\n        b.classList.remove('bg-indigo-600', 'text-white');\r\n        b.classList.add('bg-slate-800', 'text-slate-400');\r\n      });\r\n      event.target.classList.add('bg-indigo-600', 'text-white');\r\n      event.target.classList.remove('bg-slate-800', 'text-slate-400');\r\n\r\n      if (cat === 'all') {\r\n        renderPresets(globalPresets);\r\n      } else {\r\n        renderPresets(globalPresets.filter(p => p.category === cat));\r\n      }\r\n    }\r\n\r\n    async function loadAccounts() {\r\n      try {\r\n        const res = await fetch('/api/accounts');\r\n        globalAccounts = await res.json();\r\n        renderAccounts();\r\n        updateAccountSelects();\r\n      } catch (err) {\r\n        console.error(\"Accounts error:\", err);\r\n      }\r\n    }\r\n\r\n    function updateAccountSelects() {\r\n      const select = document.getElementById('workers-account-select');\r\n      if (!select) return;\r\n      if (globalAccounts.length === 0) {\r\n        select.innerHTML = '<option value=\"\">هیچ حسابی متصل نیست</option>';\r\n        return;\r\n      }\r\n      select.innerHTML = globalAccounts.map((a, i) => '<option value=\"' + i + '\">' + a.name + ' (' + a.id.substring(0, 8) + '...)</option>').join('');\r\n    }\r\n\r\n    function renderAccounts() {\r\n      const container = document.getElementById('accounts-cards');\r\n      if (globalAccounts.length === 0) {\r\n        container.innerHTML = '<div class=\"col-span-2 p-8 text-center glass-card rounded-2xl text-slate-400\">هنوز هیچ حساب کلادفلری متصل نشده است. روی دکمه «افزودن اکانت جدید» کلیک کنید.</div>';\r\n        return;\r\n      }\r\n\r\n      container.innerHTML = globalAccounts.map((a, idx) => {\r\n        return '<div class=\"glass-card rounded-2xl p-5 border border-slate-800 relative\">' +\r\n          '<div class=\"flex items-center justify-between mb-4\">' +\r\n            '<div class=\"flex items-center gap-3\">' +\r\n              '<div class=\"w-10 h-10 rounded-xl bg-slate-800 flex items-center justify-center text-lg\">👤</div>' +\r\n              '<div>' +\r\n                '<h3 class=\"font-bold text-white text-base\">' + a.name + '</h3>' +\r\n                '<p class=\"text-xs text-slate-400 font-mono\">شناسه: ' + a.id + '</p>' +\r\n              '</div>' +\r\n            '</div>' +\r\n            '<button onclick=\"deleteAccountWeb(' + idx + ')\" class=\"text-rose-400 hover:text-rose-300 text-xs px-2.5 py-1 rounded-lg bg-rose-950/40 border border-rose-800/40 transition\">حذف اکانت</button>' +\r\n          '</div>' +\r\n          '<div class=\"bg-slate-900/90 rounded-xl p-3 text-xs space-y-2 mb-4\">' +\r\n            '<div class=\"flex items-center justify-between\">' +\r\n              '<span class=\"text-slate-400\">ساب‌دامین ورکرز:</span>' +\r\n              '<span class=\"font-mono text-indigo-300\">' + (a.subdomain || 'دریافت نشده') + '</span>' +\r\n            '</div>' +\r\n            '<div class=\"flex items-center justify-between\">' +\r\n              '<span class=\"text-slate-400\">توکن:</span>' +\r\n              '<span class=\"font-mono text-slate-500\">' + (a.tokenMasked || '••••••••••••') + '</span>' +\r\n            '</div>' +\r\n          '</div>' +\r\n          '<div class=\"flex items-center justify-between gap-2\">' +\r\n            '<button onclick=\"refreshSubdomainWeb(' + idx + ')\" class=\"px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs rounded-xl border border-slate-700 transition\">🔄 استعلام زنده ساب‌دامین</button>' +\r\n          '</div>' +\r\n        '</div>';\r\n      }).join('');\r\n    }\r\n\r\n    function openDeployModal(presetId) {\r\n      activePreset = globalPresets.find(p => p.id === presetId);\r\n      if (!activePreset) return;\r\n\r\n      document.getElementById('modal-preset-title').textContent = 'استقرار ' + activePreset.name;\r\n      const form = document.getElementById('modal-form-body');\r\n\r\n      let html = '<div>' +\r\n        '<label class=\"block text-xs text-slate-400 mb-1\">حساب مقصد کلادفلر:</label>' +\r\n        '<select id=\"deploy-acc-idx\" class=\"w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-sm text-slate-200 outline-none\">' +\r\n          globalAccounts.map((a, i) => '<option value=\"' + i + '\">' + a.name + '</option>').join('') +\r\n        '</select>' +\r\n      '</div>' +\r\n      '<div>' +\r\n        '<div class=\"flex items-center justify-between mb-1\">' +\r\n          '<label class=\"block text-xs text-slate-400 font-medium\">نام پروژه (' + ((activePreset && activePreset.platform === \"pages\") ? \"پیجز\" : \"ورکر\") + '):</label>' +\r\n          '<button type=\"button\" onclick=\"autoGenerateDeployName()\" class=\"text-[11px] text-indigo-400 hover:text-indigo-300 font-medium flex items-center gap-1 transition-colors\">' + ((activePreset && activePreset.platform === \"pages\") ? \"🎲 ساخت خودکار نام پیجز\" : \"🎲 ساخت خودکار نام ورکر\") + '</button>' +\r\n        '</div>' +\r\n        '<input type=\"text\" id=\"deploy-worker-name\" value=\"' + getInitialSafeName(activePreset) + '\" class=\"w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-sm text-slate-200 outline-none focus:border-indigo-500 transition\">' +\r\n      '</div>';\r\n\r\n      if (activePreset.vars && activePreset.vars.length > 0) {\r\n        html += '<div class=\"border-t border-slate-800 pt-3\"><p class=\"text-xs font-bold text-slate-300 mb-2\">متغیرهای محیطی قالب:</p>';\r\n        activePreset.vars.forEach(v => {\r\n          let placeholder = 'مقدار ' + v;\r\n          let isD1 = v.startsWith('D1_ID_');\r\n          html += '<div class=\"mb-3\">' +\r\n            '<div class=\"flex items-center justify-between mb-1\">' +\r\n              '<label class=\"text-xs text-slate-400 font-mono\">' + v + '</label>' +\r\n              '<button type=\"button\" onclick=\"autoFillVar(\\'' + v + '\\')\" class=\"text-[11px] text-indigo-400 hover:text-indigo-300\">🎲 مقدار خودکار</button>' +\r\n            '</div>' +\r\n            '<input type=\"text\" id=\"var-' + v + '\" placeholder=\"' + (isD1 ? 'شناسه دیتابیس D1 یا خالی برای ساخت خودکار' : placeholder) + '\" class=\"w-full bg-slate-900 border border-slate-700 rounded-xl p-2.5 text-sm text-slate-200 outline-none\">' +\r\n          '</div>';\r\n        });\r\n        html += '</div>';\r\n      }\r\n\r\n      form.innerHTML = html;\r\n      document.getElementById('deploy-modal').classList.remove('hidden');\r\n    }\r\n\r\n    function closeDeployModal() {\r\n      document.getElementById('deploy-modal').classList.add('hidden');\r\n    }\r\n\r\n    function autoFillVar(varName) {\r\n      const input = document.getElementById('var-' + varName);\r\n      if (!input) return;\r\n      if (varName === 'UUID' || varName === 'uuid') {\r\n        input.value = crypto.randomUUID();\r\n      } else if (varName.startsWith('D1_ID_')) {\r\n        input.value = 'auto';\r\n      } else if (varName === 'AES_KEY') {\r\n        input.value = Array.from(crypto.getRandomValues(new Uint8Array(16))).map(b => b.toString(16).padStart(2, '0')).join('');\r\n      } else if (varName === 'WEBHOOK_SECRET' || varName === 'SECRET_SALT') {\r\n        input.value = Math.random().toString(36).substring(2, 14);\r\n      } else if (varName === 'PROXY_IP' || varName === 'PROXYIP' || varName === 'proxyip') {\r\n        input.value = 'speed.cloudflare.com';\r\n      } else if (varName === 'SUB_PATH') {\r\n        input.value = '/sub/' + Math.random().toString(36).substring(2, 8);\r\n      } else {\r\n        input.value = Math.random().toString(36).substring(2, 10);\r\n      }\r\n    }\r\n\r\n    async function executeDeployFromWeb() {\r\n      if (!activePreset) return;\r\n      const accIdx = parseInt(document.getElementById('deploy-acc-idx').value, 10);\r\n      const workerName = document.getElementById('deploy-worker-name').value.trim();\r\n\r\n      if (!workerName) {\r\n        alert('لطفاً نام پروژه را وارد کنید.');\r\n        return;\r\n      }\r\n\r\n      const vars = {};\r\n      if (activePreset.vars) {\r\n        activePreset.vars.forEach(v => {\r\n          const el = document.getElementById('var-' + v);\r\n          if (el) vars[v] = el.value.trim();\r\n        });\r\n      }\r\n\r\n      const btn = document.getElementById('btn-submit-deploy');\r\n      btn.disabled = true;\r\n      btn.innerHTML = '<span>⏳ در حال استقرار...</span>';\r\n\r\n      try {\r\n        const res = await fetch('/api/deploy', {\r\n          method: 'POST',\r\n          headers: { 'Content-Type': 'application/json' },\r\n          body: JSON.stringify({\r\n            accIdx,\r\n            presetId: activePreset.id,\r\n            workerName,\r\n            vars\r\n          })\r\n        });\r\n        const data = await res.json();\r\n        if (data.success) {\r\n          closeDeployModal();\r\n          showDeploySuccessModal(workerName, data.url, data.finalVars, activePreset);\r\n          loadLogs();\r\n        } else {\r\n          showAlert('❌ خطا در استقرار: ' + (data.error || 'خطای نامشخص'), 'error');\r\n        }\r\n      } catch (err) {\r\n        showAlert('❌ خطا در ارتباط با سرور: ' + err.message, 'error');\r\n      } finally {\r\n        btn.disabled = false;\r\n        btn.innerHTML = '<span>🚀 آغاز استقرار</span>';\r\n      }\r\n    }\r\n\r\n    async function loadWorkersList() {\r\n      const select = document.getElementById('workers-account-select');\r\n      const tbody = document.getElementById('workers-table-body');\r\n      if (!select || !select.value) {\r\n        tbody.innerHTML = '<tr><td colspan=\"5\" class=\"p-6 text-center text-slate-500\">حسابی انتخاب نشده است.</td></tr>';\r\n        return;\r\n      }\r\n\r\n      const accIdx = parseInt(select.value, 10);\r\n      tbody.innerHTML = '<tr><td colspan=\"5\" class=\"p-6 text-center text-slate-400\">⏳ در حال دریافت لیست ورکرها از کلادفلر...</td></tr>';\r\n\r\n      try {\r\n        const res = await fetch('/api/workers?accIdx=' + accIdx);\r\n        const workers = await res.json();\r\n        if (!Array.isArray(workers) || workers.length === 0) {\r\n          tbody.innerHTML = '<tr><td colspan=\"5\" class=\"p-6 text-center text-slate-500\">هیچ ورکری در این اکانت یافت نشد.</td></tr>';\r\n          return;\r\n        }\r\n\r\n        tbody.innerHTML = workers.map((w, idx) => {\r\n          let rawSub = (globalAccounts[accIdx] && globalAccounts[accIdx].subdomain) ? globalAccounts[accIdx].subdomain.trim().replace(/^\\.+|\\.+$/g, \"\") : \"\";\r\n          let baseDomain = rawSub ? (rawSub.endsWith(\"workers.dev\") ? rawSub : rawSub + \".workers.dev\") : \"workers.dev\";\r\n          let workerUrl = \"https://\" + w.id + \".\" + baseDomain;\r\n          return '<tr class=\"border-b border-slate-800/60 hover:bg-slate-900/40 transition\">' +\r\n            '<td class=\"p-3 text-slate-500\">' + (idx + 1) + '</td>' +\r\n            '<td class=\"p-3 font-medium text-white font-mono\">' + w.id + '</td>' +\r\n            '<td class=\"p-3 text-xs text-slate-400\">' + new Date(w.modified_on).toLocaleDateString('fa-IR') + '</td>' +\r\n            '<td class=\"p-3 text-xs text-indigo-400 font-mono\"><a href=\"' + workerUrl + '\" target=\"_blank\" class=\"hover:underline\">مشاهده ↗</a></td>' +\r\n            '<td class=\"p-3 text-center\">' +\r\n              '<div class=\"flex items-center justify-center gap-2\">' +\r\n                '<button onclick=\"openBindingsModal(' + accIdx + ', \\'' + w.id + '\\')\" class=\"px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs rounded-lg transition\">⚙️ بایندینگ‌ها</button>' +\r\n                '<button onclick=\"downloadWorkerCodeWeb(' + accIdx + ', \\'' + w.id + '\\')\" class=\"px-2.5 py-1 bg-indigo-950/60 hover:bg-indigo-900/60 text-indigo-300 border border-indigo-800/40 text-xs rounded-lg transition\">📥 دانلود کد</button>' +\r\n                '<button onclick=\"deleteWorkerWeb(' + accIdx + ', \\'' + w.id + '\\')\" class=\"px-2.5 py-1 bg-rose-950/40 hover:bg-rose-900/40 text-rose-300 border border-rose-800/40 text-xs rounded-lg transition\">🗑️ حذف</button>' +\r\n              '</div>' +\r\n            '</td>' +\r\n          '</tr>';\r\n        }).join('');\r\n      } catch (err) {\r\n        tbody.innerHTML = '<tr><td colspan=\"5\" class=\"p-6 text-center text-rose-400\">خطا در دریافت اطلاعات: ' + err.message + '</td></tr>';\r\n      }\r\n    }\r\n\r\n    async function downloadWorkerCodeWeb(accIdx, workerName) {\r\n      try {\r\n        const res = await fetch('/a