\u0627\u06CC\u0646 \u067E\u0631\u0648\u062A\u06A9\u0644\u200C\u0647\u0627 \u062A\u0648\u0633\u0637 \u0647\u0633\u062A\u0647 Xray \u067E\u0634\u062A\u06CC\u0628\u0627\u0646\u06CC \u0646\u0645\u06CC\u200C\u0634\u0648\u0646\u062F\u060C \u0644\u0630\u0627 \u0627\u06CC\u0646 \u06A9\u0627\u0646\u0641\u06CC\u06AF\u200C\u0647\u0627 \u0628\u0647 \u0635\u0648\u0631\u062A \u0641\u0627\u06CC\u0644 \u0627\u062E\u062A\u0635\u0627\u0635\u06CC \u0647\u0633\u062A\u0647 Mihomo \u062A\u062D\u0648\u06CC\u0644 \u062F\u0627\u062F\u0647 \u0634\u062F\u0646\u062F.`,
      messageThreadId: threadId
    });
  }
  if (openvpnProfiles.length > 0) {
    await new Promise((r) => setTimeout(r, 400));
    const ovpnText = getOpenVpnContent(openvpnProfiles);
    await bot.sendDocument(chatId, Buffer.from(ovpnText, "utf8"), `${baseName}_OpenVPN.ovpn`, {
      caption: `\u26A0\uFE0F <b>\u062A\u0641\u06A9\u06CC\u06A9 \u0647\u0648\u0634\u0645\u0646\u062F \u0647\u0633\u062A\u0647\u200C\u0647\u0627:</b>
\u062A\u0639\u062F\u0627\u062F <b>${openvpnProfiles.length}</b> \u06A9\u0627\u0646\u0641\u06CC\u06AF OpenVPN \u0628\u0647 \u062F\u0644\u06CC\u0644 \u0639\u062F\u0645 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646\u06CC \u062F\u0631 \u0644\u06CC\u0646\u06A9\u200C\u0647\u0627\u06CC \u0627\u0634\u062A\u0631\u0627\u06A9 Xray\u060C \u0628\u0647 \u0635\u0648\u0631\u062A \u0627\u06CC\u0646 \u0641\u0627\u06CC\u0644 \u0645\u062C\u0632\u0627 \u062A\u062D\u0648\u06CC\u0644 \u062F\u0627\u062F\u0647 \u0634\u062F.`,
      messageThreadId: threadId
    });
  }
  if (sshProfiles.length > 0) {
    await new Promise((r) => setTimeout(r, 400));
    const sshText = formatSshText(sshProfiles);
    await bot.sendDocument(chatId, Buffer.from(sshText, "utf8"), `${baseName}_SSH.txt`, {
