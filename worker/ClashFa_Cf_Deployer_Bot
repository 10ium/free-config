function deriveFallbackSubdomain(accountName, accountId = "") {
  if (!accountName) return "";
  let clean = typeof accountName === "object" && accountName !== null ? (accountName.name || accountName.email || "") : String(accountName || "");
  const accId = typeof accountName === "object" && accountName !== null ? (accountName.id || accountId) : accountId;

  if (clean.includes("'s Account")) {
    clean = clean.replace(/'s Account/gi, "");
  }
  if (clean.includes("@")) {
    clean = clean.split("@")[0];
  }

  // Cloudflare converts all non-alphanumeric separators (dots, underscores, pluses, spaces) into hyphens
  let base = clean.toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/-+/g, "-")
    .replace(/^-+|-+$/g, "");

  if (base.length > 32) {
    base = base.substring(0, 32).replace(/-+$/, "");
  }

  if (base && base.length >= 3) {
    return base;
  }

  return accId ? `acc-${accId.substring(0, 8)}` : "worker";
}

// Subdomain Resolution System
async function getWorkerSubdomain(token, accountId, env, accountName = "") {
  // 1. Check KV Cache with self-healing check
  if (env && env.BOT_KV) {
    const cached = await env.BOT_KV.get(`subdomain:${accountId}`);
    if (cached && cached.trim()) {
      const cleanCached = cached.trim().replace(/^\.+|\.+$/g, "");
      const nameStr = typeof accountName === "string" ? accountName : (accountName?.name || "");
      if (!cleanCached.includes("-") && (nameStr.includes(".") || nameStr.includes("-"))) {
        const liveSub = await refreshWorkerSubdomainLive(token, accountId, env);
        if (liveSub && liveSub.trim()) return liveSub.trim().replace(/^\.+|\.+$/g, "");
      }
      return cleanCached;
    }
  }

  // 2. Fetch Live from Cloudflare API
  const liveSub = await refreshWorkerSubdomainLive(token, accountId, env);
  if (liveSub && liveSub.trim()) return liveSub.trim().replace(/^\.+|\.+$/g, "");

  // 3. Derive Intelligent Fallback (e.g. Quentin.10.coldwater@atomicmail.io -> quentin-10-coldwater)
  if (accountName) {
    const fallbackSub = deriveFallbackSubdomain(accountName, accountId);
    if (env && env.BOT_KV && fallbackSub) {
      await env.BOT_KV.put(`subdomain:${accountId}`, fallbackSub);
    }
    return fallbackSub.replace(/^\.+|\.+$/g, "");
  }
  return "";
}

async function refreshWorkerSubdomainLive(token, accountId, env = null) {
  try {
    const res = await fetchWithTimeout(`https://api.cloudflare.com/client/v4/accounts/${accountId}/workers/subdomain`, {
      headers: { 
        "Authorization": `Bearer ${token}`
      }
    }, 25000);
    const data = await res.json();
    if (data.success && data.result && data.result.subdomain) {
      const sub = data.result.subdomain.trim().replace(/^\.+|\.+$/g, "");
      if (env && env.BOT_KV) {
        await env.BOT_KV.put(`subdomain:${accountId}`, sub);
      }
      return sub;
