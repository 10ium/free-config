  const remainingMs = Math.max(0, (sub.expiresAt || 0) - Date.now());
  const remainingDays = Math.ceil(remainingMs / (1e3 * 86400));
  const totalConfigs = sub.profiles ? sub.profiles.length : sub.stats?.total || 0;
  const protoList = Object.entries(sub.stats?.protoCounts || {}).map(([pr, cnt]) => `<span class="proto-tag">${pr.toUpperCase()}: ${cnt}</span>`).join(" ");
  return `<!DOCTYPE html>
