// Universal Deployment URLs Resolver (Covers all scenarios: live subdomain, customized subdomain, custom domains, routes & Pages)
async function resolveDeploymentUrls(token, accountId, name, type, preset, vars, env, accountName = "") {
  let sub = "";

  if (type === "pages") {
    const defaultUrl = `https://${name}.pages.dev`;
    const pDomains = await getPagesCustomDomains(token, accountId, name);
    return {
      primaryUrl: defaultUrl,
      rawBaseUrl: defaultUrl,
      customUrls: pDomains.map(d => `https://${d}`),
      subdomain: name,
      pathSuffix: ""
    };
  }

  // Priority 1: Check live Cloudflare subdomain API (most authoritative source)
  sub = await refreshWorkerSubdomainLive(token, accountId, env);

  // Priority 2: Check KV cache if live API timed out or failed
  if (!sub || !sub.trim()) {
    if (env && env.BOT_KV && accountId) {
      sub = await env.BOT_KV.get(`subdomain:${accountId}`);
    }
  }

  // Priority 3: Derive intelligent fallback if live & KV are empty
  if (!sub || !sub.trim()) {
    sub = deriveFallbackSubdomain(accountName, accountId);
    if (sub && env && env.BOT_KV && accountId) {
      await env.BOT_KV.put(`subdomain:${accountId}`, sub);
    }
  }

  // Self-healing check: if cached sub has no hyphens but accountName had dots or hyphens
  if (sub) {
    const rawName = typeof accountName === "string" ? accountName : (accountName?.name || "");
    const cleanEmail = rawName.split("@")[0].replace(/'s Account/gi, "");
    if ((cleanEmail.includes(".") || cleanEmail.includes("-")) && !sub.includes("-")) {
      const reDerived = deriveFallbackSubdomain(accountName, accountId);
      if (reDerived && reDerived.includes("-")) {
        sub = reDerived;
        if (env && env.BOT_KV && accountId) {
          await env.BOT_KV.put(`subdomain:${accountId}`, sub);
        }
      }
    }
  }

  sub = sub ? sub.trim().replace(/^\.+|\.+$/g, "") : "";

  // Check for any Custom Domains bound to this worker script
  const wDomains = await getWorkerCustomDomains(token, accountId, name);

  const pathSuffix = preset ? resolvePathSuffix(preset, vars) : "";
  const rawBaseUrl = sub ? `https://${name}.${sub}.workers.dev` : `https://${name}.workers.dev`;
  const primaryUrl = `${rawBaseUrl}${pathSuffix}`;

  const customUrls = wDomains.map(d => `https://${d}${pathSuffix}`);

  return {
    rawBaseUrl,
    primaryUrl,
    customUrls,
    subdomain: sub,
    pathSuffix
  };
}

