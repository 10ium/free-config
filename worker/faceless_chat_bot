// src/handlers/message.ts
async function handleMessage(msg, env, db, tg) {
  const from = msg.from;
  if (!from || from.is_bot)
    return;
  const userHash = await hashUserId(from.id, env.SECRET_SALT);
  const text = (msg.text || "").trim();
  const chatType = msg.chat.type;
  if (chatType === "supergroup" || chatType === "group") {
    if (text === "/connect" || text === "/setgroup") {
      try {
        const member = await tg.getChatMember(msg.chat.id, from.id);
        if (member.status !== "administrator" && member.status !== "creator") {
          await tg.sendMessage(msg.chat.id, "\u274C \u0641\u0642\u0637 \u0645\u062F\u06CC\u0631\u0627\u0646 \u06AF\u0631\u0648\u0647 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u0646\u062F \u0627\u06CC\u0646 \u062F\u0633\u062A\u0648\u0631 \u0631\u0627 \u0627\u062C\u0631\u0627 \u06A9\u0646\u0646\u062F.");
          return;
        }
        await db.connectUserGroup(userHash, msg.chat.id);
        const memberCount = await tg.getChatMemberCount(msg.chat.id);
        let warning = "";
        if (memberCount > 2) {
          warning = `

\u26A0\uFE0F <b>\u062A\u0648\u062C\u0647:</b> \u0627\u06CC\u0646 \u06AF\u0631\u0648\u0647 \u062F\u0627\u0631\u0627\u06CC <b>${memberCount} \u0639\u0636\u0648</b> \u0627\u0633\u062A. \u0631\u0628\u0627\u062A \u0642\u0628\u0644 \u0627\u0632 \u0627\u0631\u0633\u0627\u0644 \u067E\u06CC\u0627\u0645 \u062A\u0648\u0633\u0637 \u0627\u0641\u0631\u0627\u062F \u0646\u0627\u0634\u0646\u0627\u0633\u060C \u0628\u0647 \u0622\u0646\u200C\u0647\u0627 \u0627\u0637\u0644\u0627\u0639 \u062E\u0648\u0627\u0647\u062F \u062F\u0627\u062F \u06A9\u0647 \u067E\u06CC\u0627\u0645\u0634\u0627\u0646 \u062F\u0631 \u0627\u06CC\u0646 \u06AF\u0631\u0648\u0647 \u0646\u0645\u0627\u06CC\u0634 \u062F\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F.`;
        }
        await tg.sendMessage(
          msg.chat.id,
          `\u2705 <b>\u0627\u06CC\u0646 \u06AF\u0631\u0648\u0647 \u062A\u0627\u067E\u06CC\u06A9\u200C\u062F\u0627\u0631 \u0628\u0627 \u0645\u0648\u0641\u0642\u06CC\u062A \u0628\u0647 \u0644\u06CC\u0646\u06A9 \u0646\u0627\u0634\u0646\u0627\u0633 \u0634\u0645\u0627 \u0645\u062A\u0635\u0644 \u0634\u062F!</b>
\u0627\u0632 \u0627\u06CC\u0646 \u067E\u0633 \u067E\u06CC\u0627\u0645\u200C\u0647\u0627\u06CC\u06CC \u06A9\u0647 \u0628\u0647 \u0644\u06CC\u0646\u06A9 \u0634\u0645\u0627 \u0627\u0631\u0633\u0627\u0644 \u0634\u0648\u0646\u062F\u060C \u0628\u0647 \u0635\u0648\u0631\u062A \u062A\u0627\u067E\u06CC\u06A9 \u062C\u062F\u0627\u06AF\u0627\u0646\u0647 \u062F\u0631 \u0627\u06CC\u0646 \u06AF\u0631\u0648\u0647 \u062F\u0631\u06CC\u0627\u0641\u062A \u062E\u0648\u0627\u0647\u0646\u062F \u0634\u062F.${warning}`
        );
      } catch (e) {
        console.error("Error connecting group:", e);
        await tg.sendMessage(
          msg.chat.id,
          "\u274C \u0627\u062A\u0635\u0627\u0644 \u06AF\u0631\u0648\u0647 \u0646\u0627\u0645\u0648\u0641\u0642 \u0628\u0648\u062F. \u0644\u0637\u0641\u0627\u064B \u0627\u0637\u0645\u06CC\u0646\u0627\u0646 \u062D\u0627\u0635\u0644 \u06A9\u0646\u06CC\u062F \u0631\u0628\u0627\u062A \u0627\u062F\u0645\u06CC\u0646 \u06AF\u0631\u0648\u0647 \u0627\u0633\u062A \u0648 \u062F\u0633\u062A\u0631\u0633\u06CC \u0645\u062F\u06CC\u0631\u06CC\u062A \u062A\u0627\u067E\u06CC\u06A9\u200C\u0647\u0627 \u0631\u0627 \u062F\u0627\u0631\u062F."
        );
      }
      return;
    }
    if (text === "/disconnect") {
      await db.disconnectUserGroup(userHash);
      await tg.sendMessage(
        msg.chat.id,
        "\u2705 \u0627\u062A\u0635\u0627\u0644 \u06AF\u0631\u0648\u0647 \u0642\u0637\u0639 \u0634\u062F. \u0627\u0632 \u0627\u06CC\u0646 \u067E\u0633 \u067E\u06CC\u0627\u0645\u200C\u0647\u0627\u06CC \u0646\u0627\u0634\u0646\u0627\u0633 \u0645\u062C\u062F\u062F\u0627\u064B \u0628\u0647 \u067E\u06CC\u200C\u0648\u06CC \u0634\u0645\u0627 \u062F\u0631 \u0631\u0628\u0627\u062A \u0627\u0631\u0633\u0627\u0644 \u062E\u0648\u0627\u0647\u0646\u062F \u0634\u062F."
      );
      return;
    }
    return;
  }
  let user = await db.getUserByHash(userHash);
  if (user && user.is_banned === 1) {
    await tg.sendMessage(from.id, "\u26D4\uFE0F \u062D\u0633\u0627\u0628 \u06A9\u0627\u0631\u0628\u0631\u06CC \u0634\u0645\u0627 \u0628\u0647 \u062F\u0644\u06CC\u0644 \u0646\u0642\u0636 \u0642\u0648\u0627\u0646\u06CC\u0646 \u0645\u0633\u062F\u0648\u062F \u0634\u062F\u0647 \u0627\u0633\u062A.");
    return;
  }
  if (!user) {
    const encryptedId = await encryptTgId(from.id, env.AES_KEY);
    const initialNickname = from.first_name || "\u0646\u0627\u0634\u0646\u0627\u0633";
    const linkToken = generateRandomToken(12);
    user = await db.createUser(
      userHash,
      encryptedId,
      initialNickname,
      linkToken,
      env.DEFAULT_DELIVERY_MODE || "direct"
    );
  }
  const adminIds = (env.ADMIN_IDS || "").split(",").map((s) => s.trim());
  const isAdmin = adminIds.includes(from.id.toString());
  if (text.startsWith("/start")) {
    const parts = text.split(" ");
    if (parts.length > 1 && parts[1].startsWith("u_")) {
      const targetToken = parts[1].replace("u_", "");
      await setupAnonymousChat(from.id, user, targetToken, db, tg, env);
      return;
    }
    const welcome = `\u{1F3AD} \u0628\u0647 \u0631\u0628\u0627\u062A \u067E\u06CC\u0627\u0645 \u0646\u0627\u0634\u0646\u0627\u0633 <b>Faceless</b> \u062E\u0648\u0634 \u0622\u0645\u062F\u06CC\u062F!

\u0627\u06CC\u0646\u062C\u0627 \u0647\u06CC\u0686 \u067E\u06CC\u0627\u0645\u06CC \u062F\u0631 \u0633\u0631\u0648\u0631 \u0630\u062E\u06CC\u0631\u0647 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u0647\u0648\u06CC\u062A \u0634\u0645\u0627 \u06A9\u0627\u0645\u0644\u0627\u064B \u0631\u0645\u0632\u0646\u06AF\u0627\u0631\u06CC \u0634\u062F\u0647 \u0648 \u0627\u0645\u0646 \u0627\u0633\u062A.

\u0644\u0642\u0628 \u0641\u0639\u0644\u06CC \u0634\u0645\u0627: <b>${user.nickname}</b>
\u0627\u0632 \u0645\u0646\u0648\u06CC \u0632\u06CC\u0631 \u0628\u0631\u0627\u06CC \u0645\u062F\u06CC\u0631\u06CC\u062A \u0648 \u062F\u0631\u06CC\u0627\u0641\u062A \u0644\u06CC\u0646\u06A9 \u0627\u062E\u062A\u0635\u0627\u0635\u06CC \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u06A9\u0646\u06CC\u062F:`;
    await tg.sendMessage(from.id, welcome, {
      reply_markup: mainMenuBar()
    });
    await tg.sendMessage(from.id, "\u{1F3E0} <b>\u0645\u0646\u0648\u06CC \u0627\u0635\u0644\u06CC:</b>", {
      reply_markup: mainMenuInlineKeyboard(user, env.BOT_USERNAME, isAdmin)
    });
    return;
  }
  if (text === "\u{1F3E0} \u0645\u0646\u0648" || text === "/menu") {
    await tg.sendMessage(from.id, "\u{1F3E0} <b>\u0645\u0646\u0648\u06CC \u0627\u0635\u0644\u06CC:</b>", {
      reply_markup: mainMenuInlineKeyboard(user, env.BOT_USERNAME, isAdmin)
    });
    return;
  }
  if (text === "/mylink") {
    const linkUrl = `https://t.me/${env.BOT_USERNAME}?start=u_${user.link_token}`;
    const txt = `\u{1F517} <b>\u0644\u06CC\u0646\u06A9 \u0627\u062E\u062A\u0635\u0627\u0635\u06CC \u067E\u06CC\u0627\u0645 \u0646\u0627\u0634\u0646\u0627\u0633 \u0634\u0645\u0627:</b>

<code>${linkUrl}</code>

\u0627\u06CC\u0646 \u0644\u06CC\u0646\u06A9 \u0631\u0627 \u062F\u0631 \u0628\u06CC\u0648 \u06CC\u0627 \u06A9\u0627\u0646\u0627\u0644 \u062E\u0648\u062F \u0642\u0631\u0627\u0631 \u062F\u0647\u06CC\u062F \u062A\u0627 \u0628\u0642\u06CC\u0647 \u0628\u062A\u0648\u0627\u0646\u0646\u062F \u0646\u0627\u0634\u0646\u0627\u0633 \u0628\u0647 \u0634\u0645\u0627 \u067E\u06CC\u0627\u0645 \u0628\u0641\u0631\u0633\u062A\u0646\u062F.`;
    await tg.sendMessage(from.id, txt, {
      reply_markup: linkManagementKeyboard(user.link_token, user.is_link_active === 1, env.BOT_USERNAME)
    });
    return;
  }
  if (text === "/settings") {
    const filters = await db.getMediaFilters(userHash);
    await tg.sendMessage(from.id, "\u2699\uFE0F <b>\u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u062D\u0633\u0627\u0628 \u06A9\u0627\u0631\u0628\u0631\u06CC \u0648 \u0641\u06CC\u0644\u062A\u0631 \u0631\u0633\u0627\u0646\u0647\u200C\u0647\u0627:</b>", {
      reply_markup: settingsKeyboard(user, filters)
    });
    return;
  }
  if (text === "/help") {
    const helpTxt = `\u{1F4D6} <b>\u0631\u0627\u0647\u0646\u0645\u0627 \u0648 \u0627\u0635\u0648\u0644 \u0627\u0645\u0646\u06CC\u062A \u062F\u0631 Faceless:</b>

