      <!-- Subscription URL Input -->
      <div class="sub-input-row">
        <input type="text" id="subInput" class="sub-input" placeholder="\u06CC\u0627 \u0644\u06CC\u0646\u06A9 \u0627\u0634\u062A\u0631\u0627\u06A9 (HTTP / HTTPS) \u0631\u0627 \u0627\u06CC\u0646\u062C\u0627 \u062C\u0627\u06CC\u200C\u06AF\u0630\u0627\u0631\u06CC \u06A9\u0646\u06CC\u062F...">
        <button id="subBtn" class="btn-primary">\u067E\u0631\u062F\u0627\u0632\u0634 \u0644\u06CC\u0646\u06A9</button>
