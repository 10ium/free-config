  if (!cleaned.startsWith('/')) return '';
  let cmd = cleaned.split(/[\s@]+/)[0].toLowerCase();
  if (cmd === '/no_ship' || cmd === '/no-ship') cmd = '/noship';
  if (cmd === '/ship_me' || cmd === '/ship-me') cmd = '/shipme';
  if (cmd === '/block_ship' || cmd === '/block-ship') cmd = '/blockship';
  return cmd;
}

