// src/db.ts
var Database = class {
  constructor(db) {
    this.db = db;
  }
  /**
   * دریافت اطلاعات کاربر با استفاده از هش شناسه
   */
  async getUserByHash(hash) {
    return await this.db.prepare("SELECT * FROM users WHERE user_id_hash = ?").bind(hash).first();
  }
  /**
   * دریافت اطلاعات کاربر با استفاده از توکن لینک اختصاصی
   */
  async getUserByLinkToken(token) {
    return await this.db.prepare("SELECT * FROM users WHERE link_token = ?").bind(token).first();
  }
  /**
   * ایجاد کاربر جدید به همراه فیلترهای رسانه پیش‌فرض
   */
  async createUser(hash, encryptedId, nickname, linkToken, deliveryMode = "direct") {
    await this.db.prepare(
      `INSERT INTO users (user_id_hash, encrypted_tg_id, nickname, link_token, delivery_mode)
         VALUES (?, ?, ?, ?, ?)`
    ).bind(hash, encryptedId, nickname, linkToken, deliveryMode).run();
    await this.db.prepare(
      `INSERT OR IGNORE INTO media_filters (user_id_hash)
         VALUES (?)`
    ).bind(hash).run();
    return await this.getUserByHash(hash);
  }
  /**
   * تغییر لقب کاربر
   */
  async updateNickname(hash, newNickname) {
    await this.db.prepare("UPDATE users SET nickname = ?, last_active = CURRENT_TIMESTAMP WHERE user_id_hash = ?").bind(newNickname, hash).run();
  }
  /**
   * تغییر و بازتولید توکن لینک اختصاصی (لینک قبلی باطل می‌شود)
   */
  async regenerateLinkToken(hash, newToken) {
    await this.db.prepare("UPDATE users SET link_token = ?, is_link_active = 1 WHERE user_id_hash = ?").bind(newToken, hash).run();
  }
  /**
   * تغییر وضعیت فعال بودن لینک اختصاصی
   */
  async toggleLinkActive(hash, active) {
    await this.db.prepare("UPDATE users SET is_link_active = ? WHERE user_id_hash = ?").bind(active ? 1 : 0, hash).run();
  }
  /**
   * تغییر وضعیت حالت استراحت (Vacation Mode)
   */
  async toggleVacation(hash) {
    const user = await this.getUserByHash(hash);
    if (!user)
      return false;
    const nextState = user.is_vacation === 1 ? 0 : 1;
    await this.db.prepare("UPDATE users SET is_vacation = ? WHERE user_id_hash = ?").bind(nextState, hash).run();
    return nextState === 1;
  }
  /**
   * تغییر حالت تحویل پیام (مستقیم یا پیش‌نمایش با تایید خوانده شدن)
   */
  async setDeliveryMode(hash, mode) {
    await this.db.prepare("UPDATE users SET delivery_mode = ? WHERE user_id_hash = ?").bind(mode, hash).run();
  }
  /**
   * تعیین محدودیت پیام در دقیقه اختصاصی برای کاربر (0 = خاموش)
   */
  async setPersonalRateLimit(hash, limit) {
    await this.db.prepare("UPDATE users SET personal_rate_limit = ? WHERE user_id_hash = ?").bind(limit, hash).run();
  }
  /**
   * بن یا آنبن سراسری کاربر توسط ادمین
   */
  async setGlobalBan(hash, banned) {
    await this.db.prepare("UPDATE users SET is_banned = ? WHERE user_id_hash = ?").bind(banned ? 1 : 0, hash).run();
  }
  // ----------------- فیلترهای رسانه -----------------
  async getMediaFilters(hash) {
    const row = await this.db.prepare("SELECT * FROM media_filters WHERE user_id_hash = ?").bind(hash).first();
    if (!row) {
      await this.db.prepare("INSERT OR IGNORE INTO media_filters (user_id_hash) VALUES (?)").bind(hash).run();
      return {
        user_id_hash: hash,
        allow_photo: 1,
        allow_video: 1,
        allow_voice: 1,
        allow_video_note: 1,
        allow_audio: 1,
        allow_document: 1,
        allow_sticker: 1,
        allow_web_preview: 1
      };
    }
    return row;
  }
  async toggleMediaFilter(hash, field) {
    const filters = await this.getMediaFilters(hash);
    const currentValue = filters[field];
    const newValue = currentValue === 1 ? 0 : 1;
    await this.db.prepare(`UPDATE media_filters SET ${String(field)} = ? WHERE user_id_hash = ?`).bind(newValue, hash).run();
    return newValue === 1;
  }
  // ----------------- مسدودسازی (بلاک) -----------------
  async isBlocked(blockerHash, blockedHash) {
    const row = await this.db.prepare("SELECT 1 FROM blocks WHERE blocker_hash = ? AND blocked_hash = ?").bind(blockerHash, blockedHash).first();
    return !!row;
  }
  async addBlock(blockerHash, blockedHash) {
    await this.db.prepare("INSERT OR IGNORE INTO blocks (blocker_hash, blocked_hash) VALUES (?, ?)").bind(blockerHash, blockedHash).run();
  }
  async removeBlock(blockerHash, blockedHash) {
    await this.db.prepare("DELETE FROM blocks WHERE blocker_hash = ? AND blocked_hash = ?").bind(blockerHash, blockedHash).run();
  }
  // ----------------- یادداشت‌های خصوصی و نام‌گذاری ادمین -----------------
  async getNote(ownerHash, targetHash) {
    return await this.db.prepare("SELECT * FROM user_notes WHERE owner_hash = ? AND target_hash = ?").bind(ownerHash, targetHash).first();
  }
  async saveNote(ownerHash, targetHash, noteText) {
    await this.db.prepare(
      `INSERT INTO user_notes (owner_hash, target_hash, note_text, updated_at)
         VALUES (?, ?, ?, CURRENT_TIMESTAMP)
         ON CONFLICT(owner_hash, target_hash) DO UPDATE SET note_text = excluded.note_text, updated_at = CURRENT_TIMESTAMP`
    ).bind(ownerHash, targetHash, noteText).run();
  }
  async saveAdminAlias(ownerHash, targetHash, alias) {
    await this.db.prepare(
      `INSERT INTO user_notes (owner_hash, target_hash, admin_alias, updated_at)
         VALUES (?, ?, ?, CURRENT_TIMESTAMP)
         ON CONFLICT(owner_hash, target_hash) DO UPDATE SET admin_alias = excluded.admin_alias, updated_at = CURRENT_TIMESTAMP`
    ).bind(ownerHash, targetHash, alias).run();
  }
  // ----------------- تاریخچه مکالمات -----------------
  async recordConversation(u1, u2) {
    const [first, second] = u1 < u2 ? [u1, u2] : [u2, u1];
    await this.db.prepare(
      `INSERT INTO conversations (user1_hash, user2_hash, last_message_at, is_active_for_user1, is_active_for_user2)
         VALUES (?, ?, CURRENT_TIMESTAMP, 1, 1)
         ON CONFLICT(user1_hash, user2_hash) DO UPDATE SET last_message_at = CURRENT_TIMESTAMP, is_active_for_user1 = 1, is_active_for_user2 = 1`
    ).bind(first, second).run();
  }
  async getContactsForUser(userHash) {
    const rows = await this.db.prepare(
      `SELECT user1_hash, user2_hash FROM conversations
         WHERE (user1_hash = ? AND is_active_for_user1 = 1)
            OR (user2_hash = ? AND is_active_for_user2 = 1)
         ORDER BY last_message_at DESC LIMIT 30`
    ).bind(userHash, userHash).all();
    return (rows.results || []).map((r) => r.user1_hash === userHash ? r.user2_hash : r.user1_hash);
  }
  async deleteContact(userHash, targetHash) {
    const [first, second] = userHash < targetHash ? [userHash, targetHash] : [targetHash, userHash];
    if (userHash === first) {
      await this.db.prepare("UPDATE conversations SET is_active_for_user1 = 0 WHERE user1_hash = ? AND user2_hash = ?").bind(first, second).run();
    } else {
      await this.db.prepare("UPDATE conversations SET is_active_for_user2 = 0 WHERE user1_hash = ? AND user2_hash = ?").bind(first, second).run();
    }
  }
  async clearAllContacts(userHash) {
    await this.db.prepare("UPDATE conversations SET is_active_for_user1 = 0 WHERE user1_hash = ?").bind(userHash).run();
    await this.db.prepare("UPDATE conversations SET is_active_for_user2 = 0 WHERE user2_hash = ?").bind(userHash).run();
  }
  // ----------------- نگاشت پیام‌ها جهت ویرایش، حذف و ری‌اکشن -----------------
  async saveMessageMapping(srcChatHash, srcMsgId, destChatHash, destMsgId) {
    await this.db.prepare(
      `INSERT INTO message_mappings (src_chat_hash, src_msg_id, dest_chat_hash, dest_msg_id)
         VALUES (?, ?, ?, ?)`
    ).bind(srcChatHash, srcMsgId, destChatHash, destMsgId).run();
  }
  async getMappingBySource(srcChatHash, srcMsgId) {
    return await this.db.prepare(
      "SELECT dest_chat_hash, dest_msg_id FROM message_mappings WHERE src_chat_hash = ? AND src_msg_id = ?"
    ).bind(srcChatHash, srcMsgId).first();
  }
  async getMappingByDest(destChatHash, destMsgId) {
    return await this.db.prepare(
      "SELECT src_chat_hash, src_msg_id FROM message_mappings WHERE dest_chat_hash = ? AND dest_msg_id = ?"
    ).bind(destChatHash, destMsgId).first();
  }
  async deleteMappingBySource(srcChatHash, srcMsgId) {
    const mapping = await this.getMappingBySource(srcChatHash, srcMsgId);
    if (mapping) {
      await this.db.prepare("DELETE FROM message_mappings WHERE src_chat_hash = ? AND src_msg_id = ?").bind(srcChatHash, srcMsgId).run();
    }
    return mapping;
  }
  // ----------------- گروه‌های متصل‌شده کاربران و تاپیک‌های فروم -----------------
  async connectUserGroup(userHash, groupId) {
    await this.db.prepare(
      `INSERT INTO user_groups (user_hash, group_id, is_active)
         VALUES (?, ?, 1)
         ON CONFLICT(user_hash) DO UPDATE SET group_id = excluded.group_id, is_active = 1`
    ).bind(userHash, groupId).run();
  }
  async getUserConnectedGroup(userHash) {
    return await this.db.prepare("SELECT group_id, is_active FROM user_groups WHERE user_hash = ?").bind(userHash).first();
  }
  async disconnectUserGroup(userHash) {
    await this.db.prepare("UPDATE user_groups SET is_active = 0 WHERE user_hash = ?").bind(userHash).run();
  }
  async getForumTopic(recipientHash, senderHash, groupId) {
    const row = await this.db.prepare(
      "SELECT topic_id FROM forum_topics WHERE recipient_hash = ? AND sender_hash = ? AND group_id = ?"
    ).bind(recipientHash, senderHash, groupId).first();
    return row ? row.topic_id : null;
  }
  async saveForumTopic(recipientHash, senderHash, topicId, groupId) {
    await this.db.prepare(
      `INSERT INTO forum_topics (recipient_hash, sender_hash, topic_id, group_id)
         VALUES (?, ?, ?, ?)
         ON CONFLICT(recipient_hash, sender_hash, group_id) DO UPDATE SET topic_id = excluded.topic_id`
    ).bind(recipientHash, senderHash, topicId, groupId).run();
  }
  async getTopicMapping(groupId, topicId) {
    return await this.db.prepare(
      "SELECT recipient_hash, sender_hash FROM forum_topics WHERE group_id = ? AND topic_id = ?"
    ).bind(groupId, topicId).first();
  }
  // ----------------- صف پیام‌های حالت استراحت -----------------
  async queueMessage(recipientHash, senderHash, fromChatId, messageId) {
    await this.db.prepare(
      `INSERT INTO message_queue (recipient_hash, sender_hash, from_chat_id, message_id)
         VALUES (?, ?, ?, ?)`
    ).bind(recipientHash, senderHash, fromChatId, messageId).run();
  }
  async getAndClearQueuedMessages(recipientHash) {
    const rows = await this.db.prepare("SELECT * FROM message_queue WHERE recipient_hash = ? ORDER BY id ASC").bind(recipientHash).all();
    if (rows.results && rows.results.length > 0) {
      await this.db.prepare("DELETE FROM message_queue WHERE recipient_hash = ?").bind(recipientHash).run();
    }
    return rows.results || [];
  }
  // ----------------- تنظیمات سراسری سیستم -----------------
  async getSetting(key, defaultVal = "") {
    const row = await this.db.prepare("SELECT value FROM system_settings WHERE key = ?").bind(key).first();
    return row ? row.value : defaultVal;
  }
  async setSetting(key, value) {
    await this.db.prepare(
      `INSERT INTO system_settings (key, value) VALUES (?, ?)
         ON CONFLICT(key) DO UPDATE SET value = excluded.value`
    ).bind(key, value).run();
  }
  // ----------------- سپر ضد اسپم و ریت لیمیت -----------------
  async checkRateLimit(senderHash, targetHash, maxPerMinute) {
    if (maxPerMinute <= 0)
      return true;
    const currentMinute = Math.floor(Date.now() / 6e4);
    const row = await this.db.prepare(
      "SELECT count FROM rate_limits WHERE sender_hash = ? AND target_hash = ? AND window_minute = ?"
    ).bind(senderHash, targetHash, currentMinute).first();
    if (row && row.count >= maxPerMinute) {
      return false;
    }
    await this.db.prepare(
      `INSERT INTO rate_limits (sender_hash, target_hash, window_minute, count)
         VALUES (?, ?, ?, 1)
         ON CONFLICT(sender_hash, target_hash, window_minute) DO UPDATE SET count = count + 1`
    ).bind(senderHash, targetHash, currentMinute).run();
    return true;
  }
};

// src/telegram.ts
var TelegramClient = class {
  constructor(botToken) {
    this.botToken = botToken;
    this.baseUrl = `https://api.telegram.org/bot${botToken}`;
  }
  baseUrl;
  async call(method, payload) {
    const response = await fetch(`${this.baseUrl}/${method}`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    });
    const data = await response.json();
    if (!data.ok) {
      console.error(`Telegram API error [${method}]:`, data.description, payload);
      throw new Error(`Telegram API [${method}] failed: ${data.description}`);
    }
    return data.result;
  }
  /**
   * ارسال پیام متنی
   */
  async sendMessage(chatId, text, options = {}) {
    return await this.call("sendMessage", {
      chat_id: chatId,
      text,
      parse_mode: options.parse_mode || "HTML",
      reply_markup: options.reply_markup,
      message_thread_id: options.message_thread_id,
      reply_to_message_id: options.reply_to_message_id,
      disable_web_page_preview: options.disable_web_page_preview
    });
  }
  /**
   * کپی پیام (انتقال انواع مدیا، متن، ویس و... بدون هدر فوروارد)
   */
  async copyMessage(chatId, fromChatId, messageId, options = {}) {
    return await this.call("copyMessage", {
      chat_id: chatId,
      from_chat_id: fromChatId,
      message_id: messageId,
      caption: options.caption,
      parse_mode: options.parse_mode || "HTML",
      reply_markup: options.reply_markup,
      message_thread_id: options.message_thread_id,
      reply_to_message_id: options.reply_to_message_id
    });
  }
  /**
   * ویرایش متن پیام قبلی
   */
  async editMessageText(chatId, messageId, text, options = {}) {
    return await this.call("editMessageText", {
      chat_id: chatId,
      message_id: messageId,
      text,
      parse_mode: options.parse_mode || "HTML",
      reply_markup: options.reply_markup,
      disable_web_page_preview: options.disable_web_page_preview
    });
  }
  /**
   * ویرایش کپشن رسانه قبلی
   */
  async editMessageCaption(chatId, messageId, caption, options = {}) {
    return await this.call("editMessageCaption", {
      chat_id: chatId,
      message_id: messageId,
      caption,
      parse_mode: options.parse_mode || "HTML",
      reply_markup: options.reply_markup
    });
  }
  /**
   * حذف یک پیام
   */
  async deleteMessage(chatId, messageId) {
    try {
      return await this.call("deleteMessage", { chat_id: chatId, message_id: messageId });
    } catch (e) {
      console.warn("deleteMessage failed or already deleted", e);
      return false;
    }
  }
  /**
   * ثبت ری‌اکشن به پیام (Telegram Bot API 7.0+)
   */
  async setMessageReaction(chatId, messageId, reactions, isBig = false) {
    try {
      return await this.call("setMessageReaction", {
        chat_id: chatId,
        message_id: messageId,
        reaction: reactions,
        is_big: isBig
      });
    } catch (e) {
      console.warn("setMessageReaction failed:", e);
      return false;
    }
  }
  /**
   * پاسخ به دکمه‌های شیشه‌ای اینلاین
   */
  async answerCallbackQuery(callbackQueryId, text, showAlert = false) {
    return await this.call("answerCallbackQuery", {
      callback_query_id: callbackQueryId,
      text,
      show_alert: showAlert
    });
  }
  /**
   * ساخت تاپیک اختصاصی در سوپرگروه دارای Forum
   */
  async createForumTopic(chatId, name) {
    return await this.call("createForumTopic", {
      chat_id: chatId,
      name
    });
  }
  /**
   * دریافت تعداد اعضای گروه (برای بررسی امنیت و تعداد اعضای غریبه)
   */
  async getChatMemberCount(chatId) {
    try {
      return await this.call("getChatMemberCount", { chat_id: chatId });
    } catch (e) {
      console.warn("getChatMemberCount failed:", e);
      return 2;
    }
  }
  /**
   * دریافت اطلاعات عضویت کاربر در گروه (جهت تایید ادمین/مالک بودن)
   */
  async getChatMember(chatId, userId) {
    return await this.call("getChatMember", { chat_id: chatId, user_id: userId });
  }
  /**
   * تنظیم منوی دستورات رسمی تلگرام (setMyCommands)
   */
  async setMyCommands(commands, scope = { type: "default" }) {
    return await this.call("setMyCommands", {
      commands,
      scope
    });
  }
  /**
   * ثبت وبهوک در سرورهای تلگرام
   */
  async setWebhook(url, secretToken) {
    return await this.call("setWebhook", {
      url,
      secret_token: secretToken,
      allowed_updates: ["message", "edited_message", "callback_query", "message_reaction", "my_chat_member"]
    });
  }
};

// src/crypto.ts
function toUint8Array(str) {
  return new TextEncoder().encode(str);
}
function toHex(buffer) {
  return Array.from(new Uint8Array(buffer)).map((b) => b.toString(16).padStart(2, "0")).join("");
}
async function hashUserId(userId, salt) {
  const key = await crypto.subtle.importKey(
    "raw",
    toUint8Array(salt),
    { name: "HMAC", hash: "SHA-256" },
    false,
    ["sign"]
  );
  const signature = await crypto.subtle.sign("HMAC", key, toUint8Array(userId.toString()));
  return toHex(signature);
}
async function getAesKey(rawKeyString) {
  const keyBuffer = await crypto.subtle.digest("SHA-256", toUint8Array(rawKeyString));
  return crypto.subtle.importKey("raw", keyBuffer, { name: "AES-GCM" }, false, ["encrypt", "decrypt"]);
}
async function encryptTgId(userId, secretKey) {
  const key = await getAesKey(secretKey);
  const iv = crypto.getRandomValues(new Uint8Array(12));
  const encrypted = await crypto.subtle.encrypt(
    { name: "AES-GCM", iv },
    key,
    toUint8Array(userId.toString())
  );
  const combined = new Uint8Array(iv.byteLength + encrypted.byteLength);
  combined.set(iv, 0);
  combined.set(new Uint8Array(encrypted), iv.byteLength);
  let binary = "";
  for (let i = 0; i < combined.byteLength; i++) {
    binary += String.fromCharCode(combined[i]);
  }
  return btoa(binary);
}
async function decryptTgId(encryptedBase64, secretKey) {
  const key = await getAesKey(secretKey);
  const binary = atob(encryptedBase64);
  const combined = new Uint8Array(binary.length);
  for (let i = 0; i < binary.length; i++) {
    combined[i] = binary.charCodeAt(i);
  }
  const iv = combined.slice(0, 12);
  const data = combined.slice(12);
  const decrypted = await crypto.subtle.decrypt(
    { name: "AES-GCM", iv },
    key,
    data
  );
  const decodedStr = new TextDecoder().decode(decrypted);
  const parsed = parseInt(decodedStr, 10);
  if (isNaN(parsed)) {
    throw new Error("\u0631\u0645\u0632\u06AF\u0634\u0627\u06CC\u06CC \u0622\u06CC\u062F\u06CC \u0646\u0627\u0645\u0648\u0641\u0642 \u0628\u0648\u062F.");
  }
  return parsed;
}
function generateRandomToken(length = 12) {
  const chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
  const array = new Uint8Array(length);
  crypto.getRandomValues(array);
  let result = "";
  for (let i = 0; i < length; i++) {
    result += chars[array[i] % chars.length];
  }
  return result;
}
function generateReportCaseId() {
  return "rep_" + generateRandomToken(8);
}

