// --- HELPER UTILITIES ---
function generateRandomString(charset, length) {
  let result = "";
  for (let i = 0; i < length; i++) {
    result += charset.charAt(Math.floor(Math.random() * charset.length));
  }
  return result;
}

function deriveFallbackSubdomain(accountName, accountId = "") {
  if (!accountName) return "";
  let clean = typeof accountName === "object" && accountName !== null ? (accountName.name || accountName.email || "") : String(accountName || "");
  const accId = typeof accountName === "object" && accountName !== null ? (accountName.id || accountId) : accountId;
  if (clean.includes("@")) {
    clean = clean.split("@")[0];
  } else if (clean.includes("'s Account")) {
    clean = clean.replace(/'s Account/gi, "");
  }
  let base = clean.toLowerCase().replace(/[^a-z0-9-]/g, "");
  if (!base && accId) {
    base = "cf-" + String(accId).replace(/[^a-z0-9]/gi, "").substring(0, 8);
  }
  if (base.length > 25) base = base.substring(0, 25);
  return base;
}

function autoGenerateVars(varList, context = {}) {
  const generated = {};
  varList.forEach(v => {
    if (v === "UUID" || v === "uuid") {
      const u = generated.UUID || generated.uuid || crypto.randomUUID();
      generated.UUID = u;
      generated.uuid = u;
    } else if (v === "TR_PASS" || v === "ADMIN_PASSWORD" || v === "ADMIN") {
      generated[v] = generateRandomString(CharsetTrojanPassword, 12);
    } else if (v === "SUB_PATH") {
      generated[v] = "/sub/" + generateRandomString(CharsetURIPath, 16);
    } else if (v === "PROXY_IP" || v === "PROXYIP" || v === "proxyip") {
      generated[v] = "speed.cloudflare.com";
    } else if (v === "PREFIX") {
      generated[v] = "BPB";
    } else if (v === "FALLBACK") {
      generated[v] = "speed.cloudflare.com";
    } else if (v === "PASSWORD") {
      generated[v] = generateRandomString(CharsetAlphaNumeric, 12);
    } else if (v === "KEY") {
      generated[v] = generateRandomString(CharsetAlphaNumeric, 32);
    } else if (v === "SOCKS5") {
      generated[v] = "";
    } else if (v.startsWith("D1_ID_")) {
      generated[v] = "auto";
    } else if (v === "AES_KEY") {
      const array = new Uint8Array(16);
      crypto.getRandomValues(array);
      generated[v] = Array.from(array, b => b.toString(16).padStart(2, '0')).join('');
    } else if (v === "WEBHOOK_SECRET") {
      generated[v] = generateRandomString(CharsetAlphaNumeric, 32);
    } else if (v === "SECRET_SALT") {
      generated[v] = generateRandomString(CharsetAlphaNumeric, 32);
    } else if (v === "BOT_TOKEN") {
      generated[v] = context.BOT_TOKEN || "";
    } else if (v === "BOT_USERNAME") {
      generated[v] = context.BOT_USERNAME || "facelesscahtbot";
    } else if (v === "ADMIN_IDS") {
      generated[v] = context.chatId ? context.chatId.toString() : "";
    } else {
      generated[v] = generateRandomString(CharsetAlphaNumeric, 12);
    }
  });
  return generated;
}

// --- TELEGRAM UPDATE HANDLER ---
async function handleTelegramUpdate(update, env) {
  if (update.message) {
    await handleTelegramMessage(update.message, env);
  } else if (update.callback_query) {
    await handleTelegramCallback(update.callback_query, env);
  }
}

function pushHistory(session, currentState) {
  if (!session.history) session.history = [];
  session.history.push(currentState);
}

function popHistory(session) {
  if (!session.history || session.history.length === 0) return "IDLE";
  return session.history.pop();
}

async function handleTelegramMessage(msg, env) {
  const chatId = msg.chat.id.toString();
  const text = msg.text ? msg.text.trim() : "";
  
  let userSession = await env.BOT_KV.get(`session:${chatId}`, { type: "json" }) || { state: "IDLE", accounts: [], history: [] };
  if (!userSession.accounts) userSession.accounts = [];
  if (!userSession.history) userSession.history = [];

  // --- TELEGRAM SLASH COMMANDS ROUTER ---
  if (text.startsWith("/")) {
    const cmd = text.split(" ")[0].toLowerCase();
    if (cmd === "/start") {
      userSession.state = "IDLE";
      userSession.history = [];
      await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
      if (env.TELEGRAM_BOT_TOKEN) registerTelegramCommands(env.TELEGRAM_BOT_TOKEN);
      return sendMainMenu(chatId, env);
    }
    if (cmd === "/cancel") {
      userSession.state = "IDLE";
      userSession.history = [];
      userSession.deployPayload = {};
      await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
      await sendMessage(chatId, "❌ عملیات جاری لغو گردید و به منوی اصلی برگشتید.", env);
      return sendMainMenu(chatId, env);
    }
    if (cmd === "/new_worker" || cmd === "/newworker" || cmd === "/create_worker" || cmd === "/deploy_worker") {
      if (!userSession.accounts || userSession.accounts.length === 0) {
        return sendMessage(chatId, "⚠️ ابتدا باید یک حساب کلادفلر اضافه کنید. از منوی اصلی اقدام نمایید.", env);
      }
      userSession.deployPayload = { type: "worker" };
      userSession.state = "SELECT_CATEGORY";
      userSession.history = ["IDLE"];
      await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
      return sendCategorySelection(chatId, env);
    }
    if (cmd === "/new_pages" || cmd === "/newpages" || cmd === "/create_pages" || cmd === "/deploy_pages") {
      if (!userSession.accounts || userSession.accounts.length === 0) {
        return sendMessage(chatId, "⚠️ ابتدا باید یک حساب کلادفلر متصل کنید.", env);
      }
      userSession.deployPayload = { type: "pages" };
      userSession.state = "SELECT_CATEGORY";
      userSession.history = ["IDLE"];
      await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
      return sendCategorySelection(chatId, env);
    }
    if (cmd === "/workers" || cmd === "/list" || cmd === "/projects") {
      if (!userSession.accounts || userSession.accounts.length === 0) {
        return sendMessage(chatId, "⚠️ ابتدا باید یک حساب کلادفلر اضافه کنید. از منوی اصلی اقدام نمایید.", env);
      }
      const keyboard = [
        [
          { text: "🚀 ساخت و استقرار ورکر جدید", callback_data: "cmd_new_worker" },
          { text: "📋 مشاهده لیست ورکرها", callback_data: "list_projects" }
        ],
        [
          { text: "🏠 منوی اصلی", callback_data: "go_main" }
        ]
      ];
      await sendMessage(chatId, "📂 <b>بخش ورکرها (Cloudflare Workers):</b>\n\nمی‌توانید یک ورکر جدید بسازید یا لیست پروژه‌های فعال را مدیریت کنید:", env, false, keyboard);
      return handleTelegramListProjects(chatId, userSession, env);
    }
    if (cmd === "/pages") {
      if (!userSession.accounts || userSession.accounts.length === 0) {
        return sendMessage(chatId, "⚠️ ابتدا باید یک حساب کلادفلر متصل کنید.", env);
      }
      const acc = userSession.accounts[0];
      const projects = await getPagesProjects(acc.token, acc.id);
      const keyboard = [
        [
          { text: "🚀 ساخت و استقرار پیجز جدید", callback_data: "cmd_new_pages" }
        ],
        [
          { text: "🏠 منوی اصلی", callback_data: "go_main" }
        ]
      ];
      if (!projects || projects.length === 0) {
        return sendMessage(chatId, `📄 <b>پروژه‌های Cloudflare Pages:</b>\n\n👤 حساب: <b>${escapeHTML(acc.name)}</b>\n\n⚠️ هیچ پروژه Pages فعالی روی این حساب یافت نشد. با دکمه زیر می‌توانید اولین پروژه پیجز را بسازید:`, env, false, keyboard);
      }
      let msg = `📄 <b>پروژه‌های فعال Cloudflare Pages (${projects.length}):</b>\n\n👤 حساب: <b>${escapeHTML(acc.name)}</b>\n\n`;
      projects.forEach((p, idx) => {
        const domain = p.subdomain ? `https://${p.subdomain}.pages.dev` : "";
        const branch = p.production_branch || "main";
        msg += `${idx + 1}. <b>${escapeHTML(p.name)}</b>\n`;
        if (domain) msg += `🔗 <code>${escapeHTML(domain)}</code>\n`;
        msg += `🌿 شاخه اصلی: <code>${escapeHTML(branch)}</code>\n\n`;
      });
      return sendMessage(chatId, msg, env, false, keyboard);
    }
    if (cmd === "/subdomain") {
      if (!userSession.accounts || userSession.accounts.length === 0) {
        return sendMessage(chatId, "⚠️ ابتدا باید یک حساب کلادفلر متصل کنید.", env);
      }
      const acc = userSession.accounts[0];
      const sub = await getWorkerSubdomain(acc.token, acc.id, env, acc.name);
      return sendMessage(chatId, `🌐 <b>اطلاعات ساب‌دومین ورکرز:</b>\n\n👤 حساب: <b>${escapeHTML(acc.name)}</b>\n🏷 ساب‌دومین: <code>${escapeHTML(sub || "ثبت‌نشده")}</code>\n\nجهت تغییر یا استعلام مجدد، از منوی 🔑 مدیریت اکانت‌ها اقدام کنید.`, env);
    }
    if (cmd === "/status") {
      const accCount = (userSession.accounts || []).length;
      return sendMessage(chatId, `📊 <b>وضعیت ربات استقرار کلش‌فا:</b>\n\n🔹 تعداد اکانت‌های متصل: <code>${accCount}</code>\n🔹 تعداد قالب‌های آماده: <code>${PRESETS.length}</code>\n🔹 نسخه سیستم: <code>2.4.0 Ultra</code>\n🔹 پنل وب: فعال بر روی ریشه ورکر <code>/</code>`, env);
    }
    if (cmd === "/help") {
      const helpText = `ℹ️ <b>راهنمای دستورات ربات:</b>\n\n` +
        `🚀 /new_worker - ساخت و استقرار ورکر جدید\n` +
        `📦 /new_pages - ساخت و استقرار پیجز جدید\n` +
        `📂 /workers - مدیریت و مشاهده لیست ورکرها\n` +
        `📄 /pages - مدیریت و مشاهده پروژه‌های Pages\n` +
        `🌐 /subdomain - استعلام و بررسی ساب‌دومین فعال\n` +
        `📊 /status - وضعیت سامانه و اکانت‌ها\n` +
        `❌ /cancel - لغو عملیات جاری و بازگشت\n` +
        `🏠 /start - بازگشت به منوی اصلی\n\n` +
        `💡 <i>همچنین می‌توانید از پنل تحت وب برای استقرار سریع استفاده نمایید.</i>`;
      return sendMessage(chatId, helpText, env);
    }
  }

  if (text === "🔙 بازگشت به منوی اصلی") {
    userSession.state = "IDLE";
    userSession.history = [];
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
    return sendMainMenu(chatId, env);
  }

  // --- STATE: AWAITING CF API TOKEN ---
  if (userSession.state === "AWAITING_CF_TOKEN") {
    if (!text) {
      return sendMessage(chatId, "⚠️ لطفاً یک توکن API معتبر ارسال کنید.", env);
    }

    await sendMessage(chatId, "⏳ در حال بررسی اطلاعات و تست مجوزهای توکن کلادفلر...", env);
    const isValid = await verifyCloudflareToken(text);
    if (!isValid) {
      await logEvent(env, `تلاش ناموفق برای افزودن توکن نامعتبر در تلگرام برای کاربر ${chatId}`, "warning");
      return sendMessage(chatId, "❌ توکن نامعتبر است یا دسترسی‌های کافی ندارد. مجدداً اقدام فرمایید.", env, true);
    }

    const accounts = await getCloudflareAccounts(text);
    if (!accounts || accounts.length === 0) {
      return sendMessage(chatId, "❌ حساب کاربری یافت نشد. مجوز Account Settings: Read توکن را بررسی کنید.", env, true);
    }

    // Check for duplicate account / token
    const existing = userSession.accounts.find(a => a.token === text || a.id === accounts[0].id);
    if (existing) {
      userSession.state = "IDLE";
      await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
      return sendMessage(chatId, `⚠️ این حساب کلادفلر با نام <b>${escapeHTML(existing.name)}</b> قبلاً به ربات متصل شده است.`, env);
    }

    // Verify detailed permissions (Workers, KV, D1)
    const perms = await validateTokenPermissions(text, accounts[0].id);

    // Fetch or derive subdomain immediately on connection
    let detectedSub = await refreshWorkerSubdomainLive(text, accounts[0].id, env);
    if (!detectedSub) {
      detectedSub = deriveFallbackSubdomain(accounts[0].name);
    }
    if (detectedSub && env.BOT_KV) {
      await env.BOT_KV.put(`subdomain:${accounts[0].id}`, detectedSub);
    }

    const newAccount = { 
      uid: "acc_" + Date.now() + "_" + Math.random().toString(36).substring(2, 6),
      token: text, 
      id: accounts[0].id, 
      name: accounts[0].name,
      subdomain: detectedSub || ""
    };
    userSession.accounts.push(newAccount);
    userSession.state = "IDLE";
    userSession.history = [];
    
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
    await logEvent(env, `حساب جدید (${newAccount.name}) با ساب‌دومین (${newAccount.subdomain}) از طریق تلگرام اضافه شد.`, "info");

    let permsReport = `✅ <b>حساب کلادفلر با موفقیت متصل شد:</b>\n\n👤 نام حساب: <b>${escapeHTML(newAccount.name)}</b>\n🆔 شناسه: <code>${newAccount.id}</code>\n🌐 ساب‌دومین ورکرز: <code>${escapeHTML(newAccount.subdomain || "استعلام خودکار")}</code>\n\n📊 <b>وضعیت مجوزهای توکن:</b>\n`;
    permsReport += `🔹 مدیریت ورکرها (Workers Scripts): ${perms.workers ? "✅ مجاز" : "⚠️ فاقد مجوز"}\n`;
    permsReport += `🔹 دیتابیس کلید-مقدار (KV Storage): ${perms.kv ? "✅ مجاز" : "⚠️ فاقد مجوز"}\n`;
    permsReport += `🔹 دیتابیس رابطه‌ای (D1 Database): ${perms.d1 ? "✅ مجاز" : "⚠️ فاقد مجوز"}\n`;

    if (!perms.workers || !perms.kv || !perms.d1) {
      permsReport += `\n💡 <i>نکته: در صورت نیاز به قالب‌های دارای KV یا D1، مطمئن شوید دسترسی‌های لازم به توکن داده شده است.</i>`;
    }

    await sendMessage(chatId, permsReport, env);
    return sendMainMenu(chatId, env);
  }

  // --- STATE: AWAITING MANUAL SUBDOMAIN ENTRY ---
  if (userSession.state.startsWith("AWAITING_SUBDOMAIN_INPUT_")) {
    const accIdx = parseInt(userSession.state.replace("AWAITING_SUBDOMAIN_INPUT_", ""), 10);
    const account = userSession.accounts[accIdx];
    
    if (!text || text.length > 50) {
      return sendMessage(chatId, "⚠️ فرمت ساب‌دومین نامعتبر است. مجدداً تلاش کنید:", env);
    }

    await env.BOT_KV.put(`subdomain:${account.id}`, text.toLowerCase().trim());
    await logEvent(env, `ساب‌دومین دستی برای حساب ${account.name} ذخیره شد: ${text}`, "info");

    userSession.state = "IDLE";
    userSession.history = [];
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
    await sendMessage(chatId, `✅ ساب‌دومین ورکرز حساب <b>${escapeHTML(account.name)}</b> با موفقیت به <code>${escapeHTML(text)}</code> تنظیم شد.`, env);
    return sendMainMenu(chatId, env);
  }

  // --- STATE: AWAITING CUSTOM URL ---
  if (userSession.state === "AWAITING_CUSTOM_URL") {
    if (!text.startsWith("http://") && !text.startsWith("https://")) {
      return sendMessage(chatId, "⚠️ لطفاً یک لینک معتبر شروع شده با http یا https ارسال کنید:", env, false, [getNavKeyboardRow()]);
    }

    const normalizedUrl = normalizeGitHubUrl(text);
    userSession.deployPayload = userSession.deployPayload || {};
    userSession.deployPayload.templateIdx = "custom";
    userSession.deployPayload.templateUrl = normalizedUrl;
    userSession.deployPayload.templateName = "ورکر سفارشی 🛠️";
    userSession.deployPayload.isLegacy = false;
    userSession.deployPayload.kvBindings = [];
    userSession.deployPayload.vars = {};

    pushHistory(userSession, "AWAITING_CUSTOM_URL");
    userSession.state = "CHOOSE_CUSTOM_VAR_OPTION";
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));

    return sendCustomVarOptionSelection(chatId, env);
  }

  // --- STATE: AWAITING CUSTOM RESOURCES COUNT ---
  if (userSession.state === "AWAITING_CUSTOM_RESOURCES_COUNT") {
    const counts = text.split(/\s+/);
    if (counts.length !== 3 || counts.some(c => isNaN(parseInt(c, 10)))) {
      return sendMessage(chatId, "⚠️ لطفاً دقیقاً ۳ عدد وارد کنید (مثال: 1 1 2) یا 0 0 0 برای رد کردن:", env, false, [getNavKeyboardRow()]);
    }

    const [numKv, numD1, numVar] = counts.map(c => parseInt(c, 10));

    if (numKv === 0 && numD1 === 0 && numVar === 0) {
      pushHistory(userSession, "AWAITING_CUSTOM_RESOURCES_COUNT");
      userSession.state = "AWAITING_PROJECT_NAME";
      await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
      return sendProjectNamePrompt(chatId, env);
    }

    userSession.deployPayload.resourceQueue = [];
    for (let i = 1; i <= numKv; i++) {
      userSession.deployPayload.resourceQueue.push({ type: "kv", index: i, step: "NAME", name: "", id: "" });
    }
    for (let i = 1; i <= numD1; i++) {
      userSession.deployPayload.resourceQueue.push({ type: "d1", index: i, step: "NAME", name: "", id: "" });
    }
    for (let i = 1; i <= numVar; i++) {
      userSession.deployPayload.resourceQueue.push({ type: "var", index: i, step: "NAME", name: "", val: "" });
    }

    userSession.deployPayload.resourceIndex = 0;
    pushHistory(userSession, "AWAITING_CUSTOM_RESOURCES_COUNT");
    userSession.state = "COLLECTING_RESOURCES";
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));

    return promptCurrentResource(chatId, userSession, env);
  }

  // --- STATE: COLLECTING_RESOURCES (CUSTOM WIZARD) ---
  if (userSession.state === "COLLECTING_RESOURCES") {
    const queue = userSession.deployPayload.resourceQueue;
    const idx = userSession.deployPayload.resourceIndex;
    const item = queue[idx];

    if (item.type === "kv") {
      if (item.step === "NAME") {
        item.name = text;
        item.step = "ID";
        await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
        return promptCurrentResource(chatId, userSession, env);
      } else if (item.step === "ID") {
        item.id = text;
        return advanceResourceIndex(chatId, userSession, env);
      }
    } else if (item.type === "d1") {
      if (item.step === "NAME") {
        item.name = text;
        item.step = "ID";
        await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
        return promptCurrentResource(chatId, userSession, env);
      } else if (item.step === "ID") {
        item.id = text;
        return advanceResourceIndex(chatId, userSession, env);
      }
    } else if (item.type === "var") {
      if (item.step === "NAME") {
        item.name = text;
        item.step = "VAL";
        await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
        return promptCurrentResource(chatId, userSession, env);
      } else if (item.step === "VAL") {
        item.val = text;
        return advanceResourceIndex(chatId, userSession, env);
      }
    }
  }

  // --- STATE: AWAITING_PROJECT_NAME ---
  if (userSession.state === "AWAITING_PROJECT_NAME") {
    const validNameRegex = /^[a-z0-9-]+$/;
    if (!validNameRegex.test(text) || text.length > 63) {
      return sendMessage(chatId, "⚠️ نام پروژه فقط شامل حروف انگلیسی کوچک، اعداد و خط تیره (-) است. دوباره تلاش کنید:", env, false, [getNavKeyboardRow()]);
    }

    userSession.deployPayload = userSession.deployPayload || {};
    userSession.deployPayload.name = text;

    pushHistory(userSession, "AWAITING_PROJECT_NAME");

    const presetIdx = userSession.deployPayload.templateIdx;
    
    if (presetIdx === "custom") {
      return proceedToAccountStep(chatId, userSession, env);
    } else {
      const preset = PRESETS[presetIdx];
      const hasVars = (preset.vars && preset.vars.length > 0);

      if (hasVars) {
        userSession.state = "CHOOSE_VAR_MODE";
        await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
        return sendVarModeSelection(chatId, env);
      } else {
        return proceedToAccountStep(chatId, userSession, env);
      }
    }
  }

  // --- STATE: VAR_COLLECT_[varName] ---
  if (userSession.state.startsWith("VAR_COLLECT_")) {
    const varName = userSession.state.replace("VAR_COLLECT_", "");
    return proceedToNextVarOrDeploy(chatId, userSession, env, varName, text);
  }

  return sendMessage(chatId, "🤖 لطفاً یکی از گزینه‌های منو را انتخاب کنید:", env);
}

// --- STATE MACHINE FOR VARIABLE FLOWS ---
async function proceedToNextVarOrDeploy(chatId, session, env, currentVarName, val) {
  session.deployPayload = session.deployPayload || {};
  session.deployPayload.vars = session.deployPayload.vars || {};
  session.deployPayload.vars[currentVarName] = val;

  const currentPreset = PRESETS[session.deployPayload.templateIdx];

  // If user selected Auto-Generation mode, once mandatory inputs are collected, auto-generate all rest!
  if (session.deployPayload.autoGenTemplate) {
    session.deployPayload.vars = autoGenerateVars(currentPreset.vars, {
      ...session.deployPayload.vars,
      chatId: chatId.toString()
    });
    if (!session.deployPayload.vars["ADMIN_IDS"]) {
      session.deployPayload.vars["ADMIN_IDS"] = chatId.toString();
    }
    pushHistory(session, `VAR_COLLECT_${currentVarName}`);
    return proceedToAccountStep(chatId, session, env);
  }

  const collectedKeys = Object.keys(session.deployPayload.vars);
  const missingVar = currentPreset.vars.find(v => !collectedKeys.includes(v));

  pushHistory(session, `VAR_COLLECT_${currentVarName}`);

  if (missingVar) {
    session.state = `VAR_COLLECT_${missingVar}`;
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(session));
    return sendVariablePrompt(chatId, missingVar, env);
  } else {
    return proceedToAccountStep(chatId, session, env);
  }
}

// --- PROCEED TO ACCOUNT STEP ---
async function proceedToAccountStep(chatId, session, env) {
  if (!session.accounts || session.accounts.length === 0) {
    return sendMessage(chatId, "⚠️ شما هنوز هیچ حساب کلادفلری به ربات اضافه نکرده‌اید. لطفاً ابتدا حساب اضافه کنید.", env);
  }

  if (session.accounts.length === 1) {
    session.deployPayload.account = session.accounts[0];
    session.state = "EXECUTING_DEPLOY";
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(session));
    await sendMessage(chatId, `👤 تنها یک حساب کاربری یافت شد. استقرار به طور خودکار بر روی حساب <b>${escapeHTML(session.accounts[0].name)}</b> آغاز می‌شود...\n\n⚡ در حال آماده‌سازی و استقرار...`, env);
    return executeTelegramDeployment(chatId, session, env);
  } else {
    session.state = "SELECT_ACCOUNT_DEST";
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(session));
    return sendAccountSelection(chatId, session, env);
  }
}

// --- TELEGRAM CALLBACK ACTIONS ---
async function handleTelegramCallback(cb, env) {
  const chatId = cb.message.chat.id.toString();
  const data = cb.data;
  const messageId = cb.message.message_id;

  let userSession = await env.BOT_KV.get(`session:${chatId}`, { type: "json" }) || { state: "IDLE", accounts: [], history: [] };
  if (!userSession.accounts) userSession.accounts = [];
  if (!userSession.history) userSession.history = [];

  await answerCallbackQuery(cb.id, env);

  if (data === "noop") return;

  // --- REFRESH PRESETS CACHE HANDLER ---
  if (data === "refresh_presets_cache") {
    await sendMessage(chatId, "⏳ در حال دانلود و بروزرسانی آخرین نسخه کدهای ۱۹ قالب از مخازن گیت‌هاب...", env);
    await cacheAllPresets(env);
    return sendMessage(chatId, "✅ تمامی قالب‌ها با موفقیت بروزرسانی و مجدداً در حافظه ابری کش شدند.", env);
  }

  // --- BACK NAVIGATION LOGIC ---
  if (data === "step_back") {
    if (userSession.state === "COLLECTING_RESOURCES") {
      const queue = userSession.deployPayload.resourceQueue;
      let idx = userSession.deployPayload.resourceIndex;
      let item = queue[idx];

      if (item.step === "ID" || item.step === "VAL") {
        item.step = "NAME";
      } else {
        if (idx > 0) {
          idx -= 1;
          userSession.deployPayload.resourceIndex = idx;
          item = queue[idx];
          item.step = item.type === "var" ? "VAL" : "ID";
        } else {
          userSession.state = "AWAITING_CUSTOM_RESOURCES_COUNT";
          await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
          return sendCustomResourcesPrompt(chatId, env);
        }
      }

      await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
      return promptCurrentResource(chatId, userSession, env);
    }

    const prevState = popHistory(userSession);
    userSession.state = prevState;
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));

    if (prevState === "IDLE") return sendMainMenu(chatId, env);
    if (prevState === "SELECT_PLATFORM_TYPE") return sendPlatformTypeSelection(chatId, env);
    if (prevState === "SELECT_CATEGORY") return sendCategorySelection(chatId, env);
    if (prevState === "SELECT_TEMPLATE") {
      return sendTemplateSelection(chatId, env, userSession.deployPayload.type, userSession.deployPayload.category);
    }
    if (prevState === "AWAITING_CUSTOM_URL") {
      return sendMessage(chatId, "🔗 لطفاً لینک سورس ورکر سفارشی را ارسال کنید:", env, false, [getNavKeyboardRow()]);
    }
    if (prevState === "CHOOSE_CUSTOM_VAR_OPTION") return sendCustomVarOptionSelection(chatId, env);
    if (prevState === "AWAITING_CUSTOM_RESOURCES_COUNT") return sendCustomResourcesPrompt(chatId, env);
    if (prevState === "AWAITING_PROJECT_NAME") return sendProjectNamePrompt(chatId, env);
    if (prevState === "CHOOSE_VAR_MODE") {
      userSession.deployPayload.vars = {};
      await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
      return sendVarModeSelection(chatId, env);
    }
    if (prevState.startsWith("VAR_COLLECT_")) {
      const varName = prevState.replace("VAR_COLLECT_", "");
      if (userSession.deployPayload && userSession.deployPayload.vars) {
        delete userSession.deployPayload.vars[varName];
      }
      await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
      return sendVariablePrompt(chatId, varName, env);
    }
    return sendMainMenu(chatId, env);
  }

  if (data === "manage_accounts") {
    return sendAccountsManagement(chatId, userSession, env, messageId);
  }

  if (data === "add_cf_token") {
    userSession.state = "AWAITING_CF_TOKEN";
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
    return editMessageText(chatId, messageId, "🔑 لطفاً <b>API Token</b> خود را با دسترسی‌های کامل ارسال نمایید.", env, true);
  }

  if (data === "del_all_acc") {
    userSession.accounts = [];
    userSession.state = "IDLE";
    userSession.history = [];
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
    await logEvent(env, `خروج همزمان از تمامی حساب‌ها توسط کاربر ${chatId}`, "warning");
    await sendMessage(chatId, "🔒 خروج با موفقیت انجام شد. تمامی حساب‌ها از حافظه ربات پاک شدند.", env);
    return sendMainMenu(chatId, env);
  }

  if (data.startsWith("del_acc_")) {
    const idx = parseInt(data.replace("del_acc_", ""), 10);
    if (userSession.accounts && userSession.accounts[idx]) {
      const removed = userSession.accounts.splice(idx, 1);
      await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
      await logEvent(env, `حذف حساب کلادفلر: ${removed[0].name}`, "info");
      await sendMessage(chatId, "🗑️ حساب کلادفلر انتخاب شده با موفقیت برکنار شد.", env);
      return sendAccountsManagement(chatId, userSession, env);
    }
  }

  if (data.startsWith("view_acc_")) {
    const idx = parseInt(data.replace("view_acc_", ""), 10);
    const acc = userSession.accounts[idx];
    const sub = await env.BOT_KV.get(`subdomain:${acc.id}`) || "ثبت نشده (تلاش برای دریافت خودکار)";
    
    const kb = [
      [{ text: "🔄 استعلام زنده ساب‌دامین", callback_data: `refresh_sub_${idx}` }],
      [{ text: "✏️ ویرایش دستی ساب‌دامین", callback_data: `set_sub_${idx}` }],
      [{ text: "🔙 بازگشت به لیست حساب‌ها", callback_data: "manage_accounts" }]
    ];
    return sendMessage(chatId, `👤 <b>جزئیات حساب کلادفلر:</b>\n\n🔹 نام: <code>${escapeHTML(acc.name)}</code>\n🔹 شناسه: <code>${acc.id}</code>\n🔹 ساب‌دومین ورکرز: <code>${escapeHTML(sub)}</code>\n🔹 توکن: <code>${acc.token.substring(0, 8)}***</code>`, env, false, kb);
  }

  if (data.startsWith("refresh_sub_")) {
    const idx = parseInt(data.replace("refresh_sub_", ""), 10);
    const acc = userSession.accounts[idx];
    await sendMessage(chatId, "⏳ در حال استعلام مستقیم ساب‌دامین از کلادفلر...", env);
    const liveSub = await refreshWorkerSubdomainLive(acc.token, acc.id, env);
    if (liveSub) {
      return sendMessage(chatId, `✅ ساب‌دامین با موفقیت از کلادفلر استعلام و ذخیره شد:\n<code>${escapeHTML(liveSub)}</code>`, env);
    } else {
      return sendMessage(chatId, "⚠️ ساب‌دامین فعالی برای این حساب یافت نشد. می‌توانید با دکمه ویرایش دستی، ساب‌دامین را وارد کنید.", env);
    }
  }

  if (data.startsWith("set_sub_")) {
    const idx = parseInt(data.replace("set_sub_", ""), 10);
    userSession.state = `AWAITING_SUBDOMAIN_INPUT_${idx}`;
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
    return sendMessage(chatId, "✍️ لطفاً ساب‌دومین ورکرز اکانت خود را بدون پیشوند یا پسوند ارسال کنید:", env, true);
  }

  // --- FLOW START: SELECT DEPLOY TYPE ---
  if (data === "start_deploy") {
    userSession.deployPayload = {};
    userSession.state = "SELECT_PLATFORM_TYPE";
    userSession.history = ["IDLE"];
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
    return sendPlatformTypeSelection(chatId, env);
  }

  if (data === "cmd_new_worker") {
    userSession.deployPayload = { type: "worker" };
    userSession.state = "SELECT_CATEGORY";
    userSession.history = ["IDLE"];
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
    return sendCategorySelection(chatId, env);
  }

  if (data === "cmd_new_pages") {
    userSession.deployPayload = { type: "pages" };
    userSession.state = "SELECT_CATEGORY";
    userSession.history = ["IDLE"];
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
    return sendCategorySelection(chatId, env);
  }

  if (data.startsWith("platform_")) {
    const type = data.replace("platform_", "");
    userSession.deployPayload.type = type;
    
    pushHistory(userSession, "SELECT_PLATFORM_TYPE");
    userSession.state = "SELECT_CATEGORY";
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));

    return sendCategorySelection(chatId, env);
  }

  if (data.startsWith("cat_")) {
    const category = data.replace("cat_", "");
    userSession.deployPayload.category = category;

    pushHistory(userSession, "SELECT_CATEGORY");
    userSession.state = "SELECT_TEMPLATE";
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));

    return sendTemplateSelection(chatId, env, userSession.deployPayload.type, category, 0);
  }

  if (data.startsWith("tpl_page_")) {
    const parts = data.replace("tpl_page_", "").split("_");
    const category = parts[0];
    const page = parseInt(parts[1], 10);
    return sendTemplateSelection(chatId, env, userSession.deployPayload.type, category, page);
  }

  if (data.startsWith("tpl_idx_")) {
    const idxStr = data.replace("tpl_idx_", "");
    pushHistory(userSession, userSession.state);

    if (idxStr === "custom") {
      userSession.deployPayload.templateIdx = "custom";
      userSession.state = "AWAITING_CUSTOM_URL";
      await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
      return sendMessage(chatId, "🔗 لطفاً لینک سورس ورکر سفارشی را ارسال کنید (لینک‌های گیت‌هاب به صورت خودکار پشتیبانی می‌شوند):", env, false, [getNavKeyboardRow()]);
    } else {
      const idx = parseInt(idxStr, 10);
      const selectedPreset = PRESETS[idx];
      userSession.deployPayload.templateIdx = idx;
      userSession.deployPayload.templateName = selectedPreset.name;
      userSession.deployPayload.templateUrl = selectedPreset.url;
      userSession.deployPayload.isLegacy = selectedPreset.isLegacy;
      userSession.deployPayload.kvBindings = selectedPreset.kvBindings;
      userSession.deployPayload.vars = {};

      userSession.state = "AWAITING_PROJECT_NAME";
      await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
      return sendProjectNamePrompt(chatId, env);
    }
  }

  if (data === "custom_vars_none") {
    userSession.deployPayload.vars = {};
    pushHistory(userSession, "CHOOSE_CUSTOM_VAR_OPTION");
    userSession.state = "AWAITING_PROJECT_NAME";
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
    return sendProjectNamePrompt(chatId, env);
  }

  if (data === "custom_vars_yes") {
    pushHistory(userSession, "CHOOSE_CUSTOM_VAR_OPTION");
    userSession.state = "AWAITING_CUSTOM_RESOURCES_COUNT";
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
    return sendCustomResourcesPrompt(chatId, env);
  }

  if (data === "var_mode_auto") {
    const preset = PRESETS[userSession.deployPayload.templateIdx];
    const needsBotToken = preset.vars.includes("BOT_TOKEN");
    
    if (needsBotToken) {
      await sendMessage(chatId, "⚙️ حالت نیمه خودکار فعال شد. متغیرهای ساختاری به صورت رندوم ایجاد خواهند شد. لطفاً توکن ربات تلگرام را ارسال کنید تا فرآیند ادامه یابد:", env, false, [getNavKeyboardRow()]);
      userSession.deployPayload.autoGenTemplate = true;
      userSession.state = "VAR_COLLECT_BOT_TOKEN";
      await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
    } else {
      userSession.deployPayload.vars = autoGenerateVars(preset.vars, { chatId: chatId.toString() });
      pushHistory(userSession, "CHOOSE_VAR_MODE");
      return proceedToAccountStep(chatId, userSession, env);
    }
  }

  if (data === "var_mode_manual") {
    const preset = PRESETS[userSession.deployPayload.templateIdx];
    const firstVar = preset.vars[0];

    pushHistory(userSession, "CHOOSE_VAR_MODE");
    userSession.state = `VAR_COLLECT_${firstVar}`;
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
    return sendVariablePrompt(chatId, firstVar, env);
  }

  // --- SINGLE VARIABLE INLINE AUTO-GENERATOR ---
  if (data.startsWith("auto_gen_var_")) {
    const varName = data.replace("auto_gen_var_", "");
    let generatedVal = "";

    if (varName === "BOT_USERNAME" && userSession.deployPayload && userSession.deployPayload.vars && userSession.deployPayload.vars.BOT_TOKEN) {
      try {
        const tgRes = await fetchWithTimeout(`https://api.telegram.org/bot${userSession.deployPayload.vars.BOT_TOKEN}/getMe`, {}, 8000);
        const tgData = await tgRes.json();
        if (tgData.ok && tgData.result && tgData.result.username) {
          generatedVal = tgData.result.username;
        }
      } catch (_) {}
    }

    if (!generatedVal) {
      const singleVarObj = autoGenerateVars([varName], { chatId: chatId.toString() });
      generatedVal = singleVarObj[varName] || "";
    }

    return proceedToNextVarOrDeploy(chatId, userSession, env, varName, generatedVal);
  }

  if (data === "res_auto_kv") {
    const idx = userSession.deployPayload.resourceIndex;
    const item = userSession.deployPayload.resourceQueue[idx];
    item.id = "auto";
    return advanceResourceIndex(chatId, userSession, env);
  }

  if (data === "res_auto_val") {
    const idx = userSession.deployPayload.resourceIndex;
    const item = userSession.deployPayload.resourceQueue[idx];
    if (item.name === "UUID" || item.name === "uuid") {
      item.val = crypto.randomUUID();
    } else if (item.name === "TR_PASS" || item.name === "ADMIN_PASSWORD" || item.name === "ADMIN") {
      item.val = generateRandomString(CharsetTrojanPassword, 12);
    } else {
      item.val = generateRandomString(CharsetAlphaNumeric, 12);
    }
    return advanceResourceIndex(chatId, userSession, env);
  }

  if (data.startsWith("deploy_to_")) {
    const accIdx = parseInt(data.replace("deploy_to_", ""), 10);
    const selectedAccount = userSession.accounts[accIdx];
    userSession.deployPayload.account = selectedAccount;

    userSession.state = "EXECUTING_DEPLOY";
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
    return executeTelegramDeployment(chatId, userSession, env);
  }

  if (data === "list_projects") {
    if (!userSession.accounts || userSession.accounts.length === 0) {
      return sendMessage(chatId, "⚠️ ابتدا باید اکانت کلادفلر اضافه کنید.", env);
    }
    return handleTelegramListProjects(chatId, userSession, env);
  }

  if (data.startsWith("list_opts_")) {
    const accIdx = parseInt(data.replace("list_opts_", ""), 10);
    const account = userSession.accounts[accIdx];
    return displayTelegramProjects(chatId, account, env, accIdx);
  }

  // --- WORKER DETAILED MENU HANDLERS ---
  if (data.startsWith("wk_menu_")) {
    const idx = parseInt(data.replace("wk_menu_", ""), 10);
    if (userSession.listedWorkers && userSession.listedWorkers[idx]) {
      const workerName = userSession.listedWorkers[idx];
      userSession.activeWorker = workerName;
      await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));

      const keyboard = [
        [{ text: "⚙️ مشاهده و مدیریت بایندینگ‌ها (KV, D1, متغیرها)", callback_data: "manage_binds" }],
        [{ text: "📥 دریافت و دانلود سورس‌کد ورکر (.js)", callback_data: `dl_wrk_code_${idx}` }],
        [{ text: "🗑️ حذف کامل ورکر", callback_data: "conf_del_wrk_sess" }],
        [{ text: "🔙 بازگشت به لیست پروژه‌ها", callback_data: `list_opts_${userSession.activeAccIdx}` }]
      ];

      return sendMessage(chatId, `🛠️ <b>منوی مدیریت ورکر:</b> <code>${escapeHTML(workerName)}</code>\n\nلطفاً یکی از گزینه‌های زیر را انتخاب کنید:`, env, false, keyboard);
    }
  }

  // --- DOWNLOAD WORKER SOURCE CODE ---
  if (data.startsWith("dl_wrk_code_")) {
    const workerName = userSession.activeWorker;
    const accIdx = userSession.activeAccIdx;
    const account = userSession.accounts[accIdx];

    await sendMessage(chatId, `⏳ در حال دریافت کدهای ورکر <code>${escapeHTML(workerName)}</code> از کلادفلر...`, env);
    try {
      const code = await getWorkerScriptCode(account.token, account.id, workerName);
      const filename = `${workerName}.js`;
      const caption = `📄 <b>سورس‌کد ورکر:</b> <code>${escapeHTML(workerName)}</code>\nحجم فایل: ${(code.length / 1024).toFixed(1)} کیلوبایت`;
      
      const sent = await sendTelegramDocument(chatId, filename, code, env, caption);
      if (!sent) {
        // Fallback: If document sending fails, send as chunked message
        await sendMessage(chatId, `<code>${escapeHTML(code.substring(0, 3000))}</code>`, env);
      }
    } catch (err) {
      await sendMessage(chatId, `❌ خطا در دریافت سورس‌کد:\n<code>${escapeHTML(err.message)}</code>`, env);
    }
    return;
  }

  if (data === "wk_menu_back") {
    if (userSession.listedWorkers && userSession.activeWorker) {
      const idx = userSession.listedWorkers.indexOf(userSession.activeWorker);
      if (idx !== -1) {
        const keyboard = [
          [{ text: "⚙️ مشاهده و مدیریت بایندینگ‌ها (KV, D1, متغیرها)", callback_data: "manage_binds" }],
          [{ text: "📥 دریافت و دانلود سورس‌کد ورکر (.js)", callback_data: `dl_wrk_code_${idx}` }],
          [{ text: "🗑️ حذف کامل ورکر", callback_data: "conf_del_wrk_sess" }],
          [{ text: "🔙 بازگشت به لیست پروژه‌ها", callback_data: `list_opts_${userSession.activeAccIdx}` }]
        ];
        return sendMessage(chatId, `🛠️ <b>منوی مدیریت ورکر:</b> <code>${escapeHTML(userSession.activeWorker)}</code>\n\nلطفاً یکی از گزینه‌های زیر را انتخاب کنید:`, env, false, keyboard);
      }
    }
    return sendMainMenu(chatId, env);
  }

  if (data === "manage_binds") {
    return displayWorkerBindings(chatId, userSession, env);
  }

  if (data.startsWith("del_b_")) {
    const idx = parseInt(data.replace("del_b_", ""), 10);
    const bindings = userSession.activeBindings || [];
    if (bindings[idx]) {
      const targetBinding = bindings[idx];
      const filteredBindings = bindings.filter((_, i) => i !== idx);

      const workerName = userSession.activeWorker;
      const accIdx = userSession.activeAccIdx;
      const account = userSession.accounts[accIdx];

      await sendMessage(chatId, `⏳ در حال حذف بایندینگ <code>${escapeHTML(targetBinding.name)}</code> از ورکر...`, env);

      try {
        await updateWorkerBindings(account.token, account.id, workerName, filteredBindings);
        await logEvent(env, `بایندینگ ${targetBinding.name} از ورکر ${workerName} حذف شد.`, "warning");
        await sendMessage(chatId, `✅ بایندینگ <code>${escapeHTML(targetBinding.name)}</code> با موفقیت حذف شد.`, env);
        
        userSession.activeBindings = filteredBindings;
        await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
        return displayWorkerBindings(chatId, userSession, env);
      } catch (err) {
        await sendMessage(chatId, `❌ خطای حذف بایندینگ:\n<code>${escapeHTML(err.message)}</code>`, env);
        return displayWorkerBindings(chatId, userSession, env);
      }
    }
  }

  if (data === "del_all_b") {
    const workerName = userSession.activeWorker;
    const keyboard = [
      [
        { text: "💥 بله، همه حذف شوند", callback_data: "exec_del_all_b" },
        { text: "❌ لغو عملیات", callback_data: "manage_binds" }
      ]
    ];
    return sendMessage(chatId, `⚠️ آیا مطمئن هستید که می‌خواهید <b>تمامی</b> بایندینگ‌های ورکر <code>${escapeHTML(workerName)}</code> را حذف کنید؟ این عمل بلافاصله دسترسی ورکر به منابع را قطع می‌کند.`, env, false, keyboard);
  }

  if (data === "exec_del_all_b") {
    const workerName = userSession.activeWorker;
    const accIdx = userSession.activeAccIdx;
    const account = userSession.accounts[accIdx];

    await sendMessage(chatId, "⏳ در حال حذف تمامی بایندینگ‌های ورکر...", env);

    try {
      await updateWorkerBindings(account.token, account.id, workerName, []);
      await logEvent(env, `تمامی بایندینگ‌های ورکر ${workerName} حذف شدند.`, "warning");
      await sendMessage(chatId, "✅ تمامی بایندینگ‌ها با موفقیت حذف شدند.", env);
      
      userSession.activeBindings = [];
      await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
      return displayWorkerBindings(chatId, userSession, env);
    } catch (err) {
      await sendMessage(chatId, `❌ خطا در حذف تمامی بایندینگ‌ها:\n<code>${escapeHTML(err.message)}</code>`, env);
      return displayWorkerBindings(chatId, userSession, env);
    }
  }

  if (data === "conf_del_wrk_sess") {
    const workerName = userSession.activeWorker;
    const keyboard = [
      [
        { text: "🗑️ فقط حذف خود ورکر", callback_data: "exec_del_wrk_only" },
        { text: "💥 حذف ورکر + متغیرها و دیتابیس‌ها", callback_data: "exec_del_wrk_full" }
      ],
      [
        { text: "❌ لغو عملیات", callback_data: "wk_menu_back" }
      ]
    ];
    return sendMessage(chatId, `⚠️ <b>گزینه‌های حذف ورکر <code>${escapeHTML(workerName)}</code>:</b>\n\nلطفاً نوع حذف را مشخص فرمایید:\n\n1️⃣ <b>فقط حذف ورکر:</b> اسکریپت ورکر پاک می‌شود اما پایگاه‌های داده و متغیرها در کلادفلر حفظ می‌گردند.\n2️⃣ <b>حذف کامل ورکر + منابع:</b> علاوه بر اسکریپت، دیتابیس‌های KV و بایندینگ‌های اختصاصی متصل به این ورکر نیز پاک‌سازی می‌شوند.`, env, false, keyboard);
  }

  if (data === "exec_del_wrk_only" || data === "exec_del_wrk_sess") {
    const workerName = userSession.activeWorker;
    const accIdx = userSession.activeAccIdx;
    const account = userSession.accounts[accIdx];

    await sendMessage(chatId, `⏳ در حال حذف ورکر <code>${escapeHTML(workerName)}</code> از کلادفلر...`, env);
    try {
      await deleteWorkerScript(account.token, account.id, workerName);
      await logEvent(env, `ورکر ${workerName} با موفقیت حذف شد.`, "warning");
      await sendMessage(chatId, `✅ اسکریپت ورکر <code>${escapeHTML(workerName)}</code> با موفقیت حذف گردید (منابع حفظ شدند).`, env);
    } catch (err) {
      await sendMessage(chatId, `❌ خطا در حذف ورکر:\n<code>${escapeHTML(err.message)}</code>`, env);
    }
    return displayTelegramProjects(chatId, account, env, accIdx);
  }

  if (data === "exec_del_wrk_full") {
    const workerName = userSession.activeWorker;
    const accIdx = userSession.activeAccIdx;
    const account = userSession.accounts[accIdx];

    await sendMessage(chatId, `⏳ در حال حذف ورکر <code>${escapeHTML(workerName)}</code> و پاک‌سازی منابع متصل...`, env);
    let deletedResourcesCount = 0;
    try {
      try {
        const settings = await getWorkerSettings(account.token, account.id, workerName);
        if (settings && Array.isArray(settings.bindings)) {
          for (const b of settings.bindings) {
            if (b.type === "kv_namespace" && b.namespace_id) {
              const ok = await deleteKVNamespace(account.token, account.id, b.namespace_id);
              if (ok) deletedResourcesCount++;
            } else if (b.type === "d1" && b.database_id) {
              const ok = await deleteD1Database(account.token, account.id, b.database_id);
              if (ok) deletedResourcesCount++;
            }
          }
        }
      } catch (_) {}

      await deleteWorkerScript(account.token, account.id, workerName);
      await logEvent(env, `ورکر ${workerName} و تعداد ${deletedResourcesCount} منبع متصل حذف شدند.`, "warning");
      await sendMessage(chatId, `✅ ورکر <code>${escapeHTML(workerName)}</code> با موفقیت حذف گردید.\n📦 تعداد منابع اختصاصی پاک‌شده: <code>${deletedResourcesCount}</code>`, env);
    } catch (err) {
      await sendMessage(chatId, `❌ خطا در حذف کامل ورکر:\n<code>${escapeHTML(err.message)}</code>`, env);
    }
    return displayTelegramProjects(chatId, account, env, accIdx);
  }

  if (data.startsWith("conf_del_all_wrk_")) {
    const accIdx = parseInt(data.replace("conf_del_all_wrk_", ""), 10);
    const keyboard = [
      [
        { text: "💥 بله، همه ورکرها حذف شوند", callback_data: `exec_del_all_wrk_${accIdx}` },
        { text: "❌ انصراف", callback_data: `list_opts_${accIdx}` }
      ]
    ];
    return sendMessage(chatId, "⚠️⚠️⚠️ <b>هشدار جدی</b>\n\nآیا از حذف <b>تمامی</b> ورکرهای موجود بر روی این اکانت اطمینان دارید؟ تمامی اسکریپت‌های شما پاک خواهند شد!", env, false, keyboard);
  }

  if (data.startsWith("exec_del_all_wrk_")) {
    const accIdx = parseInt(data.replace("exec_del_all_wrk_", ""), 10);
    const account = userSession.accounts[accIdx];

    await sendMessage(chatId, "⏳ در حال حذف دسته جمعی تمام ورکرها... لطفاً صبور باشید.", env);
    try {
      const workers = await listWorkerScripts(account.token, account.id);
      let deletedCount = 0;
      for (const w of workers) {
        try {
          await deleteWorkerScript(account.token, account.id, w.id);
          deletedCount++;
        } catch (e) {
          await logEvent(env, `خطا در حذف ورکر ${w.id}: ${e.message}`, "error");
        }
      }
      await logEvent(env, `تعداد ${deletedCount} ورکر از اکانت ${account.name} حذف دسته‌جمعی شدند.`, "warning");
      await sendMessage(chatId, `✅ عملیات پایان یافت. تعداد <code>${deletedCount}</code> ورکر با موفقیت حذف شدند.`, env);
    } catch (err) {
      await sendMessage(chatId, `❌ خطا در حذف دسته جمعی:\n<code>${escapeHTML(err.message)}</code>`, env);
    }
    return displayTelegramProjects(chatId, account, env, accIdx);
  }

  if (data === "go_main") {
    userSession.state = "IDLE";
    userSession.history = [];
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(userSession));
    return sendMainMenu(chatId, env);
  }
}

// --- RESOURCE NAVIGATION FOR CUSTOM WIZARD ---
async function advanceResourceIndex(chatId, session, env) {
  session.deployPayload.resourceIndex += 1;
  pushHistory(session, "COLLECTING_RESOURCES");

  if (session.deployPayload.resourceIndex < session.deployPayload.resourceQueue.length) {
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(session));
    return promptCurrentResource(chatId, session, env);
  } else {
    return proceedToAccountStep(chatId, session, env);
  }
}

async function promptCurrentResource(chatId, session, env) {
  const queue = session.deployPayload.resourceQueue;
  const idx = session.deployPayload.resourceIndex;
  const item = queue[idx];

  const keyboard = [getNavKeyboardRow()];

  if (item.type === "kv") {
    if (item.step === "NAME") {
      return sendMessage(chatId, `📦 <b>دیتابیس KV (شماره ${item.index}):</b>\n\nنام متغیر بایندینگ (Binding Name) را وارد کنید (مثال: <code>KV</code>):`, env, false, keyboard);
    } else if (item.step === "ID") {
      const customKb = [
        [{ text: "🎲 ساخت خودکار توسط ربات", callback_data: "res_auto_kv" }],
        getNavKeyboardRow()
      ];
      return sendMessage(chatId, `📦 <b>دیتابیس KV (شماره ${item.index}):</b>\n\nشناسه Namespace ID دیتابیس KV خود را وارد کنید، یا روی دکمه ساخت خودکار کلیک کنید:`, env, false, customKb);
    }
  } else if (item.type === "d1") {
    if (item.step === "NAME") {
      return sendMessage(chatId, `🗄 <b>دیتابیس D1 (شماره ${item.index}):</b>\n\nنام متغیر بایندینگ (Binding Name) را وارد کنید (مثال: <code>DB</code> یا <code>IOT_DB</code>):`, env, false, keyboard);
    } else if (item.step === "ID") {
      return sendMessage(chatId, `🗄 <b>دیتابیس D1 (شماره ${item.index}):</b>\n\nشناسه دیتابیس D1 (Database ID) را وارد کنید یا خالی بگذارید برای ساخت خودکار:`, env, false, keyboard);
    }
  } else if (item.type === "var") {
    if (item.step === "NAME") {
      return sendMessage(chatId, `⚙️ <b>متغیر معمولی (شماره ${item.index}):</b>\n\nنام متغیر محیطی را وارد کنید (مثال: <code>ADMIN</code>):`, env, false, keyboard);
    } else if (item.step === "VAL") {
      const customKb = [
        [{ text: "🎲 تولید خودکار مقدار رندوم", callback_data: "res_auto_val" }],
        getNavKeyboardRow()
      ];
      return sendMessage(chatId, `⚙️ <b>متغیر معمولی (شماره ${item.index}):</b>\n\nمقدار متغیر <code>${escapeHTML(item.name)}</code> را وارد کنید:`, env, false, customKb);
    }
  }
}

// --- TELEGRAM DEPLOYMENT EXECUTOR ---
async function executeTelegramDeployment(chatId, session, env) {
  const { account, name, templateIdx, templateUrl, isLegacy, kvBindings, vars, type, autoGenTemplate } = session.deployPayload;

  await sendMessage(chatId, "⚡ در حال خواندن سورس کد قالب...", env);
  let sourceCode = "";
  try {
    if (templateIdx === "custom") {
      sourceCode = await getPresetCode(null, env, templateUrl);
    } else {
      const preset = PRESETS[templateIdx];
      sourceCode = await getPresetCode(preset, env);
    }
  } catch (err) {
    session.state = "IDLE";
    await env.BOT_KV.put(`session:${chatId}`, JSON.stringify(session));
    return sendMessage(chatId, `❌ خطا در دریافت سورس کد:\n<code>${escapeHTML(err.message)}</code>`, env);
  }

  sourceCode += `\n\n/* Signed: ${generateRandomString(CharsetAlphaNumeric, 24)} */`;

  await sendMessage(chatId, "🛠️ در حال ساخت دیتابیس‌ها و تنظیم منابع اختصاصی شما...", env);
  try {
    const activeBindings = [];

    // Process presets' default KVs
    if (kvBindings && kvBindings.length > 0) {
      for (const kvName of kvBindings) {
        await sendMessage(chatId, `📦 در حال ایجاد دیتابیس KV با نام <code>${escapeHTML(kvName)}</code>...`, env);
        const kvNamespaceId = await createKVNamespace(account.token, account.id, `${name}-${kvName}`);
        if (kvNamespaceId) {
          activeBindings.push({ name: kvName, namespace_id: kvNamespaceId, type: "kv_namespace" });
        }
      }
    }

    // Process presets' variables & DB mappings
    let finalVars = { ...vars };
    if (autoGenTemplate && templateIdx !== "custom") {
      const preset = PRESETS[templateIdx];
      finalVars = autoGenerateVars(preset.vars, { ...vars, chatId: chatId.toString() });
    }

    // Auto-detect BOT_USERNAME via Telegram API if needed
    if (finalVars.BOT_TOKEN && (!finalVars.BOT_USERNAME || finalVars.BOT_USERNAME === "")) {
      try {
        const tgRes = await fetchWithTimeout(`https://api.telegram.org/bot${finalVars.BOT_TOKEN}/getMe`, {}, 8000);
        const tgData = await tgRes.json();
        if (tgData.ok && tgData.result && tgData.result.username) {
          finalVars.BOT_USERNAME = tgData.result.username;
        }
      } catch (_) {}
    }

    // Ensure ADMIN_IDS has a value if preset needs it
    if (finalVars.hasOwnProperty("ADMIN_IDS") && (!finalVars.ADMIN_IDS || finalVars.ADMIN_IDS === "")) {
      finalVars.ADMIN_IDS = chatId.toString();
    }

    if (finalVars) {
      for (let [key, val] of Object.entries(finalVars)) {
        if (key.startsWith("D1_ID_")) {
          const bindingName = key.replace("D1_ID_", "");
          let dbId = val;
          if (dbId === "auto" || !dbId) {
            await sendMessage(chatId, `🗄 در حال ایجاد فیزیکی دیتابیس D1 با نام <code>${escapeHTML(bindingName)}</code>...`, env);
            const sanitizedDbName = `${name}-${bindingName}`.toLowerCase().replace(/[^a-z0-9_-]/g, "-");
            dbId = await createD1Database(account.token, account.id, sanitizedDbName);
            finalVars[key] = dbId;
          }

          activeBindings.push({
            name: bindingName,
            database_id: dbId,
            type: "d1"
          });

          // Execute D1 Database Schema if preset requires it
          if (templateIdx !== "custom") {
            const currentPreset = PRESETS[templateIdx];
            if (currentPreset && currentPreset.id === "faceless_chat_bot") {
              await sendMessage(chatId, "⚙️ در حال ساخت خودکار جدول‌های دیتابیس (users, chats, logs) برای بات چت ناشناس...", env);
              const schemaSql = `
CREATE TABLE IF NOT EXISTS users (
  user_id INTEGER PRIMARY KEY,
  gender TEXT,
  target_gender TEXT,
  status TEXT DEFAULT 'idle',
  chat_id TEXT DEFAULT NULL,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
CREATE TABLE IF NOT EXISTS chats (
  chat_id TEXT PRIMARY KEY,
  user1 INTEGER,
  user2 INTEGER,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
CREATE TABLE IF NOT EXISTS logs (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  user_id INTEGER,
  action TEXT,
  details TEXT,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
`;
              await executeD1Statements(account.token, account.id, dbId, schemaSql);
            }
          }
        } else {
          activeBindings.push({
            name: key,
            text: val ? val.toString() : "",
            type: "plain_text"
          });
        }
      }
    }

    // Handle custom wizard resources if applicable
    if (session.deployPayload.resourceQueue && session.deployPayload.resourceQueue.length > 0) {
      for (const item of session.deployPayload.resourceQueue) {
        if (item.type === "kv") {
          let kvId = item.id;
          if (kvId === "auto" || !kvId) {
            await sendMessage(chatId, `📦 در حال ایجاد خودکار دیتابیس KV برای بایندینگ ${escapeHTML(item.name)}...`, env);
            kvId = await createKVNamespace(account.token, account.id, `${name}-${item.name}`);
          }
          activeBindings.push({ name: item.name, namespace_id: kvId, type: "kv_namespace" });
        } else if (item.type === "d1") {
          let d1Id = item.id;
          if (d1Id === "auto" || !d1Id) {
            await sendMessage(chatId, `🗄 در حال ساخت فیزیکی دیتابیس D1 برای بایندینگ ${escapeHTML(item.name)}...`, env);
            const sanitizedDbName = `${name}-${item.name}`.toLowerCase().replace(/[^a-z0-9_-]/g, "-");
            d1Id = await createD1Database(account.token, account.id, sanitizedDbName);
          }
          activeBindings.push({ name: item.name, database_id: d1Id, type: "d1" });
        } else if (item.type === "var") {
          activeBindings.push({ name: item.name, text: item.val ? item.val.toString() : "", type: "plain_text" });
        }
      }
    }

    await sendMessage(chatId, "🚀 در حال انتشار و استقرار نهایی پروژه در لبه‌های ابری کلادفلر...", env);

    if (type === "pages") {
      await createPagesProject(account.token, account.id, name, activeBindings);
      await deployPagesAsset(account.token, account.id, name, sourceCode);
    } else {
      await deployWorkerScript(account.token, account.id, name, sourceCode, activeBindings);
      await enableWorkerSubdomain(account.token, account.id, name);
    }

    // Resolve workers subdomain & path suffix
    let sub = account.subdomain;
    if (!sub || !sub.trim()) {
      sub = await getWorkerSubdomain(account.token, account.id, env, account.name);
    }
    sub = sub ? sub.trim().replace(/^.+|.+$/g, "") : "";
    if (!sub && account.name) {
      sub = deriveFallbackSubdomain(account.name);
    }

    let pathSuffix = "";
    if (templateIdx !== "custom") {
      const preset = PRESETS[templateIdx];
      pathSuffix = resolvePathSuffix(preset, finalVars);
    }

    const rawBaseUrl = (type === "pages")
      ? `https://${name}.pages.dev`
      : (sub ? `https://${name}.${sub}.workers.dev` : `https://${name}.workers.dev`);

    const finalUrl = `${rawBaseUrl}${pathSuffix}`;

    // Build precise success variable list output
    // Build comprehensive success variable and resource list output
    let varsMsg = "";
    const activePreset = templateIdx !== "custom" ? PRESETS[templateIdx] : null;

    if (activePreset && activePreset.kvBindings && activePreset.kvBindings.length > 0) {
      varsMsg += "\n\n📦 <b>دیتابیس‌های ذخیره‌سازی KV متصل‌شده:</b>\n";
      for (const kv of activePreset.kvBindings) {
        varsMsg += `🔸 دیتابیس KV: متغیر بایندینگ <code>${escapeHTML(kv)}</code> (متصل شد)\n`;
      }
    }

    if (finalVars && Object.keys(finalVars).length > 0) {
      varsMsg += "\n🔑 <b>مشخصات و متغیرهای ثبت‌شده:</b>\n";
      for (const [k, v] of Object.entries(finalVars)) {
        const displayKey = k.startsWith("D1_ID_") ? k.replace("D1_ID_", "D1_DATABASE_") : k;
        varsMsg += `🔸 <code>${displayKey}</code>: <code>${escapeHTML(v.toString())}</code>\n`;
      }
    }

    if (activePreset) {
      if (activePreset.id === "netra_panel") {
        varsMsg += "\n🖥️ <b>اطلاعات ورود به پنل نترا (Netra Panel):</b>\n";
        varsMsg += "🔸 مسیر پنل: <code>/panel</code>\n";
