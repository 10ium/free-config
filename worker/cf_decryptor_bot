          <div class="btn-group">
            <button id="copyAllBtn" class="btn-primary">\u{1F4CB} \u06A9\u067E\u06CC \u06A9\u0644 \u0645\u062D\u062A\u0648\u0627</button>
            <button id="downloadBtn" class="btn-secondary">\u{1F4BE} \u062F\u0627\u0646\u0644\u0648\u062F \u0641\u0627\u06CC\u0644 \u062E\u0631\u0648\u062C\u06CC</button>
