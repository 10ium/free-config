</head>
<body>
    <div class="container">
        <!-- هدر اصلی -->
        <div class="header">
            <div class="header-badge">⚡ نسل جدید کانورتر هوشمند ۳ هسته‌ای</div>
            <h1>Universal Proxy Hub</h1>
            <p>تبدیل و میکس زنده سابسکریپشن‌ها به کلش، سینگ‌باکس و اکس‌ری با لینک کوتاه ایزوله</p>
        </div>

        <!-- باکس گزارش خطای سراسری با دکمه کپی -->
        <div id="global_error_box" class="error-banner">
            <div class="error-banner-header">
                <span class="error-banner-title">⚠️ گزارش خطای سیستم یا عملیات</span>
                <button class="btn-copy-error" onclick="copyGlobalError()">📋 کپی متن کامل خطا</button>
            </div>
            <pre id="global_error_text" class="error-banner-text"></pre>
        </div>

        <!-- کارت ۱: فرم ساخت یا ویرایش خروجی دلخواه -->
        <div class="card">
            <div class="card-header">
                <div class="card-title">
                    <span class="icon">🛠️</span>
                    <span id="form_title_text">ساخت خروجی اختصاصی جدید</span>
                </div>
                <div class="auth-bar">
                    <span id="auth_badge" class="badge-auth guest">در حال بررسی...</span>
                    <button id="btn_auth_modal" class="btn btn-secondary btn-action" onclick="openAuthModal()">🔑 لاگین مدیر</button>
                </div>
            </div>

            <div class="form-group">
                <label for="subs">لینک‌های سورس اشتراک (هر لینک در یک خط):</label>
                <textarea id="subs" placeholder="https://example.com/sub1&#10;https://example.com/sub2"></textarea>
                <div class="input-hint">می‌توانید چندین سورس مختلف را ترکیب کنید؛ هر خروجی کاملاً ایزوله است و سورس‌های شما هرگز در سابسکریپشن‌های عمومی افشا نمی‌شوند.</div>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label for="slug">نام اسلاگ دلخواه (لینک کوتاه و نام پروفایل VPN):</label>
                    <input type="text" id="slug" placeholder="مثلاً: vip-mix یا میکس-فری-ساب" dir="auto">
                    <div class="input-hint">آدرس خروجی به صورت /&lt;slug&gt; ساخته می‌شود و همین نام به‌عنوان اسم پروفایل در کلش/اکس‌ری نمایش داده می‌شود.</div>
                </div>
                <div class="form-group">
                    <label for="limit_total">حداکثر تعداد کل کانفیگ‌ها (اختیاری):</label>
                    <input type="number" id="limit_total" placeholder="مثلاً: 100 (خالی = نامحدود)">
                    <div class="input-hint">برای جلوگیری از سنگین شدن کلاینت و کدهای سابسکریپشن.</div>
                </div>
            </div>

            <!-- تنظیمات Amnezia-WG و فیلتر تکراری‌ها -->
            <div class="form-group" style="background: rgba(255,255,255,0.02); padding: 14px; border-radius: 12px; border: 1px solid var(--border-color);">
                <label class="checkbox-container">
                    <input type="checkbox" id="cfg_dedup" checked>
                    <span>حذف هوشمند کانفیگ‌های تکراری (Smart Deduplication)</span>
                </label>
                <div class="input-hint" style="margin-right: 28px;">
                    کانفیگ‌های تکراری با انجین دقیق ورکر به صورت خودکار پالایش می‌شوند تا حجم ساب سبک بماند. اگر می‌خواهید هیچ کانفیگی حذف نشود، تیک را بردارید.
                </div>

                <label class="checkbox-container" style="margin-top: 14px;">
                    <input type="checkbox" id="awg">
                    <span>فعال‌سازی پارامترهای ضد فیلترینگ Amnezia-WG</span>
                </label>
                <div class="input-hint" style="margin-right: 28px;">
                    تزریق مقادیر جک‌پات (Jc, Jmin, Jmax) به کانفیگ‌های وایرگارد جهت دور زدن فیلترینگ شدید پروتکل UDP.
                </div>
            </div>

            <!-- اولویت‌بندی و فیلتر سقف پروتکل‌ها -->
            <div class="form-group" style="background: rgba(255,255,255,0.02); padding: 14px; border-radius: 12px; border: 1px solid var(--border-color); margin-top: 12px;">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 6px;">
                    <label style="display: block; font-weight: 700; margin: 0;">⚡ اولویت‌بندی و محدودیت پروتکل‌ها:</label>
                    <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                        <button type="button" class="btn btn-secondary btn-action" onclick="resetProtocolsToDefault()" style="font-size: 11px; padding: 4px 8px;">🔄 بازنشانی به ترتیب پیش‌فرض</button>
                        <button type="button" class="btn btn-secondary btn-action" onclick="setAllLimits('')" style="font-size: 11px; padding: 4px 8px;">∞ نامحدود کردن همه</button>
                        <button type="button" class="btn btn-secondary btn-action" onclick="setAllLimits('0')" style="font-size: 11px; padding: 4px 8px;">🚫 صفر کردن همه</button>
                    </div>
                </div>
                <div class="input-hint" style="margin-bottom: 8px;">
                    ترتیب پیش‌فرض بر اساس میزان محبوبیت و کاربرد چیده شده است. برای جابجایی سطرها را با ماوس بکشید (Drag &amp; Drop) یا از دکمه‌های ▲ و ▼ استفاده کنید. برای هر پروتکل سقف مشخص کنید (خالی = نامحدود، عدد ۰ = فیلتر و حذف کامل).
                </div>
                
                <div class="table-scroll-container">
                    <table class="config-table">
                        <thead>
                            <tr>
                                <th style="text-align: right; padding-right: 14px;">اولویت و نوع پروتکل</th>
                                <th style="width: 140px; text-align: center;">سقف تعداد (۰ = حذف)</th>
                            </tr>
                        </thead>
                        <tbody id="protocol_table_body"></tbody>
                    </table>
                </div>
            </div>

            <!-- دکمه ثبت / بروزرسانی -->
            <button id="btn_submit_slug" class="btn btn-primary" onclick="processAndSave()">
                <span>🚀 ذخیره و ساخت لینک‌های اختصاصی</span>
            </button>
            <button id="btn_cancel_edit" class="btn btn-secondary" onclick="cancelEdit()" style="display: none; width: 100%; margin-top: 8px;">
                <span>انصراف از ویرایش</span>
            </button>
        </div>

        <!-- کارت ۲: لیست خروجی‌های ذخیره شده (با قابلیت ویرایش و حذف) -->
        <div class="card" id="card_saved_slugs">
            <div class="card-header">
                <div class="card-title">
                    <span class="icon">📁</span>
                    <span>خروجی‌های اختصاصی شما (مدیریت، ویرایش و حذف)</span>
                </div>
                <button class="btn btn-secondary btn-action" onclick="loadSlugsList()">🔄 بروزرسانی لیست</button>
            </div>
            
            <div id="slugs_loading" style="text-align: center; color: var(--text-muted); padding: 20px;">در حال بارگذاری لیست اسلاگ‌ها...</div>
            <div id="slugs_empty" style="text-align: center; color: var(--text-muted); padding: 20px; display: none;">هنوز هیچ خروجی سفارشی ثبت نشده است. اولین خروجی خود را از فرم بالا بسازید!</div>
            <div id="slugs_container" class="slugs-list"></div>
        </div>
    </div>

    <!-- مودال ورود / تنظیم رمز عبور -->
    <div id="auth_modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <div id="modal_title" class="modal-title">🔑 احراز هویت مدیریت</div>
                <button class="close-btn" onclick="closeAuthModal()">&times;</button>
            </div>
            <p id="modal_desc" style="font-size: 13px; color: var(--text-muted); margin-bottom: 16px; line-height: 1.5;">
                برای ویرایش، مشاهده و حذف خروجی‌ها، رمز عبور مدیریت را وارد کنید.
            </p>
            <div class="form-group">
                <label for="admin_password">رمز عبور مدیر:</label>
                <input type="password" id="admin_password" placeholder="رمز عبور...">
            </div>
            <button id="btn_auth_submit" class="btn btn-primary" onclick="submitAuth()">
                <span>تایید و ورود</span>
            </button>
        </div>
    </div>

    <div id="toast" class="toast">✅ انجام شد!</div>

    <script>
        // گزارش سراسری خطا به کاربر بدون باگ اسکیپ
        window.onerror = function(msg, url, lineNo, columnNo, error) {
            var nl = String.fromCharCode(10);
            showGlobalError("خطای اسکریپت: " + msg + nl + "خط: " + lineNo + ":" + columnNo + (error && error.stack ? nl + error.stack : ""));
            return false;
        };
        window.onunhandledrejection = function(event) {
            showGlobalError("خطای نامتقارن: " + (event.reason ? (event.reason.stack || event.reason) : event));
        };

        function showGlobalError(txt) {
            var box = document.getElementById('global_error_box');
            var pre = document.getElementById('global_error_text');
            if (box && pre) {
                box.style.display = 'block';
                pre.textContent = txt;
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        function copyGlobalError() {
            var pre = document.getElementById('global_error_text');
            if (pre) {
                navigator.clipboard.writeText(pre.textContent).then(function() {
                    showToast('📋 متن کامل خطا کپی شد!');
                }).catch(function() { prompt('متن خطا:', pre.textContent); });
            }
        }

        var origin = window.location.origin;
        var editingSlug = null;

        function getAuthToken() {
            return localStorage.getItem('uph_admin_token') || '';
        }

        function setAuthToken(token) {
            localStorage.setItem('uph_admin_token', token);
            document.cookie = 'uph_admin_token=' + token + '; path=/; max-age=31536000';
        }

        function showToast(msg) {
            var toast = document.getElementById('toast');
            toast.textContent = msg;
            toast.classList.add('show');
            setTimeout(function() { toast.classList.remove('show'); }, 3000);
        }

        function copyText(txt, desc) {
            navigator.clipboard.writeText(txt).then(function() {
                showToast('📋 ' + desc + ' کپی شد!');
            }).catch(function() {
                prompt('کپی دستی:', txt);
            });
        }

        // اولویت‌بندی پیش‌فرض بر اساس سفارش دقیق کاربر بدون توضیحات اضافی
        var DEFAULT_PROTOCOLS = [
            { id: "vless",        name: "VLESS" },
            { id: "trojan",       name: "Trojan" },
            { id: "shadowsocks",  name: "Shadowsocks" },
            { id: "vmess",        name: "VMess" },
            { id: "hysteria2",    name: "Hysteria 2" },
            { id: "masque",       name: "MASQUE" },
            { id: "wireguard",    name: "WireGuard / AWG" },
            { id: "ssh",          name: "SH Tunnel" },
            { id: "anytls",       name: "AnyTLS" },
            { id: "tuic",         name: "TUIC" },
            { id: "shadowtls",    name: "ShadowTLS" },
            { id: "shadowsocksr", name: "ShadowsocksR" },
            { id: "shadowquic",   name: "ShadowQUIC" },
            { id: "socks5",       name: "SOCKS5" },
            { id: "http",         name: "HTTP / HTTPS" },
            { id: "snell",        name: "Snell" },
            { id: "naive",        name: "NaiveProxy" },
            { id: "trusttunnel",  name: "TrustTunnel" },
            { id: "sudoku",       name: "Sudoku" },
            { id: "mieru",        name: "Mieru" },
            { id: "easytier",     name: "EasyTier" },
            { id: "tailscale",    name: "Tailscale" }
        ];

        function resetProtocolsToDefault() {
            initProtocolTable(null, null);
            showToast('🔄 اولویت‌ها به ترتیب محبوب‌ترین پروتکل‌ها بازنشانی شد.');
        }

        function setAllLimits(val) {
            document.querySelectorAll('#protocol_table_body .limit-input').forEach(function(inp) {
                inp.value = val;
            });
            showToast(val === '' ? '∞ تمام پروتکل‌ها نامحدود شدند.' : '🚫 تمام پروتکل‌ها روی ۰ قرار گرفتند.');
        }

        function initProtocolTable(priorities, limits) {
            var tbody = document.getElementById('protocol_table_body');
            if (!tbody) return;
            tbody.innerHTML = '';
            var protos = DEFAULT_PROTOCOLS.slice();
            if (priorities && typeof priorities === 'object') {
                protos.sort(function(a, b) {
                    var pa = priorities[a.id] !== undefined ? priorities[a.id] : 99;
                    var pb = priorities[b.id] !== undefined ? priorities[b.id] : 99;
                    return pa - pb;
                });
            }
            protos.forEach(function(p) {
                var tr = document.createElement('tr');
                tr.className = 'draggable-row';
                tr.draggable = true;
                tr.dataset.protocol = p.id;
                
                var limVal = (limits && limits[p.id] !== undefined) ? limits[p.id] : '';
                
                tr.innerHTML = '<td>' +
                    '<div class="proto-label-box">' +
                        '<span class="drag-handle" title="بکشید و جابجا کنید">☰</span>' +
                        '<div class="move-btns">' +
                            '<button type="button" class="move-btn" onclick="moveRowUp(this)" title="انتقال به بالا">▲</button>' +
                            '<button type="button" class="move-btn" onclick="moveRowDown(this)" title="انتقال به پایین">▼</button>' +
                        '</div>' +
                        '<span class="proto-badge-name">' + p.name + '</span>' +
                    '</div>' +
                '</td>' +
                '<td style="text-align:center;">' +
                    '<input type="number" class="limit-input" placeholder="∞" value="' + limVal + '" min="0">' +
                '</td>';
                tbody.appendChild(tr);
            });
            setupDragAndDrop();
        }

        function moveRowUp(btn) {
            var row = btn.closest('tr');
            if (row && row.previousElementSibling) {
                row.parentNode.insertBefore(row, row.previousElementSibling);
            }
        }

        function moveRowDown(btn) {
            var row = btn.closest('tr');
            if (row && row.nextElementSibling) {
                row.parentNode.insertBefore(row.nextElementSibling, row);
            }
        }

        var draggedItem = null;
        function setupDragAndDrop() {
            document.querySelectorAll('.draggable-row').forEach(function(row) {
                row.addEventListener('dragstart', function(e) {
                    draggedItem = this;
                    setTimeout(function() { if (draggedItem) draggedItem.classList.add('dragging'); }, 0);
                });
                row.addEventListener('dragend', function() {
                    setTimeout(function() {
                        document.querySelectorAll('.draggable-row').forEach(function(r) {
                            r.classList.remove('dragging');
                            r.classList.remove('drag-over');
                        });
                        draggedItem = null;
                    }, 0);
                });
                row.addEventListener('dragover', function(e) { e.preventDefault(); });
                row.addEventListener('dragenter', function(e) {
                    e.preventDefault();
                    if (this !== draggedItem) this.classList.add('drag-over');
                });
                row.addEventListener('dragleave', function() {
                    this.classList.remove('drag-over');
                });
                row.addEventListener('drop', function(e) {
                    this.classList.remove('drag-over');
                    if (this !== draggedItem && draggedItem) {
                        var tbody = this.parentNode;
                        var rows = Array.from(tbody.children);
                        var draggedIndex = rows.indexOf(draggedItem);
                        var targetIndex = rows.indexOf(this);
                        if (draggedIndex < targetIndex) {
                            tbody.insertBefore(draggedItem, this.nextSibling);
                        } else {
                            tbody.insertBefore(draggedItem, this);
                        }
                    }
                });
            });
        }

        // بررسی وضعیت اولیه
        async function checkStatus() {
            try {
                var res = await fetch('/api/status', {
                    headers: { 'x-admin-key': getAuthToken() }
                });
                var data = await res.json();
                var badge = document.getElementById('auth_badge');
                if (data.setupRequired) {
                    badge.className = 'badge-auth guest';
                    badge.textContent = 'نیاز به تعیین رمز اولیه';
                    openAuthModal(true);
                } else if (data.authenticated) {
                    badge.className = 'badge-auth logged';
                    badge.textContent = 'مدیر احراز هویت شده ✅';
                    document.getElementById('btn_auth_modal').textContent = 'تغییر رمز';
                    loadSlugsList();
                } else {
                    badge.className = 'badge-auth guest';
                    badge.textContent = 'کاربر مهمان';
                    document.getElementById('slugs_loading').textContent = '🔒 برای مشاهده و مدیریت لیست خروجی‌ها ابتدا از دکمه بالا لاگین کنید.';
                }
            } catch (e) {
                showGlobalError("خطا در ارتباط با ورکر: " + (e.message || e));
            }
        }

        function openAuthModal(isSetup) {
            var modal = document.getElementById('auth_modal');
            var title = document.getElementById('modal_title');
            var desc = document.getElementById('modal_desc');
            var btn = document.getElementById('btn_auth_submit');
            var passInput = document.getElementById('admin_password');
            passInput.value = '';

            if (isSetup) {
                title.textContent = '🔐 تعیین رمز عبور مدیر ورکر';
                desc.textContent = 'هیچ رمزی برای ورکر تعیین نشده است. لطفاً برای محافظت از سورس‌ها یک رمز مطمئن انتخاب کنید.';
                btn.onclick = submitSetup;
            } else {
                title.textContent = '🔑 ورود به پنل مدیریت';
                desc.textContent = 'جهت مشاهده، ویرایش و حذف اسلاگ‌ها، رمز عبور مدیر را وارد کنید.';
                btn.onclick = submitAuth;
            }
            modal.classList.add('open');
            passInput.focus();
        }

        function closeAuthModal() {
            document.getElementById('auth_modal').classList.remove('open');
        }

        async function submitSetup() {
            var pass = document.getElementById('admin_password').value.trim();
            if (!pass) return alert('رمز عبور الزامی است.');
            try {
                var res = await fetch('/api/setup', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ password: pass })
                });
                var d = await res.json();
                if (!res.ok) throw new Error(d.error || 'خطا در ثبت رمز');
                setAuthToken(pass);
                closeAuthModal();
                showToast('✅ رمز عبور با موفقیت تعیین شد.');
                checkStatus();
            } catch (e) {
                showGlobalError("خطا در تنظیم رمز: " + (e.message || e));
            }
        }

        async function submitAuth() {
            var pass = document.getElementById('admin_password').value.trim();
            if (!pass) return alert('رمز عبور را وارد کنید.');
            try {
                var res = await fetch('/api/auth', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ password: pass })
                });
                var d = await res.json();
                if (!res.ok) throw new Error(d.error || 'رمز عبور اشتباه است.');
                setAuthToken(pass);
                closeAuthModal();
                showToast('✅ با موفقیت وارد شدید.');
                checkStatus();
            } catch (e) {
                showGlobalError("خطا در لاگین: " + (e.message || e));
            }
        }

        // بارگذاری و رندر لیست اسلاگ‌ها بدون باگ کاراکترهای اسکیپ
        async function loadSlugsList() {
            var container = document.getElementById('slugs_container');
            var loading = document.getElementById('slugs_loading');
            var empty = document.getElementById('slugs_empty');
            loading.style.display = 'block';
            empty.style.display = 'none';
            container.innerHTML = '';

            try {
                var res = await fetch('/api/slugs', {
                    headers: { 'x-admin-key': getAuthToken() }
                });
                if (res.status === 401) {
                    loading.textContent = '🔒 برای مشاهده و مدیریت لیست خروجی‌ها باید لاگین کنید.';
                    return;
                }
                var list = await res.json();
                loading.style.display = 'none';
                if (!Array.isArray(list) || list.length === 0) {
                    empty.style.display = 'block';
                    return;
                }

                list.forEach(function(item) {
                    var card = document.createElement('div');
                    card.className = 'slug-item';

                    var header = document.createElement('div');
                    header.className = 'slug-header';

                    var info = document.createElement('div');
                    info.className = 'slug-info';

                    var nameSpan = document.createElement('span');
                    nameSpan.className = 'slug-name';
                    nameSpan.textContent = '/' + item.slug;

                    var badgeCount = document.createElement('span');
                    badgeCount.className = 'slug-badge';
                    badgeCount.textContent = (item.subsCount || 0) + ' سورس';

                    info.appendChild(nameSpan);
                    info.appendChild(badgeCount);

                    if (item.limit_total) {
                        var badgeLimit = document.createElement('span');
                        badgeLimit.className = 'slug-badge';
                        badgeLimit.textContent = 'سقف: ' + item.limit_total;
                        info.appendChild(badgeLimit);
                    }

                    if (item.dedup === false) {
                        var badgeNoDedup = document.createElement('span');
                        badgeNoDedup.className = 'slug-badge';
                        badgeNoDedup.style.color = '#fbbf24';
                        badgeNoDedup.textContent = 'بدون حذف تکراری';
                        info.appendChild(badgeNoDedup);
                    }

                    if (item.awg) {
                        var badgeAwg = document.createElement('span');
                        badgeAwg.className = 'slug-badge';
                        badgeAwg.style.color = '#34d399';
                        badgeAwg.textContent = 'AWG فعال';
                        info.appendChild(badgeAwg);
                    }

                    var actions = document.createElement('div');
                    actions.className = 'slug-actions';

                    var btnEdit = document.createElement('button');
                    btnEdit.className = 'btn btn-action btn-edit';
                    btnEdit.textContent = '✏️ ویرایش';
                    btnEdit.onclick = function() { editSlug(item.slug); };

                    var btnDel = document.createElement('button');
                    btnDel.className = 'btn btn-action btn-del';
                    btnDel.textContent = '🗑️ حذف';
                    btnDel.onclick = function() { deleteSlug(item.slug); };

                    actions.appendChild(btnEdit);
                    actions.appendChild(btnDel);

                    header.appendChild(info);
                    header.appendChild(actions);
                    card.appendChild(header);

                    // ردیف دکمه‌های کپی لینک
                    var grid = document.createElement('div');
                    grid.className = 'slug-links-grid';

                    var encodedSlug = encodeURIComponent(item.slug);
                    var formats = [
                        { label: '⚡ تشخیص هوشمند', path: '/' + encodedSlug, desc: 'لینک هوشمند' },
                        { label: '🐱 کلش (Clash)', path: '/' + encodedSlug + '/clash', desc: 'لینک کلش' },
                        { label: '📦 سینگ‌باکس', path: '/' + encodedSlug + '/singbox', desc: 'لینک سینگ‌باکس' },
                        { label: '🚀 اکس‌ری متن', path: '/' + encodedSlug + '/xray', desc: 'لینک اکس‌ری' },
                        { label: '🔒 بیس۶۴', path: '/' + encodedSlug + '/b64', desc: 'لینک بیس۶۴' }
                    ];

                    formats.forEach(function(fmt) {
                        var btnFmt = document.createElement('button');
                        btnFmt.className = 'btn-copy-format';
                        btnFmt.textContent = fmt.label;
                        btnFmt.onclick = function() { copyText(origin + fmt.path, fmt.desc); };
                        grid.appendChild(btnFmt);
                    });

                    card.appendChild(grid);
                    container.appendChild(card);
                });
            } catch (e) {
                loading.textContent = 'خطا در بارگذاری خروجی‌ها.';
                showGlobalError("خطا در بارگذاری خروجی‌ها: " + (e.message || e));
            }
        }

        async function editSlug(slug) {
            try {
                var res = await fetch('/api/slug/' + encodeURIComponent(slug), {
                    headers: { 'x-admin-key': getAuthToken() }
                });
                var d = await res.json();
                if (!res.ok) throw new Error(d.error || 'یافت نشد');
                var cfg = d.config || {};
                editingSlug = slug;

                var nl = String.fromCharCode(10);
                document.getElementById('subs').value = (cfg.subs || []).join(nl);
                document.getElementById('slug').value = slug;
                document.getElementById('slug').disabled = true;
                document.getElementById('limit_total').value = cfg.limit_total || '';
                document.getElementById('awg').checked = Boolean(cfg.awg);
                document.getElementById('cfg_dedup').checked = (cfg.dedup !== false);
                initProtocolTable(cfg.priorities, cfg.limits);

                document.getElementById('form_title_text').textContent = 'ویرایش خروجی: /' + slug;
                document.getElementById('btn_submit_slug').textContent = '💾 بروزرسانی تغییرات خروجی';
                document.getElementById('btn_cancel_edit').style.display = 'block';

                window.scrollTo({ top: 0, behavior: 'smooth' });
                showToast('در حال ویرایش اسلاگ ' + slug);
            } catch (e) {
                showGlobalError("خطا در بارگذاری برای ویرایش: " + (e.message || e));
            }
        }

        function cancelEdit() {
            editingSlug = null;
            document.getElementById('subs').value = '';
            document.getElementById('slug').value = '';
            document.getElementById('slug').disabled = false;
            document.getElementById('limit_total').value = '';
            document.getElementById('awg').checked = false;
            document.getElementById('cfg_dedup').checked = true;
            initProtocolTable(null, null);

            document.getElementById('form_title_text').textContent = 'ساخت خروجی اختصاصی جدید';
            document.getElementById('btn_submit_slug').textContent = '🚀 ذخیره و ساخت لینک‌های اختصاصی';
            document.getElementById('btn_cancel_edit').style.display = 'none';
        }

        async function deleteSlug(slug) {
            if (!confirm('آیا از حذف خروجی /' + slug + ' اطمینان دارید؟')) return;
            try {
                var res = await fetch('/api/slug/' + encodeURIComponent(slug), {
                    method: 'DELETE',
                    headers: { 'x-admin-key': getAuthToken() }
                });
                var d = await res.json();
                if (!res.ok) throw new Error(d.error || 'خطا در حذف');
                showToast('🗑️ خروجی حذف شد.');
                if (editingSlug === slug) cancelEdit();
                loadSlugsList();
            } catch (e) {
                showGlobalError("خطا در حذف خروجی: " + (e.message || e));
            }
        }

        async function processAndSave() {
            var btn = document.getElementById('btn_submit_slug');
            var subsText = document.getElementById('subs').value.trim();
            var slug = document.getElementById('slug').value.trim().toLowerCase();
            var limitTotal = document.getElementById('limit_total').value.trim();
            var awg = document.getElementById('awg').checked;
            var dedup = document.getElementById('cfg_dedup').checked;

            if (!slug) return alert('لطفاً یک نام اسلاگ وارد کنید.');
            var splitRegex = new RegExp('[' + String.fromCharCode(13) + String.fromCharCode(10) + ']+');
            var subsList = subsText ? subsText.split(splitRegex).map(function(s) { return s.trim(); }).filter(Boolean) : [];

            btn.disabled = true;
            btn.textContent = '⏳ در حال ذخیره و پردازش...';

            var limits = {};
            var priorities = {};
            var pRows = document.querySelectorAll('#protocol_table_body tr');
            pRows.forEach(function(row, idx) {
                var proto = row.dataset.protocol;
                priorities[proto] = idx + 1;
                var val = row.querySelector('.limit-input').value.trim();
                if (val !== "") {
                    limits[proto] = parseInt(val, 10);
                }
            });

            var payload = {
                slug: slug,
                config: {
                    subs: subsList,
                    limit_total: limitTotal ? parseInt(limitTotal) : null,
                    awg: awg,
                    dedup: dedup,
                    limits: limits,
                    priorities: priorities
                }
            };

            try {
                var res = await fetch('/api/slug', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'x-admin-key': getAuthToken()
                    },
                    body: JSON.stringify(payload)
                });
                var d = await res.json();
                if (!res.ok) throw new Error(d.error || 'خطا در ذخیره اسلاگ');

                showToast('🎉 خروجی با موفقیت ذخیره شد!');
                cancelEdit();
                loadSlugsList();
            } catch (e) {
                showGlobalError("خطا در ذخیره خروجی: " + (e.message || e));
            } finally {
                btn.disabled = false;
                btn.textContent = editingSlug ? '💾 بروزرسانی تغییرات خروجی' : '🚀 ذخیره و ساخت لینک‌های اختصاصی';
            }
        }

        window.onload = checkStatus;
    </script>
</body>
</html>`;
}

