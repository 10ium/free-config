\u2022 <b>\u0627\u0631\u0633\u0627\u0644 \u0628\u0627 \u0631\u0633\u06CC\u062F \u0633\u06CC\u0646 (\u{1F441}):</b> \u067E\u06CC\u0627\u0645 \u0628\u0647 \u0635\u0648\u0631\u062A \u067E\u0627\u06A9\u062A \u0646\u0627\u0634\u0646\u0627\u0633 \u062A\u062D\u0648\u06CC\u0644 \u062F\u0627\u062F\u0647 \u0634\u062F\u0647 \u0648 \u0645\u062E\u0627\u0637\u0628 \u0628\u0627 \u0632\u062F\u0646 \u062F\u06A9\u0645\u0647 \u0622\u0646 \u0631\u0627 \u0628\u0627\u0632 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0628\u0647 \u0645\u062D\u0636 \u0628\u0627\u0632 \u0634\u062F\u0646 \u067E\u06CC\u0627\u0645\u060C \u062A\u06CC\u06A9 \u0648 \u0631\u0633\u06CC\u062F \u0633\u06CC\u0646 (\u062E\u0648\u0627\u0646\u062F\u0647 \u0634\u062F) \u0628\u0631\u0627\u06CC \u0634\u0645\u0627 \u0627\u0631\u0633\u0627\u0644 \u0645\u06CC\u200C\u06AF\u0631\u062F\u062F.

