async function handleWebhookSetup(origin, env) {
  if (!env.TELEGRAM_BOT_TOKEN) {
    return new Response("TELEGRAM_BOT_TOKEN is not configured.", { status: 400 });
  }

  const webhookUrl = `${origin}/`;
  const setWebhookApi = `https://api.telegram.org/bot${env.TELEGRAM_BOT_TOKEN}/setWebhook`;
  
  const payload = {
    url: webhookUrl,
    drop_pending_updates: true
  };
  if (env.SECRET_TOKEN) {
    payload.secret_token = env.SECRET_TOKEN;
  }

  try {
    const res = await fetchWithTimeout(setWebhookApi, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    }, 10000);
    const data = await res.json();
    return new Response(JSON.stringify(data, null, 2), {
      status: 200,
      headers: { "Content-Type": "application/json" }
    });
  } catch (err) {
    return new Response(JSON.stringify({ error: err.message }), {
      status: 500,
      headers: { "Content-Type": "application/json" }
    });
  }
}



// --- SERVICE WORKER LISTENERS ---
addEventListener("fetch", event => {
  event.respondWith(handleFetch(event.request, event));
});

addEventListener("scheduled", event => {
  event.waitUntil(handleScheduled(event));
});

// --- ENVIRONMENT LOADER HELPER ---
function getEnv() {
  return {
    BOT_KV: typeof BOT_KV !== "undefined" ? BOT_KV : null,
    TELEGRAM_BOT_TOKEN: typeof TELEGRAM_BOT_TOKEN !== "undefined" ? TELEGRAM_BOT_TOKEN : null,
    SECRET_TOKEN: typeof SECRET_TOKEN !== "undefined" ? SECRET_TOKEN : null
  };
}

// --- SYSTEM LOGGER HELPER ---
async function logEvent(env, message, type = "info") {
  if (!env || !env.BOT_KV) {
    console.log(`[${type}] ${message}`);
    return;
  }
  try {
    const logs = await env.BOT_KV.get("system:logs", { type: "json" }) || [];
    const newLog = {
      timestamp: new Date().toLocaleString("fa-IR", { timeZone: "Asia/Tehran" }),
      message,
      type
    };
    logs.unshift(newLog);
    if (logs.length > 50) logs.pop();
    await env.BOT_KV.put("system:logs", JSON.stringify(logs));
  } catch (err) {
    console.error("Logging error: ", err);
  }
}

// --- SCHEDULED CRON HANDLER ---
async function handleScheduled(event) {
  const env = getEnv();
  await logEvent(env, "سرویس دوره‌ای بررسی و ذخیره‌سازی نسخه‌های جدید ورکرها آغاز شد.", "info");
  await cacheAllPresets(env);
}

// --- MAIN FETCH HANDLER ---
async function handleFetch(request, event) {
  const url = new URL(request.url);
  const env = getEnv();

  // Telegram Webhook Setup endpoint
  if (url.pathname === "/setup") {
    return await handleWebhookSetup(url.origin, env);
  }

  // --- REST API ENDPOINTS FOR WEB DASHBOARD ---
  if (url.pathname.startsWith("/api/")) {
    return await handleApiRoutes(request, url, env);
  }

  // --- WEB DASHBOARD UI (SERVE ON / OR /dashboard) ---
  if (request.method === "GET" && (url.pathname === "/" || url.pathname === "/dashboard")) {
    return new Response(renderWebDashboard(), {
      status: 200,
      headers: {
        "Content-Type": "text/html; charset=utf-8",
        "Cache-Control": "no-cache"
      }
    });
  }

  // --- TELEGRAM WEBHOOK (POST) ---
  if (request.method === "POST") {
    if (env.SECRET_TOKEN) {
      const xTelegramToken = request.headers.get("X-Telegram-Bot-Api-Secret-Token");
      if (xTelegramToken !== env.SECRET_TOKEN) {
        return new Response("Unauthorized", { status: 403 });
      }
    }

    try {
      const update = await request.json();
      event.waitUntil(handleTelegramUpdate(update, env));
    } catch (err) {
      await logEvent(env, `Error parsing TG update: ${err.message}`, "error");
    }
    return new Response("OK", { status: 200 });
  }

  return new Response("Not Found", { status: 404 });
}

// --- REST API ROUTER ---
async function handleApiRoutes(request, url, env) {
  const jsonResponse = (data, status = 200) => new Response(JSON.stringify(data), {
    status,
    headers: { "Content-Type": "application/json; charset=utf-8" }
  });

  try {
    // 1. GET /api/presets
    if (request.method === "GET" && url.pathname === "/api/presets") {
      return jsonResponse(PRESETS);
    }

    // 2. GET /api/accounts
    if (request.method === "GET" && url.pathname === "/api/accounts") {
      const accounts = await getGlobalAccounts(env);
      const safeAccounts = [];
      for (const a of accounts) {
        const sub = await env.BOT_KV.get(`subdomain:${a.id}`) || "";
        safeAccounts.push({
          id: a.id,
          name: a.name,
          subdomain: sub,
          tokenMasked: a.token ? (a.token.substring(0, 6) + "••••••••" + a.token.slice(-4)) : ""
        });
      }
      return jsonResponse(safeAccounts);
    }

    // 3. POST /api/accounts (Add Account)
    if (request.method === "POST" && url.pathname === "/api/accounts") {
      const body = await request.json();
      const token = (body.token || "").trim();
      if (!token) return jsonResponse({ success: false, error: "توکن کلادفلر الزامی است." }, 400);

      const isValid = await verifyCloudflareToken(token);
      if (!isValid) return jsonResponse({ success: false, error: "توکن کلادفلر نامعتبر است یا دسترسی‌های کافی ندارد." }, 400);

      const cfAccounts = await getCloudflareAccounts(token);
      if (!cfAccounts || cfAccounts.length === 0) {
        return jsonResponse({ success: false, error: "هیچ حسابی یافت نشد." }, 400);
      }

      const accounts = await getGlobalAccounts(env);
      if (accounts.some(a => a.token === token || a.id === cfAccounts[0].id)) {
        return jsonResponse({ success: false, error: "این حساب یا توکن قبلاً اضافه شده است." }, 400);
      }

      let detectedSub = await refreshWorkerSubdomainLive(token, cfAccounts[0].id, env);
      if (!detectedSub) {
        detectedSub = deriveFallbackSubdomain(cfAccounts[0].name);
      }
      if (detectedSub && env.BOT_KV) {
        await env.BOT_KV.put(`subdomain:${cfAccounts[0].id}`, detectedSub);
      }

      const newAcc = {
        uid: "acc_" + Date.now(),
        token: token,
        id: cfAccounts[0].id,
        name: cfAccounts[0].name,
        subdomain: detectedSub || ""
      };
      accounts.push(newAcc);
      await saveGlobalAccounts(env, accounts);
      await logEvent(env, `حساب جدید (${newAcc.name}) با ساب‌دومین (${newAcc.subdomain}) از طریق وب اضافه شد.`, "info");
      return jsonResponse({ success: true, account: { id: newAcc.id, name: newAcc.name, subdomain: newAcc.subdomain } });
    }

    // 4. DELETE /api/accounts
    if (request.method === "DELETE" && url.pathname === "/api/accounts") {
      const idx = parseInt(url.searchParams.get("idx"), 10);
      const accounts = await getGlobalAccounts(env);
      if (accounts[idx]) {
        const removed = accounts.splice(idx, 1);
        await saveGlobalAccounts(env, accounts);
        await logEvent(env, `حساب ${removed[0].name} از طریق وب برکنار شد.`, "warning");
        return jsonResponse({ success: true });
      }
      return jsonResponse({ success: false, error: "اکانت یافت نشد." }, 404);
    }

    // 5. POST /api/refresh-subdomain
    if (request.method === "POST" && url.pathname === "/api/refresh-subdomain") {
      const idx = parseInt(url.searchParams.get("idx"), 10);
      const accounts = await getGlobalAccounts(env);
      const acc = accounts[idx];
      if (!acc) return jsonResponse({ success: false, error: "اکانت یافت نشد." }, 404);

      const liveSub = await refreshWorkerSubdomainLive(acc.token, acc.id, env);
      return jsonResponse({ success: !!liveSub, subdomain: liveSub || "" });
    }

    // 6. GET /api/workers
    if (request.method === "GET" && url.pathname === "/api/workers") {
      const accIdx = parseInt(url.searchParams.get("accIdx"), 10);
      const accounts = await getGlobalAccounts(env);
      const acc = accounts[accIdx];
      if (!acc) return jsonResponse([], 200);

      const workers = await listWorkerScripts(acc.token, acc.id);
      return jsonResponse(workers);
    }

    // 7. GET /api/worker-source
    if (request.method === "GET" && url.pathname === "/api/worker-source") {
      const accIdx = parseInt(url.searchParams.get("accIdx"), 10);
      const workerName = url.searchParams.get("name");
      const accounts = await getGlobalAccounts(env);
      const acc = accounts[accIdx];
      if (!acc || !workerName) return new Response("Not found", { status: 404 });

      const code = await getWorkerScriptCode(acc.token, acc.id, workerName);
      return new Response(code, {
        headers: {
          "Content-Type": "application/javascript; charset=utf-8",
          "Content-Disposition": `attachment; filename="${workerName}.js"`
        }
      });
    }

    // 8. DELETE /api/workers
    if (request.method === "DELETE" && url.pathname === "/api/workers") {
      const accIdx = parseInt(url.searchParams.get("accIdx"), 10);
      const workerName = url.searchParams.get("name");
      const cleanBindings = url.searchParams.get("cleanBindings") === "true";
      const accounts = await getGlobalAccounts(env);
      const acc = accounts[accIdx];
      if (!acc || !workerName) return jsonResponse({ success: false, error: "ورکر یافت نشد." }, 404);

      let cleanedResourcesCount = 0;
      if (cleanBindings) {
        try {
          const settings = await getWorkerSettings(acc.token, acc.id, workerName);
          if (settings && Array.isArray(settings.bindings)) {
            for (const b of settings.bindings) {
              if (b.type === "kv_namespace" && b.namespace_id) {
                const ok = await deleteKVNamespace(acc.token, acc.id, b.namespace_id);
                if (ok) cleanedResourcesCount++;
              } else if (b.type === "d1" && b.database_id) {
                const ok = await deleteD1Database(acc.token, acc.id, b.database_id);
                if (ok) cleanedResourcesCount++;
              }
            }
          }
        } catch (_) {}
      }

      const cleanMsg = cleanBindings ? ("به همراه " + cleanedResourcesCount + " منبع متصل ") : "";
      await logEvent(env, "ورکر " + workerName + " " + cleanMsg + "از طریق پنل وب حذف شد.", "warning");
      return jsonResponse({ success: true, cleanedResourcesCount });
    }

    // 9. GET /api/worker-bindings
    if (request.method === "GET" && url.pathname === "/api/worker-bindings") {
      const accIdx = parseInt(url.searchParams.get("accIdx"), 10);
      const workerName = url.searchParams.get("name");
      const accounts = await getGlobalAccounts(env);
      const acc = accounts[accIdx];
      if (!acc || !workerName) return jsonResponse({ bindings: [] }, 404);

      const settings = await getWorkerSettings(acc.token, acc.id, workerName);
      return jsonResponse({ bindings: settings.bindings || [] });
    }

    // 10. DELETE /api/worker-bindings
    if (request.method === "DELETE" && url.pathname === "/api/worker-bindings") {
      const accIdx = parseInt(url.searchParams.get("accIdx"), 10);
      const workerName = url.searchParams.get("name");
      const accounts = await getGlobalAccounts(env);
      const acc = accounts[accIdx];
      if (!acc || !workerName) return jsonResponse({ success: false }, 404);

      const isAll = url.searchParams.get("all") === "true";
      if (isAll) {
        await updateWorkerBindings(acc.token, acc.id, workerName, []);
        await logEvent(env, `تمامی بایندینگ‌های ورکر ${workerName} از طریق وب حذف شدند.`, "warning");
        return jsonResponse({ success: true });
      }

      const bindingIdx = parseInt(url.searchParams.get("idx"), 10);
      const settings = await getWorkerSettings(acc.token, acc.id, workerName);
      const current = settings.bindings || [];
      const updated = current.filter((_, i) => i !== bindingIdx);
      await updateWorkerBindings(acc.token, acc.id, workerName, updated);
      await logEvent(env, `یک بایندینگ از ورکر ${workerName} از طریق وب حذف شد.`, "warning");
      return jsonResponse({ success: true });
    }

    // 11. POST /api/deploy (Web 1-Click Deploy)
    if (request.method === "POST" && url.pathname === "/api/deploy") {
      const body = await request.json();
      const { accIdx, presetId, workerName, vars, customUrl } = body;

      const accounts = await getGlobalAccounts(env);
      const account = accounts[accIdx];
      if (!account) return jsonResponse({ success: false, error: "اکانت کلادفلر انتخاب نشده است." }, 400);

      const preset = PRESETS.find(p => p.id === presetId);
      if (!preset && !customUrl) return jsonResponse({ success: false, error: "قالب نامعتبر است." }, 400);

      // Download code
      const code = preset ? await getPresetCode(preset, env) : await getPresetCode(null, env, customUrl);
      const signedCode = code + `\n\n/* Signed Web: ${generateRandomString(CharsetAlphaNumeric, 24)} */`;

      const activeBindings = [];

      // Create preset KVs if applicable
      if (preset && preset.kvBindings && preset.kvBindings.length > 0) {
        for (const kvName of preset.kvBindings) {
          const kvId = await createKVNamespace(account.token, account.id, `${workerName}-${kvName}`);
          activeBindings.push({ name: kvName, namespace_id: kvId, type: "kv_namespace" });
        }
      }

      // Process variables & D1
      const finalVars = autoGenerateVars(preset ? preset.vars : Object.keys(vars || {}), vars || {});
      for (const [k, v] of Object.entries(finalVars)) {
        if (k.startsWith("D1_ID_")) {
          const bindingName = k.replace("D1_ID_", "");
          let dbId = v;
          if (dbId === "auto" || !dbId) {
            const dbName = `${workerName}-${bindingName}`.toLowerCase().replace(/[^a-z0-9_-]/g, "-");
            dbId = await createD1Database(account.token, account.id, dbName);
          }
          activeBindings.push({ name: bindingName, database_id: dbId, type: "d1" });

          if (preset && (preset.id === "faceless-bot" || preset.id === "faceless_chat_bot")) {
            const schemaSql = `
CREATE TABLE IF NOT EXISTS users (user_id INTEGER PRIMARY KEY, gender TEXT, target_gender TEXT, status TEXT DEFAULT 'idle', chat_id TEXT DEFAULT NULL, created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE IF NOT EXISTS chats (chat_id TEXT PRIMARY KEY, user1 INTEGER, user2 INTEGER, created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE IF NOT EXISTS logs (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER, action TEXT, details TEXT, created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP);
`;
            await executeD1Statements(account.token, account.id, dbId, schemaSql);
          }
        } else {
          activeBindings.push({ name: k, text: v ? v.toString() : "", type: "plain_text" });
        }
      }

      await deployWorkerScript(account.token, account.id, workerName, signedCode, activeBindings);
      await enableWorkerSubdomain(account.token, account.id, workerName);

      let sub = account.subdomain;
      if (!sub || !sub.trim()) {
        sub = await getWorkerSubdomain(account.token, account.id, env, account.name);
      }
      const cleanSub = sub ? sub.trim().replace(/^.+|.+$/g, "") : deriveFallbackSubdomain(account.name);
      const pathSuffix = resolvePathSuffix(preset, finalVars);
      const rawBaseUrl = cleanSub ? `https://${workerName}.${cleanSub}.workers.dev` : `https://${workerName}.workers.dev`;
      const finalUrl = `${rawBaseUrl}${pathSuffix}`;

      // Automated post-deploy actions for bot presets
      if (preset && (preset.id === "faceless-bot" || preset.id === "faceless_chat_bot")) {
        try {
          await new Promise(r => setTimeout(r, 2500));
          await fetchWithTimeout(`${rawBaseUrl}/setup`, {}, 8000).catch(() => {});
        } catch (_) {}
      } else if (preset && preset.id === "tg_proxy_assistant" && finalVars.BOT_TOKEN) {
        try {
          const webhookTarget = `${rawBaseUrl}/webhook`;
          await fetchWithTimeout(`https://api.telegram.org/bot${finalVars.BOT_TOKEN}/setWebhook?url=${encodeURIComponent(webhookTarget)}`, {}, 8000).catch(() => {});
        } catch (_) {}
      }

      await logEvent(env, `استقرار موفق ورکر ${workerName} از طریق پنل وب.`, "info");
      return jsonResponse({ success: true, url: finalUrl, pathSuffix });
    }

    // 12. GET /api/logs
    if (request.method === "GET" && url.pathname === "/api/logs") {
      const logs = await env.BOT_KV.get("system:logs", { type: "json" }) || [];
      return jsonResponse(logs);
    }

    // 13. POST /api/refresh-cache
    if (request.method === "POST" && url.pathname === "/api/refresh-cache") {
      await cacheAllPresets(env);
      return jsonResponse({ success: true });
    }

    return jsonResponse({ error: "Endpoint not found" }, 404);

  } catch (err) {
    return jsonResponse({ success: false, error: err.message }, 500);
  }
}

// Helper to access shared accounts across Web & Telegram
async function getGlobalAccounts(env) {
  // First check if dedicated web accounts exist in KV
  let accounts = await env.BOT_KV.get("system:accounts", { type: "json" });
  if (accounts && Array.isArray(accounts) && accounts.length > 0) return accounts;

  // Fallback: check session accounts from telegram users if any
  // e.g. list sessions and gather accounts
  return [];
}

async function saveGlobalAccounts(env, accounts) {
  await env.BOT_KV.put("system:accounts", JSON.stringify(accounts));
}

