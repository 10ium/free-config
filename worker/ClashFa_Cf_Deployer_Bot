// --- STRING UTILITIES FOR TELEGRAM SAFETY ---
function escapeHTML(str) {
  if (typeof str !== "string") return String(str ?? "");
  return str
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
}

function stripHTML(str) {
  if (typeof str !== "string") return String(str ?? "");
  return str.replace(/<[^>]*>?/gm, "");
}

function splitTextIntoChunks(text, maxLen = 3800) {
  if (text.length <= maxLen) return [text];
  const chunks = [];
  let current = "";
  const lines = text.split("\n");

  for (const line of lines) {
    if (line.length > maxLen) {
      if (current) {
        chunks.push(current.trim());
        current = "";
      }
      for (let i = 0; i < line.length; i += maxLen) {
        chunks.push(line.slice(i, i + maxLen));
      }
      continue;
    }

    if ((current + "\n" + line).length > maxLen) {
      if (current) chunks.push(current.trim());
      current = line;
    } else {
      current = current ? (current + "\n" + line) : line;
    }
  }
  if (current) chunks.push(current.trim());
  return chunks;
}

// --- TELEGRAM SEND / EDIT / UPLOAD SYSTEM ---
async function sendMessage(chatId, text, env, useReplyMarkup = false, customKeyboard = null) {
  let replyMarkup = {};
  if (useReplyMarkup) {
    replyMarkup = { keyboard: [[{ text: "🔙 بازگشت به منوی اصلی" }]], resize_keyboard: true };
  } else if (customKeyboard) {
    replyMarkup = { inline_keyboard: customKeyboard };
  }

  // Auto-split long messages (> 3800 chars) to prevent Telegram 400 Bad Request
  if (text.length > 3800) {
    const chunks = splitTextIntoChunks(text, 3800);
    for (let i = 0; i < chunks.length; i++) {
      const isLast = (i === chunks.length - 1);
      await sendSingleMessage(chatId, chunks[i], env, isLast ? ((useReplyMarkup || customKeyboard) ? replyMarkup : undefined) : undefined);
    }
    return;
  }

  await sendSingleMessage(chatId, text, env, (useReplyMarkup || customKeyboard) ? replyMarkup : undefined);
}

async function sendSingleMessage(chatId, text, env, replyMarkup) {
  const botToken = env.TELEGRAM_BOT_TOKEN || env.BOT_TOKEN;
  const url = `https://api.telegram.org/bot${botToken}/sendMessage`;
  try {
    const res = await fetchWithTimeout(url, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        chat_id: chatId,
        text: text,
        parse_mode: "HTML",
        reply_markup: replyMarkup
      })
    }, 10000);

    const data = await res.json();
    // Resilient fallback: If HTML entity parsing fails, retry as plain text!
    if (!data.ok && data.description && data.description.includes("can't parse entities")) {
      await fetchWithTimeout(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          chat_id: chatId,
          text: stripHTML(text),
          reply_markup: replyMarkup
        })
      }, 10000);
    }
  } catch (err) {
    console.error("Telegram sendSingleMessage error:", err);
  }
}

