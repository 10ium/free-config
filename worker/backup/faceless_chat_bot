function escapeHtml(str = "") {
  return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}
async function ensureForumTopic(db, tg, recipientHash, senderHash, groupId, topicTitle) {
  let topicId = await db.getForumTopic(recipientHash, senderHash, groupId);
  if (topicId) {
    tg.editForumTopic(groupId, topicId, topicTitle).catch(() => {
    });
    return topicId;
  }
  const lockKey = `topic:create:${recipientHash}:${senderHash}`;
  const isLeader = await db.acquireUserLock(lockKey, 6e3);
  if (!isLeader) {
    await new Promise((resolve) => setTimeout(resolve, 500));
    topicId = await db.getForumTopic(recipientHash, senderHash, groupId);
    if (topicId) {
      return topicId;
    }
  }
  try {
    topicId = await db.getForumTopic(recipientHash, senderHash, groupId);
    if (!topicId) {
      const newTopic = await tg.createForumTopic(groupId, topicTitle);
      topicId = newTopic.message_thread_id;
      await db.saveForumTopic(recipientHash, senderHash, topicId, groupId);
    }
    return topicId;
  } finally {
    await db.releaseUserLock(lockKey);
  }
}
